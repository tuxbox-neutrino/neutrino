<!DOCTYPE html>
<html lang="de" data-theme="dark">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>yWeb - {=L:yw.nav.settings=}</title>
	<link rel="icon" href="/favicon/favicon.ico">
	<link rel="stylesheet" href="/css/pico.min.css">
	<link rel="stylesheet" href="/css/yweb.css?v=67">
	<style>
		/* Layout as <main>: inherits the global main rule (flex:1,
		   min-height:0, overflow:auto) so long content scrolls and the
		   footer stays below, like every other page.
		   M5b: randlos wie bouquets/timer — keine Zentrierung mehr */
		.yweb-settings-layout {
			display: flex;
			gap: 0.5rem;
			padding: 0.5rem;
		}

		/* Sidebar — Panel-Karte in der Optik von bouquets/timer */
		.yweb-settings-sidebar {
			width: 230px;
			flex-shrink: 0;
			position: sticky;
			top: 4.5rem;
			align-self: flex-start;
			max-height: calc(100vh - 5rem);
			overflow-y: auto;
			overflow-x: hidden;
			background: var(--pico-card-background-color);
			border: 1px solid var(--pico-muted-border-color);
			border-radius: var(--yweb-radius);
		}
		.settings-nav-head {
			padding: 0.5rem 0.85rem;
			font-size: var(--yweb-font-sm);
			font-weight: 600;
			color: var(--pico-color);
			border-bottom: 1px solid var(--pico-muted-border-color);
		}
		#settingsSidebar {
			display: block;
			padding: 0.1rem 0 0.25rem;
		}
		/* Gruppen-Zwischentitel (Optik wie .yweb-form-section-title).
		   Kompakte Zeilen: alle 6 Gruppen + 17 Einträge müssen bis
		   900px Fensterhöhe ohne Sidebar-Scroll sichtbar sein */
		#settingsSidebar .grp {
			padding: 0.4rem 0.75rem 0.15rem;
			font-size: var(--yweb-font-xs);
			color: var(--yweb-accent);
			text-transform: uppercase;
			letter-spacing: 0.08em;
			font-weight: 600;
			line-height: 1.2;
		}
		#settingsSidebar button {
			display: flex;
			align-items: center;
			gap: 0.5rem;
			width: 100%;
			text-align: left;
			padding: 0.3rem 0.75rem;
			font-size: var(--yweb-font-sm);
			line-height: 1.2;
			color: var(--pico-muted-color);
			background: none;
			border: none;
			border-left: 3px solid transparent;
			border-radius: 0;
			cursor: pointer;
			transition: var(--yweb-transition);
			margin: 0;
		}
		#settingsSidebar button svg {
			flex-shrink: 0;
		}
		#settingsSidebar button:hover {
			color: var(--pico-color);
			background: rgba(255,255,255,0.03);
		}
		#settingsSidebar button.active {
			color: var(--yweb-accent);
			border-left-color: var(--yweb-accent);
			font-weight: 600;
			background: rgba(255,165,0,0.06);
		}

		/* Mobile category dropdown */
		.yweb-settings-mobile-nav {
			display: none;
			padding: 0.75rem 1rem 0;
		}
		.yweb-settings-mobile-nav select {
			width: 100%;
			padding: 0.5rem !important;
			font-size: var(--yweb-font-sm);
			margin-bottom: 0 !important;
			height: auto !important;
			border-radius: var(--yweb-radius);
			border: 1px solid var(--pico-muted-border-color);
			background: var(--pico-card-background-color);
			color: var(--pico-color);
		}

		/* Content area — Karte füllt die Restbreite, der Formular-Inhalt
		   bleibt für die Lesbarkeit auf 720px begrenzt */
		.yweb-settings-content {
			flex: 1;
			min-width: 0;
		}
		.settings-card > :not(.settings-card-header) {
			max-width: 720px;
		}

		/* Panels */
		.settings-panel {
			display: none;
		}
		.settings-panel.active {
			display: block;
		}
		.settings-card {
			background: var(--pico-card-background-color);
			border: 1px solid var(--pico-muted-border-color);
			border-radius: var(--yweb-radius);
			padding: 1.2rem;
		}
		.settings-card-header {
			display: flex;
			align-items: center;
			justify-content: space-between;
			margin-bottom: 1rem;
			padding-bottom: 0.6rem;
			border-bottom: 1px solid var(--pico-muted-border-color);
		}
		.settings-card-header h3 {
			margin: 0;
			font-size: var(--yweb-font-sm);
			font-weight: 600;
			color: var(--pico-color);
		}

		/* Settings-specific form overrides */
		.settings-card .yweb-form-row label:not(.yweb-toggle) {
			min-width: 10rem;
		}
		.settings-card .yweb-form-row select,
		.settings-card .yweb-form-row input[type="text"],
		.settings-card .yweb-form-row input[type="number"],
		.settings-card .yweb-form-row input[type="password"] {
			width: 16rem;
			flex: none;
		}
		.settings-card .yweb-form-row input[type="number"] {
			width: 6rem;
		}

		/* M5c: zentrale Dirty-State-Save-Leiste am Fuß der Content-Spalte.
		   Klebt beim Scrollen am unteren Rand und wirkt über der Karte
		   wie deren Fuß (gleicher Hintergrund, border-top als Trenner) */
		.settings-save-bar {
			display: flex;
			gap: 0.5rem;
			align-items: center;
			justify-content: flex-end;
			border-top: 1px solid var(--pico-muted-border-color);
			padding: 0.7rem 1rem;
			position: sticky;
			bottom: 0;
			background: var(--pico-card-background-color);
			border-radius: 0 0 var(--yweb-radius) var(--yweb-radius);
		}
		/* hidden-Attribut muss gegen das display:flex gewinnen */
		.settings-save-bar[hidden] {
			display: none;
		}
		.settings-save-bar .note {
			margin-right: auto;
			color: var(--pico-muted-color);
			font-size: var(--yweb-font-sm);
		}

		/* Mount slots */
		.mount-slot {
			background: var(--pico-background-color);
			border: 1px solid var(--pico-muted-border-color);
			border-radius: var(--yweb-radius);
			margin-bottom: 0.5rem;
			overflow: hidden;
		}
		.mount-slot-header {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 0.6rem 0.85rem;
			cursor: pointer;
			font-size: var(--yweb-font-sm);
			color: var(--pico-color);
			transition: var(--yweb-transition);
		}
		.mount-slot-header:hover {
			background: rgba(255,255,255,0.03);
		}
		.mount-slot-header .slot-summary {
			color: var(--pico-muted-color);
			font-size: var(--yweb-font-xs);
			margin-left: 0.5rem;
		}
		.mount-slot-header svg {
			width: 16px;
			height: 16px;
			transition: transform 0.2s;
			flex-shrink: 0;
			color: var(--pico-muted-color);
		}
		.mount-slot.open > .mount-slot-header svg {
			transform: rotate(180deg);
		}
		.mount-slot-body {
			display: none;
			padding: 0.6rem 0.85rem 0.85rem;
			border-top: 1px solid var(--pico-muted-border-color);
		}
		.mount-slot.open > .mount-slot-body {
			display: block;
		}
		.cifs-fields {
			display: none;
		}
		.cifs-fields.visible {
			display: block;
		}

		/* M5c: Erweiterungen als 3-Spalten-Tabelle (Name | Slot | Aktiv) */
		.ext-grid {
			display: grid;
			grid-template-columns: 1fr 140px 52px;
			gap: 0.45rem 0.75rem;
			align-items: center;
		}
		.ext-grid .ext-grid-head {
			font-size: var(--yweb-font-xs);
			color: var(--pico-muted-color);
			text-transform: uppercase;
			letter-spacing: 0.05em;
			font-weight: 600;
			border-bottom: 1px solid var(--pico-muted-border-color);
			padding-bottom: 0.3rem;
		}
		.ext-grid select {
			width: 100%;
			margin: 0;
			padding: 0.2rem 0.4rem !important;
			height: auto !important;
			font-size: var(--yweb-font-sm);
		}
		.ext-grid .ext-name {
			font-size: var(--yweb-font-sm);
			min-width: 0;
		}

		/* Loading */
		.settings-loading {
			text-align: center;
			padding: 3rem;
			color: var(--pico-muted-color);
		}

		/* Mobile — settings-specific overrides (form-row mobile handled by yweb.css) */
		@media (max-width: 800px) {
			.yweb-settings-sidebar { display: none; }
			.yweb-settings-mobile-nav { display: block; }
			.yweb-settings-layout { padding: 0.5rem; }
			.settings-card { padding: 0.8rem; }
			.settings-card .yweb-form-row select,
			.settings-card .yweb-form-row input[type="text"],
			.settings-card .yweb-form-row input[type="number"],
			.settings-card .yweb-form-row input[type="password"] {
				width: 100%;
				flex: auto;
			}
		}
	</style>
</head>
<body>
	<div class="yweb-header-wrapper" data-page="settings"></div>
	<div class="yweb-header-spacer"></div>

	<!-- Mobile category selector -->
	<div class="yweb-settings-mobile-nav">
		<select id="mobileCategorySelect" onchange="switchCategory(this.value)"></select>
	</div>

	<main class="yweb-settings-layout">
		<!-- Sidebar -->
		<div class="yweb-settings-sidebar">
			<div class="settings-nav-head">{=L:yw.nav.settings=}</div>
			<nav id="settingsSidebar"></nav>
		</div>

		<!-- Content: Panels + zentrale Save-Leiste (M5c) -->
		<div class="yweb-settings-content">
			<div id="settingsContent">
				<div class="settings-loading">{=L:yw.set.loading=}</div>
			</div>
			<div id="settingsSaveBar" class="settings-save-bar" hidden>
				<span class="note"><b id="saveBarCount">0</b> {=L:yw.set.unsaved=}</span>
				<button type="button" class="yweb-btn ghost" onclick="discardSettings()">{=L:yw.set.discard=}</button>
				<button type="button" class="yweb-btn primary" onclick="saveSettings()">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>{=L:yw.bqe.save=}
				</button>
			</div>
		</div>
	</main>

	<!-- Reihenfolge: Registry-Labels rufen ywebL (yweb-header.js) auf, das
	     window.YWEB_L aus Y_Lang.yjs liest — Registry muss zuletzt laden -->
	<script src="/Y_Baselib.js"></script>
	<script src="/Y_Lang.yjs?v=8"></script>
	<script src="/yweb-header.js?v=40"></script>
	<script src="/settings-registry.js?v=8"></script>
	<script>
	var configData = {};
	var originalValues = {};
	var activeCategory = '';
	var renderedPanels = {};
	// Aktivierte Erweiterungen mit settings-Definition im Manifest werden
	// als eigene Kategorien eingeblendet (id 'ext-<dir>', Panel ueber den
	// generischen ExtConfig-Zyklus gegen config=<name>, Default yweb)
	var EXT_SETTINGS_CATS = {};

	// M5c: Karten-Kopf ist reiner Titel — gespeichert wird zentral über
	// die Dirty-State-Leiste (#settingsSaveBar) am Fuß der Content-Spalte;
	// Panels mit eigener Config-Datei (ExtConfig, Erweiterungen, WoL, ...)
	// behalten ihren eigenen Save-Button im Panel-Inhalt.
	function makeCardHeader(label) {
		var d = document.createElement('div');
		d.className = 'settings-card-header';
		var h = document.createElement('h3');
		h.textContent = label;
		d.appendChild(h);
		return d.outerHTML;
	}

	function getConfigKey(key) {
		var k = key.replace(/\./g, '_dot_').replace(/-/g, '_bind_');
		return configData[k] !== undefined ? configData[k] : '';
	}

	// Action-Buttons: Registry-Felder vom Typ 'action' registrieren sich
	// hier und feuern v4-Calls (exec, startplugin, ...) mit Toast-Feedback
	var SETTINGS_ACTIONS = {};
	async function runSettingsAction(aid, btn) {
		var f = SETTINGS_ACTIONS[aid];
		if (!f || !f.api) return;
		if (f.confirm && !confirm(f.confirm)) return;
		var orig = btn.textContent;
		btn.disabled = true;
		btn.textContent = '...';
		try {
			var res = await ywebApi(f.api.endpoint, f.api.params, f.api.raw ? {raw: true} : undefined);
			ywebShowToast(f.success || (typeof res === 'string' && res.trim()) || 'Ausgef\u00fchrt');
			if (f.refresh) await loadSettings();
			if (typeof f.after === 'function') f.after(res);
		} catch (e) {
			ywebShowToast('{=L:yw.msg.error=}: ' + e.message, true);
		}
		btn.disabled = false;
		btn.textContent = orig;
	}

	function renderField(f, opts) {
		opts = opts || {};
		var val = opts.get ? (opts.get(f.key) || '') : (f.key ? getConfigKey(f.key) : '');
		// Leeren Wert mit dem Feld-Default vorbelegen (Key noch nie gesetzt)
		if ((val === '' || val === undefined) && f.default !== undefined)
			val = String(f.default);
		// Optionaler (i)-Infotext: an das Label anhaengen (native title-Tooltip),
		// ohne die einzelnen Feldzweige anzufassen
		if (f.hint) {
			var fh = {}; for (var k in f) fh[k] = f[k];
			fh.label = f.label + ' <span class="yweb-hint" title="' + escapeHtml(f.hint) + '">&#9432;</span>';
			f = fh;
		}
		var id = 'cfg_' + (opts.idPrefix || '') + String(f.key || f.id || '').replace(/\./g, '__');
		var ext = opts.dataConfig ? ' data-extcfg="' + opts.dataConfig + '"' : '';

		if (f.type === 'info') {
			var text = (f.text !== undefined) ? f.text : val;
			return '<div class="yweb-form-row"><label>' + f.label + '</label>' +
				'<span id="' + id + '" style="color:var(--pico-muted-color)">' + (text || '--') + '</span></div>';
		}
		if (f.type === 'action') {
			// Einzel-Action oder Button-Gruppe (f.actions) in einer Zeile
			var acts = f.actions || [f];
			var btns = '';
			acts.forEach(function(a) {
				var aid = a.id || a.label || f.label;
				SETTINGS_ACTIONS[aid] = a;
				btns += '<button type="button" class="yweb-btn" onclick="runSettingsAction(\'' + aid + '\', this)">' + (a.button || a.label || f.label) + '</button> ';
			});
			return '<div class="yweb-form-row"><label>' + f.label + '</label><span>' + btns.trim() + '</span></div>';
		}

		if (f.type === 'select') {
			var opts = f.options.map(function(o) {
				return '<option value="' + o.v + '"' + (val === o.v ? ' selected' : '') + '>' + o.l + '</option>';
			}).join('');
			return '<div class="yweb-form-row"><label>' + f.label + '</label>' +
				'<select id="' + id + '" data-key="' + f.key + '"' + ext + '>' + opts + '</select></div>';
		}
		if (f.type === 'bool') {
			var isTrue = (val === 'true' || val === '1');
			return '<div class="yweb-form-row"><label>' + f.label + '</label>' +
				'<label class="yweb-toggle"><input type="checkbox" id="' + id + '" data-key="' + f.key + '" data-on="true" data-off="false"' + ext + (isTrue ? ' checked' : '') + '>' +
				'<span class="yweb-toggle-slider"></span></label></div>';
		}
		if (f.type === 'bool01') {
			var isOne = (val === '1');
			return '<div class="yweb-form-row"><label>' + f.label + '</label>' +
				'<label class="yweb-toggle"><input type="checkbox" id="' + id + '" data-key="' + f.key + '" data-on="1" data-off="0"' + ext + (isOne ? ' checked' : '') + '>' +
				'<span class="yweb-toggle-slider"></span></label></div>';
		}
		if (f.type === 'number') {
			var attrs = 'type="number"';
			if (f.min !== undefined) attrs += ' min="' + f.min + '"';
			if (f.max !== undefined) attrs += ' max="' + f.max + '"';
			return '<div class="yweb-form-row"><label>' + f.label + '</label>' +
				'<input ' + attrs + ' id="' + id + '" data-key="' + f.key + '"' + ext + ' value="' + val + '"></div>';
		}
		if (f.type === 'password') {
			return '<div class="yweb-form-row"><label>' + f.label + '</label>' +
				'<input type="password" id="' + id + '" data-key="' + f.key + '"' + ext + ' value="' + val.replace(/"/g, '&quot;') + '"></div>';
		}
		// text — optional mit Verzeichnis-Picker (f.picker: true)
		var pick = '';
		if (f.picker) {
			var pstart = val || '/';
			pick = ' <button type="button" class="yweb-btn" title="' + ywebL('picker.title', 'Choose folder') +
				'" onclick="ywebPickInto(\'' + id + '\', \'' + escapeJs(pstart) + '\')">' + FOLDER_ICON + '</button>';
		}
		return '<div class="yweb-form-row"><label>' + f.label + '</label><span>' +
			'<input type="text" id="' + id + '" data-key="' + f.key + '"' + ext + ' value="' + val.replace(/"/g, '&quot;') + '">' + pick + '</span></div>';
	}

	// kleines Ordner-Icon fuer Picker-Buttons
	var FOLDER_ICON = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:1rem;height:1rem;vertical-align:middle"><path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>';

	// M5c: 14px-Icon-Wrapper fuer Panel-Buttons (Optik wie Save-Leiste)
	function sIcon(paths) {
		return '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' + paths + '<\/svg>';
	}
	var SAVE_ICON = sIcon('<path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/>');
	var DL_ICON = sIcon('<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>');
	var UP_ICON = sIcon('<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>');
	var PLAY_ICON = sIcon('<polygon points="5 3 19 12 5 21 5 3"/>');
	var REFRESH_ICON = sIcon('<polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>');
	var ZAP_ICON = sIcon('<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>');
	var MOUNT_ICON = sIcon('<line x1="22" y1="12" x2="2" y2="12"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/><line x1="6" y1="16" x2="6.01" y2="16"/><line x1="10" y1="16" x2="10.01" y2="16"/>');
	var EJECT_ICON = sIcon('<path d="M12 5l7 9H5l7-9z"/><line x1="5" y1="19" x2="19" y2="19"/>');
	var RESTORE_ICON = sIcon('<polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>');

	// Markup-Helfer: gestyltes Datei-Control (.yweb-file aus yweb.css);
	// der gewählte Dateiname landet via onchange in .yweb-file-name
	function makeFileControl(inputId, accept) {
		return '<label class="yweb-file"><input type="file" id="' + inputId + '"' +
			(accept ? ' accept="' + accept + '"' : '') + ' onchange="ywebFileName(this)">' +
			'<span class="yweb-file-btn">{=L:yw.set.choose_file=}</span>' +
			'<span class="yweb-file-name">&ndash;</span></label>';
	}
	// ywebFileName (onchange-Companion des Controls) liefert yweb-header.js

	// Rechtsbuendiger Save-Button fuer Panels mit eigenem Config-Zyklus
	// (ExtConfig, Erweiterungen, WoL) — Optik wie die zentrale Save-Leiste.
	// display:flex inline, weil .yweb-row-actions nur innerhalb von
	// .yweb-form-row automatisch flext (hier steht die Zeile solo)
	function makePanelSaveRow(onclick, label) {
		return '<div class="yweb-row-actions" style="display:flex;gap:0.5rem;justify-content:flex-end;margin-top:0.6rem">' +
			'<button type="button" class="yweb-btn primary" onclick="' + onclick + '">' +
			SAVE_ICON + (label || '{=L:yw.bqe.save=}') + '</button></div>';
	}

	// Picker oeffnen und Ergebnis in das Textfeld schreiben
	function ywebPickInto(inputId, startPath) {
		ywebShowPathPicker(startPath, function(p) {
			var el = document.getElementById(inputId);
			if (el) { el.value = p; el.dispatchEvent(new Event('change')); }
		});
	}

	function renderCategory(catId) {
		if (EXT_SETTINGS_CATS[catId]) return renderExtConfigPanel(EXT_SETTINGS_CATS[catId]);
		var cat = SETTINGS_REGISTRY.find(function(c) { return c.id === catId; });
		if (!cat) return '';

		if (cat.custom && cat.id === 'mounts') return renderMountsPanel();
		if (cat.custom && cat.id === 'plugins') return renderPluginsPanel();
		if (cat.custom && cat.id === 'backup') return renderBackupPanel();
		if (cat.custom && cat.id === 'wol') return renderWolPanel();
		if (cat.custom && cat.id === 'xmltv') return renderXmltvPanel();
		if (cat.custom && cat.id === 'zapitupload') return renderZapitUploadPanel();
		if (cat.custom && cat.id === 'extensions') return renderExtensionsPanel();
		if (cat.config && cat.config !== 'neutrino') return renderExtConfigPanel(cat);

		var html = makeCardHeader(cat.label);
		cat.sections.forEach(function(sec) {
			html += '<div class="yweb-form-section">';
			html += '<div class="yweb-form-section-title">' + sec.title + '</div>';
			sec.fields.forEach(function(f) {
				html += renderField(f);
			});
			html += '</div>';
		});

		return '<div class="settings-card">' + html + '</div>';
	}

	// Kategorien mit eigener Config-Datei (nhttpd.conf, yWeb.conf, ...):
	// eigener Load/Diff/Save-Zyklus gegen config=<name>, getrennt vom
	// neutrino-Hauptformular (collectValues ignoriert data-extcfg-Felder)
	var EXT_CONFIG_CACHE = {};
	function renderExtConfigPanel(cat) {
		setTimeout(function() { loadExtConfigPanel(cat); }, 0);
		return '<div class="settings-card">' + makeCardHeader(cat.label) +
			'<div id="extcfg-' + cat.id + '"><p aria-busy="true">{=L:yw.msg.loading=}</p></div></div>';
	}

	async function loadExtConfigPanel(cat) {
		var el = document.getElementById('extcfg-' + cat.id);
		if (!el) return;
		try {
			var resp = await ywebApi('config', {config: cat.config});
			var cfg = (resp && resp.data && resp.data.config) || {};
			EXT_CONFIG_CACHE[cat.config] = cfg;
			var get = function(key) { return cfg[String(key).replace(/\./g, '_dot_').replace(/-/g, '_bind_')] || ''; };
			var html = '';
			var savable = 0;
			cat.sections.forEach(function(sec) {
				html += '<div class="yweb-form-section"><div class="yweb-form-section-title">' + sec.title + '</div>';
				sec.fields.forEach(function(f) {
					if (f.key && f.type !== 'info' && f.type !== 'action') savable++;
					html += renderField(f, {get: get, dataConfig: cat.config, idPrefix: cat.id + '_'});
				});
				html += '</div>';
			});
			// Reine Action-/Info-Panels haben nichts zu speichern
			if (savable > 0)
				html += makePanelSaveRow('saveExtConfig(\'' + cat.id + '\', \'' + cat.config + '\', this)');
			el.innerHTML = html;
		} catch (e) {
			el.innerHTML = '<div class="yweb-form-row"><label>{=L:yw.set.notavail=}: ' + escapeHtml(e.message) + '</label></div>';
		}
	}

	async function saveExtConfig(catId, cfgName, btn) {
		var root = document.getElementById('extcfg-' + catId);
		var cfg = EXT_CONFIG_CACHE[cfgName] || {};
		var params = 'action=submit';
		var changed = 0;
		root.querySelectorAll('[data-key][data-extcfg]').forEach(function(el) {
			var key = el.getAttribute('data-key');
			var val = (el.type === 'checkbox') ? (el.checked ? el.getAttribute('data-on') : el.getAttribute('data-off')) : el.value;
			var ck = key.replace(/\./g, '_dot_').replace(/-/g, '_bind_');
			if (val !== (cfg[ck] || '')) {
				params += '&' + encodeURIComponent(key) + '=' + encodeURIComponent(val);
				changed++;
			}
		});
		if (changed === 0) { ywebShowToast('{=L:yw.set.nochanges=}'); return; }
		btn.disabled = true;
		try {
			await ywebApi('config', 'config=' + cfgName + '&' + params);
			ywebShowToast(changed + ' Einstellung' + (changed > 1 ? 'en' : '') + ' gespeichert');
			await loadExtConfigPanel(SETTINGS_REGISTRY.find(function(c) { return c.id === catId; }) || EXT_SETTINGS_CATS[catId]);
		} catch (e) {
			ywebShowToast('{=L:yw.msg.error=}: ' + e.message, true);
		}
		btn.disabled = false;
	}

	// Backup/Restore der Einstellungen via exec-Vertrag
	// (Y_Tools settings_backup_restore; Script echot den Archivpfad)
	function renderBackupPanel() {
		return '<div class="settings-card">' + makeCardHeader('{=L:yw.set.backup_title=}') +
			'<div class="yweb-form-section"><div class="yweb-form-section-title">Backup</div>' +
			'<div class="yweb-form-row"><label>{=L:yw.set.backup_label=} <small style="color:var(--pico-muted-color)">{=L:yw.set.backup_hint=}</small></label>' +
			'<span class="yweb-row-actions">' +
			'<button type="button" class="yweb-btn primary" onclick="doSettingsBackup(this)">' + DL_ICON + '{=L:yw.set.backup_btn=}</button></span></div></div>' +
			'<div class="yweb-form-section"><div class="yweb-form-section-title">Restore</div>' +
			'<div class="yweb-form-row"><label>{=L:yw.set.restore_label=} <small style="color:var(--pico-muted-color)">{=L:yw.set.restore_hint=}</small></label>' +
			'<span class="yweb-row-actions">' + makeFileControl('restoreFile') +
			'<button type="button" class="yweb-btn danger" onclick="doSettingsRestore(this)">' + RESTORE_ICON + '{=L:yw.set.restore_btn=}</button></span></div></div></div>';
	}

	async function doSettingsBackup(btn) {
		btn.disabled = true;
		try {
			var out = (await ywebApi('exec', 'Y_Tools&settings_backup_restore&backup', {raw: true})).trim();
			var file = out.split('\n').pop().trim();
			if (file.indexOf('/') !== 0) throw new Error(out || '{=L:yw.set.no_archive=}');
			ywebShowToast('Backup: ' + file);
			window.location.href = '/api/v4/file?action=download&path=' + encodeURIComponent(file);
		} catch (e) {
			ywebShowToast('{=L:yw.set.backup_fail=}: ' + e.message, true);
		}
		btn.disabled = false;
	}

	// M5c: Bestätigung im geteilten ywebModal statt confirm() — die
	// destruktive Aktion bekommt einen klaren Danger-Bestätigungsknopf
	function doSettingsRestore(btn) {
		var inp = document.getElementById('restoreFile');
		if (!inp || !inp.files || !inp.files.length) { ywebShowToast('{=L:yw.inst.nofile=}', true); return; }
		ywebModal('restoreConfirmModal', '{=L:yw.set.restore_btn=}',
			'<p>{=L:yw.set.restore_confirm=}<br><small style="color:var(--pico-muted-color)">' +
			escapeHtml(inp.files[0].name) + '</small></p>' +
			'<div class="yweb-row-actions" style="justify-content:flex-end">' +
			'<button type="button" class="yweb-btn ghost" onclick="ywebCloseModal(\'restoreConfirmModal\')">{=L:yw.tm.cancel=}</button>' +
			'<button type="button" class="yweb-btn danger" onclick="ywebRestoreGo(this)">' + RESTORE_ICON + '{=L:yw.set.restore_btn=}</button></div>');
	}

	async function ywebRestoreGo(btn) {
		var inp = document.getElementById('restoreFile');
		if (!inp || !inp.files || !inp.files.length) return;
		btn.disabled = true;
		try {
			var f = inp.files[0];
			var fd = new FormData();
			fd.append('file', f);
			var up = await fetch('/api/v4/file?action=upload&path=/tmp', {method: 'POST', body: fd});
			if (!up.ok) throw new Error('Upload fehlgeschlagen');
			var out = await ywebApi('exec', 'Y_Tools&exec_cmd&restore.sh&' + encodeURIComponent('/tmp/' + f.name), {raw: true});
			ywebShowToast('Restore: ' + (out.trim() || '{=L:yw.set.restore_done=}'));
			ywebCloseModal('restoreConfirmModal');
		} catch (e) {
			ywebShowToast('{=L:yw.set.restore_fail=}: ' + e.message, true);
		}
		btn.disabled = false;
	}

	// Erweiterungs-Verwaltung: entdeckte Manifeste mit Enable-Toggle und
	// Slot-Override (persistiert in config=yweb, Loader in yweb-header.js)
	function renderExtensionsPanel() {
		setTimeout(loadExtensionsPanel, 0);
		return '<div class="settings-card">' + makeCardHeader('{=L:yw.set.ext_title=}') +
			'<div id="extPanel"><p aria-busy="true">{=L:yw.set.ext_search=}</p></div></div>';
	}

	async function loadExtensionsPanel() {
		var el = document.getElementById('extPanel');
		if (!el) return;
		_ywebExtensions = null; // Discovery-Cache invalidieren
		var exts = await ywebDiscoverExtensions();
		if (!exts.length) {
			el.innerHTML = '<div class="yweb-form-row"><label>{=L:yw.set.ext_none=} ' +
				'<small style="color:var(--pico-muted-color)">Verzeichnis: &lt;webroot&gt;/extensions/&lt;name&gt;/manifest.json — siehe README</small></label></div>';
			return;
		}
		// M5c: 3-Spalten-Grid mit Kopfzeile statt frei fließender Zeilen —
		// Slot-Selects und Toggles aller Erweiterungen fluchten spaltenweise
		var html = '<div class="yweb-form-section"><div class="yweb-form-section-title">{=L:yw.set.ext_found=}</div>' +
			'<div class="ext-grid">' +
			'<div class="ext-grid-head">{=L:yw.set.ext_col_ext=}</div>' +
			'<div class="ext-grid-head">Slot</div>' +
			'<div class="ext-grid-head">{=L:yw.set.ext_col_on=}</div>';
		exts.forEach(function(m) {
			html += '<div class="ext-name">' + escapeHtml(m.name) +
				' <small style="color:var(--pico-muted-color)">v' + escapeHtml(m.version || '?') +
				(m.url ? ' — <a href="' + escapeHtml(m.url) + '">' + escapeHtml(m.entry) + '</a>' : ' — {=L:yw.set.ext_settings_only=}') + '</small></div>' +
				'<div><select id="extslot_' + m.dir + '">' +
				['nav', 'tools', 'dashboard', 'page'].map(function(sl) {
					return '<option value="' + sl + '"' + (m.slot === sl ? ' selected' : '') + '>' + sl + '</option>';
				}).join('') + '</select></div>' +
				'<div><label class="yweb-toggle"><input type="checkbox" id="extena_' + m.dir + '"' + (m.enabled ? ' checked' : '') + '>' +
				'<span class="yweb-toggle-slider"></span></label></div>';
		});
		html += '</div></div>' + makePanelSaveRow('saveExtensions(this)');
		el.innerHTML = html;
	}

	async function saveExtensions(btn) {
		var exts = await ywebDiscoverExtensions();
		var params = 'action=submit';
		exts.forEach(function(m) {
			var ena = document.getElementById('extena_' + m.dir);
			var slot = document.getElementById('extslot_' + m.dir);
			params += '&ext_' + m.dir + '_enabled=' + (ena && ena.checked ? '1' : '0');
			if (slot) params += '&ext_' + m.dir + '_slot=' + slot.value;
		});
		btn.disabled = true;
		try {
			await ywebApi('config', 'config=yweb&' + params);
			ywebShowToast('{=L:yw.set.ext_saved=}');
			await loadExtensionsPanel();
		} catch (e) { ywebShowToast('{=L:yw.msg.error=}: ' + e.message, true); }
		btn.disabled = false;
	}

	// Wake-on-LAN: MAC/Beschreibung in yWeb.conf (config=yweb), Wecken
	// via exec-Vertrag (ether-wake auf der Box)
	function renderWolPanel() {
		setTimeout(loadWolPanel, 0);
		return '<div class="settings-card">' + makeCardHeader('Wake-on-LAN') +
			'<div id="wolPanel"><p aria-busy="true">Lade…</p></div></div>';
	}

	async function loadWolPanel() {
		var el = document.getElementById('wolPanel');
		if (!el) return;
		try {
			var resp = await ywebApi('config', {config: 'yweb'});
			var cfg = (resp && resp.data && resp.data.config) || {};
			EXT_CONFIG_CACHE['yweb'] = cfg;
			var html = '<div class="yweb-form-section"><div class="yweb-form-section-title">{=L:yw.set.wol_devices=}</div>';
			for (var i = 1; i <= 3; i++) {
				html += '<div class="yweb-form-row"><label>{=L:yw.set.wol_device=} ' + i + '</label><span>' +
					'<input type="text" id="wol_desc_' + i + '" placeholder="{=L:yw.m3u.desc=}" style="max-width:140px" value="' + (cfg['wol_desc_' + i] || '') + '"> ' +
					'<input type="text" id="wol_mac_' + i + '" placeholder="aa:bb:cc:dd:ee:ff" style="max-width:160px" value="' + (cfg['wol_mac_' + i] || '') + '"> ' +
					'<button type="button" class="yweb-btn" onclick="wolWake(' + i + ', this)">' + ZAP_ICON + '{=L:yw.set.wol_wake=}</button></span></div>';
			}
			html += '</div>' + makePanelSaveRow('wolSave(this)');
			el.innerHTML = html;
		} catch (e) {
			el.innerHTML = '<div class="yweb-form-row"><label>{=L:yw.set.notavail=}: ' + escapeHtml(e.message) + '</label></div>';
		}
	}

	async function wolWake(i, btn) {
		var mac = (document.getElementById('wol_mac_' + i) || {}).value || '';
		if (!mac.trim()) { ywebShowToast('{=L:yw.set.wol_nomac=}', true); return; }
		btn.disabled = true;
		try {
			await ywebApi('exec', 'Y_Tools&wol&' + encodeURIComponent(mac.trim()), {raw: true});
			ywebShowToast('{=L:yw.set.wol_sent=}: ' + mac.trim());
		} catch (e) {
			ywebShowToast('{=L:yw.msg.error=}: ' + e.message, true);
		}
		btn.disabled = false;
	}

	async function wolSave(btn) {
		var cfg = EXT_CONFIG_CACHE['yweb'] || {};
		var params = 'action=submit';
		var changed = 0;
		for (var i = 1; i <= 3; i++) {
			['wol_desc_' + i, 'wol_mac_' + i].forEach(function(k) {
				var v = (document.getElementById(k) || {}).value || '';
				if (v !== (cfg[k] || '')) { params += '&' + k + '=' + encodeURIComponent(v); changed++; }
			});
		}
		if (!changed) { ywebShowToast('{=L:yw.set.nochanges=}'); return; }
		btn.disabled = true;
		try {
			await ywebApi('config', 'config=yweb&' + params);
			ywebShowToast('{=L:yw.m3u.saved=}');
			await loadWolPanel();
		} catch (e) { ywebShowToast('{=L:yw.msg.error=}: ' + e.message, true); }
		btn.disabled = false;
	}

	// XMLTV/WebChannels-Quellen: eine URL pro Zeile; Speichern setzt die
	// Listen via xmltvlist (ACHTUNG: leere Textarea leert die Liste) und
	// laedt die Kanallisten neu (reloadchannels-Trichter, vgl. WORK-147)
	function renderXmltvPanel() {
		setTimeout(loadXmltvPanel, 0);
		return '<div class="settings-card">' + makeCardHeader('{=L:yw.set.xmltv_title=}') +
			'<div id="xmltvPanel"><p aria-busy="true">Lade…</p></div></div>';
	}

	function collectXmlSources(cfg, base) {
		var out = [];
		if (cfg[base]) out.push(cfg[base]);
		var count = parseInt(cfg[base + '_count']) || 0;
		for (var i = 1; i <= count; i++)
			if (cfg[base + '_' + i]) out.push(cfg[base + '_' + i]);
		return out;
	}

	async function loadXmltvPanel() {
		var el = document.getElementById('xmltvPanel');
		if (!el) return;
		try {
			var resp = await ywebApi('config', {config: 'neutrino'});
			var cfg = (resp && resp.data && resp.data.config) || {};
			var tv = collectXmlSources(cfg, 'webtv_xml').join('\n');
			var radio = collectXmlSources(cfg, 'webradio_xml').join('\n');
			el.innerHTML = '<div class="yweb-form-section"><div class="yweb-form-section-title">WebTV</div>' +
				'<textarea id="xmltv_tv" rows="4" style="width:100%" placeholder="{=L:yw.set.xmltv_ph=}">' + escapeHtml(tv) + '</textarea>' +
				'<div class="yweb-form-row" style="margin-top:0.4rem"><label><small style="color:var(--pico-muted-color)">{=L:yw.set.xmltv_upload=}</small></label>' +
				'<span class="yweb-row-actions">' + makeFileControl('xmltv_tv_file', '.xml,.m3u') +
				'<button type="button" class="yweb-btn" onclick="uploadXmltv(\'tv\', this)">' + UP_ICON + '{=L:yw.fm.upload=}</button></span></div></div>' +
				'<div class="yweb-form-section"><div class="yweb-form-section-title">WebRadio</div>' +
				'<textarea id="xmltv_radio" rows="4" style="width:100%">' + escapeHtml(radio) + '</textarea>' +
				'<div class="yweb-form-row" style="margin-top:0.4rem"><label><small style="color:var(--pico-muted-color)">{=L:yw.set.xmltv_upload=}</small></label>' +
				'<span class="yweb-row-actions">' + makeFileControl('xmltv_radio_file', '.xml,.m3u') +
				'<button type="button" class="yweb-btn" onclick="uploadXmltv(\'radio\', this)">' + UP_ICON + '{=L:yw.fm.upload=}</button></span></div></div>' +
				'<div class="yweb-form-row"><label><small style="color:var(--pico-muted-color)">{=L:yw.set.xmltv_hint=}</small></label>' +
				'<span class="yweb-row-actions">' +
				'<button type="button" class="yweb-btn primary" onclick="saveXmltv(this)">' + SAVE_ICON + '{=L:yw.bqe.save_reload=}</button></span></div>';
		} catch (e) {
			el.innerHTML = '<div class="yweb-form-row"><label>{=L:yw.set.notavail=}: ' + escapeHtml(e.message) + '</label></div>';
		}
	}

	// Lokale Quelldatei ins WebTV/WebRadio-Verzeichnis hochladen und ihren
	// Pfad als neue Zeile in die passende Quellliste eintragen (Speichern
	// aktiviert sie dann wie eine URL-Zeile). Ersetzt xmltvlist NICHT sofort.
	async function uploadXmltv(kind, btn) {
		var inp = document.getElementById('xmltv_' + kind + '_file');
		var ta = document.getElementById('xmltv_' + kind);
		if (!inp || !inp.files || !inp.files.length) { ywebShowToast('{=L:yw.inst.nofile=}', true); return; }
		btn.disabled = true;
		try {
			var paths = await ywebApi('paths');
			var dir = (kind === 'tv' ? paths.webtvdir_var : paths.webradiodir_var) || paths.configdir;
			var f = inp.files[0];
			var fd = new FormData();
			fd.append('file', f);
			var up = await fetch('/api/v4/file?action=upload&path=' + encodeURIComponent(dir),
				{method: 'POST', body: fd});
			if (!up.ok) throw new Error('{=L:yw.inst.upfail=}');
			var res = await up.json();
			var savedPath = (res.data && res.data.path) || (dir + '/' + f.name);
			if (ta && ta.value.split('\n').indexOf(savedPath) < 0)
				ta.value = (ta.value ? ta.value.replace(/\n*$/, '\n') : '') + savedPath;
			ywebShowToast('{=L:yw.fm.uploaded=}: ' + savedPath);
			inp.value = '';
		} catch (e) { ywebShowToast('{=L:yw.fm.upload_fail=}: ' + e.message, true); }
		btn.disabled = false;
	}

	async function saveXmltv(btn) {
		var tv = (document.getElementById('xmltv_tv') || {}).value || '';
		var radio = (document.getElementById('xmltv_radio') || {}).value || '';
		if (!confirm('{=L:yw.set.xmltv_confirm=}')) return;
		btn.disabled = true;
		try {
			await ywebApi('xmltvlist', {webtv: tv, webradio: radio});
			await ywebApi('reloadchannels');
			ywebShowToast('{=L:yw.set.xmltv_saved=}');
		} catch (e) { ywebShowToast('{=L:yw.msg.error=}: ' + e.message, true); }
		btn.disabled = false;
	}

	// Zapit-Upload: Kanal-/Bouquet-XML hochladen und aktivieren
	function renderZapitUploadPanel() {
		return '<div class="settings-card">' + makeCardHeader('Zapit-Upload') +
			'<div class="yweb-form-section"><div class="yweb-form-section-title">{=L:yw.set.zapit_section=}</div>' +
			'<div class="yweb-form-row"><label>{=L:yw.set.zapit_target=}</label>' +
			'<select id="zapitTarget"><option>ubouquets.xml</option><option>bouquets.xml</option><option>services.xml</option><option>myservices.xml</option></select></div>' +
			'<div class="yweb-form-row"><label>{=L:yw.fm.file=}</label>' +
			'<span class="yweb-row-actions">' + makeFileControl('zapitFile', '.xml') +
			'<button type="button" class="yweb-btn primary" onclick="doZapitUpload(this)">' + UP_ICON + '{=L:yw.set.zapit_btn=}</button></span></div>' +
			'<div class="yweb-form-row"><label><small style="color:var(--pico-muted-color)">{=L:yw.set.zapit_hint=}</small></label>' +
			'<span id="zapitStatus" style="color:var(--pico-muted-color);font-size:0.8rem"></span></div></div></div>';
	}

	async function doZapitUpload(btn) {
		var inp = document.getElementById('zapitFile');
		var target = (document.getElementById('zapitTarget') || {}).value;
		var status = document.getElementById('zapitStatus');
		if (!inp || !inp.files || !inp.files.length) { ywebShowToast('{=L:yw.inst.nofile=}', true); return; }
		if (!confirm(target + ' {=L:yw.set.zapit_confirm=}')) return;
		btn.disabled = true;
		if (status) status.textContent = '{=L:yw.inst.uploading=}…';
		try {
			var f = inp.files[0];
			var fd = new FormData();
			fd.append('file', f);
			var up = await fetch('/api/v4/file?action=upload&path=/tmp', {method: 'POST', body: fd});
			if (!up.ok) throw new Error('{=L:yw.inst.upfail=}');
			var res = await up.json();
			var size = (res.data && res.data.size) || '?';
			var paths = await ywebApi('paths');
			var confdir = paths.configdir || '/var/tuxbox/config';
			await ywebApi('exec', 'Y_Tools&exec_cmd&cp&' + encodeURIComponent('/tmp/' + f.name) + '&' + encodeURIComponent(confdir + '/zapit/' + target), {raw: true});
			await ywebApi('reloadchannels');
			if (status) status.textContent = target + ' ✓ (' + size + ' B)';
			ywebShowToast(target + ' {=L:yw.set.zapit_done=}');
		} catch (e) {
			if (status) status.textContent = '';
			ywebShowToast('{=L:yw.msg.error=}: ' + e.message, true);
		}
		btn.disabled = false;
	}

	async function doMountUnmount(i, btn) {
		var inp = document.getElementById('cfg_network_nfs_local_dir_' + i);
		var dir = inp ? inp.value.trim() : '';
		if (!dir) { ywebShowToast('{=L:yw.set.no_mountpoint=}', true); return; }
		btn.disabled = true;
		try {
			var out = (await ywebApi('exec', 'Y_Tools&dounmount&' + encodeURIComponent(dir), {raw: true})).trim();
			ywebShowToast(out || ('Getrennt: ' + dir));
		} catch (e) {
			ywebShowToast('{=L:yw.msg.error=}: ' + e.message, true);
		}
		btn.disabled = false;
	}

	async function doMountAction(i, action, btn) {
		btn.disabled = true;
		try {
			var out = (await ywebApi('exec', 'Y_Tools&' + action + (i >= 0 ? '&' + i : ''), {raw: true})).trim();
			ywebShowToast(out || 'Ausgefuehrt');
		} catch (e) {
			ywebShowToast('{=L:yw.msg.error=}: ' + e.message, true);
		}
		btn.disabled = false;
	}

	// Plugins: Liste vom v4 plugins-Endpoint, Start via startplugin.
	// Daemon-Steuerung (nfs/samba/... via Y_Tools-Scripts) bleibt bewusst
	// der Legacy-Seite ueberlassen - paket-/imageabhaengig.
	function renderPluginsPanel() {
		setTimeout(loadPluginsPanel, 0);
		return '<div class="settings-card">' + makeCardHeader('Plugins') +
			'<div id="pluginsPanel"><p aria-busy="true">{=L:yw.set.plugins_loading=}</p></div></div>';
	}

	async function loadPluginsPanel() {
		var el = document.getElementById('pluginsPanel');
		if (!el) return;
		try {
			var data = await ywebApi('plugins');
			var list = (data && data.plugins) || [];
			var html = '<div class="yweb-form-section"><div class="yweb-form-section-title">Installierte Plugins</div>';
			if (list.length === 0) {
				html += '<div class="yweb-form-row"><label>{=L:yw.set.plugins_none=}</label></div>';
			} else {
				list.forEach(function(pl) {
					if (pl.hidden) return;
					var desc = pl.description ? ' <small style="color:var(--pico-muted-color)">' + escapeHtml(pl.description) + '</small>' : '';
					html += '<div class="yweb-form-row"><label>' + escapeHtml(pl.name) + desc + '</label>' +
						'<span class="yweb-row-actions">' +
						'<button type="button" class="yweb-btn" onclick="startPluginByName(\'' + escapeJs(pl.name) + '\', this)">' + PLAY_ICON + '{=L:yw.set.plugins_start=}</button></span></div>';
				});
			}
			html += '</div><div class="yweb-form-section"><div class="yweb-form-section-title">Verwaltung</div>' +
				'<div class="yweb-form-row"><label>{=L:yw.set.plugins_reload=}</label>' +
				'<span class="yweb-row-actions">' +
				'<button type="button" class="yweb-btn" onclick="reloadPluginList(this)">' + REFRESH_ICON + '{=L:yw.set.plugins_reload_btn=}</button></span></div></div>';
			el.innerHTML = html;
		} catch (e) {
			el.innerHTML = '<div class="yweb-form-row"><label>{=L:yw.set.plugins_notavail=}: ' + escapeHtml(e.message) + '</label></div>';
		}
	}

	async function startPluginByName(name, btn) {
		btn.disabled = true;
		try {
			await ywebApi('startplugin', {name: name});
			ywebShowToast('{=L:yw.set.plugin_started=}: ' + name);
		} catch (e) {
			ywebShowToast('{=L:yw.msg.error=}: ' + e.message, true);
		}
		btn.disabled = false;
	}

	async function reloadPluginList(btn) {
		btn.disabled = true;
		try {
			await ywebApi('reloadplugins');
			await loadPluginsPanel();
			ywebShowToast('Plugin-Liste neu geladen');
		} catch (e) {
			ywebShowToast('{=L:yw.msg.error=}: ' + e.message, true);
		}
		btn.disabled = false;
	}

	function renderMountsPanel() {
		var html = makeCardHeader('Netzlaufwerke');
		html += '<div class="yweb-form-row"><label>Alle konfigurierten Mounts</label>' +
			'<span class="yweb-row-actions">' +
			'<button type="button" class="yweb-btn primary" onclick="doMountAction(-1, \'do_mount_all\', this)">' + MOUNT_ICON + '{=L:yw.set.mnt_mount_all=}</button></span></div>';
		var chevron = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>';
		for (var i = 0; i < 8; i++) {
			var ip = getConfigKey('network_nfs_ip_' + i);
			var dir = getConfigKey('network_nfs_dir_' + i);
			var local = getConfigKey('network_nfs_local_dir_' + i);
			var typeVal = getConfigKey('network_nfs_type_' + i);
			var summary = ip ? (ip + ':' + dir + ' \u2192 ' + local) : '{=L:yw.set.mnt_unconfigured=}';
			var isCifs = (typeVal === '1');

			html += '<div class="mount-slot" id="mount-slot-' + i + '">' +
				'<div class="mount-slot-header" onclick="toggleMount(' + i + ')">' +
				'<span>Slot ' + i + ' <span class="slot-summary">' + summary + '</span></span>' + chevron +
				'</div>' +
				'<div class="mount-slot-body">' +
				renderMountFields(i, isCifs) +
				'</div></div>';
		}

		return '<div class="settings-card">' + html + '</div>';
	}

	function renderMountFields(i, isCifs) {
		var g = function(k) { return escapeHtml(getConfigKey('network_nfs_' + k + '_' + i)); };
		var id = function(k) { return 'cfg_network_nfs_' + k + '_' + i; };
		var dk = function(k) { return 'network_nfs_' + k + '_' + i; };

		return '<div class="yweb-form-row"><label>{=L:yw.tm.type=}</label>' +
			'<select id="' + id('type') + '" data-key="' + dk('type') + '" onchange="onMountTypeChange(' + i + ')">' +
			'<option value="0"' + (g('type') !== '1' ? ' selected' : '') + '>NFS</option>' +
			'<option value="1"' + (g('type') === '1' ? ' selected' : '') + '>CIFS</option>' +
			'</select></div>' +
			'<div class="yweb-form-row"><label>{=L:yw.set.mnt_ip=}</label>' +
			'<input type="text" id="' + id('ip') + '" data-key="' + dk('ip') + '" value="' + g('ip') + '"></div>' +
			'<div class="yweb-form-row"><label>{=L:yw.set.mnt_dir=}</label>' +
			'<input type="text" id="' + id('dir') + '" data-key="' + dk('dir') + '" value="' + g('dir') + '"></div>' +
			'<div class="yweb-form-row"><label>{=L:yw.set.mnt_local=}</label><span>' +
			'<input type="text" id="' + id('local_dir') + '" data-key="' + dk('local_dir') + '" value="' + g('local_dir') + '">' +
			' <button type="button" class="yweb-btn" title="{=L:yw.picker.title=}" onclick="ywebPickInto(\'' + id('local_dir') + '\', \'' + (getConfigKey('network_nfs_local_dir_' + i) || '/media') + '\')">' + FOLDER_ICON + '</button></span></div>' +
			'<div class="yweb-form-row"><label>Auto-Mount</label>' +
			'<label class="yweb-toggle"><input type="checkbox" id="' + id('automount') + '" data-key="' + dk('automount') + '" data-on="1" data-off="0"' + (g('automount') === '1' ? ' checked' : '') + '>' +
			'<span class="yweb-toggle-slider"></span></label></div>' +
			'<div class="yweb-form-row"><label>{=L:yw.set.mnt_opts=} 1</label>' +
			'<input type="text" id="' + id('mount_options1') + '" data-key="' + dk('mount_options1') + '" value="' + g('mount_options1') + '"></div>' +
			'<div class="yweb-form-row"><label>{=L:yw.set.mnt_opts=} 2</label>' +
			'<input type="text" id="' + id('mount_options2') + '" data-key="' + dk('mount_options2') + '" value="' + g('mount_options2') + '"></div>' +
			'<div class="yweb-form-row"><label>{=L:yw.set.mnt_mac=}</label>' +
			'<input type="text" id="' + id('mac') + '" data-key="' + dk('mac') + '" value="' + g('mac') + '"></div>' +
			'<div class="cifs-fields' + (isCifs ? ' visible' : '') + '" id="cifs-' + i + '">' +
			'<div class="yweb-form-row"><label>{=L:yw.set.mnt_user=}</label>' +
			'<input type="text" id="' + id('username') + '" data-key="' + dk('username') + '" value="' + g('username') + '"></div>' +
			'<div class="yweb-form-row"><label>{=L:yw.set.mnt_pass=}</label>' +
			'<input type="password" id="' + id('password') + '" data-key="' + dk('password') + '" value="' + g('password') + '"></div>' +
			'</div>' +
			'<div class="yweb-form-row"><label>{=L:yw.set.mnt_actions=}</label><span class="yweb-row-actions">' +
			'<button type="button" class="yweb-btn" onclick="doMountAction(' + i + ', \'domount\', this)">' + MOUNT_ICON + '{=L:yw.set.mnt_mount=}</button> ' +
			'<button type="button" class="yweb-btn" onclick="doMountUnmount(' + i + ', this)">' + EJECT_ICON + '{=L:yw.set.mnt_umount=}</button></span></div>';
	}

	function toggleMount(i) {
		document.getElementById('mount-slot-' + i).classList.toggle('open');
	}

	function onMountTypeChange(i) {
		var sel = document.getElementById('cfg_network_nfs_type_' + i);
		var cifsDiv = document.getElementById('cifs-' + i);
		if (sel && cifsDiv) {
			if (sel.value === '1') cifsDiv.classList.add('visible');
			else cifsDiv.classList.remove('visible');
		}
	}

	// M5b: Sidebar nach SETTINGS_GROUPS gruppiert (Zwischentitel + Icon je
	// Kategorie), Mobile-Select mit <optgroup> je Gruppe. Registry-Labels
	// sind vertrauenswürdige Konstanten (dürfen Entities enthalten) und
	// bleiben roh; Extension-Labels kommen aus Manifesten und werden escapt.
	function buildNavigation() {
		var sidebarHtml = '';
		var mobileHtml = '';
		var groups = {};
		SETTINGS_GROUPS.forEach(function(g) { groups[g.id] = []; });

		SETTINGS_REGISTRY.forEach(function(cat) {
			(groups[cat.group] || groups.ext).push({cat: cat, esc: false});
		});
		Object.keys(EXT_SETTINGS_CATS).forEach(function(cid) {
			var cat = EXT_SETTINGS_CATS[cid];
			(groups[cat.group] || groups.ext).push({cat: cat, esc: true});
		});

		SETTINGS_GROUPS.forEach(function(g) {
			var entries = groups[g.id];
			if (!entries.length) return;
			sidebarHtml += '<div class="grp">' + g.label + '</div>';
			mobileHtml += '<optgroup label="' + escapeHtml(g.label) + '">';
			entries.forEach(function(e) {
				var label = e.esc ? escapeHtml(e.cat.label) : e.cat.label;
				var icon = e.cat.icon || SETTINGS_DEFAULT_ICON;
				sidebarHtml += '<button data-cat="' + e.cat.id + '"' +
					(e.cat.id === activeCategory ? ' class="active"' : '') +
					' onclick="switchCategory(\'' + e.cat.id + '\')">' + icon +
					'<span>' + label + '</span></button>';
				mobileHtml += '<option value="' + e.cat.id + '"' +
					(e.cat.id === activeCategory ? ' selected' : '') + '>' + label + '</option>';
			});
			mobileHtml += '</optgroup>';
		});

		document.getElementById('settingsSidebar').innerHTML = sidebarHtml;
		document.getElementById('mobileCategorySelect').innerHTML = mobileHtml;
	}

	function switchCategory(catId) {
		if (activeCategory === catId && document.getElementById('panel-' + catId)) return;
		activeCategory = catId;

		// Update hash without triggering hashchange
		history.replaceState(null, '', '#' + catId);

		// Update sidebar active state
		document.querySelectorAll('#settingsSidebar button').forEach(function(btn) {
			btn.classList.toggle('active', btn.getAttribute('data-cat') === catId);
		});

		// Update mobile select
		var mobileSelect = document.getElementById('mobileCategorySelect');
		if (mobileSelect) mobileSelect.value = catId;

		// Show/hide panels — lazy render on first visit
		var content = document.getElementById('settingsContent');
		var panels = content.querySelectorAll('.settings-panel');
		panels.forEach(function(p) { p.classList.remove('active'); });

		var panel = document.getElementById('panel-' + catId);
		if (!panel) {
			// First visit: render and insert
			panel = document.createElement('div');
			panel.className = 'settings-panel';
			panel.id = 'panel-' + catId;
			panel.innerHTML = renderCategory(catId);
			content.appendChild(panel);
			renderedPanels[catId] = true;
		}
		panel.classList.add('active');
	}

	// M5c: sammelt über ALLE gerenderten Panels (nicht nur das aktive) —
	// gecachte Panels behalten ungespeicherte Eingaben beim Kategorie-
	// Wechsel, und die zentrale Save-Leiste speichert sie alle zusammen
	function collectValues() {
		var values = {};
		var content = document.getElementById('settingsContent');
		if (!content) return values;

		content.querySelectorAll('select[data-key]:not([data-extcfg]), input[type="text"][data-key]:not([data-extcfg]), input[type="number"][data-key]:not([data-extcfg]), input[type="password"][data-key]:not([data-extcfg])').forEach(function(el) {
			values[el.getAttribute('data-key')] = el.value;
		});
		content.querySelectorAll('input[type="checkbox"][data-key]:not([data-extcfg])').forEach(function(el) {
			values[el.getAttribute('data-key')] = el.checked ? el.getAttribute('data-on') : el.getAttribute('data-off');
		});
		return values;
	}

	// Dirty-Zähler für die Save-Leiste: gleiche Diff-Logik wie
	// saveSettings (String-Vergleich gegen configData)
	function ywebCountDirty() {
		var values = collectValues();
		var dirty = 0;
		for (var key in values) {
			var origKey = key.replace(/\./g, '_dot_').replace(/-/g, '_bind_');
			if (values[key] !== (configData[origKey] || '')) dirty++;
		}
		return dirty;
	}

	function ywebUpdateSaveBar() {
		var bar = document.getElementById('settingsSaveBar');
		if (!bar) return;
		var n = ywebCountDirty();
		document.getElementById('saveBarCount').textContent = n;
		bar.hidden = (n === 0);
	}

	// Verwerfen: alle Panel-Caches wegwerfen und aktive Kategorie aus
	// configData neu rendern (die übrigen rendern beim nächsten Besuch)
	function discardSettings() {
		renderedPanels = {};
		document.querySelectorAll('#settingsContent .settings-panel').forEach(function(p) { p.remove(); });
		var cat = activeCategory;
		activeCategory = '';
		switchCategory(cat);
		ywebUpdateSaveBar();
	}

	async function saveSettings() {
		var values = collectValues();
		var params = 'action=submit';
		var changed = 0;

		for (var key in values) {
			var origKey = key.replace(/\./g, '_dot_').replace(/-/g, '_bind_');
			if (values[key] !== (configData[origKey] || '')) {
				params += '&' + encodeURIComponent(key) + '=' + encodeURIComponent(values[key]);
				changed++;
			}
		}

		if (changed === 0) {
			ywebShowToast('{=L:yw.set.nochanges=}');
			return;
		}

		var btns = document.querySelectorAll('#settingsSaveBar .yweb-btn');
		btns.forEach(function(b) { b.disabled = true; });

		try {
			await ywebApi('config', 'config=neutrino&' + params);
			ywebShowToast(changed + ' Einstellung' + (changed > 1 ? 'en' : '') + ' gespeichert');
			await loadSettings();
		} catch (e) {
			ywebShowToast('{=L:yw.tm.save_fail=}', true);
		}

		btns.forEach(function(b) { b.disabled = false; });
	}

	async function loadSettings() {
		try {
			// v4 liefert ein valides Envelope-Dokument - der historische
			// Brace-Zaehler (Workaround fuer das alte Doppel-Dokument) entfaellt
			var resp = await ywebApi('config', {config: 'neutrino'});
			configData = (resp && resp.data && resp.data.config) || {};
		} catch (e) {
			document.getElementById('settingsContent').innerHTML =
				'<div class="settings-loading">{=L:yw.set.load_fail=}</div>';
			return;
		}

		originalValues = Object.assign({}, configData);

		// Aktivierte Erweiterungen mit settings-Definition als Kategorien
		EXT_SETTINGS_CATS = {};
		try {
			_ywebExtensions = null; // frisch entdecken (Enable kann sich geaendert haben)
			(await ywebDiscoverExtensions()).forEach(function(m) {
				if (!m.enabled || !m.settings || !m.settings.sections) return;
				var cid = 'ext-' + m.dir;
				EXT_SETTINGS_CATS[cid] = {
					id: cid,
					label: m.settings.label || m.name,
					config: m.settings.config || 'yweb',
					sections: m.settings.sections
				};
			});
		} catch (ignore) {}

		// Clear cached panels — config changed
		renderedPanels = {};
		document.getElementById('settingsContent').innerHTML = '';

		// Determine active category from hash or default to first
		var hash = location.hash.replace('#', '');
		var validCat = SETTINGS_REGISTRY.find(function(c) { return c.id === hash; }) || EXT_SETTINGS_CATS[hash];
		var targetCategory = validCat ? hash : SETTINGS_REGISTRY[0].id;

		activeCategory = '';
		buildNavigation();
		switchCategory(targetCategory);
		ywebUpdateSaveBar();
	}

	// Hash navigation
	window.addEventListener('hashchange', function() {
		var hash = location.hash.replace('#', '');
		var validCat = SETTINGS_REGISTRY.find(function(c) { return c.id === hash; }) || EXT_SETTINGS_CATS[hash];
		if (validCat) switchCategory(hash);
	});

	// M5c: Dirty-State live verfolgen (Delegation — Panels werden lazy
	// gerendert und gecacht, der Listener auf dem Container sieht alles)
	document.getElementById('settingsContent').addEventListener('input', ywebUpdateSaveBar);
	document.getElementById('settingsContent').addEventListener('change', ywebUpdateSaveBar);

	loadSettings();
	</script>
</body>
</html>
