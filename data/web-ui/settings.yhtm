<!DOCTYPE html>
<html lang="de" data-theme="dark">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Neutrino-Web-UI - {=L:yw.nav.settings=}</title>
	<link rel="icon" href="/favicon/favicon.ico">
	<script>
		// Apply the stored theme before first paint: yweb-header.js runs
		// too late, and some pages never load it at all.
		try { document.documentElement.setAttribute('data-theme', localStorage.getItem('yweb-theme') || 'dark'); } catch (e) {}
	</script>
	<link rel="stylesheet" href="/css/pico.min.css">
	<link rel="stylesheet" href="/css/yweb.css?v=89">
	<style>
		/* Layout as <main>: inherits the global main rule (flex:1,
		   min-height:0, overflow:auto) so long content scrolls and the
		   footer stays below, like every other page.
		   M5b: randlos wie bouquets/timer — keine Zentrierung mehr */
		.yweb-settings-layout {
			display: flex;
			gap: 0.5rem;
			padding: 0.5rem;
		}

		/* Sidebar — Panel-Karte in der Optik von bouquets/timer.
		   sticky-Offset bezieht sich auf den Scroller <main> (liegt
		   schon unter dem Header), nicht aufs Fenster: 4.5rem drueckte
		   die Sidebar bei hohen Panels sichtbar nach unten (Audio,
		   Tasten, ...), bei kurzen klemmte der Containing Block sie
		   oben fest — Menue sprang je nach gewaehltem Eintrag */
		.yweb-settings-sidebar {
			width: 230px;
			flex-shrink: 0;
			position: sticky;
			top: 0;
			align-self: flex-start;
			max-height: calc(100vh - 7rem);
			overflow-y: auto;
			overflow-x: hidden;
			background: var(--pico-card-background-color);
			border: 1px solid var(--pico-muted-border-color);
			border-radius: var(--yweb-radius);
		}
		.settings-nav-head {
			padding: 0.5rem 0.85rem;
			font-size: var(--yweb-font-sm);
			font-weight: 600;
			color: var(--pico-color);
			border-bottom: 1px solid var(--pico-muted-border-color);
		}
		#settingsSidebar {
			display: block;
			padding: 0.1rem 0 0.25rem;
		}
		/* Gruppen-Zwischentitel (Optik wie .yweb-form-section-title).
		   Kompakte Zeilen: alle 6 Gruppen + 17 Einträge müssen bis
		   900px Fensterhöhe ohne Sidebar-Scroll sichtbar sein */
		#settingsSidebar .grp {
			padding: 0.4rem 0.75rem 0.15rem;
			font-size: var(--yweb-font-xs);
			color: var(--yweb-accent);
			text-transform: uppercase;
			letter-spacing: 0.08em;
			font-weight: 600;
			line-height: 1.2;
		}
		#settingsSidebar button {
			display: flex;
			align-items: center;
			gap: 0.5rem;
			width: 100%;
			text-align: left;
			padding: 0.3rem 0.75rem;
			font-size: var(--yweb-font-sm);
			line-height: 1.2;
			color: var(--pico-muted-color);
			background: none;
			border: none;
			border-left: 3px solid transparent;
			border-radius: 0;
			cursor: pointer;
			transition: var(--yweb-transition);
			margin: 0;
		}
		#settingsSidebar button svg {
			flex-shrink: 0;
		}
		#settingsSidebar button:hover {
			color: var(--yweb-accent);
			background: var(--yweb-accent-light);
		}
		#settingsSidebar button.active {
			color: var(--yweb-accent);
			border-left-color: var(--yweb-accent);
			font-weight: 600;
			background: var(--yweb-accent-light);
		}

		/* Mobile category dropdown — replaces the sidebar below 800px.
		   background-color (NOT the background shorthand) keeps Pico's
		   chevron icon, so the select is recognizable as a dropdown */
		.yweb-settings-mobile-nav {
			display: none;
			padding: 0.75rem 1rem 0;
			align-items: center;
			gap: 0.6rem;
		}
		.yweb-settings-mobile-nav > svg {
			flex: none;
			width: 18px;
			height: 18px;
			color: var(--yweb-accent);
		}
		.yweb-settings-mobile-nav select {
			flex: 1;
			width: 100%;
			padding: 0.5rem 2.5rem 0.5rem 0.75rem !important;
			font-size: var(--yweb-font-sm);
			margin-bottom: 0 !important;
			height: auto !important;
			border-radius: var(--yweb-radius);
			border: 1px solid var(--pico-muted-border-color);
			background-color: var(--pico-card-background-color);
			color: var(--pico-color);
		}

		/* Content area — Karte füllt die Restbreite, der Formular-Inhalt
		   bleibt für die Lesbarkeit auf 720px begrenzt */
		.yweb-settings-content {
			flex: 1;
			min-width: 0;
		}
		.settings-card > :not(.settings-card-header) {
			max-width: 720px;
		}

		/* Panels */
		.settings-panel {
			display: none;
		}
		.settings-panel.active {
			display: block;
		}
		.settings-card {
			background: var(--pico-card-background-color);
			border: 1px solid var(--pico-muted-border-color);
			border-radius: var(--yweb-radius);
			padding: 1.2rem;
		}
		.settings-card-header {
			display: flex;
			align-items: center;
			justify-content: space-between;
			margin-bottom: 1rem;
			padding-bottom: 0.6rem;
			border-bottom: 1px solid var(--pico-muted-border-color);
		}
		.settings-card-header h3 {
			margin: 0;
			font-size: var(--yweb-font-sm);
			font-weight: 600;
			color: var(--pico-color);
		}

		/* Settings-specific form overrides */
		.settings-card .yweb-form-row label:not(.yweb-toggle) {
			min-width: 10rem;
		}
		.settings-card .yweb-form-row select,
		.settings-card .yweb-form-row input[type="text"],
		.settings-card .yweb-form-row input[type="number"],
		.settings-card .yweb-form-row input[type="password"] {
			width: 16rem;
			flex: none;
		}
		.settings-card .yweb-form-row input[type="number"] {
			width: 6rem;
		}
		/* Rows of the box's own settings (settings-v1.js): label, help
		   button and restart mark share the label column; the help and a
		   refusal of the box sit below the row, across both columns */
		.yweb-set-label {
			display: flex;
			align-items: center;
			gap: 0.3rem;
			min-width: 0;
		}
		/* a long label wraps inside its column instead of pushing the
		   help button under the control (yweb.css keeps labels unshrunk) */
		.settings-card .yweb-set-label label:not(.yweb-toggle) {
			min-width: 0;
			flex-shrink: 1;
			overflow-wrap: anywhere;
		}
		.yweb-set-info {
			flex: none;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 1.6rem;
			height: 1.6rem;
			padding: 0;
			margin: 0;
			border: none;
			border-radius: 50%;
			background: none;
			color: var(--pico-muted-color);
			cursor: pointer;
		}
		.yweb-set-info:hover,
		.yweb-set-info[aria-expanded="true"] {
			color: var(--yweb-accent);
		}
		.yweb-set-info svg,
		.yweb-set-restart svg {
			width: 1rem;
			height: 1rem;
		}
		.yweb-set-restart {
			flex: none;
			display: inline-flex;
			color: var(--yweb-warning);
		}
		.yweb-set-help,
		.yweb-set-error {
			grid-column: 1 / -1;
			font-size: var(--yweb-font-sm);
		}
		.yweb-set-help {
			padding: 0.5rem 0.75rem;
			border-left: 3px solid var(--yweb-accent);
			border-radius: 0 var(--yweb-radius) var(--yweb-radius) 0;
			background: var(--yweb-accent-light);
			color: var(--pico-color);
		}
		.yweb-set-help[hidden] {
			display: none;
		}
		.yweb-set-help p {
			margin: 0 0 0.3rem;
			white-space: pre-line;
		}
		.yweb-set-help p:last-child {
			margin-bottom: 0;
		}
		.yweb-set-help .yweb-set-default {
			color: var(--pico-muted-color);
		}
		.yweb-set-error {
			color: var(--yweb-danger);
		}
		.settings-card .yweb-form-row [aria-invalid="true"] {
			border-color: var(--yweb-danger);
		}

		/* M5c: zentrale Dirty-State-Save-Leiste am Fuß der Content-Spalte.
		   Klebt beim Scrollen am unteren Rand und wirkt über der Karte
		   wie deren Fuß (gleicher Hintergrund, border-top als Trenner) */
		.settings-save-bar {
			display: flex;
			gap: 0.5rem;
			align-items: center;
			justify-content: flex-end;
			border-top: 1px solid var(--pico-muted-border-color);
			padding: 0.7rem 1rem;
			position: sticky;
			bottom: 0;
			background: var(--pico-card-background-color);
			border-radius: 0 0 var(--yweb-radius) var(--yweb-radius);
		}
		/* hidden-Attribut muss gegen das display:flex gewinnen */
		.settings-save-bar[hidden] {
			display: none;
		}
		.settings-save-bar .note {
			margin-right: auto;
			color: var(--pico-muted-color);
			font-size: var(--yweb-font-sm);
		}

		/* Mount slots */
		.mount-slot {
			background: var(--pico-background-color);
			border: 1px solid var(--pico-muted-border-color);
			border-radius: var(--yweb-radius);
			margin-bottom: 0.5rem;
			overflow: hidden;
		}
		.mount-slot-header {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 0.6rem 0.85rem;
			cursor: pointer;
			font-size: var(--yweb-font-sm);
			color: var(--pico-color);
			transition: var(--yweb-transition);
		}
		.mount-slot-header:hover {
			background: rgba(255,255,255,0.03);
		}
		.mount-slot-header .slot-summary {
			color: var(--pico-muted-color);
			font-size: var(--yweb-font-xs);
			margin-left: 0.5rem;
		}
		.mount-slot-header svg {
			width: 16px;
			height: 16px;
			transition: transform 0.2s;
			flex-shrink: 0;
			color: var(--pico-muted-color);
		}
		.mount-slot.open > .mount-slot-header svg {
			transform: rotate(180deg);
		}
		.mount-slot-body {
			display: none;
			padding: 0.6rem 0.85rem 0.85rem;
			border-top: 1px solid var(--pico-muted-border-color);
		}
		.mount-slot.open > .mount-slot-body {
			display: block;
		}
		.cifs-fields {
			display: none;
		}
		.cifs-fields.visible {
			display: block;
		}

		/* Extensions as a 4-column table (name | slot | active | action) */
		.ext-grid {
			display: grid;
			grid-template-columns: 1fr 140px 52px auto;
			gap: 0.45rem 0.75rem;
			align-items: center;
		}
		.ext-grid .ext-grid-head {
			font-size: var(--yweb-font-xs);
			color: var(--pico-muted-color);
			text-transform: uppercase;
			letter-spacing: 0.08em;
			font-weight: 600;
			padding-bottom: 0.1rem;
		}
		.ext-grid .ext-grid-head.center { text-align: center; }
		.ext-grid .ext-grid-head.right { text-align: right; }
		/* one continuous rule under the header row — per-cell borders
		   would break at the column gaps */
		.ext-grid-rule {
			grid-column: 1 / -1;
			height: 1px;
			background: var(--pico-muted-border-color);
			margin-top: -0.25rem;
		}
		/* centers toggles under their header and kills the inline-block
		   baseline gap that pushed them off the row center */
		.ext-cell-center {
			display: flex;
			align-items: center;
			justify-content: center;
			align-self: stretch;
		}
		.ext-grid select {
			/* block kills the inline baseline gap inside the plain cell
			   div, so the row centers on the select height */
			display: block;
			width: 100%;
			margin: 0;
			padding: 0.2rem 0.4rem !important;
			height: auto !important;
			font-size: var(--yweb-font-sm);
		}
		.ext-grid .ext-name {
			font-size: var(--yweb-font-sm);
			min-width: 0;
		}
		.ext-grid .ext-actions {
			display: flex;
			gap: 0.35rem;
			justify-content: flex-end;
		}
		.ext-grid .ext-actions .yweb-btn {
			padding: 0.25rem 0.5rem;
			font-size: var(--yweb-font-xs);
		}
		/* update badge next to the extension name after a manual check */
		.ext-badge {
			display: inline-block;
			padding: 0.05rem 0.45rem;
			border-radius: 999px;
			font-size: var(--yweb-font-xs);
			font-weight: 600;
			background: var(--pico-primary);
			color: var(--pico-primary-inverse);
			margin-left: 0.4rem;
			vertical-align: middle;
		}
		@media (max-width: 600px) {
			.ext-grid {
				grid-template-columns: minmax(0, 1fr) 90px 44px auto;
				gap: 0.4rem 0.4rem;
			}
		}

		/* Loading */
		.settings-loading {
			text-align: center;
			padding: 3rem;
			color: var(--pico-muted-color);
		}

		/* Mobile — settings-specific overrides (form-row mobile handled by yweb.css) */
		@media (max-width: 800px) {
			.yweb-settings-sidebar { display: none; }
			.yweb-settings-mobile-nav { display: flex; }
			.yweb-settings-layout { padding: 0.5rem; }
			.settings-card { padding: 0.8rem; }
			.settings-card .yweb-form-row select,
			.settings-card .yweb-form-row input[type="text"],
			.settings-card .yweb-form-row input[type="number"],
			.settings-card .yweb-form-row input[type="password"] {
				width: 100%;
				flex: auto;
			}
		}
	</style>
</head>
<body>
	<div class="yweb-header-wrapper" data-page="settings"></div>
	<div class="yweb-header-spacer"></div>

	<!-- Mobile category selector -->
	<div class="yweb-settings-mobile-nav">
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg>
		<select id="mobileCategorySelect" onchange="switchCategory(this.value)" aria-label="{=L:yw.nav.settings=}"></select>
	</div>

	<main class="yweb-settings-layout">
		<!-- Sidebar -->
		<div class="yweb-settings-sidebar">
			<div class="settings-nav-head">{=L:yw.nav.settings=}</div>
			<nav id="settingsSidebar"></nav>
		</div>

		<!-- Content: Panels + zentrale Save-Leiste (M5c) -->
		<div class="yweb-settings-content">
			<div id="settingsContent">
				<div class="settings-loading">{=L:yw.set.loading=}</div>
			</div>
			<div id="settingsSaveBar" class="settings-save-bar" hidden>
				<span class="note"><b id="saveBarCount">0</b> {=L:yw.set.unsaved=}</span>
				<button type="button" class="yweb-btn ghost" onclick="discardSettings()">{=L:yw.set.discard=}</button>
				<button type="button" class="yweb-btn primary" onclick="saveSettings()">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>{=L:yw.bqe.save=}
				</button>
			</div>
		</div>
	</main>

	<!-- Reihenfolge: Registry-Labels rufen ywebL (yweb-header.js) auf, das
	     window.YWEB_L aus Y_Lang.yjs liest — Registry muss zuletzt laden -->
	<script src="/Y_Lang.yjs?v=27"></script>
	<script src="/yweb-header.js?v=61"></script>
	<script src="/yweb-dom.js?v=1"></script>
	<script src="/yweb-v1.js?v=14"></script>
	<script src="/settings-registry.js?v=17"></script>
	<script src="/settings-v1.js?v=1"></script>
	<script>
	var configData = {};
	var originalValues = {};
	var activeCategory = '';
	var renderedPanels = {};
	// Aktivierte Erweiterungen mit settings-Definition im Manifest werden
	// als eigene Kategorien eingeblendet (id 'ext-<dir>', Panel ueber den
	// generischen ExtConfig-Zyklus gegen config=<name>, Default yweb)
	var EXT_SETTINGS_CATS = {};

	// M5c: Karten-Kopf ist reiner Titel — gespeichert wird zentral über
	// die Dirty-State-Leiste (#settingsSaveBar) am Fuß der Content-Spalte;
	// Panels mit eigener Config-Datei (ExtConfig, Erweiterungen, WoL, ...)
	// behalten ihren eigenen Save-Button im Panel-Inhalt.
	function makeCardHeader(label) {
		var d = document.createElement('div');
		d.className = 'settings-card-header';
		var h = document.createElement('h3');
		h.textContent = label;
		d.appendChild(h);
		return d.outerHTML;
	}

	function getConfigKey(key) {
		var k = key.replace(/\./g, '_dot_').replace(/-/g, '_bind_');
		return configData[k] !== undefined ? configData[k] : '';
	}

	function hasConfigKey(key) {
		return configData[key.replace(/\./g, '_dot_').replace(/-/g, '_bind_')] !== undefined;
	}

	// Action-Buttons: Registry-Felder vom Typ 'action' registrieren sich
	// hier und feuern v4-Calls (exec, startplugin, ...) mit Toast-Feedback
	var SETTINGS_ACTIONS = {};
	async function runSettingsAction(aid, btn) {
		var f = SETTINGS_ACTIONS[aid];
		if (!f || !f.api) return;
		if (f.confirm && !confirm(f.confirm)) return;
		var orig = btn.textContent;
		btn.disabled = true;
		btn.textContent = '...';
		try {
			var res = await ywebApi(f.api.endpoint, f.api.params, f.api.raw ? {raw: true} : undefined);
			ywebShowToast(f.success || (typeof res === 'string' && res.trim()) || 'Ausgef\u00fchrt');
			if (f.refresh) await loadSettings();
			if (typeof f.after === 'function') f.after(res);
		} catch (e) {
			ywebShowToast('{=L:yw.msg.error=}: ' + e.message, true);
		}
		btn.disabled = false;
		btn.textContent = orig;
	}

	// Hinweis fuer Felder, die ein uebergeordneter Eintrag sperrt (disabledIf)
	var DEP_HINT = '{=L:yw.set.dep_locked=}';

	// Aktueller Wert eines Keys: bevorzugt das bereits gerenderte Formularfeld
	// (traegt eine noch ungespeicherte Aenderung), sonst die geladene Config
	function getLiveValue(key) {
		var el = document.querySelector('#settingsContent [data-key="' + key + '"]:not([data-extcfg])');
		if (!el) return getConfigKey(key);
		if (el.type === 'checkbox')
			return el.checked ? el.getAttribute('data-on') : el.getAttribute('data-off');
		return el.value;
	}

	// disabledIf: {key, unless} — beobachtete Felder sperren, solange der
	// Observer nicht auf dem Freigabewert steht. Der Observer kann in
	// derselben Gruppe stehen, darum nach jeder Aenderung neu bewerten.
	function ywebApplyDeps() {
		document.querySelectorAll('#settingsContent .yweb-form-row[data-dep-key]').forEach(function(r) {
			var off = getLiveValue(r.getAttribute('data-dep-key')) !== r.getAttribute('data-dep-unless');
			r.classList.toggle('is-disabled', off);
			if (off) r.setAttribute('title', DEP_HINT);
			else r.removeAttribute('title');
			r.querySelectorAll('select, input').forEach(function(el) { el.disabled = off; });
		});
	}

	function renderField(f, opts) {
		opts = opts || {};
		var val = opts.get ? (opts.get(f.key) || '') : (f.key ? getConfigKey(f.key) : '');
		// Leeren Wert mit dem Feld-Default vorbelegen (Key noch nie gesetzt)
		if ((val === '' || val === undefined) && f.default !== undefined)
			val = String(f.default);
		// Optionaler (i)-Infotext: an das Label anhaengen (native title-Tooltip),
		// ohne die einzelnen Feldzweige anzufassen
		if (f.hint) {
			var fh = {}; for (var k in f) fh[k] = f[k];
			fh.label = f.label + ' <span class="yweb-hint" title="' + escapeHtml(f.hint) + '">&#9432;</span>';
			f = fh;
		}
		var id = 'cfg_' + (opts.idPrefix || '') + String(f.key || f.id || '').replace(/\./g, '__');
		var ext = opts.dataConfig ? ' data-extcfg="' + opts.dataConfig + '"' : '';

		// Observer-Abhaengigkeit: Zeile wird gerendert, aber gesperrt, solange
		// der beobachtete Key nicht den Freigabewert traegt. Kein Zwangsschreiben
		// des Werts — Neutrino ignoriert den Key in dem Fall ohnehin.
		var dis = '';
		var row = '<div class="yweb-form-row">';
		if (f.disabledIf) {
			var off = getLiveValue(f.disabledIf.key) !== String(f.disabledIf.unless);
			dis = off ? ' disabled' : '';
			row = '<div class="yweb-form-row' + (off ? ' is-disabled' : '') + '"' +
				' data-dep-key="' + f.disabledIf.key + '" data-dep-unless="' + f.disabledIf.unless + '"' +
				(off ? ' title="' + escapeHtml(DEP_HINT) + '"' : '') + '>';
		}

		if (f.type === 'info') {
			var text = (f.text !== undefined) ? f.text : val;
			return row + '<label>' + f.label + '</label>' +
				'<span id="' + id + '" style="color:var(--pico-muted-color)">' + (text || '--') + '</span></div>';
		}
		if (f.type === 'action') {
			// Einzel-Action oder Button-Gruppe (f.actions) in einer Zeile
			var acts = f.actions || [f];
			var btns = '';
			acts.forEach(function(a) {
				var aid = a.id || a.label || f.label;
				SETTINGS_ACTIONS[aid] = a;
				btns += '<button type="button" class="yweb-btn" onclick="runSettingsAction(\'' + aid + '\', this)">' + (a.button || a.label || f.label) + '</button> ';
			});
			return row + '<label>' + f.label + '</label><span>' + btns.trim() + '</span></div>';
		}

		if (f.type === 'select') {
			var opts = f.options.map(function(o) {
				return '<option value="' + o.v + '"' + (val === o.v ? ' selected' : '') + '>' + o.l + '</option>';
			}).join('');
			return row + '<label>' + f.label + '</label>' +
				'<select id="' + id + '" data-key="' + f.key + '"' + ext + dis + '>' + opts + '</select></div>';
		}
		// ACCESS-Domaene (personalize.h): nur 0 = ohne PIN und 2 = mit PIN.
		// Der Eintrag ist immer sichtbar (personalize.cpp:1006), die 0 heisst
		// hier also NICHT 'ausgeblendet'. Zur Laufzeit wertet Neutrino nur die
		// 2 aus (personalize.cpp:961) — jeder andere Wert bedeutet 'ohne PIN'.
		if (f.type === 'access') {
			var pin = (val === '2');
			return row + '<label>' + f.label + '</label>' +
				'<select id="' + id + '" data-key="' + f.key + '"' + ext + dis + '>' +
				'<option value="0"' + (pin ? '' : ' selected') + '>{=L:yw.pers.no=}</option>' +
				'<option value="2"' + (pin ? ' selected' : '') + '>{=L:yw.pers.yes=}</option>' +
				'</select></div>';
		}
		if (f.type === 'bool') {
			var isTrue = (val === 'true' || val === '1');
			return row + '<label>' + f.label + '</label>' +
				'<label class="yweb-toggle"><input type="checkbox" id="' + id + '" data-key="' + f.key + '" data-on="true" data-off="false"' + ext + dis + (isTrue ? ' checked' : '') + '>' +
				'<span class="yweb-toggle-slider"></span></label></div>';
		}
		if (f.type === 'bool01') {
			var isOne = (val === '1');
			return row + '<label>' + f.label + '</label>' +
				'<label class="yweb-toggle"><input type="checkbox" id="' + id + '" data-key="' + f.key + '" data-on="1" data-off="0"' + ext + dis + (isOne ? ' checked' : '') + '>' +
				'<span class="yweb-toggle-slider"></span></label></div>';
		}
		if (f.type === 'number') {
			var attrs = 'type="number"';
			if (f.min !== undefined) attrs += ' min="' + f.min + '"';
			if (f.max !== undefined) attrs += ' max="' + f.max + '"';
			return row + '<label>' + f.label + '</label>' +
				'<input ' + attrs + ' id="' + id + '" data-key="' + f.key + '"' + ext + dis + ' value="' + val + '"></div>';
		}
		if (f.type === 'password') {
			var pattr = f.pattern ? ' pattern="' + f.pattern + '"' : '';
			if (f.maxlength) pattr += ' maxlength="' + f.maxlength + '"';
			return row + '<label>' + f.label + '</label><span>' +
				'<input type="password" id="' + id + '" data-key="' + f.key + '"' + ext + dis + pattr + ' autocomplete="new-password" value="' + val.replace(/"/g, '&quot;') + '">' +
				' <button type="button" class="yweb-btn" aria-pressed="false" aria-label="{=L:yw.set.pw_show=}" onclick="togglePwField(\'' + id + '\', this)">' + EYEOFF_ICON + '</button></span></div>';
		}
		// text — optional mit Verzeichnis-Picker (f.picker: true)
		var pick = '';
		if (f.picker) {
			var pstart = val || '/';
			pick = ' <button type="button" class="yweb-btn" title="' + ywebL('picker.title', 'Choose folder') +
				'" onclick="ywebPickInto(\'' + id + '\', \'' + escapeJs(pstart) + '\')">' + FOLDER_ICON + '</button>';
		}
		return row + '<label>' + f.label + '</label><span>' +
			'<input type="text" id="' + id + '" data-key="' + f.key + '"' + ext + dis + ' value="' + val.replace(/"/g, '&quot;') + '">' + pick + '</span></div>';
	}

	// kleines Ordner-Icon fuer Picker-Buttons
	var FOLDER_ICON = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:1rem;height:1rem;vertical-align:middle"><path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>';

	// Auge-Icons fuer Passwortfelder (Feather-Geometrie wie bouquet-editor)
	var EYE_ICON = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:1rem;height:1rem;vertical-align:middle" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>';
	var EYEOFF_ICON = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:1rem;height:1rem;vertical-align:middle" aria-hidden="true"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/></svg>';

	// Konstanter Button-Name, Zustand via aria-pressed (a11y-Regel).
	// The icon mirrors the state: crossed-out eye while masked.
	function togglePwField(id, btn) {
		var el = document.getElementById(id);
		if (!el) return;
		var show = el.type === 'password';
		el.type = show ? 'text' : 'password';
		btn.setAttribute('aria-pressed', show ? 'true' : 'false');
		btn.innerHTML = show ? EYE_ICON : EYEOFF_ICON;
	}

	// M5c: 14px-Icon-Wrapper fuer Panel-Buttons (Optik wie Save-Leiste)
	function sIcon(paths) {
		return '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' + paths + '<\/svg>';
	}
	var SAVE_ICON = sIcon('<path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/>');
	var DL_ICON = sIcon('<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>');
	var UP_ICON = sIcon('<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>');
	var PLAY_ICON = sIcon('<polygon points="5 3 19 12 5 21 5 3"/>');
	var REFRESH_ICON = sIcon('<polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>');
	var ZAP_ICON = sIcon('<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>');
	var MOUNT_ICON = sIcon('<line x1="22" y1="12" x2="2" y2="12"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/><line x1="6" y1="16" x2="6.01" y2="16"/><line x1="10" y1="16" x2="10.01" y2="16"/>');
	var EJECT_ICON = sIcon('<path d="M12 5l7 9H5l7-9z"/><line x1="5" y1="19" x2="19" y2="19"/>');
	var RESTORE_ICON = sIcon('<polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>');
	var TRASH_ICON = sIcon('<polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>');

	// Markup-Helfer: gestyltes Datei-Control (.yweb-file aus yweb.css);
	// der gewählte Dateiname landet via onchange in .yweb-file-name
	function makeFileControl(inputId, accept) {
		return '<label class="yweb-file"><input type="file" id="' + inputId + '"' +
			(accept ? ' accept="' + accept + '"' : '') + ' onchange="ywebFileName(this)">' +
			'<span class="yweb-file-btn">{=L:yw.set.choose_file=}</span>' +
			'<span class="yweb-file-name">&ndash;</span></label>';
	}
	// ywebFileName (onchange-Companion des Controls) liefert yweb-header.js

	// Rechtsbuendiger Save-Button fuer Panels mit eigenem Config-Zyklus
	// (ExtConfig, Erweiterungen, WoL) — Optik wie die zentrale Save-Leiste.
	// display:flex inline, weil .yweb-row-actions nur innerhalb von
	// .yweb-form-row automatisch flext (hier steht die Zeile solo)
	function makePanelSaveRow(onclick, label) {
		return '<div class="yweb-row-actions" style="display:flex;gap:0.5rem;justify-content:flex-end;margin-top:0.6rem">' +
			'<button type="button" class="yweb-btn primary" onclick="' + onclick + '">' +
			SAVE_ICON + (label || '{=L:yw.bqe.save=}') + '</button></div>';
	}

	// Picker oeffnen und Ergebnis in das Textfeld schreiben
	function ywebPickInto(inputId, startPath) {
		ywebShowPathPicker(startPath, function(p) {
			var el = document.getElementById(inputId);
			// bubbling, so the delegated listeners (save bar, conditions) see it
			if (el) { el.value = p; el.dispatchEvent(new Event('change', {bubbles: true})); }
		});
	}

	// What a registry category dissolved into this section of the box adds
	// to it: its fields the schema lacks, if the box's file carries them
	function renderLeftovers(section) {
		var html = '';
		SETTINGS_REGISTRY.forEach(function(cat) {
			if (V1SET.dissolved[cat.id] !== section) return;
			cat.sections.forEach(function(sec) {
				var body = '';
				sec.fields.forEach(function(f) {
					if (f.key && (V1SET.items[f.key] || !hasConfigKey(f.key))) return;
					body += renderField(f);
				});
				if (body)
					html += '<div class="yweb-form-section">' +
						'<div class="yweb-form-section-title">' + sec.title + '</div>' + body + '</div>';
			});
		});
		return html;
	}

	// A section of the box comes back as an element (settings-v1.js), every
	// other category as markup
	function renderCategory(catId) {
		if (EXT_SETTINGS_CATS[catId]) return renderExtConfigPanel(EXT_SETTINGS_CATS[catId]);
		if (V1SET.ok && V1SET.bySection[catId]) return v1setPanel(catId, renderLeftovers(catId));
		var cat = SETTINGS_REGISTRY.find(function(c) { return c.id === catId; });
		if (!cat) return '';

		if (cat.custom && cat.id === 'mounts') return renderMountsPanel();
		if (cat.custom && cat.id === 'plugins') return renderPluginsPanel();
		if (cat.custom && cat.id === 'backup') return renderBackupPanel();
		if (cat.custom && cat.id === 'wol') return renderWolPanel();
		if (cat.custom && cat.id === 'xmltv') return renderXmltvPanel();
		if (cat.custom && cat.id === 'zapitupload') return renderZapitUploadPanel();
		if (cat.custom && cat.id === 'extensions') return renderExtensionsPanel();
		if (cat.config && cat.config !== 'neutrino') return renderExtConfigPanel(cat);

		var html = makeCardHeader(cat.label);
		cat.sections.forEach(function(sec) {
			// Feldliste zuerst bauen, damit die Zaehlung in der Kopfzeile die
			// tatsaechlich gerenderten Felder nennt. cat.requireKeys blendet
			// Felder aus, deren Key die Box nicht kennt: Neutrino schreibt beim
			// Speichern immer die volle Tabelle (neutrino.cpp:1920), ein
			// fehlender Key heisst also 'nicht einkompiliert' (ENABLE_PIP,
			// ENABLE_UPNP, HAVE_CST_HARDWARE).
			var body = '', n = 0;
			sec.fields.forEach(function(f) {
				// a key the box declares is drawn by settings-v1.js
				if (f.key && V1SET.claimed[f.key]) { body += v1setSlot(f.key); n++; return; }
				if (cat.requireKeys && f.key && !hasConfigKey(f.key)) return;
				var fh = renderField(f);
				if (fh) { body += fh; n++; }
			});
			if (!n) return;

			// Kategorien mit vielen Gruppen (Personalisierung) klappen ihre
			// Sections auf; ohne sec.collapsible bleibt das flache Layout
			if (sec.collapsible) {
				html += '<details class="yweb-form-group"' + (sec.open ? ' open' : '') + '>' +
					'<summary><span class="yweb-form-group-title">' + sec.title + '</span>' +
					'<span class="yweb-form-group-count">' + n + '</span></summary>' +
					'<div class="yweb-form-group-body">' + body + '</div></details>';
			} else {
				html += '<div class="yweb-form-section">' +
					'<div class="yweb-form-section-title">' + sec.title + '</div>' +
					body + '</div>';
			}
		});

		return '<div class="settings-card">' + html + '</div>';
	}

	// Kategorien mit eigener Config-Datei (nhttpd.conf, yWeb.conf, ...):
	// eigener Load/Diff/Save-Zyklus gegen config=<name>, getrennt vom
	// neutrino-Hauptformular (collectValues ignoriert data-extcfg-Felder)
	var EXT_CONFIG_CACHE = {};

	// The web interface's own settings (yWeb.conf) over /api/v1, as a plain
	// object; a write names only the keys to change, and an empty value takes
	// a key out, which the pages read the same as a key that is not there
	async function webuiSettingsRead() {
		var r = await ywebV1('GET', '/webui/settings');
		var out = {};
		((r && r.items) || []).forEach(function(it) { out[it.key] = it.value; });
		return out;
	}

	function webuiSettingsWrite(changes) {
		return ywebV1('PATCH', '/webui/settings', {body: changes});
	}

	// The web server's own settings over /api/v1: the access file and
	// nhttpd.conf behind one route, by its member names. A field's value as
	// the form shows it, and what a changed one is sent as.
	function webserverFieldValue(cfg, key) {
		var v = cfg[key];
		return (v === undefined || v === null) ? '' : String(v);
	}

	function webserverBodyValue(el, val) {
		if (el.type === 'checkbox') return val === 'true';
		if (el.type === 'number') return parseInt(val, 10);
		return val;
	}

	/* A write answers what it means for the caller before the server is
	   restarted on it: whether it restarts, and where it answers next. The page
	   waits for the restart by the server's start count, which the answer
	   carries from before it. A server here with a higher count has restarted
	   here: done, or, where the port was to move, the new port was taken and the
	   server went back to this one, which the page then says. Gone from here for
	   a few seconds, a moved server is followed, under the scheme and the name
	   the page was reached by. 'moving', 'restarting', or '' for a write the
	   server takes without a restart. */
	async function webserverAfterWrite(answer) {
		var caller = (answer && answer.caller) || {};
		var was = (answer && answer.webserver) || {};
		if (!caller.restarting) return '';
		var moving = !!caller.port_moved;
		var target = new URL(location.href);
		target.port = String(was.port);
		ywebShowToast(moving ? '{=L:yw.set.ws_moving=} ' + target.origin + '/' : '{=L:yw.set.ws_restarting=}');
		// what answers here, or null where nothing does
		var here = async function() {
			try {
				var r = await fetch('/api/v1/system/webserver', {credentials: 'same-origin', cache: 'no-store'});
				return r.ok ? await r.json() : {};
			} catch (e) {
				return null;
			}
		};
		var downSince = 0;
		for (var i = 0; i < 80; i++) {
			await new Promise(function(r) { setTimeout(r, 300); });
			var now = await here();
			if (now === null) {
				if (!moving) continue;
				if (!downSince) downSince = Date.now();
				else if (Date.now() - downSince > 4000) {
					location.href = target.toString();
					return 'moving';
				}
				continue;
			}
			if (typeof now.restarts === 'number' && now.restarts > was.restarts) {
				if (moving) ywebShowToast('{=L:yw.set.ws_port_taken=} ' + (now.bound_port || now.port), true);
				return 'restarting';
			}
		}
		return 'restarting';
	}
	function renderExtConfigPanel(cat) {
		setTimeout(function() { loadExtConfigPanel(cat); }, 0);
		return '<div class="settings-card">' + makeCardHeader(cat.label) +
			'<div id="extcfg-' + cat.id + '"><p aria-busy="true">{=L:yw.msg.loading=}</p></div></div>';
	}

	async function loadExtConfigPanel(cat) {
		var el = document.getElementById('extcfg-' + cat.id);
		if (!el) return;
		try {
			var cfg, get;
			if (cat.config === 'yweb') {
				cfg = await webuiSettingsRead();
				get = function(key) { return cfg[key] || ''; };
			} else if (cat.config === 'nhttpd') {
				cfg = await ywebV1('GET', '/system/webserver');
				get = function(key) { return webserverFieldValue(cfg, key); };
			} else {
				var resp = await ywebApi('config', {config: cat.config});
				cfg = (resp && resp.data && resp.data.config) || {};
				get = function(key) { return cfg[String(key).replace(/\./g, '_dot_').replace(/-/g, '_bind_')] || ''; };
			}
			EXT_CONFIG_CACHE[cat.config] = cfg;
			var html = '';
			var savable = 0;
			cat.sections.forEach(function(sec) {
				html += '<div class="yweb-form-section"><div class="yweb-form-section-title">' + sec.title + '</div>';
				sec.fields.forEach(function(f) {
					if (f.key && f.type !== 'info' && f.type !== 'action') savable++;
					html += renderField(f, {get: get, dataConfig: cat.config, idPrefix: cat.id + '_'});
				});
				html += '</div>';
			});
			// Reine Action-/Info-Panels haben nichts zu speichern
			if (savable > 0)
				html += makePanelSaveRow('saveExtConfig(\'' + cat.id + '\', \'' + cat.config + '\', this)');
			el.innerHTML = html;
			// Passwort-Status unter dem (bewusst immer leeren) Passwortfeld:
			// der Server liefert nur die abgeleiteten Bits, nie das Passwort
			if (cat.config === 'nhttpd') {
				var pwEl = el.querySelector('#cfg_' + cat.id + '_password');
				var pwDef = cfg.password_shipped === true;
				var pwSet = cfg.has_password === true;
				var pwMsg = pwDef ? '{=L:yw.set.pw_default=}' : (pwSet ? '{=L:yw.set.pw_isset=}' : '');
				var pwRow = pwEl ? pwEl.closest('.yweb-form-row') : null;
				if (pwRow && pwMsg) {
					var note = document.createElement('div');
					note.className = 'yweb-form-row';
					note.innerHTML = '<label></label><small id="pw-status-note" style="color:' +
						(pwDef ? 'var(--pico-del-color)' : 'var(--pico-muted-color)') + '">' + pwMsg + '</small>';
					pwRow.insertAdjacentElement('afterend', note);
					pwEl.setAttribute('aria-describedby', 'pw-status-note');
				}
			}
		} catch (e) {
			el.innerHTML = '<div class="yweb-form-row"><label>{=L:yw.set.notavail=}: ' + escapeHtml(e.message) + '</label></div>';
		}
	}

	async function saveExtConfig(catId, cfgName, btn) {
		var root = document.getElementById('extcfg-' + catId);
		var cfg = EXT_CONFIG_CACHE[cfgName] || {};
		// the web interface's own file and the web server go over /api/v1,
		// by their plain keys and member names
		var yweb = cfgName === 'yweb';
		var webserver = cfgName === 'nhttpd';
		var params = 'action=submit';
		var changes = {};
		var changed = 0;
		root.querySelectorAll('[data-key][data-extcfg]').forEach(function(el) {
			var key = el.getAttribute('data-key');
			var val = (el.type === 'checkbox') ? (el.checked ? el.getAttribute('data-on') : el.getAttribute('data-off')) : el.value;
			if (webserver) {
				// the password field opens empty and an empty one keeps the password
				if (el.type === 'password' ? val === '' : val === webserverFieldValue(cfg, key)) return;
				changes[key] = webserverBodyValue(el, val);
				changed++;
				return;
			}
			var ck = yweb ? key : key.replace(/\./g, '_dot_').replace(/-/g, '_bind_');
			if (val !== (cfg[ck] || '')) {
				params += '&' + encodeURIComponent(key) + '=' + encodeURIComponent(val);
				changes[key] = val;
				changed++;
			}
		});
		if (changed === 0) { ywebShowToast('{=L:yw.set.nochanges=}'); return; }
		btn.disabled = true;
		var after = '';
		try {
			if (yweb)
				await webuiSettingsWrite(changes);
			else if (webserver)
				after = await webserverAfterWrite(await ywebV1('PUT', '/system/webserver', {body: changes}));
			else
				// in the body: the password field travels with it
				await ywebApi('config', 'config=' + cfgName + '&' + params, {post: true});
			if (after === 'moving') return;
			if (after !== 'restarting') ywebShowToast(changed + ' ' + (changed > 1 ? '{=L:yw.set.saved_many=}' : '{=L:yw.set.saved_one=}'));
			await loadExtConfigPanel(SETTINGS_REGISTRY.find(function(c) { return c.id === catId; }) || EXT_SETTINGS_CATS[catId]);
		} catch (e) {
			ywebShowToast('{=L:yw.msg.error=}: ' + e.message, true);
		}
		btn.disabled = false;
	}

	// Backup and restore over /api/v1: the box packs its settings with its own
	// backup.sh; an archive goes up in pieces to /tmp, and the box checks it,
	// puts it back itself and restarts
	function renderBackupPanel() {
		return '<div class="settings-card">' + makeCardHeader('{=L:yw.set.backup_title=}') +
			'<div class="yweb-form-section"><div class="yweb-form-section-title">Backup</div>' +
			'<div class="yweb-form-row"><label>{=L:yw.set.backup_label=} <small style="color:var(--pico-muted-color)">{=L:yw.set.backup_hint=}</small></label>' +
			'<span class="yweb-row-actions">' +
			'<button type="button" class="yweb-btn primary" onclick="doSettingsBackup(this)">' + DL_ICON + '{=L:yw.set.backup_btn=}</button></span></div></div>' +
			'<div class="yweb-form-section"><div class="yweb-form-section-title">Restore</div>' +
			'<div class="yweb-form-row"><label>{=L:yw.set.restore_label=} <small style="color:var(--pico-muted-color)">{=L:yw.set.restore_hint=}</small></label>' +
			'<span class="yweb-row-actions">' + makeFileControl('restoreFile') +
			'<button type="button" class="yweb-btn danger" onclick="doSettingsRestore(this)">' + RESTORE_ICON + '{=L:yw.set.restore_btn=}</button></span></div></div></div>';
	}

	async function doSettingsBackup(btn) {
		btn.disabled = true;
		try {
			ywebShowToast('Backup: ' + await ywebV1Download('/system/backup', 'settings.tar.gz'));
		} catch (e) {
			ywebShowToast('{=L:yw.set.backup_fail=}: ' + e.message, true);
		}
		btn.disabled = false;
	}

	// M5c: Bestätigung im geteilten ywebModal statt confirm() — die
	// destruktive Aktion bekommt einen klaren Danger-Bestätigungsknopf
	function doSettingsRestore(btn) {
		var inp = document.getElementById('restoreFile');
		if (!inp || !inp.files || !inp.files.length) { ywebShowToast('{=L:yw.inst.nofile=}', true); return; }
		if (!/\.(tar\.gz|tgz|tar)$/i.test(inp.files[0].name)) { ywebShowToast('{=L:yw.set.restore_type=}', true); return; }
		ywebModal('restoreConfirmModal', '{=L:yw.set.restore_btn=}',
			'<p>{=L:yw.set.restore_confirm=}<br><small style="color:var(--pico-muted-color)">' +
			escapeHtml(inp.files[0].name) + '</small></p>' +
			'<div class="yweb-row-actions" style="justify-content:flex-end">' +
			'<button type="button" class="yweb-btn ghost" onclick="ywebCloseModal(\'restoreConfirmModal\')">{=L:yw.tm.cancel=}</button>' +
			'<button type="button" class="yweb-btn danger" onclick="ywebRestoreGo(this)">' + RESTORE_ICON + '{=L:yw.set.restore_btn=}</button></div>');
	}

	async function ywebRestoreGo(btn) {
		var inp = document.getElementById('restoreFile');
		if (!inp || !inp.files || !inp.files.length) return;
		btn.disabled = true;
		// a name of its own in /tmp, keeping the ending the box tells the kind by
		var f = inp.files[0];
		var ending = (/\.(tar\.gz|tgz|tar)$/i.exec(f.name) || ['', 'tar.gz'])[1].toLowerCase();
		var name = 'restore-' + Math.random().toString(36).slice(2, 10) + '.' + ending;
		var uploaded = false;
		try {
			await ywebV1UploadPieces(f, '/tmp/' + name);
			uploaded = true;
			await ywebV1('POST', '/system/restore', {body: {file: name}});
			uploaded = false;	// the box has it now, and is about to restart
			ywebCloseModal('restoreConfirmModal');
			ywebShowToast('{=L:yw.set.restore_started=}');
		} catch (e) {
			if (uploaded && !e.status) {
				// no answer: the box may have taken the archive over and be restarting
				ywebShowToast('{=L:yw.set.restore_unknown=}', true);
			} else {
				// a refusal; the box takes the upload away itself once it has read it
				if (uploaded)
					ywebV1('DELETE', '/storage/path', {query: {path: '/tmp/' + name}}).catch(function() {});
				ywebShowToast('{=L:yw.set.restore_fail=}: ' + e.message, true);
			}
		}
		btn.disabled = false;
	}

	// Extension manager: discovered manifests with enable toggle, slot
	// override (persisted in yWeb.conf, loader in yweb-header.js) and
	// install/update/uninstall over /api/v1/webui/extensions. The box fetches
	// nothing: an archive from an address is loaded by the browser and
	// uploaded like a file.
	function renderExtensionsPanel() {
		setTimeout(loadExtensionsPanel, 0);
		return '<div class="settings-card">' + makeCardHeader('{=L:yw.set.ext_title=}') +
			'<div id="extPanel"><p aria-busy="true">{=L:yw.set.ext_search=}</p></div></div>';
	}

	// dir -> {version, tarball} filled by an explicit update check
	var _extUpdates = {};

	async function loadExtensionsPanel() {
		var el = document.getElementById('extPanel');
		if (!el) return;
		_ywebExtensions = null; // Discovery-Cache invalidieren
		var exts = await ywebDiscoverExtensions();
		var html = '';
		if (!exts.length) {
			html = '<div class="yweb-form-row"><label>{=L:yw.set.ext_none=} ' +
				'<small style="color:var(--pico-muted-color)">{=L:yw.set.ext_dir_hint=}</small></label></div>';
		} else {
			// 4-column grid with a header row — slot selects, toggles and
			// action buttons of all extensions align per column
			html = '<div class="yweb-form-section"><div class="yweb-form-section-title">{=L:yw.set.ext_found=}</div>' +
				'<div class="ext-grid">' +
				'<div class="ext-grid-head">{=L:yw.set.ext_col_ext=}</div>' +
				'<div class="ext-grid-head">Slot</div>' +
				'<div class="ext-grid-head center">{=L:yw.set.ext_col_on=}</div>' +
				'<div class="ext-grid-head right">{=L:yw.set.ext_col_action=}</div>' +
				'<div class="ext-grid-rule"></div>';
			exts.forEach(function(m) {
				var upd = _extUpdates[m.dir];
				html += '<div class="ext-name">' + escapeHtml(m.name) +
					(upd ? '<span class="ext-badge">v' + escapeHtml(upd.version) + '</span>' : '') +
					' <small style="color:var(--pico-muted-color)">v' + escapeHtml(m.version || '?') +
					(m.url ? ' — <a href="' + escapeHtml(m.url) + '">' + escapeHtml(m.entry) + '</a>' : ' — {=L:yw.set.ext_settings_only=}') + '</small></div>' +
					'<div><select id="extslot_' + m.dir + '">' +
					['nav', 'tools', 'dashboard', 'page'].map(function(sl) {
						return '<option value="' + sl + '"' + (m.slot === sl ? ' selected' : '') + '>' + sl + '</option>';
					}).join('') + '</select></div>' +
					'<div class="ext-cell-center"><label class="yweb-toggle"><input type="checkbox" id="extena_' + m.dir + '"' + (m.enabled ? ' checked' : '') + '>' +
					'<span class="yweb-toggle-slider"></span></label></div>' +
					'<div class="ext-actions">' +
					(upd ? '<button type="button" class="yweb-btn primary" title="{=L:yw.set.extup_avail=}" onclick="extUpdate(\'' + m.dir + '\', this)">' +
						DL_ICON + 'v' + escapeHtml(upd.version) + '</button>' : '') +
					'<button type="button" class="yweb-btn danger" title="{=L:yw.set.extuninst_btn=}" onclick="extUninstall(\'' + m.dir + '\')">' + TRASH_ICON + '</button>' +
					'</div>';
			});
			html += '</div></div>' + makePanelSaveRow('saveExtensions(this)');
		}
		// install/update row — also shown when no extension is installed
		html += '<div class="yweb-form-section"><div class="yweb-form-section-title">{=L:yw.set.extinst_section=}</div>' +
			'<div class="yweb-form-row"><label>{=L:yw.set.extinst_label=}</label>' +
			'<span class="yweb-row-actions">' +
			'<button type="button" class="yweb-btn primary" onclick="extInstallDialog()">' + UP_ICON + '{=L:yw.set.extinst_btn=}</button>' +
			'<button type="button" class="yweb-btn" onclick="extCheckUpdates(this)">' + REFRESH_ICON + '{=L:yw.set.extup_check=}</button>' +
			'</span></div></div>';
		el.innerHTML = html;
	}

	// install dialog: tar.gz upload OR direct URL (the browser loads the
	// archive and uploads it the same way; update = re-install)
	function extInstallDialog() {
		ywebModal('extInstallModal', '{=L:yw.set.extinst_title=}',
			'<div class="yweb-form-section"><div class="yweb-form-section-title">{=L:yw.set.extinst_file=}</div>' +
			'<div class="yweb-form-row"><label>tar.gz</label><span class="yweb-row-actions">' +
			makeFileControl('extInstFile', '.tar.gz,.tgz,.tar') +
			'<button type="button" class="yweb-btn primary" onclick="extInstallUpload(this)">' + UP_ICON + '{=L:yw.set.extinst_btn=}</button></span></div></div>' +
			'<div class="yweb-form-section"><div class="yweb-form-section-title">{=L:yw.set.extinst_url=}</div>' +
			'<div class="yweb-form-row"><label>URL</label><span class="yweb-row-actions">' +
			'<input type="url" id="extInstUrl" placeholder="https://…/extension.tar.gz" style="min-width:240px">' +
			'<button type="button" class="yweb-btn" onclick="extInstallUrl(this)">' + DL_ICON + '{=L:yw.set.extinst_btn=}</button></span></div></div>');
	}

	// The archive up to /tmp under a name of the page's own, then installed
	// from there; the box takes the upload over and removes it.
	async function extUploadAndInstall(blob, originalName) {
		var tar = /\.tar$/i.test(String(originalName || ''));
		var name = 'ext-' + Date.now() + (tar ? '.tar' : '.tar.gz');
		await ywebV1UploadPieces(blob, '/tmp/' + name);
		return ywebV1('POST', '/webui/extensions', {body: {file: name}});
	}

	// The browser loads it; an address that does not let a page read it is said.
	async function extFetchArchive(url) {
		var r;
		try {
			r = await fetch(url, {cache: 'no-cache'});
		} catch (e) {
			throw new Error('{=L:yw.set.extinst_cors=}');
		}
		if (!r.ok) throw new Error('HTTP ' + r.status);
		return r.blob();
	}

	async function extInstallUpload(btn) {
		var inp = document.getElementById('extInstFile');
		if (!inp || !inp.files || !inp.files.length) { ywebShowToast('{=L:yw.inst.nofile=}', true); return; }
		btn.disabled = true;
		try {
			var f = inp.files[0];
			var res = await extUploadAndInstall(f, f.name);
			ywebShowToast('{=L:yw.set.extinst_ok=}: ' + (res && res.dir));
			ywebCloseModal('extInstallModal');
			await loadExtensionsPanel();
		} catch (e) { ywebShowToast('{=L:yw.set.extinst_fail=}: ' + e.message, true); }
		btn.disabled = false;
	}

	async function extInstallUrl(btn) {
		var url = ((document.getElementById('extInstUrl') || {}).value || '').trim();
		if (!url) { ywebShowToast('{=L:yw.set.extinst_nourl=}', true); return; }
		btn.disabled = true;
		try {
			var res = await extUploadAndInstall(await extFetchArchive(url), url.split(/[?#]/)[0]);
			ywebShowToast('{=L:yw.set.extinst_ok=}: ' + (res && res.dir));
			ywebCloseModal('extInstallModal');
			await loadExtensionsPanel();
		} catch (e) { ywebShowToast('{=L:yw.set.extinst_fail=}: ' + e.message, true); }
		btn.disabled = false;
	}

	function extUninstall(dir) {
		var m = (_ywebExtensions || []).filter(function(x) { return x.dir === dir; })[0];
		var name = m ? m.name : dir;
		// the dialog takes markup; the name is the manifest's
		ywebShowConfirm('{=L:yw.set.extuninst_btn=}', escapeHtml(name) + ' — {=L:yw.set.extuninst_confirm=}',
			'{=L:yw.set.extuninst_btn=}', async function() {
			try {
				await ywebV1('DELETE', '/webui/extensions/' + encodeURIComponent(dir));
				// its keys go with it (an empty value takes a key out); the
				// extension is gone either way, and keys left over are inert
				var gone = {};
				gone['ext_' + dir + '_enabled'] = '';
				gone['ext_' + dir + '_slot'] = '';
				try { await webuiSettingsWrite(gone); } catch (eKeys) { console.warn('extension keys kept:', eKeys.message); }
				delete _extUpdates[dir];
				ywebShowToast('{=L:yw.set.extuninst_ok=}: ' + name);
				await loadExtensionsPanel();
			} catch (e) { ywebShowToast('{=L:yw.msg.error=}: ' + e.message, true); }
		});
	}

	// update check is an explicit user action (no automatic calls to
	// external URLs); index URL overridable via yweb key ext_index_url
	var EXT_INDEX_DEFAULT = 'https://raw.githubusercontent.com/tuxbox-neutrino/yweb-extensions/master/index.json';

	function extVerNewer(a, b) {
		var pa = String(a || '').split('.'), pb = String(b || '').split('.');
		for (var i = 0; i < Math.max(pa.length, pb.length); i++) {
			var na = parseInt(pa[i], 10) || 0, nb = parseInt(pb[i], 10) || 0;
			if (na !== nb) return na > nb;
		}
		return false;
	}

	async function extCheckUpdates(btn) {
		btn.disabled = true;
		try {
			var cfg = await webuiSettingsRead();
			var url = cfg['ext_index_url'] || EXT_INDEX_DEFAULT;
			// the browser reads the index; the box fetches nothing
			var idx = JSON.parse(await (await extFetchArchive(url)).text());
			var exts = await ywebDiscoverExtensions();
			_extUpdates = {};
			var found = 0;
			((idx && idx.extensions) || []).forEach(function(e) {
				exts.forEach(function(m) {
					if (m.dir === e.dir && e.tarball && extVerNewer(e.version, m.version)) {
						_extUpdates[m.dir] = {version: e.version, tarball: e.tarball};
						found++;
					}
				});
			});
			ywebShowToast(found ? ('{=L:yw.set.extup_avail=}: ' + found) : '{=L:yw.set.extup_none=}');
			await loadExtensionsPanel();
		} catch (e) { ywebShowToast('{=L:yw.set.extup_fail=}: ' + e.message, true); }
		btn.disabled = false;
	}

	async function extUpdate(dir, btn) {
		var u = _extUpdates[dir];
		if (!u) return;
		btn.disabled = true;
		try {
			var res = await extUploadAndInstall(await extFetchArchive(u.tarball), u.tarball.split(/[?#]/)[0]);
			delete _extUpdates[dir];
			ywebShowToast('{=L:yw.set.extinst_ok=}: ' + (res && res.dir) + ' v' + u.version);
			await loadExtensionsPanel();
		} catch (e) { ywebShowToast('{=L:yw.set.extinst_fail=}: ' + e.message, true); }
		btn.disabled = false;
	}

	async function saveExtensions(btn) {
		var exts = await ywebDiscoverExtensions();
		var changes = {};
		exts.forEach(function(m) {
			// a folder put there by hand under a name no key can carry is left
			// out rather than failing the save of every other one
			if (!/^[A-Za-z0-9][A-Za-z0-9_.-]{0,254}$/.test(m.dir)) return;
			var ena = document.getElementById('extena_' + m.dir);
			var slot = document.getElementById('extslot_' + m.dir);
			changes['ext_' + m.dir + '_enabled'] = ena && ena.checked ? '1' : '0';
			if (slot) changes['ext_' + m.dir + '_slot'] = slot.value;
		});
		btn.disabled = true;
		try {
			await webuiSettingsWrite(changes);
			ywebShowToast('{=L:yw.set.ext_saved=}');
			await loadExtensionsPanel();
		} catch (e) { ywebShowToast('{=L:yw.msg.error=}: ' + e.message, true); }
		btn.disabled = false;
	}

	// Wake-on-LAN: description and MAC of up to three devices in the web
	// interface's own settings (/api/v1/webui/settings); the box sends the
	// wake-up packet itself (POST /api/v1/network/wake)
	function renderWolPanel() {
		setTimeout(loadWolPanel, 0);
		return '<div class="settings-card">' + makeCardHeader('Wake-on-LAN') +
			'<div id="wolPanel"><p aria-busy="true">Lade…</p></div></div>';
	}

	async function loadWolPanel() {
		var el = document.getElementById('wolPanel');
		if (!el) return;
		try {
			var cfg = await webuiSettingsRead();
			EXT_CONFIG_CACHE['yweb'] = cfg;
			var section = ywebEl('div', {className: 'yweb-form-section'},
				ywebEl('div', {className: 'yweb-form-section-title'}, '{=L:yw.set.wol_devices=}'));
			[1, 2, 3].forEach(function(i) {
				section.appendChild(ywebEl('div', {className: 'yweb-form-row'},
					ywebEl('label', {}, '{=L:yw.set.wol_device=} ' + i),
					ywebEl('span', {},
						ywebEl('input', {type: 'text', id: 'wol_desc_' + i, value: cfg['wol_desc_' + i] || '',
							attrs: {placeholder: '{=L:yw.set.wol_desc_ph=}'}, style: {'max-width': '140px'}}), ' ',
						ywebEl('input', {type: 'text', id: 'wol_mac_' + i, value: cfg['wol_mac_' + i] || '',
							attrs: {placeholder: 'aa:bb:cc:dd:ee:ff'}, style: {'max-width': '160px'}}), ' ',
						ywebEl('button', {type: 'button', className: 'yweb-btn', on: {click: function() { wolWake(i, this); }}},
							ywebMarkup(ZAP_ICON), '{=L:yw.set.wol_wake=}'))));
			});
			el.replaceChildren(section);
			el.insertAdjacentHTML('beforeend', makePanelSaveRow('wolSave(this)'));
		} catch (e) {
			el.replaceChildren(ywebEl('div', {className: 'yweb-form-row'},
				ywebEl('label', {}, '{=L:yw.set.notavail=}: ' + e.message)));
		}
	}

	async function wolWake(i, btn) {
		var mac = (document.getElementById('wol_mac_' + i) || {}).value || '';
		if (!mac.trim()) { ywebShowToast('{=L:yw.set.wol_nomac=}', true); return; }
		btn.disabled = true;
		try {
			await ywebV1('POST', '/network/wake', {body: {mac: mac.trim()}});
			ywebShowToast('{=L:yw.set.wol_sent=}: ' + mac.trim());
		} catch (e) {
			ywebShowToast('{=L:yw.msg.error=}: ' + e.message, true);
		}
		btn.disabled = false;
	}

	async function wolSave(btn) {
		var cfg = EXT_CONFIG_CACHE['yweb'] || {};
		var changes = {};
		var changed = 0;
		for (var i = 1; i <= 3; i++) {
			['wol_desc_' + i, 'wol_mac_' + i].forEach(function(k) {
				var v = (document.getElementById(k) || {}).value || '';
				if (v !== (cfg[k] || '')) { changes[k] = v; changed++; }
			});
		}
		if (!changed) { ywebShowToast('{=L:yw.set.nochanges=}'); return; }
		btn.disabled = true;
		try {
			await webuiSettingsWrite(changes);
			ywebShowToast('{=L:yw.msg.saved=}');
			await loadWolPanel();
		} catch (e) { ywebShowToast('{=L:yw.msg.error=}: ' + e.message, true); }
		btn.disabled = false;
	}

	// The lists the box reads web channels and XMLTV guides from, over
	// /api/v1/channels/sources: one address or file per line; a save replaces
	// only the lists that changed and has the box read its channels again
	var XMLTV_LOADED = null;
	var XMLTV_KINDS = ['webtv', 'webradio', 'xmltv'];
	// a list file uploaded over one already named changes no line, and the box
	// still has to read it in: the uploads finished per list, and how many of
	// them a save had the box read in. Counted rather than flagged, so an upload
	// that finishes while a save runs stays owed
	var XMLTV_UPLOADS = {webtv: 0, webradio: 0};
	var XMLTV_READ_IN = {webtv: 0, webradio: 0};

	function xmltvOwed() {
		return Object.keys(XMLTV_UPLOADS).filter(function(kind) {
			return XMLTV_UPLOADS[kind] !== XMLTV_READ_IN[kind];
		});
	}

	function renderXmltvPanel() {
		setTimeout(loadXmltvPanel, 0);
		return '<div class="settings-card">' + makeCardHeader('{=L:yw.set.xmltv_title=}') +
			'<div id="xmltvPanel"><p aria-busy="true">Lade…</p></div></div>';
	}

	function xmltvSection(kind, title, upload) {
		var html = '<div class="yweb-form-section"><div class="yweb-form-section-title">' + title + '</div>' +
			'<textarea id="xmltv_' + kind + '" rows="4" style="width:100%" placeholder="{=L:yw.set.xmltv_ph=}">' +
			escapeHtml((XMLTV_LOADED[kind] || []).join('\n')) + '</textarea>';
		if (upload)
			html += '<div class="yweb-form-row" style="margin-top:0.4rem"><label><small style="color:var(--pico-muted-color)">{=L:yw.set.xmltv_upload=}</small></label>' +
				'<span class="yweb-row-actions">' + makeFileControl('xmltv_' + kind + '_file', '.xml,.m3u') +
				'<button type="button" class="yweb-btn" onclick="uploadXmltv(\'' + kind + '\', this)">' + UP_ICON + '{=L:yw.fm.upload=}</button></span></div>';
		return html + '</div>';
	}

	async function loadXmltvPanel() {
		var el = document.getElementById('xmltvPanel');
		if (!el) return;
		try {
			XMLTV_LOADED = await ywebV1('GET', '/channels/sources');
			el.innerHTML = xmltvSection('webtv', 'WebTV', true) +
				xmltvSection('webradio', 'WebRadio', true) +
				xmltvSection('xmltv', '{=L:yw.set.xmltv_guide=}', false) +
				'<div class="yweb-form-row"><label><small style="color:var(--pico-muted-color)">{=L:yw.set.xmltv_hint=}</small></label>' +
				'<span class="yweb-row-actions">' +
				'<button type="button" class="yweb-btn primary" onclick="saveXmltv(this)">' + SAVE_ICON + '{=L:yw.bqe.save_reload=}</button></span></div>';
		} catch (e) {
			el.innerHTML = '<div class="yweb-form-row"><label>{=L:yw.set.notavail=}: ' + escapeHtml(e.message) + '</label></div>';
		}
	}

	// A list as the box takes it: the lines of the field, without blanks and
	// without the spaces a paste brings along at either end
	function xmltvEntries(kind) {
		var ta = document.getElementById('xmltv_' + kind);
		return ((ta && ta.value) || '').split('\n').map(function(l) { return l.trim(); })
			.filter(function(l) { return l.length > 0; });
	}

	// A local list file goes up in pieces into the directory the box keeps its
	// own lists in, under a name no reload reads, and takes its own name only
	// once it is whole; its path is then added as a line (a save names it)
	async function uploadXmltv(kind, btn) {
		var inp = document.getElementById('xmltv_' + kind + '_file');
		var ta = document.getElementById('xmltv_' + kind);
		if (!inp || !inp.files || !inp.files.length) { ywebShowToast('{=L:yw.inst.nofile=}', true); return; }
		btn.disabled = true;
		var part = '';
		try {
			var f = inp.files[0];
			var dir = (kind === 'webtv' ? XMLTV_LOADED.webtv_dir : XMLTV_LOADED.webradio_dir);
			var name = f.name.replace(/[^A-Za-z0-9._-]/g, '_');
			var savedPath = dir + '/' + name;
			part = dir + '/.' + name + '.' + Math.random().toString(36).slice(2, 8) + '.upload';
			await ywebV1UploadPieces(f, part);
			await ywebV1('POST', '/storage/rename', {body: {from: part, to: savedPath, overwrite: true}});
			part = '';
			XMLTV_UPLOADS[kind]++;
			if (ta && xmltvEntries(kind).indexOf(savedPath) < 0)
				ta.value = (ta.value ? ta.value.replace(/\n*$/, '\n') : '') + savedPath;
			ywebShowToast('{=L:yw.fm.uploaded=}: ' + savedPath);
			inp.value = '';
		} catch (e) {
			if (part) {
				try { await ywebV1('DELETE', '/storage/path', {query: {path: part}}); } catch (e2) {}
			}
			ywebShowToast('{=L:yw.fm.upload_fail=}: ' + e.message, true);
		}
		btn.disabled = false;
	}

	async function saveXmltv(btn) {
		var changed = XMLTV_KINDS.filter(function(kind) {
			return JSON.stringify(xmltvEntries(kind)) !== JSON.stringify(XMLTV_LOADED[kind] || []);
		});
		var owed = xmltvOwed();
		if (!changed.length && !owed.length) { ywebShowToast('{=L:yw.set.nochanges=}'); return; }
		if (!confirm('{=L:yw.set.xmltv_confirm=}')) return;
		// what this save answers for; an upload finishing meanwhile stays owed
		var upto = {webtv: XMLTV_UPLOADS.webtv, webradio: XMLTV_UPLOADS.webradio};
		// with nothing changed an upload's list goes as it stands: the reload that
		// comes with a written list is the box's own, which reads the guides the
		// playlists name as well, and a bare channel reload does not
		var sending = changed.length ? changed : [owed[0]];
		// every list as it stands now, before the first request: the panel can
		// be closed while one is under way, and a field gone reads as empty
		var bodies = {};
		sending.forEach(function(kind) { bodies[kind] = xmltvEntries(kind); });
		btn.disabled = true;
		try {
			// each with the reload: the box carries what came meanwhile in one go,
			// and a list taken over is read in even where a later one is refused.
			// What is compared next time is what was sent, list by list: a list
			// changed elsewhere meanwhile is not taken for an edit made here
			for (var i = 0; i < sending.length; i++) {
				var answer = await ywebV1('PUT', '/channels/sources/' + sending[i],
					{body: bodies[sending[i]], query: {reload: true}});
				XMLTV_LOADED[sending[i]] = answer[sending[i]];
			}
			XMLTV_READ_IN = upto;
			ywebShowToast('{=L:yw.set.xmltv_saved=}');
		} catch (e) { ywebShowToast('{=L:yw.msg.error=}: ' + e.message, true); }
		btn.disabled = false;
	}

	// Zapit-Upload: Kanal-/Bouquet-XML hochladen und aktivieren
	function renderZapitUploadPanel() {
		return '<div class="settings-card">' + makeCardHeader('Zapit-Upload') +
			'<div class="yweb-form-section"><div class="yweb-form-section-title">{=L:yw.set.zapit_section=}</div>' +
			'<div class="yweb-form-row"><label>{=L:yw.set.zapit_target=}</label>' +
			'<select id="zapitTarget"><option>ubouquets.xml</option><option>bouquets.xml</option><option>services.xml</option><option>myservices.xml</option></select></div>' +
			'<div class="yweb-form-row"><label>{=L:yw.fm.file=}</label>' +
			'<span class="yweb-row-actions">' + makeFileControl('zapitFile', '.xml') +
			'<button type="button" class="yweb-btn primary" onclick="doZapitUpload(this)">' + UP_ICON + '{=L:yw.set.zapit_btn=}</button></span></div>' +
			'<div class="yweb-form-row"><label><small style="color:var(--pico-muted-color)">{=L:yw.set.zapit_hint=}</small></label>' +
			'<span id="zapitStatus" style="color:var(--pico-muted-color);font-size:0.8rem"></span></div></div></div>';
	}

	// The list goes up in pieces into /tmp under a name of its own, and the box
	// takes it over from there: checks that it is a list of the kind chosen,
	// puts it in place of its own and reads its channel lists again, so the
	// uploaded list wins over what the box holds
	async function doZapitUpload(btn) {
		var inp = document.getElementById('zapitFile');
		var target = (document.getElementById('zapitTarget') || {}).value;
		var status = document.getElementById('zapitStatus');
		if (!inp || !inp.files || !inp.files.length) { ywebShowToast('{=L:yw.inst.nofile=}', true); return; }
		if (!confirm(target + ' {=L:yw.set.zapit_confirm=}')) return;
		btn.disabled = true;
		if (status) status.textContent = '{=L:yw.inst.uploading=}…';
		var file = 'zapit-' + Math.random().toString(36).slice(2, 10) + '.xml';
		var uploaded = false;
		try {
			var f = inp.files[0];
			await ywebV1UploadPieces(f, '/tmp/' + file);
			uploaded = true;
			await ywebV1('POST', '/channels/files/' + target.replace(/\.xml$/, ''), {body: {file: file}});
			uploaded = false;
			if (status) status.textContent = target + ' ✓ (' + f.size + ' B)';
			ywebShowToast(target + ' {=L:yw.set.zapit_done=}');
			inp.value = '';
		} catch (e) {
			// the box takes an upload it looked at away itself; one it never got to stays
			if (uploaded) {
				try { await ywebV1('DELETE', '/storage/path', {query: {path: '/tmp/' + file}}); } catch (e2) {}
			}
			if (status) status.textContent = '';
			ywebShowToast('{=L:yw.msg.error=}: ' + e.message, true);
		}
		btn.disabled = false;
	}

	// Plugins over /api/v1: the list, starting one, and reading the plugin
	// directories again. The box starts a plugin and reads its directories
	// on its own thread, after it answered. Starting and stopping services
	// (nfs, samba, ...) is not part of this panel: it depends on the
	// packages and the image, and comes as an extension over /api/v1/daemons.
	function renderPluginsPanel() {
		setTimeout(loadPluginsPanel, 0);
		return '<div class="settings-card">' + makeCardHeader('{=L:yw.reg.plugins=}') +
			'<div id="pluginsPanel"><p aria-busy="true">{=L:yw.set.plugins_loading=}</p></div></div>';
	}

	function pluginRow(label, note, button) {
		return ywebEl('div', {className: 'yweb-form-row'},
			ywebEl('label', {}, label, note ? ' ' : null,
				note ? ywebEl('small', {style: {color: 'var(--pico-muted-color)'}}, note) : null),
			button ? ywebEl('span', {className: 'yweb-row-actions'}, button) : null);
	}

	function pluginButton(icon, text, onClick) {
		return ywebEl('button', {type: 'button', className: 'yweb-btn', on: {click: function() { onClick(this); }}},
			ywebMarkup(icon), text);
	}

	async function loadPluginsPanel() {
		var el = document.getElementById('pluginsPanel');
		if (!el) return;
		try {
			var data = await ywebV1('GET', '/plugins');
			var list = ((data && data.items) || []).filter(function(pl) { return !pl.hidden; });
			var installed = ywebEl('div', {className: 'yweb-form-section'},
				ywebEl('div', {className: 'yweb-form-section-title'}, 'Installierte Plugins'));
			if (list.length === 0)
				installed.appendChild(pluginRow('{=L:yw.set.plugins_none=}'));
			list.forEach(function(pl) {
				installed.appendChild(pluginRow(pl.title || pl.name, pl.description,
					pluginButton(PLAY_ICON, '{=L:yw.set.plugins_start=}', function(btn) { startPluginByName(pl.name, btn); })));
			});
			var manage = ywebEl('div', {className: 'yweb-form-section'},
				ywebEl('div', {className: 'yweb-form-section-title'}, 'Verwaltung'),
				pluginRow('{=L:yw.set.plugins_reload=}', null,
					pluginButton(REFRESH_ICON, '{=L:yw.set.plugins_reload_btn=}', reloadPluginList)));
			el.replaceChildren(installed, manage);
		} catch (e) {
			el.replaceChildren(pluginRow('{=L:yw.set.plugins_notavail=}: ' + e.message));
		}
	}

	async function startPluginByName(name, btn) {
		btn.disabled = true;
		try {
			await ywebV1('POST', '/plugins/' + encodeURIComponent(name) + '/start');
			ywebShowToast('{=L:yw.set.plugin_started=}: ' + name);
		} catch (e) {
			ywebShowToast('{=L:yw.msg.error=}: ' + e.message, true);
		}
		btn.disabled = false;
	}

	// The box reads the directories after it answered, so the list is read
	// again a moment later
	async function reloadPluginList(btn) {
		btn.disabled = true;
		try {
			await ywebV1('POST', '/plugins/reload');
			await new Promise(function(r) { setTimeout(r, 1500); });
			await loadPluginsPanel();
			ywebShowToast('{=L:yw.set.plugins_reloaded=}');
		} catch (e) {
			ywebShowToast('{=L:yw.msg.error=}: ' + e.message, true);
		}
		btn.disabled = false;
	}

	// The box's own network shares over /api/v1/storage/shares: the 8 slots the
	// screen at the box edits, each saved, mounted and unmounted on its own.
	// Not part of the save bar: a slot is written whole, and a stored password
	// is never read back, so the field opens empty and is only sent when typed.
	var SHARE_STATE = {
		mounted: '{=L:yw.set.mnt_state_mounted=}',
		unmounted: '{=L:yw.set.mnt_state_unmounted=}',
		foreign: '{=L:yw.set.mnt_state_foreign=}'
	};

	function renderMountsPanel() {
		setTimeout(loadSharesPanel, 0);
		return '<div class="settings-card">' + makeCardHeader('Netzlaufwerke') +
			'<div id="sharesPanel"><p aria-busy="true"></p></div></div>';
	}

	async function loadSharesPanel() {
		var el = document.getElementById('sharesPanel');
		if (!el) return;
		try {
			var data = await ywebV1('GET', '/storage/shares');
			drawShares(el, (data && data.items) || []);
		} catch (e) {
			el.replaceChildren(ywebEl('p', {}, '{=L:yw.msg.error=}: ' + e.message));
		}
	}

	function shareSummary(sh) {
		return (sh.host ? (sh.host + ':' + sh.remote_dir + ' → ' + sh.local_dir) : '{=L:yw.set.mnt_unconfigured=}') +
			' · ' + (SHARE_STATE[sh.state] || sh.state);
	}

	function shareSlot(sh, open) {
		var chevron = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>';
		var slot = ywebEl('div', {className: 'mount-slot' + (open ? ' open' : ''), id: 'mount-slot-' + sh.slot},
			ywebEl('div', {className: 'mount-slot-header', on: {click: function() { slot.classList.toggle('open'); }}},
				ywebEl('span', {}, 'Slot ' + sh.slot + ' ',
					ywebEl('span', {className: 'slot-summary', id: 'share_summary_' + sh.slot}, shareSummary(sh))),
				ywebMarkup(chevron)),
			ywebEl('fieldset', {className: 'mount-slot-body', id: 'share_body_' + sh.slot,
				style: {border: '0', margin: '0', padding: '0', 'min-width': '0'}},
				// an FTP share (lufs) is set, mounted and unmounted at the box only
				sh.type === 'lufs' ? shareRow('FTP (lufs)', ywebEl('span', {}, '{=L:yw.set.mnt_lufs_note=}')) : shareFields(sh)));
		return slot;
	}

	function drawShares(el, items) {
		var all = ywebEl('div', {className: 'yweb-form-row'},
			ywebEl('label', {}, '{=L:yw.set.mnt_mount_auto=}'),
			ywebEl('span', {className: 'yweb-row-actions'},
				ywebEl('button', {type: 'button', className: 'yweb-btn primary', on: {click: function() { mountAutomaticShares(this); }}},
					ywebMarkup(MOUNT_ICON), '{=L:yw.set.mnt_mount=}')));
		el.replaceChildren(all, ...items.map(function(sh) { return shareSlot(sh, false); }));
	}

	/* After an action: the slot acted on is drawn again from what the box
	   answered, the others only get their summary, so what was typed into
	   them and not saved yet stays. */
	function updateShares(items, acted) {
		items.forEach(function(sh) {
			if (sh.slot === acted) {
				var old = document.getElementById('mount-slot-' + sh.slot);
				if (old) old.replaceWith(shareSlot(sh, true));
				return;
			}
			var summary = document.getElementById('share_summary_' + sh.slot);
			if (summary) summary.textContent = shareSummary(sh);
		});
	}

	// The slot's own form is locked while the box answers for it.
	async function onShare(i, request) {
		var body = document.getElementById('share_body_' + i);
		if (body) body.disabled = true;
		try {
			var res = await request();
			updateShares((res && res.items) || [], i);
			return true;
		} catch (e) {
			ywebShowToast('{=L:yw.msg.error=}: ' + e.message, true);
			if (body) body.disabled = false;
			return false;
		}
	}

	function shareRow(label, control) {
		return ywebEl('div', {className: 'yweb-form-row'}, ywebEl('label', {}, label), control);
	}

	function shareFields(sh) {
		var i = sh.slot;
		var input = function(key, value, type) {
			return ywebEl('input', {type: type || 'text', id: 'share_' + key + '_' + i, value: value || ''});
		};
		var type = ywebEl('select', {id: 'share_type_' + i},
			ywebEl('option', {value: 'nfs'}, 'NFS'),
			ywebEl('option', {value: 'cifs'}, 'CIFS'),
			sh.type === 'lufs' ? ywebEl('option', {value: 'lufs'}, 'FTP (lufs)') : null);
		type.value = sh.type;
		var pass = input('password', '', 'password');
		pass.placeholder = sh.has_password ? '{=L:yw.set.mnt_pass_kept=}' : '';
		pass.autocomplete = 'new-password';
		var clear = sh.has_password ? ywebEl('label', {style: {display: 'inline-flex', gap: '.3rem', 'margin-left': '.5rem'}},
			ywebEl('input', {type: 'checkbox', id: 'share_clearpass_' + i}), ' {=L:yw.set.mnt_pass_clear=}') : null;
		var credentials = ywebEl('div', {className: 'cifs-fields' + (sh.type !== 'nfs' ? ' visible' : '')},
			shareRow('{=L:yw.set.mnt_user=}', input('user', sh.user)),
			shareRow('{=L:yw.set.mnt_pass=}', ywebEl('span', {}, pass, clear)));
		type.addEventListener('change', function() {
			credentials.classList.toggle('visible', type.value !== 'nfs');
		});
		var local = input('local_dir', sh.local_dir);
		var auto = ywebEl('input', {type: 'checkbox', id: 'share_automount_' + i, checked: !!sh.automount});
		var button = function(icon, text, onClick) {
			return ywebEl('button', {type: 'button', className: 'yweb-btn', on: {click: function() { onClick(this); }}},
				ywebMarkup(icon), text);
		};
		return [
			shareRow('{=L:yw.tm.type=}', type),
			shareRow('{=L:yw.set.mnt_ip=}', input('host', sh.host)),
			shareRow('{=L:yw.set.mnt_dir=}', input('remote_dir', sh.remote_dir)),
			shareRow('{=L:yw.set.mnt_local=}', ywebEl('span', {}, local, ' ',
				ywebEl('button', {type: 'button', className: 'yweb-btn', title: '{=L:yw.picker.title=}',
					on: {click: function() { ywebPickInto(local.id, local.value || '/media'); }}}, ywebMarkup(FOLDER_ICON)))),
			shareRow('Auto-Mount', ywebEl('label', {className: 'yweb-toggle'}, auto, ywebEl('span', {className: 'yweb-toggle-slider'}))),
			shareRow('{=L:yw.set.mnt_opts=} 1', input('options1', sh.options1)),
			shareRow('{=L:yw.set.mnt_opts=} 2', input('options2', sh.options2)),
			shareRow('{=L:yw.set.mnt_mac=}', input('mac', sh.mac)),
			credentials,
			shareRow('{=L:yw.set.mnt_actions=}', ywebEl('span', {className: 'yweb-row-actions'},
				button(SAVE_ICON, '{=L:yw.bqe.save=}', function() { saveShare(i); }), ' ',
				button(MOUNT_ICON, '{=L:yw.set.mnt_mount=}', function() { shareAction(i, 'mount'); }), ' ',
				button(EJECT_ICON, '{=L:yw.set.mnt_umount=}', function() { shareAction(i, 'unmount'); })))
		];
	}

	async function saveShare(i) {
		var val = function(key) { return document.getElementById('share_' + key + '_' + i).value.trim(); };
		var body = {
			automount: document.getElementById('share_automount_' + i).checked,
			type: val('type'), local_dir: val('local_dir'), host: val('host'), remote_dir: val('remote_dir'),
			user: val('user'), options1: val('options1'), options2: val('options2'), mac: val('mac')
		};
		// typed: the new one; the box's own left alone otherwise, or taken away
		var pass = document.getElementById('share_password_' + i).value;
		var clear = document.getElementById('share_clearpass_' + i);
		if (pass !== '')
			body.password = pass;
		else if (clear && clear.checked)
			body.password = '';
		if (await onShare(i, function() { return ywebV1('PUT', '/storage/shares/' + i, {body: body}); }))
			ywebShowToast('{=L:yw.set.mnt_saved=}');
	}

	function shareAction(i, act) {
		return onShare(i, function() { return ywebV1('POST', '/storage/shares/' + i + '/' + act); });
	}

	async function mountAutomaticShares(btn) {
		btn.disabled = true;
		try {
			var res = await ywebV1('POST', '/storage/shares/mount');
			var items = (res && res.items) || [];
			var failed = items.filter(function(o) { return !o.mounted; });
			if (items.length === 0)
				ywebShowToast('{=L:yw.set.mnt_auto_none=}');
			else if (failed.length === 0)
				ywebShowToast(items.length + ' {=L:yw.set.mnt_auto_done=}');
			else
				ywebShowToast(failed.map(function(o) { return 'Slot ' + o.slot + ': ' + o.detail; }).join('; '), true);
			// only the summaries: what was typed into a slot and not saved stays
			var now = await ywebV1('GET', '/storage/shares');
			updateShares((now && now.items) || [], -1);
		} catch (e) {
			ywebShowToast('{=L:yw.msg.error=}: ' + e.message, true);
		}
		btn.disabled = false;
	}

	// M5b: Sidebar nach SETTINGS_GROUPS gruppiert (Zwischentitel + Icon je
	// Kategorie), Mobile-Select mit <optgroup> je Gruppe. Registry-Labels
	// sind vertrauenswürdige Konstanten (dürfen Entities enthalten) und
	// bleiben roh; Extension-Labels kommen aus Manifesten und werden escapt.
	function buildNavigation() {
		var sidebarHtml = '';
		var mobileHtml = '';
		var groups = {};
		SETTINGS_GROUPS.forEach(function(g) { groups[g.id] = []; });

		v1setCategories().forEach(function(cat) {
			(groups[cat.group] || groups.ext).push({cat: cat, esc: !!cat.v1});
		});
		Object.keys(EXT_SETTINGS_CATS).forEach(function(cid) {
			var cat = EXT_SETTINGS_CATS[cid];
			(groups[cat.group] || groups.ext).push({cat: cat, esc: true});
		});

		SETTINGS_GROUPS.forEach(function(g) {
			var entries = groups[g.id];
			if (!entries.length) return;
			sidebarHtml += '<div class="grp">' + g.label + '</div>';
			mobileHtml += '<optgroup label="' + escapeHtml(g.label) + '">';
			entries.forEach(function(e) {
				var label = e.esc ? escapeHtml(e.cat.label) : e.cat.label;
				var icon = e.cat.icon || SETTINGS_DEFAULT_ICON;
				sidebarHtml += '<button data-cat="' + e.cat.id + '"' +
					(e.cat.id === activeCategory ? ' class="active"' : '') +
					' onclick="switchCategory(\'' + e.cat.id + '\')">' + icon +
					'<span>' + label + '</span></button>';
				mobileHtml += '<option value="' + e.cat.id + '"' +
					(e.cat.id === activeCategory ? ' selected' : '') + '>' + label + '</option>';
			});
			mobileHtml += '</optgroup>';
		});

		document.getElementById('settingsSidebar').innerHTML = sidebarHtml;
		document.getElementById('mobileCategorySelect').innerHTML = mobileHtml;
	}

	function switchCategory(catId) {
		if (activeCategory === catId && document.getElementById('panel-' + catId)) return;
		activeCategory = catId;

		// Update hash without triggering hashchange
		history.replaceState(null, '', '#' + catId);

		// Update sidebar active state
		document.querySelectorAll('#settingsSidebar button').forEach(function(btn) {
			btn.classList.toggle('active', btn.getAttribute('data-cat') === catId);
		});

		// Update mobile select
		var mobileSelect = document.getElementById('mobileCategorySelect');
		if (mobileSelect) mobileSelect.value = catId;

		// Show/hide panels — lazy render on first visit
		var content = document.getElementById('settingsContent');
		var panels = content.querySelectorAll('.settings-panel');
		panels.forEach(function(p) { p.classList.remove('active'); });

		var panel = document.getElementById('panel-' + catId);
		if (!panel) {
			// First visit: render and insert
			panel = document.createElement('div');
			panel.className = 'settings-panel';
			panel.id = 'panel-' + catId;
			var drawn = renderCategory(catId);
			if (drawn instanceof Node)
				panel.appendChild(drawn);
			else
				panel.innerHTML = drawn;
			v1setFillSlots(panel);
			content.appendChild(panel);
			renderedPanels[catId] = true;
			v1setApplyConditions();
		}
		panel.classList.add('active');
	}

	// M5c: sammelt über ALLE gerenderten Panels (nicht nur das aktive) —
	// gecachte Panels behalten ungespeicherte Eingaben beim Kategorie-
	// Wechsel, und die zentrale Save-Leiste speichert sie alle zusammen
	function collectValues() {
		var values = {};
		var content = document.getElementById('settingsContent');
		if (!content) return values;

		content.querySelectorAll('select[data-key]:not([data-extcfg]), input[type="text"][data-key]:not([data-extcfg]), input[type="number"][data-key]:not([data-extcfg]), input[type="password"][data-key]:not([data-extcfg])').forEach(function(el) {
			values[el.getAttribute('data-key')] = el.value;
		});
		content.querySelectorAll('input[type="checkbox"][data-key]:not([data-extcfg])').forEach(function(el) {
			values[el.getAttribute('data-key')] = el.checked ? el.getAttribute('data-on') : el.getAttribute('data-off');
		});
		return values;
	}

	// Dirty-Zähler für die Save-Leiste: gleiche Diff-Logik wie
	// saveSettings (String-Vergleich gegen configData), dazu die Zeilen
	// der Box-Einstellungen (settings-v1.js)
	function ywebCountDirty() {
		var values = collectValues();
		var dirty = v1setDirty().count;
		for (var key in values) {
			var origKey = key.replace(/\./g, '_dot_').replace(/-/g, '_bind_');
			if (values[key] !== (configData[origKey] || '')) dirty++;
		}
		return dirty;
	}

	function ywebUpdateSaveBar() {
		var bar = document.getElementById('settingsSaveBar');
		if (!bar) return;
		var n = ywebCountDirty();
		document.getElementById('saveBarCount').textContent = n;
		bar.hidden = (n === 0);
	}

	// Verwerfen: alle Panel-Caches wegwerfen und aktive Kategorie aus
	// configData neu rendern (die übrigen rendern beim nächsten Besuch)
	function discardSettings() {
		v1setDiscard();
		renderedPanels = {};
		document.querySelectorAll('#settingsContent .settings-panel').forEach(function(p) { p.remove(); });
		var cat = activeCategory;
		activeCategory = '';
		switchCategory(cat);
		ywebUpdateSaveBar();
	}

	// Box settings go to PATCH /api/v1/settings/{section}, what only the
	// registry knows to config=neutrino. A key the box refuses keeps its
	// input and reason (settings-v1.js) through the redraw afterwards.
	async function saveSettings() {
		var values = collectValues();
		var params = 'action=submit';
		var changed = 0;
		var v1dirty = v1setDirty();

		for (var key in values) {
			var origKey = key.replace(/\./g, '_dot_').replace(/-/g, '_bind_');
			if (values[key] !== (configData[origKey] || '')) {
				params += '&' + encodeURIComponent(key) + '=' + encodeURIComponent(values[key]);
				changed++;
			}
		}

		if (changed === 0 && v1dirty.count === 0) {
			ywebShowToast('{=L:yw.set.nochanges=}');
			return;
		}

		// no edits while the box answers and the form is drawn again: a
		// refusal arriving late must not replace a newer input
		settingsBusy(true);
		try {
			await saveSettingsNow(values, params, changed, v1dirty);
		} finally {
			settingsBusy(false);
		}
	}

	// Locks the form and the save bar while a write is answered (saving,
	// clearing a credential)
	function settingsBusy(on) {
		var content = document.getElementById('settingsContent');
		content.inert = on;
		if (on) content.setAttribute('aria-busy', 'true');
		else content.removeAttribute('aria-busy');
		document.querySelectorAll('#settingsSaveBar .yweb-btn').forEach(function(b) { b.disabled = on; });
	}

	async function saveSettingsNow(values, params, changed, v1dirty) {
		var v1 = {saved: 0, failed: 0, restart: false};
		if (v1dirty.count)
			v1 = await v1setSave(v1dirty);
		var oldOk = true;
		if (changed) {
			try {
				await ywebApi('config', 'config=neutrino&' + params);
			} catch (e) {
				oldOk = false;
			}
		}

		var saved = v1.saved + (oldOk ? changed : 0);
		if (!oldOk)
			ywebShowToast('{=L:yw.tm.save_fail=}', true);
		else if (v1.failed)
			ywebShowToast('{=L:yw.set.save_some_fail=}', true);
		else
			ywebShowToast(saved + ' ' + (saved > 1 ? '{=L:yw.set.saved_many=}' : '{=L:yw.set.saved_one=}') +
				(v1.restart ? ' \u2013 {=L:yw.set.saved_restart=}' : ''));
		// a refused save of the old interface keeps the form as it is
		if (oldOk)
			await loadSettings();
		else
			await v1setRefresh();
		ywebUpdateSaveBar();
	}

	// Werte, die ausserhalb der Domaene ihres Feldes liegen, auf den Wert
	// ziehen, den das Feld ohnehin anzeigt. Ohne das meldet der Dirty-Vergleich
	// beim ersten Rendern eine Aenderung, die der Nutzer nie gemacht hat — und
	// der naechste Save schriebe sie fest.
	//   - access: Neutrino wertet nur die 2 aus (personalize.cpp:961), alles
	//     andere heisst 'ohne PIN'. personalize_settingsmager und
	//     personalize_media_movieplayer haben sogar die 1 als Default
	//     (settings.cpp:69/99).
	//   - select: ein nicht angebotener Wert zeigt im Browser die erste Option.
	// Geschrieben wird dadurch nichts: saveSettings schickt nur echte Diffs.
	function normalizeDomains() {
		SETTINGS_REGISTRY.forEach(function(cat) {
			(cat.sections || []).forEach(function(sec) {
				sec.fields.forEach(function(f) {
					if (!f.key) return;
					var k = f.key.replace(/\./g, '_dot_').replace(/-/g, '_bind_');
					var val = configData[k];
					if (val === undefined) return;
					if (f.type === 'access') {
						if (val !== '2') configData[k] = '0';
					} else if (f.type === 'select' && f.options) {
						var known = f.options.some(function(o) { return o.v === val; });
						if (!known) configData[k] = f.options[0].v;
					}
				});
			});
		});
	}

	async function loadSettings() {
		try {
			// v4 liefert ein valides Envelope-Dokument - der historische
			// Brace-Zaehler (Workaround fuer das alte Doppel-Dokument) entfaellt.
			// Daneben die Einstellungen der Box ueber /api/v1 (settings-v1.js);
			// ohne sie bleibt die Seite bei der Registry.
			var both = await Promise.all([ywebApi('config', {config: 'neutrino'}), v1setLoad()]);
			var resp = both[0];
			configData = (resp && resp.data && resp.data.config) || {};
		} catch (e) {
			document.getElementById('settingsContent').innerHTML =
				'<div class="settings-loading">{=L:yw.set.load_fail=}</div>';
			return;
		}

		normalizeDomains();
		originalValues = Object.assign({}, configData);

		// Enabled extensions with a settings definition become categories.
		// Manifest strings prefixed with "L:" are resolved from the
		// extension's language pack (ywebExtL; discovery already loads the
		// dictionary for enabled extensions) — literals stay valid.
		function resolveExtL(dir, node) {
			if (typeof node === 'string')
				return node.indexOf('L:') === 0 ? ywebExtL(dir, node.slice(2), node) : node;
			if (Array.isArray(node))
				return node.map(function(n) { return resolveExtL(dir, n); });
			if (node && typeof node === 'object') {
				var out = {};
				Object.keys(node).forEach(function(k) { out[k] = resolveExtL(dir, node[k]); });
				return out;
			}
			return node;
		}
		EXT_SETTINGS_CATS = {};
		try {
			_ywebExtensions = null; // frisch entdecken (Enable kann sich geaendert haben)
			(await ywebDiscoverExtensions()).forEach(function(m) {
				if (!m.enabled || !m.settings || !m.settings.sections) return;
				var cid = 'ext-' + m.dir;
				EXT_SETTINGS_CATS[cid] = {
					id: cid,
					label: resolveExtL(m.dir, m.settings.label || m.name),
					config: m.settings.config || 'yweb',
					sections: resolveExtL(m.dir, m.settings.sections)
				};
			});
		} catch (ignore) {}

		// Clear cached panels — config changed
		renderedPanels = {};
		document.getElementById('settingsContent').innerHTML = '';

		// Determine active category from hash or default to first
		var targetCategory = categoryOfHash() || v1setCategories()[0].id;

		activeCategory = '';
		buildNavigation();
		switchCategory(targetCategory);
		ywebUpdateSaveBar();
	}

	// The category the address names; one dissolved into a section of the
	// box (an old bookmark such as #lcd) leads to that section
	function categoryOfHash() {
		var hash = location.hash.replace('#', '');
		if (V1SET.dissolved[hash]) return V1SET.dissolved[hash];
		var known = v1setCategories().some(function(c) { return c.id === hash; }) || EXT_SETTINGS_CATS[hash];
		return known ? hash : '';
	}

	// Hash navigation
	window.addEventListener('hashchange', function() {
		var cat = categoryOfHash();
		if (cat) switchCategory(cat);
	});

	// M5c: Dirty-State live verfolgen (Delegation — Panels werden lazy
	// gerendert und gecacht, der Listener auf dem Container sieht alles)
	document.getElementById('settingsContent').addEventListener('input', ywebUpdateSaveBar);
	document.getElementById('settingsContent').addEventListener('change', ywebUpdateSaveBar);
	// Observer-Felder (disabledIf) folgen ihrem uebergeordneten Eintrag,
	// die Zeilen der Box ihren Bedingungen
	document.getElementById('settingsContent').addEventListener('change', ywebApplyDeps);
	document.getElementById('settingsContent').addEventListener('change', v1setApplyConditions);
	// ein abgelehnter Wert, den der Nutzer wieder bearbeitet, ist erledigt
	document.getElementById('settingsContent').addEventListener('input', function(e) { v1setEdited(e.target); });
	document.getElementById('settingsContent').addEventListener('change', function(e) { v1setEdited(e.target); });

	// Was anderswo gespeichert wird (am Geraet, von einer zweiten Seite),
	// liest die Seite nach
	ywebV1Events({'settings-changed': v1setChanged, open: v1setStreamOpen});

	loadSettings();
	</script>
</body>
</html>
