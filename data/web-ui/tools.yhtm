<!DOCTYPE html>
<html lang="de" data-theme="dark">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>yWeb - {=L:yw.nav.tools=}</title>
	<link rel="icon" href="/favicon/favicon.ico">
	<link rel="stylesheet" href="/css/pico.min.css">
	<link rel="stylesheet" href="/css/yweb.css?v=77">
	<style>
		.yweb-tools-grid {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
			gap: 1rem;
			padding: 1.5rem;
			max-width: 800px;
			margin: 0 auto;
		}

		/* Desktop: fixed-width tiles, centered rows. Stays clean for any
		   card count (incl. async-injected extension tiles) without the
		   12-track JS balancer, which left spare tracks whenever the
		   per-row count did not divide 12 (e.g. 5 cards). Below the
		   breakpoint the auto-fill layout stays untouched. */
		@media (min-width: 1101px) {
			.yweb-tools-grid {
				grid-template-columns: repeat(auto-fit, minmax(240px, 300px));
				justify-content: center;
				max-width: none;
			}
		}

		.yweb-tool-card {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 0.75rem;
			padding: 1.5rem 1rem;
			background: var(--pico-card-background-color);
			border-radius: var(--yweb-radius-lg);
			box-shadow: var(--yweb-shadow);
			cursor: pointer;
			transition: var(--yweb-transition);
			text-decoration: none;
			/* Kachel-Titel neutral: Picos Anchor-Blau auf <a>-Karten aufheben */
			--pico-color: inherit;
			color: var(--pico-color);
			border: 1px solid transparent;
		}

		.yweb-tool-card:hover {
			box-shadow: var(--yweb-shadow-hover);
			border-color: var(--yweb-accent);
			color: var(--yweb-accent);
			transform: translateY(-2px);
		}

		.yweb-tool-card:active {
			transform: scale(0.97);
		}

		.yweb-tool-card svg {
			width: 36px;
			height: 36px;
			color: var(--yweb-accent);
		}

		.yweb-tool-card span {
			font-size: 0.9rem;
			font-weight: 600;
		}

		.yweb-tool-card small {
			font-size: 0.7rem;
			color: var(--pico-muted-color);
			text-align: center;
		}

		[data-theme="light"] .yweb-tool-card {
			border: 1px solid var(--yweb-border-subtle);
		}

		[data-theme="light"] .yweb-tool-card:hover {
			border-color: var(--yweb-accent);
		}
	</style>
</head>
<body>
	<div class="yweb-header-wrapper" data-page="tools"></div>
	<div class="yweb-header-spacer"></div>

	<main>
		<div class="yweb-tools-grid">
			<a href="/cmd.yhtm" class="yweb-tool-card">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/>
				</svg>
				<span>Shell</span>
				<small>{=L:yw.tools.shell_sub=}</small>
			</a>

			<a href="/sysinfo.yhtm" class="yweb-tool-card">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/>
				</svg>
				<span>System Info</span>
				<small>{=L:yw.tools.sysinfo_sub=}</small>
			</a>

			<div class="yweb-tool-card" onclick="showBoxControl()">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="8" cy="12" r="2"/><line x1="14" y1="10" x2="18" y2="10"/><line x1="14" y1="14" x2="18" y2="14"/>
				</svg>
				<span>Boxcontrol</span>
				<small>{=L:yw.tools.boxcontrol_sub=}</small>
			</div>

			<a href="/bouquet-editor.yhtm" class="yweb-tool-card">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>
				</svg>
				<span>{=L:yw.tools.bqedit=}</span>
				<small>{=L:yw.tools.bqedit_sub=}</small>
			</a>

		</div>
	</main>

	<script src="/Y_Baselib.js"></script>
	<script src="/Y_Lang.yjs?v=14"></script>
	<script src="/yweb-header.js?v=42"></script>
	<script>
		// M5-Komponenten: 14px-Icons fuer die Dialog-Buttons (Optik wie
		// Settings-Panels); Ziffern-Buttons (1080/720/PAL) bleiben bewusst
		// ohne Icon
		function sIcon(p) { return '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' + p + '<\/svg>'; }
		var I_REFRESH = sIcon('<polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>');
		var I_ROTATE = sIcon('<polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>');
		var I_POWER = sIcon('<path d="M18.36 6.64a9 9 0 1 1-12.73 0"/><line x1="12" y1="2" x2="12" y2="12"/>');
		var I_REC = sIcon('<circle cx="12" cy="12" r="7"/>');
		var I_STOP = sIcon('<rect x="6" y="6" width="12" height="12" rx="1"/>');
		var I_LOCK = sIcon('<rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>');
		var I_UNLOCK = sIcon('<rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 9.9-1"/>');

		async function bcDo(label, endpoint, params) {
			try {
				await ywebApi(endpoint, params);
				ywebShowToast(label + ' {=L:yw.msg.executed=}');
			} catch (e) {
				ywebShowToast('{=L:yw.msg.error=}: ' + e.message, true);
			}
		}

		// Rueckfrage als yweb-Dialog statt nativem confirm(); der
		// Bestaetigen-Knopf wiederholt den Aktionsnamen (label)
		function bcAction(label, endpoint, params, confirmText) {
			if (confirmText) {
				ywebShowConfirm(label, confirmText, label, function() { return bcDo(label, endpoint, params); });
				return;
			}
			return bcDo(label, endpoint, params);
		}

		async function bcExec(label, args) {
			try {
				var out = (await ywebApi('exec', args, {raw: true})).trim();
				ywebShowToast(out || (label + ' {=L:yw.msg.executed=}'));
			} catch (e) {
				ywebShowToast(label + ' {=L:yw.msg.notavail=}: ' + e.message, true);
			}
		}

		async function showBoxControl() {
			var body =
				'<div class="yweb-form-section"><div class="yweb-form-section-title">Box</div>' +
				'<div class="yweb-form-row"><label>{=L:yw.bc.restart_gui=}</label><span class="yweb-row-actions">' +
				'<button type="button" class="yweb-btn" onclick="bcAction(\'{=L:yw.bc.restart_btn=}\', \'restart\', null, \'{=L:yw.bc.restart_confirm=}\')">' + I_REFRESH + '{=L:yw.bc.restart_btn=}</button></span></div>' +
				'<div class="yweb-form-row"><label>{=L:yw.bc.reboot=}</label><span class="yweb-row-actions">' +
				'<button type="button" class="yweb-btn danger" onclick="bcAction(\'Reboot\', \'reboot\', null, \'{=L:yw.bc.reboot_confirm=}\')">' + I_ROTATE + 'Reboot</button></span></div>' +
				'<div class="yweb-form-row"><label>{=L:yw.bc.shutdown=}</label><span class="yweb-row-actions">' +
				'<button type="button" class="yweb-btn danger" onclick="bcAction(\'Shutdown\', \'shutdown\', null, \'{=L:yw.bc.shutdown_confirm=}\')">' + I_POWER + '{=L:yw.bc.shutdown_btn=}</button></span></div></div>' +
				'<div class="yweb-form-section"><div class="yweb-form-section-title">{=L:yw.bc.recording=} <small id="bcRecState" style="color:var(--pico-muted-color)"></small></div>' +
				'<div class="yweb-form-row"><label>{=L:yw.bc.instant_rec=}</label><span class="yweb-row-actions">' +
				'<button type="button" class="yweb-btn" onclick="bcAction(\'{=L:yw.bc.recording=}-Start\', \'setmode\', {record: \'start\'})">' + I_REC + 'Start</button> ' +
				'<button type="button" class="yweb-btn" onclick="bcAction(\'{=L:yw.bc.recording=}-Stop\', \'setmode\', {record: \'stop\'})">' + I_STOP + 'Stop</button></span></div></div>' +
				'<div class="yweb-form-section"><div class="yweb-form-section-title">{=L:yw.tools.remote_sub=}</div>' +
				'<div class="yweb-form-row"><label>{=L:yw.bc.rc_at_box=}</label><span class="yweb-row-actions">' +
				'<button type="button" class="yweb-btn" onclick="bcAction(\'{=L:yw.bc.lock=}\', \'rc\', \'lock\')">' + I_LOCK + '{=L:yw.bc.lock=}</button> ' +
				'<button type="button" class="yweb-btn" onclick="bcAction(\'{=L:yw.bc.unlock=}\', \'rc\', \'unlock\')">' + I_UNLOCK + '{=L:yw.bc.unlock=}</button></span></div></div>' +
				'<div class="yweb-form-section"><div class="yweb-form-section-title">Zapit <small style="color:var(--pico-muted-color)">{=L:yw.bc.script_dep=}</small></div>' +
				'<div class="yweb-form-row"><label>{=L:yw.bc.resolution=}</label><span class="yweb-row-actions">' +
				'<button type="button" class="yweb-btn" onclick="bcExec(\'1080\', \'Y_Tools&resolution&1080\')">1080</button> ' +
				'<button type="button" class="yweb-btn" onclick="bcExec(\'720\', \'Y_Tools&resolution&720\')">720</button> ' +
				'<button type="button" class="yweb-btn" onclick="bcExec(\'PAL\', \'Y_Tools&resolution&pal\')">PAL</button></span></div>' +
				'<div class="yweb-form-row"><label>{=L:yw.bc.reload_channels=}</label><span class="yweb-row-actions">' +
				'<button type="button" class="yweb-btn" onclick="bcAction(\'{=L:yw.bc.reload=}\', \'reloadchannels\', null)">' + I_REFRESH + '{=L:yw.bc.reload=}</button></span></div>' +
				'<div class="yweb-form-row"><label>{=L:yw.bc.tuner_reset=}</label><span class="yweb-row-actions">' +
				'<button type="button" class="yweb-btn" onclick="bcExec(\'{=L:yw.bc.tuner_reset=}\', \'Y_Tools&reset_tuner\')">' + I_ROTATE + 'Reset</button></span></div></div>';
			ywebModal('bcModal', 'Boxcontrol', body);
			try {
				var st = await ywebApi('setmode', {status: ''});
				var el = document.getElementById('bcRecState');
				if (el) el.textContent = (st && st.recording) ? '\u2022 {=L:yw.bc.rec_running=}' : '\u2022 {=L:yw.bc.rec_none=}';
			} catch (e) {}
		}
	</script>
</body>
</html>
