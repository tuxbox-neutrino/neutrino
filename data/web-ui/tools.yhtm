<!DOCTYPE html>
<html lang="de" data-theme="dark">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Neutrino-Web-UI - {=L:yw.nav.tools=}</title>
	<link rel="icon" href="/favicon/favicon.ico">
	<script>
		// Apply the stored theme before first paint: webui-header.js runs
		// too late, and some pages never load it at all.
		try { document.documentElement.setAttribute('data-theme', localStorage.getItem('webui-theme') || localStorage.getItem('yweb-theme') || 'dark'); } catch (e) {}
	</script>
	<link rel="stylesheet" href="/css/pico.min.css">
	<link rel="stylesheet" href="/css/webui.css?v=89">
	<style>
		.webui-tools-grid {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
			gap: 1rem;
			padding: 1.5rem;
			max-width: 800px;
			margin: 0 auto;
		}

		/* Desktop: fixed-width tiles, centered rows. Stays clean for any
		   card count (incl. async-injected extension tiles) without the
		   12-track JS balancer, which left spare tracks whenever the
		   per-row count did not divide 12 (e.g. 5 cards). Below the
		   breakpoint the auto-fill layout stays untouched. */
		@media (min-width: 1101px) {
			.webui-tools-grid {
				grid-template-columns: repeat(auto-fit, minmax(240px, 300px));
				justify-content: center;
				max-width: none;
			}
		}

		.webui-tool-card {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 0.75rem;
			padding: 1.5rem 1rem;
			background: var(--pico-card-background-color);
			border-radius: var(--webui-radius-lg);
			box-shadow: var(--webui-shadow);
			cursor: pointer;
			transition: var(--webui-transition);
			text-decoration: none;
			/* Kachel-Titel neutral: Picos Anchor-Blau auf <a>-Karten aufheben */
			--pico-color: inherit;
			color: var(--pico-color);
			border: 1px solid transparent;
		}

		.webui-tool-card:hover {
			box-shadow: var(--webui-shadow-hover);
			border-color: var(--webui-accent);
			color: var(--webui-accent);
			transform: translateY(-2px);
		}

		.webui-tool-card:active {
			transform: scale(0.97);
		}

		.webui-tool-card svg {
			width: 36px;
			height: 36px;
			color: var(--webui-accent);
		}

		.webui-tool-card span {
			font-size: 0.9rem;
			font-weight: 600;
		}

		.webui-tool-card small {
			font-size: 0.7rem;
			color: var(--pico-muted-color);
			text-align: center;
		}

		/* hidden has to win against the card's own display */
		.webui-tool-card[hidden] {
			display: none;
		}

		[data-theme="light"] .webui-tool-card {
			border: 1px solid var(--webui-border-subtle);
		}

		[data-theme="light"] .webui-tool-card:hover {
			border-color: var(--webui-accent);
		}
	</style>
</head>
<body>
	<div class="webui-header-wrapper" data-page="tools"></div>
	<div class="webui-header-spacer"></div>

	<main>
		<div class="webui-tools-grid">
			<a href="/sysinfo.yhtm" class="webui-tool-card">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/>
				</svg>
				<span>System Info</span>
				<small>{=L:yw.tools.sysinfo_sub=}</small>
			</a>

			<div class="webui-tool-card" onclick="showBoxControl()">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="8" cy="12" r="2"/><line x1="14" y1="10" x2="18" y2="10"/><line x1="14" y1="14" x2="18" y2="14"/>
				</svg>
				<span>Boxcontrol</span>
				<small>{=L:yw.tools.boxcontrol_sub=}</small>
			</div>

			<a href="/bouquet-editor.yhtm" class="webui-tool-card">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>
				</svg>
				<span>{=L:yw.tools.bqedit=}</span>
				<small>{=L:yw.tools.bqedit_sub=}</small>
			</a>

			<!-- only where the optional Swagger UI package is installed -->
			<a href="/swagger/" class="webui-tool-card" id="toolApiRef" hidden>
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
				</svg>
				<span>{=L:yw.tools.apiref=}</span>
				<small>{=L:yw.tools.apiref_sub=}</small>
			</a>

		</div>
	</main>

	<script src="/Y_Lang.yjs?v=27"></script>
	<script src="/js/webui-header.js?v=61"></script>
	<script src="/js/webui-dom.js?v=1"></script>
	<script src="/js/webui-v1.js?v=14"></script>
	<script>
		// M5-Komponenten: 14px-Icons fuer die Dialog-Buttons (Optik wie
		// Settings-Panels)
		function sIcon(p) { return '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' + p + '<\/svg>'; }
		var I_REFRESH = sIcon('<polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>');
		var I_ROTATE = sIcon('<polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>');
		var I_POWER = sIcon('<path d="M18.36 6.64a9 9 0 1 1-12.73 0"/><line x1="12" y1="2" x2="12" y2="12"/>');
		var I_REC = sIcon('<circle cx="12" cy="12" r="7"/>');
		var I_STOP = sIcon('<rect x="6" y="6" width="12" height="12" rx="1"/>');
		var I_LOCK = sIcon('<rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>');
		var I_UNLOCK = sIcon('<rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 9.9-1"/>');

		// A box action over /api/v1 ('POST /system/reboot')
		async function bcDo(label, endpoint, params) {
			try {
				var m = /^(POST|PUT) (\/.*)$/.exec(endpoint);
				await webuiV1(m[1], m[2], params ? {body: params} : {});
				webuiShowToast(label + ' {=L:yw.msg.executed=}');
			} catch (e) {
				webuiShowToast('{=L:yw.msg.error=}: ' + e.message, true);
			}
		}

		// Rueckfrage als webui-Dialog statt nativem confirm(); der
		// Bestaetigen-Knopf wiederholt den Aktionsnamen (label)
		function bcAction(label, endpoint, params, confirmText) {
			if (confirmText) {
				webuiShowConfirm(label, confirmText, label, function() { return bcDo(label, endpoint, params); });
				return;
			}
			return bcDo(label, endpoint, params);
		}

		// The API reference needs the Swagger UI package, which an image
		// carries only where its flash has room for it
		(async function() {
			try {
				var r = await fetch('/swagger/vendor/swagger-ui-bundle.js', {method: 'HEAD', credentials: 'same-origin'});
				if (r.ok) document.getElementById('toolApiRef').hidden = false;
			} catch (e) {}
		})();

		async function showBoxControl() {
			var body =
				'<div class="webui-form-section"><div class="webui-form-section-title">Box</div>' +
				'<div class="webui-form-row"><label>{=L:yw.bc.restart_gui=}</label><span class="webui-row-actions">' +
				'<button type="button" class="webui-btn" onclick="bcAction(\'{=L:yw.bc.restart_btn=}\', \'POST /system/restart\', null, \'{=L:yw.bc.restart_confirm=}\')">' + I_REFRESH + '{=L:yw.bc.restart_btn=}</button></span></div>' +
				'<div class="webui-form-row"><label>{=L:yw.bc.reboot=}</label><span class="webui-row-actions">' +
				'<button type="button" class="webui-btn danger" onclick="bcAction(\'Reboot\', \'POST /system/reboot\', null, \'{=L:yw.bc.reboot_confirm=}\')">' + I_ROTATE + 'Reboot</button></span></div>' +
				'<div class="webui-form-row"><label>{=L:yw.bc.shutdown=}</label><span class="webui-row-actions">' +
				'<button type="button" class="webui-btn danger" onclick="bcAction(\'Shutdown\', \'POST /system/shutdown\', null, \'{=L:yw.bc.shutdown_confirm=}\')">' + I_POWER + '{=L:yw.bc.shutdown_btn=}</button></span></div></div>' +
				'<div class="webui-form-section"><div class="webui-form-section-title">{=L:yw.bc.recording=} <small id="bcRecState" style="color:var(--pico-muted-color)"></small></div>' +
				'<div class="webui-form-row"><label>{=L:yw.bc.instant_rec=}</label><span class="webui-row-actions">' +
				'<button type="button" class="webui-btn" onclick="bcRecStart()">' + I_REC + 'Start</button> ' +
				'<button type="button" class="webui-btn" onclick="bcRecStop()">' + I_STOP + 'Stop</button></span></div></div>' +
				'<div class="webui-form-section" id="bcVideo" hidden><div class="webui-form-section-title">Video</div>' +
				'<div class="webui-form-row"><label for="bcVideoMode">{=L:yw.bc.resolution=}</label><span class="webui-row-actions">' +
				'<select id="bcVideoMode"></select> ' +
				'<button type="button" class="webui-btn" onclick="bcVideoApply()">{=L:yw.bqe.apply=}</button></span></div></div>' +
				'<div class="webui-form-section"><div class="webui-form-section-title">{=L:yw.tools.remote_sub=}</div>' +
				'<div class="webui-form-row"><label>{=L:yw.bc.rc_at_box=}</label><span class="webui-row-actions">' +
				'<button type="button" class="webui-btn" onclick="bcAction(\'{=L:yw.bc.lock=}\', \'PUT /osd/remote\', {locked: true})">' + I_LOCK + '{=L:yw.bc.lock=}</button> ' +
				'<button type="button" class="webui-btn" onclick="bcAction(\'{=L:yw.bc.unlock=}\', \'PUT /osd/remote\', {locked: false})">' + I_UNLOCK + '{=L:yw.bc.unlock=}</button></span></div></div>' +
				'<div class="webui-form-section"><div class="webui-form-section-title">Zapit</div>' +
				'<div class="webui-form-row"><label>{=L:yw.bc.reload_channels=}</label><span class="webui-row-actions">' +
				'<button type="button" class="webui-btn" onclick="bcAction(\'{=L:yw.bc.reload=}\', \'POST /channels/reload\', null)">' + I_REFRESH + '{=L:yw.bc.reload=}</button></span></div>' +
				'<div class="webui-form-row"><label>{=L:yw.bc.tuner_reset=}</label><span class="webui-row-actions">' +
				'<button type="button" class="webui-btn" onclick="bcAction(\'{=L:yw.bc.tuner_reset=}\', \'POST /tuner/reset\', null)">' + I_ROTATE + 'Reset</button></span></div></div>';
			webuiModal('bcModal', 'Boxcontrol', body);
			bcRecState();
			bcVideoLoad();
		}

		// What the box records besides its shift, after GET /api/v1/recordings
		async function bcRecState() {
			var el = document.getElementById('bcRecState');
			try {
				var r = await webuiV1('GET', '/recordings');
				var on = ((r && r.items) || []).some(function(it) { return !it.timeshift; });
				if (el) el.textContent = on ? '\u2022 {=L:yw.bc.rec_running=}' : '\u2022 {=L:yw.bc.rec_none=}';
			} catch (e) {
				if (el) el.textContent = '';
			}
		}

		// The record key's recording: of the channel the box shows, after asking
		// whether a box in standby is to be switched on for it. The box begins it
		// after the answer, so the state is read again a moment later.
		async function bcRecStart() {
			try {
				var ok = await webuiV1Lifting('/recordings', {}, {
					title: '{=L:yw.bc.instant_rec=}',
					ok: 'Start',
					stop: '',
					wake: '{=L:yw.bc.rec_wake=}'
				});
				if (!ok) return;
				webuiShowToast('{=L:yw.bc.recording=}-Start {=L:yw.msg.executed=}');
				setTimeout(bcRecState, 1500);
			} catch (e) {
				webuiShowToast(e.code === 'recording-running' ? '{=L:yw.bc.rec_already=}' :
					'{=L:yw.msg.error=}: ' + e.message, true);
			}
		}

		// Ends the recording of the channel the box shows, else the first that
		// is not its shift, as the old stop did
		async function bcRecStop() {
			var id = null;
			try {
				var lists = await Promise.all([webuiV1('GET', '/recordings'), webuiV1('GET', '/channels/current')]);
				var live = lists[1] && lists[1].id ? webuiLegacyChannelId(lists[1].id) : '';
				var mine = ((lists[0] && lists[0].items) || []).find(function(it) {
					return !it.timeshift && webuiLegacyChannelId(it.channel_id) === live;
				});
				if (mine) id = mine.id;
			} catch (e) {}
			await webuiStopRecording(id);
			bcRecState();
		}

		// The video modes this box offers, from its settings schema, with the one
		// it uses selected; the row stays hidden on a box that offers none
		var bcVideoSection = null;
		async function bcVideoLoad() {
			try {
				var schema = await webuiV1('GET', '/settings/schema');
				var item = ((schema && schema.items) || []).find(function(it) { return it.id === 'video_Mode'; });
				if (!item || !(item.values && item.values.length)) return;
				var now = await webuiV1('GET', '/settings/' + encodeURIComponent(item.section));
				var cur = ((now && now.items) || []).find(function(it) { return it.id === 'video_Mode'; });
				var sel = document.getElementById('bcVideoMode');
				if (!sel) return;
				sel.replaceChildren();
				item.values.forEach(function(c) {
					sel.appendChild(webuiEl('option', {value: String(c.value)}, c.label || String(c.value)));
				});
				if (cur) sel.value = String(cur.value);
				bcVideoSection = item.section;
				document.getElementById('bcVideo').hidden = false;
			} catch (e) {}
		}

		// The box switches to the chosen mode when the setting is written
		async function bcVideoApply() {
			var sel = document.getElementById('bcVideoMode');
			if (!sel || !bcVideoSection) return;
			var label = sel.options[sel.selectedIndex] ? sel.options[sel.selectedIndex].text : sel.value;
			try {
				var answer = await webuiV1('PATCH', '/settings/' + encodeURIComponent(bcVideoSection), {body: {video_Mode: sel.value}});
				var r = answer && answer.results && answer.results.video_Mode;
				if (r && r.status >= 300)
					throw new Error(r.detail || r.code || String(r.status));
				webuiShowToast('{=L:yw.bc.resolution=}: ' + label);
			} catch (e) {
				webuiShowToast('{=L:yw.msg.error=}: ' + e.message, true);
			}
		}
	</script>
</body>
</html>
