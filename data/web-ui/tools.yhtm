<!DOCTYPE html>
<html lang="de" data-theme="dark">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>yWeb - {=L:yw.nav.tools=}</title>
	<link rel="icon" href="/favicon/favicon.ico">
	<link rel="stylesheet" href="/css/pico.min.css">
	<link rel="stylesheet" href="/css/yweb.css?v=63">
	<style>
		.yweb-tools-grid {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
			gap: 1rem;
			padding: 1.5rem;
			max-width: 800px;
			margin: 0 auto;
		}

		.yweb-tool-card {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 0.75rem;
			padding: 1.5rem 1rem;
			background: var(--pico-card-background-color);
			border-radius: var(--yweb-radius-lg);
			box-shadow: var(--yweb-shadow);
			cursor: pointer;
			transition: var(--yweb-transition);
			text-decoration: none;
			/* Kachel-Titel neutral: Picos Anchor-Blau auf <a>-Karten aufheben */
			--pico-color: inherit;
			color: var(--pico-color);
			border: 1px solid transparent;
		}

		.yweb-tool-card:hover {
			box-shadow: var(--yweb-shadow-hover);
			border-color: var(--yweb-accent);
			color: var(--yweb-accent);
			transform: translateY(-2px);
		}

		.yweb-tool-card:active {
			transform: scale(0.97);
		}

		.yweb-tool-card svg {
			width: 36px;
			height: 36px;
			color: var(--yweb-accent);
		}

		.yweb-tool-card span {
			font-size: 0.9rem;
			font-weight: 600;
		}

		.yweb-tool-card small {
			font-size: 0.7rem;
			color: var(--pico-muted-color);
			text-align: center;
		}

		[data-theme="light"] .yweb-tool-card {
			border: 1px solid var(--yweb-border-subtle);
		}

		[data-theme="light"] .yweb-tool-card:hover {
			border-color: var(--yweb-accent);
		}
	</style>
</head>
<body>
	<div class="yweb-header-wrapper" data-page="tools"></div>
	<div class="yweb-header-spacer"></div>

	<main>
		<div class="yweb-tools-grid">
			<a href="/screenshot.yhtm" class="yweb-tool-card">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
					<circle cx="12" cy="13" r="3"/>
				</svg>
				<span>Screenshot</span>
				<small>{=L:yw.tools.screenshot_sub=}</small>
			</a>

			<a href="/files.yhtm" class="yweb-tool-card">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
				</svg>
				<span>{=L:yw.tools.files=}</span>
				<small>{=L:yw.tools.files_sub=}</small>
			</a>

			<div class="yweb-tool-card" onclick="ywebShowRemote()">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<rect x="7" y="2" width="10" height="20" rx="2"/>
					<circle cx="12" cy="18" r="1"/>
				</svg>
				<span>Remote</span>
				<small>{=L:yw.tools.remote_sub=}</small>
			</div>

			<div class="yweb-tool-card" onclick="ywebShowMessageDialog()">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
				</svg>
				<span>{=L:yw.tools.message=}</span>
				<small>{=L:yw.tools.message_sub=}</small>
			</div>

			<a href="/cmd.yhtm" class="yweb-tool-card">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/>
				</svg>
				<span>Shell</span>
				<small>{=L:yw.tools.shell_sub=}</small>
			</a>

			<a href="/sysinfo.yhtm" class="yweb-tool-card">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/>
				</svg>
				<span>System Info</span>
				<small>{=L:yw.tools.sysinfo_sub=}</small>
			</a>

			<a href="/settings.yhtm" class="yweb-tool-card">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
				</svg>
				<span>{=L:yw.nav.settings=}</span>
				<small>{=L:yw.tools.settings_sub=}</small>
			</a>

			<div class="yweb-tool-card" onclick="showBoxControl()">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="8" cy="12" r="2"/><line x1="14" y1="10" x2="18" y2="10"/><line x1="14" y1="14" x2="18" y2="14"/>
				</svg>
				<span>Boxcontrol</span>
				<small>{=L:yw.tools.boxcontrol_sub=}</small>
			</div>

			<div class="yweb-tool-card" onclick="showInstaller()">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
				</svg>
				<span>Installer</span>
				<small>{=L:yw.tools.installer_sub=}</small>
			</div>

			<a href="/bouquet-editor.yhtm" class="yweb-tool-card">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>
				</svg>
				<span>{=L:yw.tools.bqedit=}</span>
				<small>{=L:yw.tools.bqedit_sub=}</small>
			</a>

			<a href="/m3u-convert.yhtm" class="yweb-tool-card">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<polyline points="16 3 21 3 21 8"/><line x1="4" y1="20" x2="21" y2="3"/><polyline points="21 16 21 21 16 21"/><line x1="15" y1="15" x2="21" y2="21"/><line x1="4" y1="4" x2="9" y2="9"/>
				</svg>
				<span>{=L:yw.tools.m3u=}</span>
				<small>{=L:yw.tools.m3u_sub=}</small>
			</a>

			<div class="yweb-tool-card" onclick="sendStandby()">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M18.36 6.64a9 9 0 11-12.73 0"/>
					<line x1="12" y1="2" x2="12" y2="12"/>
				</svg>
				<span>Standby</span>
				<small>{=L:yw.tools.standby_sub=}</small>
			</div>

		</div>
	</main>

	<script src="/Y_Baselib.js"></script>
	<script src="/Y_Lang.yjs?v=5"></script>
	<script src="/yweb-header.js?v=37"></script>
	<script>
		async function bcAction(label, endpoint, params, confirmText) {
			if (confirmText && !confirm(confirmText)) return;
			try {
				await ywebApi(endpoint, params);
				ywebShowToast(label + ' {=L:yw.msg.executed=}');
			} catch (e) {
				ywebShowToast('{=L:yw.msg.error=}: ' + e.message, true);
			}
		}

		async function bcExec(label, args) {
			try {
				var out = (await ywebApi('exec', args, {raw: true})).trim();
				ywebShowToast(out || (label + ' {=L:yw.msg.executed=}'));
			} catch (e) {
				ywebShowToast(label + ' {=L:yw.msg.notavail=}: ' + e.message, true);
			}
		}

		async function showBoxControl() {
			var body =
				'<div class="yweb-form-section"><div class="yweb-form-section-title">Box</div>' +
				'<div class="yweb-form-row"><label>{=L:yw.bc.restart_gui=}</label><button type="button" class="yweb-btn" onclick="bcAction(\'{=L:yw.bc.restart_btn=}\', \'restart\', null, \'{=L:yw.bc.restart_confirm=}\')">{=L:yw.bc.restart_btn=}</button></div>' +
				'<div class="yweb-form-row"><label>{=L:yw.bc.reboot=}</label><button type="button" class="yweb-btn" onclick="bcAction(\'Reboot\', \'reboot\', null, \'{=L:yw.bc.reboot_confirm=}\')">Reboot</button></div>' +
				'<div class="yweb-form-row"><label>{=L:yw.bc.shutdown=}</label><button type="button" class="yweb-btn" onclick="bcAction(\'Shutdown\', \'shutdown\', null, \'{=L:yw.bc.shutdown_confirm=}\')">{=L:yw.bc.shutdown_btn=}</button></div></div>' +
				'<div class="yweb-form-section"><div class="yweb-form-section-title">{=L:yw.bc.recording=} <small id="bcRecState" style="color:var(--pico-muted-color)"></small></div>' +
				'<div class="yweb-form-row"><label>{=L:yw.bc.instant_rec=}</label><span>' +
				'<button type="button" class="yweb-btn" onclick="bcAction(\'{=L:yw.bc.recording=}-Start\', \'setmode\', {record: \'start\'})">Start</button> ' +
				'<button type="button" class="yweb-btn" onclick="bcAction(\'{=L:yw.bc.recording=}-Stop\', \'setmode\', {record: \'stop\'})">Stop</button></span></div></div>' +
				'<div class="yweb-form-section"><div class="yweb-form-section-title">{=L:yw.tools.remote_sub=}</div>' +
				'<div class="yweb-form-row"><label>{=L:yw.bc.rc_at_box=}</label><span>' +
				'<button type="button" class="yweb-btn" onclick="bcAction(\'{=L:yw.bc.lock=}\', \'rc\', \'lock\')">{=L:yw.bc.lock=}</button> ' +
				'<button type="button" class="yweb-btn" onclick="bcAction(\'{=L:yw.bc.unlock=}\', \'rc\', \'unlock\')">{=L:yw.bc.unlock=}</button></span></div></div>' +
				'<div class="yweb-form-section"><div class="yweb-form-section-title">Zapit <small style="color:var(--pico-muted-color)">{=L:yw.bc.script_dep=}</small></div>' +
				'<div class="yweb-form-row"><label>{=L:yw.bc.resolution=}</label><span>' +
				'<button type="button" class="yweb-btn" onclick="bcExec(\'1080\', \'Y_Tools&resolution&1080\')">1080</button> ' +
				'<button type="button" class="yweb-btn" onclick="bcExec(\'720\', \'Y_Tools&resolution&720\')">720</button> ' +
				'<button type="button" class="yweb-btn" onclick="bcExec(\'PAL\', \'Y_Tools&resolution&pal\')">PAL</button></span></div>' +
				'<div class="yweb-form-row"><label>{=L:yw.bc.reload_channels=}</label><button type="button" class="yweb-btn" onclick="bcAction(\'{=L:yw.bc.reload=}\', \'reloadchannels\', null)">{=L:yw.bc.reload=}</button></div>' +
				'<div class="yweb-form-row"><label>{=L:yw.bc.tuner_reset=}</label><button type="button" class="yweb-btn" onclick="bcExec(\'{=L:yw.bc.tuner_reset=}\', \'Y_Tools&reset_tuner\')">Reset</button></div></div>';
			ywebModal('bcModal', 'Boxcontrol', body);
			try {
				var st = await ywebApi('setmode', {status: ''});
				var el = document.getElementById('bcRecState');
				if (el) el.textContent = (st && st.recording) ? '\u2022 {=L:yw.bc.rec_running=}' : '\u2022 {=L:yw.bc.rec_none=}';
			} catch (e) {}
		}

		function showInstaller() {
			var body =
				'<div class="yweb-form-row"><label>{=L:yw.inst.file=}</label><span>' +
				'<input type="file" id="instFile" style="max-width:220px"> ' +
				'<button type="button" class="yweb-btn" onclick="doInstall(this)">{=L:yw.inst.install=}</button></span></div>' +
				'<pre id="instOut" style="max-height:220px;overflow:auto;background:var(--pico-card-sectioning-background-color);padding:0.5rem;border-radius:4px">\u00a0</pre>';
			ywebModal('instModal', '{=L:yw.inst.title=}', body);
		}

		async function doInstall(btn) {
			var inp = document.getElementById('instFile');
			var out = document.getElementById('instOut');
			if (!inp || !inp.files || !inp.files.length) { ywebShowToast('{=L:yw.inst.nofile=}', true); return; }
			btn.disabled = true;
			out.textContent = '{=L:yw.inst.uploading=}\u2026';
			try {
				var f = inp.files[0];
				var fd = new FormData();
				fd.append('file', f);
				var up = await fetch('/api/v4/file?action=upload&path=/tmp', {method: 'POST', body: fd});
				if (!up.ok) throw new Error('{=L:yw.inst.upfail=}');
				out.textContent = '{=L:yw.inst.installing=}\u2026';
				var res = (await ywebApi('exec', 'Y_Tools&installer&' + encodeURIComponent('/tmp/' + f.name), {raw: true})).trim();
				out.textContent = res || '{=L:yw.inst.noout=}';
			} catch (e) {
				out.textContent = '{=L:yw.msg.error=}: ' + e.message;
			}
			btn.disabled = false;
		}

		async function sendStandby() {
			try {
				var st = await ywebApi('standby', {status: ''});
				var inStandby = !!(st && st.standby === true);
				if (!inStandby && !confirm('{=L:yw.sb.confirm=}')) return;
				await ywebApi('standby', inStandby ? 'off' : 'on');
				ywebShowToast(inStandby ? '{=L:yw.sb.wake=}' : '{=L:yw.sb.sleep=}');
			} catch (e) {
				ywebShowToast('{=L:yw.sb.fail=}: ' + e.message, true);
			}
		}
	</script>
</body>
</html>
