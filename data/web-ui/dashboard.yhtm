				</div>
				<footer class="yweb-card-footer yweb-channel-footer">
					<div class="yweb-channel-actions">
						<a href="/timer.html" class="yweb-action-btn" title="{=L:yw.dash.all_timers=}">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<circle cx="12" cy="12" r="9"/><path d="M12 6v6l4 2"/>
							</svg>
							<span>{=L:yw.dash.timer_list=}</span>
						</a>
					</div>
				</footer>
			</article>

			<!-- Tuner Status -->
			<article class="yweb-card" id="card-tuner">
				<header class="yweb-card-header" onclick="toggleCard('card-tuner')">
					<h3 class="yweb-card-title">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0"/>
						</svg>
						Tuner
					</h3>
					<span id="tuner-preview" class="yweb-card-preview">--</span>
					<div class="yweb-tuner-icon" id="tuner-status-icon">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0"/>
						</svg>
					</div>
				</header>
				<div class="yweb-card-body">
					<div class="yweb-tuner-list" id="tuner-list">
						<!-- Tuners will be dynamically inserted here -->
					</div>
				</div>
			</article>

			<!-- Stream Info -->
			<article class="yweb-card" id="card-stream">
				<header class="yweb-card-header" onclick="toggleCard('card-stream')">
					<h3 class="yweb-card-title">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z"/>
						</svg>
						Stream Info
					</h3>
					<span id="stream-preview" class="yweb-card-preview">--</span>
				</header>
				<div class="yweb-card-body">
					<div class="yweb-stream-info">
						<div class="yweb-stream-item">
							<span class="yweb-stream-label">{=L:yw.bc.resolution=}</span>
							<span class="yweb-stream-value" id="stream-resolution">--</span>
						</div>
						<div class="yweb-stream-item">
							<span class="yweb-stream-label">Format</span>
							<span class="yweb-stream-value" id="stream-aspect">--</span>
						</div>
						<div class="yweb-stream-item">
							<span class="yweb-stream-label">Framerate</span>
							<span class="yweb-stream-value" id="stream-fps">--</span>
						</div>
						<div class="yweb-stream-item">
							<span class="yweb-stream-label">Audio</span>
							<span class="yweb-stream-value" id="stream-audio">--</span>
						</div>
						<div class="yweb-pids" id="stream-pids">
							<!-- PIDs werden dynamisch geladen -->
						</div>
					</div>
				</div>
			</article>
		</div>
		<!-- Mobile Card Indicator -->
		<div class="yweb-card-indicator" id="card-indicator"></div>
	</main>

	<footer class="yweb-footer">
		yWeb <span id="yweb-version">--</span> ·
		<a href="#" onclick="ywebShowAbout(); return false;">Über</a> ·
		<span id="yweb-footer-copyright">Copyright © Tuxbox Project</span>
	</footer>

	<script src="/jquery/jquery.min.js"></script>
	<script src="/Y_Lang.yjs?v=1"></script>
	<script src="/yweb-header.js?v=34"></script>
	<script>
	// Current channel tracking for EPG info
	let currentChannelId = null;
	let currentChannelName = null;

	// Show EPG info for current channel
	function showCurrentEpgInfo() {
		if (currentChannelId && currentChannelName) {
			ywebShowEpgModal(currentChannelId, currentChannelName);
		}
	}

	// API Helpers — all requests go to /api/v4/ (always JSON for json
	// endpoints; bare zapto keeps its raw channel id output)
	function apiGet(endpoint) {
		return $.get('/api/v4/' + endpoint).catch(function() { return ''; });
	}

	function apiJson(endpoint) {
		return $.getJSON('/api/v4/' + endpoint).catch(function() { return {}; });
	}

	// Format helpers — use shared versions from yweb-header.js
	var formatKB = ywebFormatKB;
	var formatUptime = ywebFormatUptime;

	// Update gauge - circumference = 2 * PI * 16 = 100.5
	function updateGauge(id, percent, colorClass) {
		const circumference = 100.5;
		const offset = circumference - (percent / 100 * circumference);
		const gauge = document.getElementById(id);
		if (gauge) {
			gauge.setAttribute('stroke-dashoffset', offset);
			gauge.classList.remove('ok', 'warning', 'danger');
			if (colorClass) {
				gauge.classList.add(colorClass);
			} else {
				// Default: percentage-based coloring
				if (percent >= 90) gauge.classList.add('danger');
				else if (percent >= 70) gauge.classList.add('warning');
				else gauge.classList.add('ok');
			}
		}
	}

	// Get color class for CPU load (not percentage-based)
	function getCpuColorClass(load) {
		if (load >= 4.0) return 'danger';   // Very high load
		if (load >= 2.0) return 'warning';  // Moderate load
		return 'ok';                         // Normal
	}

	// Load Channel Info
	function loadChannelInfo() {
		apiJson('channel').done(function(data) {
			if (data.success === 'true' && data.data && data.data.channel && data.data.channel[0]) {
				var ch = data.data.channel[0];
				var channelName = ch.name || 'Unbekannt';
				var channelId = ch.id;
				// Store for EPG info button
				currentChannelId = channelId;
				currentChannelName = channelName;
				$('#current-channel').text(channelName);
				$('#channel-preview').text(channelName);
				loadEpgForChannel(channelId);
			} else {
				currentChannelId = null;
				currentChannelName = null;
				$('#current-channel').text('Kein Sender');
				$('#channel-preview').text('Kein Sender');
			}
		}).fail(function() {
			currentChannelId = null;
			currentChannelName = null;
			$('#current-channel').text('Kein Sender');
			$('#channel-preview').text('Kein Sender');
		});
	}

	function loadEpgForChannel(channelId) {
		if (!channelId) return;
		apiJson('epg?channelid=' + channelId + '&details=true').done(function(resp) {
			var now = Math.floor(Date.now() / 1000);
			var progs = (resp && resp.data && resp.data.epglist && resp.data.epglist.progData) || [];
			var foundCurrent = false, foundNext = false;

			for (var i = 0; i < progs.length; i++) {
				var startSec = parseInt(progs[i].start_sec) || 0;
				var stopSec = parseInt(progs[i].stop_sec) || 0;
				var desc = progs[i].description || '--';
				var startT = progs[i].start_t || '--:--';

				if (!foundCurrent && now >= startSec && now < stopSec) {
					foundCurrent = true;
					$('#current-epg').text(desc);
					var duration = stopSec - startSec;
					var elapsed = now - startSec;
					var pct = Math.min(100, Math.max(0, Math.round(100 * elapsed / duration)));
					$('#epg-progress').val(pct);
					var sd = new Date(startSec * 1000), ed = new Date(stopSec * 1000);
					$('#epg-start').text(ywebFormatTime(sd));
					$('#epg-end').text(ywebFormatTime(ed));
				} else if (foundCurrent && !foundNext && startSec >= now) {
					foundNext = true;
					$('#next-epg').text(startT + ' ' + desc);
					break;
				}
			}

			if (!foundCurrent) $('#current-epg').text('{=L:yw.dash.no_epg=}');
			if (!foundNext) $('#next-epg').text('--');
		}).fail(function() {
			$('#current-epg').text('--');
		});
	}

	// Load System Info
	function loadSystemInfo() {
		apiJson('sysinfo').done(function(data) {
			if (!data) return;

			// Uptime
			$('#sys-uptime').text(formatUptime(data.uptime || 0));

			// Temperature
			if (data.temperature !== null && data.temperature !== undefined) {
				$('#temp-value').text(data.temperature + '°C')
					.toggleClass('hot', data.temperature >= 70);
			} else {
				$('#sys-temp').hide();
			}

			// CPU - show real CPU usage percentage
			if (data.cpu && data.cpu.percent !== undefined) {
				const pct = data.cpu.percent;
				$('#cpu-percent').text(pct + '%');
				$('#cpu-load').text(data.cpu.cores + ' Kerne');
				updateGauge('gauge-cpu', pct);
			} else if (data.load && data.load.length >= 1) {
				// Fallback to load average if cpu.percent not available
				const load1 = data.load[0];
				const gaugeFill = Math.min(100, Math.round(load1 * 12.5));
				$('#cpu-percent').text(load1.toFixed(2));
				$('#cpu-load').text('1m Load');
				updateGauge('gauge-cpu', gaugeFill, getCpuColorClass(load1));
			}

			// Memory - show used/total
			if (data.memory) {
				const pct = data.memory.percent || 0;
				$('#ram-percent').text(pct + '%');
				$('#ram-info').text(formatKB(data.memory.used) + '/' + formatKB(data.memory.total));
				updateGauge('gauge-ram', pct);
			}

			// Disk - show free/total
			if (data.disk) {
				const pct = data.disk.percent || 0;
				$('#disk-percent').text(pct + '%');
				$('#disk-info').text(formatKB(data.disk.free) + ' frei');
				updateGauge('gauge-disk', pct);
			}

			// System preview for collapsed mobile view
			let sysPreviewParts = [];
			if (data.temperature !== null && data.temperature !== undefined) {
				sysPreviewParts.push(data.temperature + '°C');
			}
			if (data.cpu && data.cpu.percent !== undefined) {
				sysPreviewParts.push('CPU ' + data.cpu.percent + '%');
			}
			if (data.memory && data.memory.percent !== undefined) {
				sysPreviewParts.push('RAM ' + data.memory.percent + '%');
			}
			$('#system-preview').text(sysPreviewParts.join(' · ') || '--');

			// Box name from hostname (sysinfo gives real hostname)
			if (data.box && data.box.name) {
				$('#sys-box').text(data.box.name);
			} else {
				$('#sys-box').text(data.hostname);
			}

			// Kernel - short version
			if (data.kernel) {
				const k = data.kernel.split(' ')[0] || data.kernel;
				$('#sys-kernel').text(k);
			}

			// Hostname in network card header
			if (data.hostname) {
				$('#net-hostname').text(data.hostname);
			}

			// Network interfaces - filter to show only relevant ones
			if (data.interfaces && data.interfaces.length > 0) {
				let html = '';
				// Filter: only interfaces with IP or physical interfaces
				const relevant = data.interfaces.filter(function(iface) {
					// Skip veth (docker), br- without IP
					if (iface.name.startsWith('veth')) return false;
					if (iface.name.startsWith('br-') && !iface.ip) return false;
					return true;
				}).slice(0, 6); // Max 6

				// Network preview - show primary IP
				const primaryNet = relevant.find(function(i) {
					return i.ip && /^(eth|en)/.test(i.name);
				}) || relevant.find(function(i) { return i.ip; });
				if (primaryNet && primaryNet.ip) {
					$('#network-preview').text(primaryNet.ip);
				}

				relevant.forEach(function(iface) {
					const isWlan = /^(wlan|wl)/.test(iface.name);
					const icon = isWlan ?
						'<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0"/></svg>' :
						'<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2"/></svg>';
					const macStr = iface.mac ? iface.mac.toUpperCase() : '';

					html += '<div class="yweb-net-item">' +
						'<div class="yweb-net-icon">' + icon + '</div>' +
						'<div class="yweb-net-info">' +
							'<div class="yweb-net-name">' + iface.name + '</div>' +
							'<div class="yweb-net-ip">' + (iface.ip || 'keine IP') + '</div>' +
							(macStr ? '<div class="yweb-net-mac">' + macStr + '</div>' : '') +
						'</div>' +
						'<div class="yweb-net-status ' + (iface.up ? 'up' : '') + '"></div>' +
					'</div>';
				});
				$('#net-interfaces').html(html || '<div class="yweb-text-muted">Keine Interfaces</div>');
			}
		});

		// Software versions from API
		apiJson('versions').done(function(data) {
			if (data) {
				if (data.yweb) $('#yweb-version').text(data.yweb);
				if (data.api) $('#api-version').text(data.api);
				if (data.copyright && data.copyright.text)
					$('#yweb-footer-copyright').text(data.copyright.text);
			}
		});
	}

	// Recording check with details
	function checkRecording() {
		apiJson('setmode?status').done(function(data) {
			if (data && typeof data.recording !== 'undefined')
				handleRecordingStatus(data.recording);
		});
	}

	// Toggle recording from dashboard Rec button
	function toggleRecording() {
		const btn = document.getElementById('rec-btn');
		if (!btn) return;
		if (btn.classList.contains('recording')) {
			ywebStopRecording();
			btn.classList.remove('recording');
			btn.querySelector('span').textContent = 'Rec';
			btn.title = 'Aufnehmen';
			setTimeout(function() { checkRecording(); loadTimers(); }, 1500);
		} else {
			// Record current event on current channel
			ywebRecordEvent(currentChannelId, currentChannelName);
			// Refresh recording status + timer card after API has processed
			setTimeout(function() { checkRecording(); loadTimers(); }, 1500);
			setTimeout(function() { checkRecording(); loadTimers(); }, 4000);
		}
	}

	function handleRecordingStatus(isRecording) {
		$('#rec-indicator').toggleClass('yweb-hidden', !isRecording);
		$('#rec-info').toggleClass('yweb-hidden', !isRecording);

		// Update Rec/Stop button state
		const recBtn = document.getElementById('rec-btn');
		if (recBtn) {
			recBtn.classList.toggle('recording', !!isRecording);
			recBtn.querySelector('span').textContent = isRecording ? 'Stop' : 'Rec';
			recBtn.title = isRecording ? '{=L:yw.dash.record_stop=}' : '{=L:yw.dash.record=}';
		}

		if (isRecording) {
				// Fetch timer data to get recording details
				apiJson('timer').done(function(response) {
					const timers = ywebParseTimerList(response);
					if (timers.length === 0) return;

					// Find running recording (state == 2, type_number == 5 or 9)
					const running = timers.find(function(t) {
						const state = parseInt(t.state) || 0;
						const typeNum = parseInt(t.type_number) || 0;
						return state === 2 && (typeNum === 5 || typeNum === 9);
					});

					if (running) {
						const title = running.title || running.channel_name || '{=L:yw.bc.recording=}';
						const channel = running.channel_name || '';

						// Calculate remaining time from stop time
						const now = Math.floor(Date.now() / 1000);
						let remaining = '--:--';
						if (running.stop && Array.isArray(running.stop) && running.stop[0]) {
							const stopSec = parseInt(running.stop[0].digits) || 0;
							if (stopSec > now) {
								const remSec = stopSec - now;
								const remMin = Math.floor(remSec / 60);
								const remHr = Math.floor(remMin / 60);
								if (remHr > 0) {
									remaining = remHr + 'h ' + (remMin % 60) + 'm';
								} else {
									remaining = remMin + ' min';
								}
							}
						}

						$('#rec-title').text(title);
						$('#rec-channel').text(channel);
						$('#rec-remaining').text(remaining);
					}
			});
		}
	}

	// Standby: im Standby wecken, sonst (mit Rückfrage) schlafen legen
	async function sendStandby() {
		try {
			var st = await ywebApi('standby', {status: ''});
			var inStandby = !!(st && st.standby === true);
			if (!inStandby && !confirm('{=L:yw.sb.confirm=}')) return;
			await ywebApi('standby', inStandby ? 'off' : 'on');
			ywebShowToast(inStandby ? '{=L:yw.sb.wake=}' : '{=L:yw.sb.sleep=}');
		} catch (e) {
			ywebShowToast('{=L:yw.sb.fail=}: ' + e.message, true);
		}
	}

	// TV/Radio Mode
	var currentMode = 'tv';

	function switchMode() {
		const newMode = currentMode === 'tv' ? 'radio' : 'tv';

		// Disable button during switch
		$('#mode-switch-btn').prop('disabled', true).css('opacity', '0.6');

		// Send API request
		apiGet('setmode?' + newMode).done(function() {
			currentMode = newMode;
			updateModeUI();
			// Refresh data after mode switch
			setTimeout(function() {
				loadChannelInfo();
				loadStreamInfo();
				$('#mode-switch-btn').prop('disabled', false).css('opacity', '1');
			}, 1500);
		}).fail(function() {
			$('#mode-switch-btn').prop('disabled', false).css('opacity', '1');
		});
	}

	function updateModeUI() {
		const isRadio = currentMode === 'radio';

		// Update current mode display
		$('#mode-current-text').text(isRadio ? 'Radio' : 'TV');
		$('#mode-current-icon-tv').toggle(!isRadio);
		$('#mode-current-icon-radio').toggle(isRadio);

		// Update switch button text
		$('#mode-switch-text').text(isRadio ? '{=L:yw.dash.to_tv=}' : '{=L:yw.dash.to_radio=}');

		// Actions preview - show current mode
		$('#actions-preview').text(isRadio ? '{=L:yw.dash.radio_mode=}' : '{=L:yw.dash.tv_mode=}');

		// In radio mode: clear video-specific fields
		if (isRadio) {
			$('#stream-resolution').text('--').removeClass('hd sd');
			$('#stream-fps').text('--');
			$('#stream-preview').text('Radio');
		}
	}

	function loadCurrentMode() {
		apiJson('mode?channelsmode').done(function(data) {
			currentMode = (data && data.mode === 'radio') ? 'radio' : 'tv';
			updateModeUI();
		});
	}

	// Timer icons: use shared ywebGetTimerIconHtml() with dashboard-specific CSS class
	function getTimerIcon(type) {
		return ywebGetTimerIconHtml(type, 'yweb-timer-icon');
	}

	// Load Timer list
	function loadTimers() {
		apiJson('timer').done(function(response) {
			const container = $('#timer-list');
			const now = Math.floor(Date.now() / 1000);

			const timers = ywebParseTimerList(response);

			if (timers.length === 0) {
				container.html('<div class="yweb-timer-empty">{=L:yw.dash.no_timers=}</div>');
				$('#timer-preview').text('{=L:yw.dash.no_timers_short=}');
				return;
			}

			// Timer helpers: use shared yweb* functions from yweb-header.js
			const getAlarm = ywebGetTimerAlarm;
			const getTimerType = ywebGetTimerType;
			const getStopSec = ywebGetTimerStopSec;

			// Separate running recordings (state=2, type 5 or 9) from future timers
			const runningRecs = timers.filter(function(t) {
				const state = parseInt(t.state) || 0;
				const typeNum = parseInt(t.type_number) || 0;
				return state === 2 && (typeNum === 5 || typeNum === 9);
			});

			// Filter future scheduled timers (exclude running ones)
			const maxScheduled = 3 - runningRecs.length;
			const futureTimers = timers.filter(function(t) {
				const state = parseInt(t.state) || 0;
				if (state === 2) return false; // Skip running
				const alarm = getAlarm(t);
				const alarmSec = alarm.digits ? parseInt(alarm.digits) : 0;
				return alarmSec > now;
			}).sort(function(a, b) {
				const aTime = parseInt(getAlarm(a).digits) || 0;
				const bTime = parseInt(getAlarm(b).digits) || 0;
				return aTime - bTime;
			}).slice(0, Math.max(maxScheduled, 1));

			if (runningRecs.length === 0 && futureTimers.length === 0) {
				container.html('<div class="yweb-timer-empty">{=L:yw.dash.no_timers=}</div>');
				$('#timer-preview').text('{=L:yw.dash.no_timers_short=}');
				return;
			}

			// Timer preview
			if (runningRecs.length > 0) {
				$('#timer-preview').text('● {=L:yw.bc.rec_running=}');
			} else {
				const nextAlarm = getAlarm(futureTimers[0]);
				$('#timer-preview').text((nextAlarm.date || '') + ' ' + (nextAlarm.time || ''));
			}

			let html = '';

			// Running recordings first
			runningRecs.forEach(function(timer) {
				const title = timer.title || timer.channel_name || '{=L:yw.bc.recording=}';
				const channel = timer.channel_name || '';
				const stopSec = getStopSec(timer);
				let remaining = '';
				if (stopSec > now) {
					const remSec = stopSec - now;
					const remMin = Math.floor(remSec / 60);
					const remHr = Math.floor(remMin / 60);
					remaining = remHr > 0 ? remHr + 'h ' + (remMin % 60) + 'm' : remMin + ' min';
				}

				html += '<div class="yweb-timer-item running">' +
					'<div class="yweb-timer-icon record"><svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/></svg></div>' +
					'<div class="yweb-timer-info">' +
						'<div class="yweb-timer-title">' + title + '</div>' +
						(channel ? '<div class="yweb-timer-channel">' + channel + '</div>' : '') +
					'</div>' +
					(remaining ? '<div class="yweb-timer-remaining">' + remaining + '</div>' : '') +
				'</div>';
			});

			// Scheduled timers
			futureTimers.forEach(function(timer) {
				const type = getTimerType(timer);
				const title = timer.title || timer.channel_name || type;
				const channel = timer.channel_name || '';
				const alarm = getAlarm(timer);

				html += '<div class="yweb-timer-item">' +
					getTimerIcon(type) +
					'<div class="yweb-timer-info">' +
						'<div class="yweb-timer-title">' + title + '</div>' +
						(channel ? '<div class="yweb-timer-channel">' + channel + '</div>' : '') +
					'</div>' +
					'<div class="yweb-timer-time">' +
						'<div class="yweb-timer-date">' + (alarm.date || '--') + '</div>' +
						'<div class="yweb-timer-hour">' + (alarm.time || '--:--') + '</div>' +
					'</div>' +
				'</div>';
			});

			container.html(html);
		}).fail(function() {
			$('#timer-list').html('<div class="yweb-timer-empty">Timer nicht verfügbar</div>');
			$('#timer-preview').text('--');
		});
	}

	// Signal quality class based on percentage
	function getSignalQuality(percent) {
		if (percent >= 80) return 'excellent';
		if (percent >= 60) return 'good';
		if (percent >= 40) return 'moderate';
		if (percent >= 20) return 'poor';
		return 'bad';
	}

	// BER quality class (lower is better)
	function getBerQuality(ber) {
		if (ber === 0) return 'ok';
		if (ber < 100) return 'ok';
		if (ber < 1000) return 'warning';
		return 'error';
	}

	// Update signal bar
	function updateSignalBar(barId, valueId, percent) {
		const bar = document.getElementById(barId);
		const value = document.getElementById(valueId);
		const quality = getSignalQuality(percent);

		if (bar) {
			bar.style.width = percent + '%';
			bar.className = 'yweb-signal-bar ' + quality;
		}
		if (value) {
			value.textContent = percent + '%';
			value.className = 'yweb-signal-value ' + quality;
		}
	}

	// Load Tuner Status using Multi-Tuner API
	function loadTunerStatus() {
		// Try new multi-tuner API first
		apiJson('tuners').done(function(data) {
			if (data && data.tuners && data.tuners.length > 0) {
				renderTunerList(data.tuners);
			} else {
				// Fallback to legacy single-tuner API
				loadTunerStatusLegacy();
			}
		}).fail(function() {
			loadTunerStatusLegacy();
		});
	}

	// Render multi-tuner list
	function renderTunerList(tuners) {
		const container = document.getElementById('tuner-list');
		if (!container) return;

		let html = '';
		let activeTuners = 0;
		let totalSig = 0;
		let totalSnr = 0;

		tuners.forEach(function(tuner) {
			const sig = Math.min(100, tuner.sig || 0);
			const snr = Math.min(100, tuner.snr || 0);
			const sigQuality = getSignalQuality(sig);
			const snrQuality = getSignalQuality(snr);
			const sigColor = getSignalColor(sig);
			const snrColor = getSignalColor(snr);

			// Short name for tuner
			let shortName = tuner.name || 'Tuner ' + tuner.id;
			if (shortName.length > 25) {
				shortName = shortName.substring(0, 22) + '...';
			}

			// State label translation
			const stateLabels = {
				'viewing': 'Live',
				'recording': 'REC',
				'busy': 'Busy',
				'idle': 'Idle'
			};
			const stateLabel = stateLabels[tuner.state] || tuner.state;

			// Track active tuners for preview
			if (tuner.state !== 'idle') {
				activeTuners++;
				totalSig += sig;
				totalSnr += snr;
			}

			html += '<div class="yweb-tuner-item">';
			html += '<div class="yweb-tuner-header">';
			html += '<span class="yweb-tuner-name" title="' + (tuner.name || '') + '">' + shortName + '</span>';
			html += '<span class="yweb-tuner-type">' + (tuner.type || 'DVB') + '</span>';
			html += '<span class="yweb-tuner-state ' + tuner.state + '">' + stateLabel + '</span>';
			html += '</div>';

			if (tuner.channel) {
				html += '<div class="yweb-tuner-channel">' + tuner.channel + '</div>';
			}

			html += '<div class="yweb-tuner-signals">';

			// SIG bar
			html += '<div class="yweb-tuner-signal">';
			html += '<div class="yweb-tuner-signal-header">';
			html += '<span class="yweb-tuner-signal-label">SIG</span>';
			html += '<span class="yweb-tuner-signal-value" style="color:' + sigColor + '">' + sig + '%</span>';
			html += '</div>';
			html += '<div class="yweb-tuner-signal-bar">';
			html += '<div class="yweb-tuner-signal-fill" style="width:' + sig + '%;background:' + sigColor + '"></div>';
			html += '</div>';
			html += '</div>';

			// SNR bar
			html += '<div class="yweb-tuner-signal">';
			html += '<div class="yweb-tuner-signal-header">';
			html += '<span class="yweb-tuner-signal-label">SNR</span>';
			html += '<span class="yweb-tuner-signal-value" style="color:' + snrColor + '">' + snr + '%</span>';
			html += '</div>';
			html += '<div class="yweb-tuner-signal-bar">';
			html += '<div class="yweb-tuner-signal-fill" style="width:' + snr + '%;background:' + snrColor + '"></div>';
			html += '</div>';
			html += '</div>';

			html += '</div>'; // signals
			html += '</div>'; // tuner-item
		});

		container.innerHTML = html;

		// Update preview and icon
		updateTunerPreview(tuners, activeTuners, totalSig, totalSnr);
	}

	// Get signal color for inline styles
	function getSignalColor(percent) {
		if (percent >= 80) return '#22c55e';
		if (percent >= 60) return '#84cc16';
		if (percent >= 40) return '#eab308';
		if (percent >= 20) return '#f97316';
		return '#ef4444';
	}

	// Update tuner card preview and icon
	function updateTunerPreview(tuners, activeTuners, totalSig, totalSnr) {
		const previewEl = document.getElementById('tuner-preview');
		const iconEl = document.getElementById('tuner-status-icon');

		// Preview text
		if (previewEl) {
			if (activeTuners > 0) {
				const avgSig = Math.round(totalSig / activeTuners);
				const avgSnr = Math.round(totalSnr / activeTuners);
				previewEl.textContent = activeTuners + '/' + tuners.length + ' aktiv';
			} else {
				previewEl.textContent = tuners.length + ' Tuner';
			}
		}

		// Icon color based on active tuner status
		if (iconEl) {
			const svg = iconEl.querySelector('svg');
			if (svg) {
				if (activeTuners > 0) {
					const avgSig = totalSig / activeTuners;
					const avgSnr = totalSnr / activeTuners;
					const avgQuality = (avgSig + avgSnr) / 2;
					if (avgQuality >= 60) {
						svg.style.color = '#22c55e';
					} else if (avgQuality >= 40) {
						svg.style.color = '#eab308';
					} else {
						svg.style.color = '#ef4444';
					}
				} else {
					svg.style.color = 'var(--pico-muted-color)';
				}
			}
		}
	}

	// Single-tuner fallback (boxes without the multi-tuner list)
	function loadTunerStatusLegacy() {
		apiJson('signal').done(function(data) {
			if (data && typeof data.sig !== 'undefined') {
				const tuners = [{
					id: 0,
					name: 'Tuner',
					type: 'DVB',
					sig: data.sig || 0,
					snr: data.snr || 0,
					ber: data.ber || 0,
					locked: (data.sig > 0),
					channel: '',
					state: (data.sig > 0) ? 'viewing' : 'idle'
				}];
				renderTunerList(tuners);
			}
		});
	}

	// Load Stream Info (Resolution, Aspect, Framerate, Audio, PIDs)
	function loadStreamInfo() {
		apiJson('info?streaminfo').done(function(data) {
			if (data && typeof data.resolution !== 'undefined')
				updateStreamInfoUI(data.resolution, data.width, data.height, data.aspect, data.fps, data.audio);
		});

		apiJson('zapto?getallpids').done(function(data) {
			if (data && typeof data.vpid !== 'undefined')
				updatePidsUI(data);
		});
	}

	// Update PIDs UI from JSON data
	function updatePidsUI(data) {
		const pidsContainer = document.getElementById('stream-pids');
		if (!pidsContainer) return;

		let html = '';

		// Video PID
		if (data.vpid) {
			html += '<span class="yweb-pid-tag"><span class="label">VID</span><span class="value">' + data.vpid + '</span></span>';
		}

		// Audio PIDs
		if (data.apids && data.apids.length > 0) {
			data.apids.forEach(function(apid) {
				let label = 'AUD';
				if (apid.ac3 || apid.eac3) label = 'AC3';
				else if (apid.aac) label = 'AAC';
				else if (apid.desc) {
					const desc = apid.desc.toLowerCase();
					if (desc.includes('eng') || desc.includes('english')) label = 'ENG';
				}
				html += '<span class="yweb-pid-tag"><span class="label">' + label + '</span><span class="value">' + apid.pid + '</span></span>';
			});
		}

		// Special PIDs
		if (data.vtxtpid) {
			html += '<span class="yweb-pid-tag"><span class="label">TXT</span><span class="value">' + data.vtxtpid + '</span></span>';
		}
		if (data.pmtpid) {
			html += '<span class="yweb-pid-tag"><span class="label">PMT</span><span class="value">' + data.pmtpid + '</span></span>';
		}
		if (data.pcrpid) {
			html += '<span class="yweb-pid-tag"><span class="label">PCR</span><span class="value">' + data.pcrpid + '</span></span>';
		}

		pidsContainer.innerHTML = html;
	}


	// Update stream info UI (shared by JSON and legacy)
	function updateStreamInfoUI(resolution, width, height, aspect, fps, audio) {
		// In radio mode: only show audio, hide video-specific info
		if (currentMode === 'radio') {
			$('#stream-resolution').text('--').removeClass('hd sd');
			$('#stream-aspect').text('--');
			$('#stream-fps').text('--');
			$('#stream-preview').text('Radio');
		} else {
			const resEl = document.getElementById('stream-resolution');
			if (resEl) {
				resEl.textContent = resolution || '--';
				resEl.classList.remove('hd', 'sd');
				if (height > 0) {
					resEl.classList.add(height >= 720 ? 'hd' : 'sd');
					const badge = height >= 720 ? 'HD' : 'SD';
					$('#stream-preview').text(resolution + ' ' + badge);
				} else {
					$('#stream-preview').text(resolution || '--');
				}
			}
			$('#stream-aspect').text(aspect || '--');
			$('#stream-fps').text(fps || '--');
		}
		$('#stream-audio').text(audio || '--');
	}


	// Init
	$(function() {
		ywebInitMobileAccordion({
			cardOrder: ['card-actions', 'card-channel', 'card-system', 'card-network', 'card-timer', 'card-tuner', 'card-stream'],
			storageKey: 'yweb-active-card',
			defaultCard: 'card-actions',
			breakpoint: 768,
			indicatorId: 'card-indicator',
			containerSelector: '.yweb-dashboard',
			mode: 'expanded'
		});

		loadCurrentMode();
		loadChannelInfo();
		loadSystemInfo();
		checkRecording();
		loadTimers();
		loadTunerStatus();
		loadStreamInfo();

		setInterval(loadChannelInfo, 30000);
		setInterval(loadSystemInfo, 30000);
		setInterval(checkRecording, 10000);
		setInterval(loadTimers, 60000);
		setInterval(loadTunerStatus, 5000);
		setInterval(loadStreamInfo, 30000);

		// Register pull-to-refresh callback
		if (typeof ywebSetRefreshCallback === 'function') {
			ywebSetRefreshCallback(function() {
				loadChannelInfo();
				loadSystemInfo();
				checkRecording();
				loadTimers();
				loadTunerStatus();
				loadStreamInfo();
				return new Promise(resolve => setTimeout(resolve, 800));
			});
		}
	});
	</script>
</body>
</html>
