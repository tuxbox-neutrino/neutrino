<!DOCTYPE html>
<html lang="de" data-theme="dark">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta name="theme-color" content="#181c25">
	<meta name="apple-mobile-web-app-capable" content="yes">
	<title>yWeb Dashboard</title>
	<link rel="icon" href="/favicon/favicon.ico">
	<link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png">
	<link rel="stylesheet" href="/css/pico.min.css">
	<link rel="stylesheet" href="/css/yweb.css?v=59">
	<style>
	/* Dashboard Grid */
	.yweb-dashboard {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 0.6rem;
		padding: 0.5rem;
	}

	/* Consistent Card Headers */
	.yweb-card .yweb-card-header {
		min-height: 2.2rem;
		padding: 0.4rem 0.6rem;
	}

	.yweb-card .yweb-card-title {
		font-size: 0.85rem;
	}

	.yweb-card .yweb-card-body {
		padding: 0.5rem 0.6rem;
	}

	.yweb-card .yweb-card-footer {
		padding: 0.35rem 0.6rem;
		font-size: 0.7rem;
	}

	/* Metric gauges - thinner strokes */
	.yweb-metrics {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.3rem;
	}

	.yweb-gauge {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 0.3rem 0.2rem;
	}

	.yweb-gauge-ring {
		position: relative;
		width: 52px;
		height: 52px;
	}

	.yweb-gauge-ring svg {
		transform: rotate(-90deg);
		width: 100%;
		height: 100%;
	}

	.yweb-gauge-ring circle {
		fill: none;
		stroke-width: 4;
	}

	.yweb-gauge-ring .bg {
		stroke: var(--pico-muted-border-color);
	}

	.yweb-gauge-ring .fg {
		stroke: var(--yweb-accent);
		stroke-linecap: round;
		transition: stroke-dashoffset 0.6s ease;
	}

	.yweb-gauge-ring .fg.ok { stroke: var(--yweb-success); }
	.yweb-gauge-ring .fg.warning { stroke: var(--yweb-warning); }
	.yweb-gauge-ring .fg.danger { stroke: var(--yweb-danger); }

	.yweb-gauge-value {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		font-size: 0.72rem;
		font-weight: 600;
	}

	.yweb-gauge-label {
		font-size: 0.65rem;
		color: var(--pico-muted-color);
		margin-top: 0.15rem;
	}

	.yweb-gauge-sub {
		font-size: 0.58rem;
		color: var(--pico-muted-color);
		opacity: 0.85;
	}

	/* System info in footer */
	.yweb-sys-footer {
		display: flex;
		justify-content: space-between;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.yweb-sys-footer-item {
		display: flex;
		gap: 0.25rem;
	}

	.yweb-sys-footer-label {
		color: var(--pico-muted-color);
	}

	.yweb-sys-footer-value {
		font-weight: 500;
	}

	/* Network list - compact */
	.yweb-net-list {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		max-height: 180px;
		overflow-y: auto;
	}

	.yweb-net-item {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.3rem 0.4rem;
		background: var(--pico-card-sectioning-background-color);
		border-radius: var(--yweb-radius);
		font-size: 0.7rem;
	}

	.yweb-net-icon {
		width: 22px;
		height: 22px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--yweb-accent-light);
		border-radius: 50%;
		flex-shrink: 0;
	}

	.yweb-net-icon svg {
		width: 12px;
		height: 12px;
		color: var(--yweb-accent);
	}

	.yweb-net-info {
		flex: 1;
		min-width: 0;
		line-height: 1.2;
	}

	.yweb-net-name {
		font-weight: 600;
		font-size: 0.68rem;
	}

	.yweb-net-ip {
		color: var(--pico-muted-color);
		font-family: var(--pico-font-family-monospace);
		font-size: 0.62rem;
	}

	.yweb-net-mac {
		color: var(--pico-muted-color);
		font-family: var(--pico-font-family-monospace);
		font-size: 0.55rem;
		opacity: 0.7;
	}

	.yweb-net-status {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--yweb-danger);
		flex-shrink: 0;
	}

	.yweb-net-status.up {
		background: var(--yweb-success);
	}

	/* Hostname in network card header (scoped to avoid overriding header hostname) */
	#net-hostname {
		font-size: 0.75rem;
		color: var(--pico-muted-color);
	}

	/* Temperature in header */
	.yweb-temp {
		display: flex;
		align-items: center;
		gap: 0.2rem;
		font-size: 0.8rem;
	}

	.yweb-temp-icon {
		color: var(--yweb-warning);
		width: 14px;
		height: 14px;
	}

	.yweb-temp-value {
		font-weight: 600;
	}

	.yweb-temp-value.hot {
		color: var(--yweb-danger);
	}

	/* TV/Radio Mode Switch */
	.yweb-mode-switch {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 0.75rem;
		padding-bottom: 0.75rem;
		border-bottom: 1px solid var(--yweb-border);
	}

	.yweb-mode-current {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.4rem 0.7rem;
		background: var(--yweb-accent-light);
		border-radius: 6px;
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--yweb-text);
	}

	.yweb-mode-current svg {
		width: 16px;
		height: 16px;
		color: var(--yweb-primary);
	}

	.yweb-mode-switch-btn {
		flex: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.3rem;
		padding: 0.5rem 0.3rem;
		background: var(--pico-card-sectioning-background-color);
		border: 1px solid var(--pico-muted-border-color);
		border-radius: var(--yweb-radius);
		color: var(--pico-color);
		font-size: 0.65rem;
		font-weight: 500;
		cursor: pointer;
		transition: all 0.2s ease;
	}

	.yweb-mode-switch-btn svg {
		width: 18px;
		height: 18px;
	}

	.yweb-mode-switch-btn:hover {
		background: var(--yweb-accent-light);
		border-color: var(--yweb-accent);
		color: var(--yweb-accent);
	}

	[data-theme="light"] .yweb-mode-switch-btn {
		background: #f8f9fa;
		border-color: #dee2e6;
		color: #495057;
	}

	[data-theme="light"] .yweb-mode-switch-btn:hover {
		background: var(--yweb-accent-light);
		border-color: var(--yweb-accent);
		color: var(--yweb-accent);
	}

	/* Actions grid - 3 columns */
	.yweb-actions {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.4rem;
	}

	.yweb-action-btn {
		padding: 0.5rem 0.3rem;
		font-size: 0.65rem;
	}

	.yweb-action-btn svg {
		width: 18px;
		height: 18px;
	}

	/* Timer list - compact */
	.yweb-timer-list {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		max-height: 180px;
		overflow-y: auto;
	}

	.yweb-timer-item {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.3rem 0.4rem;
		background: var(--pico-card-sectioning-background-color);
		border-radius: var(--yweb-radius);
		font-size: 0.7rem;
	}

	.yweb-timer-icon {
		width: 22px;
		height: 22px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--yweb-accent-light);
		border-radius: 50%;
		flex-shrink: 0;
	}

	.yweb-timer-icon svg {
		width: 12px;
		height: 12px;
		color: var(--yweb-accent);
	}

	.yweb-timer-icon.record {
		background: rgba(239, 68, 68, 0.15);
	}

	.yweb-timer-icon.record svg {
		color: var(--yweb-danger);
	}

	.yweb-timer-info {
		flex: 1;
		min-width: 0;
		line-height: 1.2;
	}

	.yweb-timer-title {
		font-weight: 600;
		font-size: 0.68rem;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.yweb-timer-channel {
		color: var(--pico-muted-color);
		font-size: 0.62rem;
	}

	.yweb-timer-time {
		text-align: right;
		flex-shrink: 0;
		line-height: 1.2;
	}

	.yweb-timer-date {
		font-weight: 600;
		font-size: 0.65rem;
	}

	.yweb-timer-hour {
		color: var(--pico-muted-color);
		font-size: 0.62rem;
	}

	.yweb-timer-empty {
		color: var(--pico-muted-color);
		text-align: center;
		padding: 1rem;
		font-size: 0.75rem;
	}

	/* Running recording in timer card */
	.yweb-timer-item.running {
		background: rgba(239, 68, 68, 0.08);
		border: 1px solid rgba(239, 68, 68, 0.2);
	}

	.yweb-timer-item.running .yweb-timer-icon {
		background: rgba(239, 68, 68, 0.15);
	}

	.yweb-timer-item.running .yweb-timer-icon svg {
		color: var(--yweb-danger);
		animation: yweb-pulse 1.5s ease-in-out infinite;
	}

	.yweb-timer-item.running .yweb-timer-remaining {
		color: var(--yweb-danger);
		font-weight: 600;
		font-size: 0.65rem;
		white-space: nowrap;
	}

	/* Dashboard channel card: 4 buttons need flexible sizing */
	.yweb-channel-footer .yweb-channel-actions .yweb-action-btn {
		min-width: 0;
	}

	/* Rec button in channel card */
	.yweb-channel-footer .yweb-rec-btn {
		color: var(--yweb-danger);
	}

	.yweb-channel-footer .yweb-rec-btn.recording {
		animation: yweb-pulse 1.5s ease-in-out infinite;
	}

	/* Recording info banner */
	.yweb-rec-info {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.4rem 0.6rem;
		background: rgba(239, 68, 68, 0.1);
		border-top: 1px solid rgba(239, 68, 68, 0.2);
		font-size: 0.7rem;
	}

	.yweb-rec-icon {
		color: var(--yweb-danger);
		animation: yweb-pulse 1.5s ease-in-out infinite;
	}

.yweb-rec-details {
		flex: 1;
		min-width: 0;
		line-height: 1.3;
	}

	.yweb-rec-title {
		font-weight: 600;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.yweb-rec-channel {
		color: var(--pico-muted-color);
		font-size: 0.62rem;
	}

	.yweb-rec-time {
		text-align: right;
		font-weight: 600;
		color: var(--yweb-danger);
		white-space: nowrap;
	}

	/* Tuner Signal Widget */
	.yweb-tuner {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.yweb-signal-row {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.yweb-signal-label {
		width: 32px;
		font-size: 0.7rem;
		font-weight: 600;
		color: var(--pico-muted-color);
		flex-shrink: 0;
	}

	.yweb-signal-bar-container {
		flex: 1;
		height: 10px;
		background: var(--pico-muted-border-color);
		border-radius: 5px;
		overflow: hidden;
		position: relative;
	}

	.yweb-signal-bar {
		height: 100%;
		border-radius: 5px;
		transition: width 0.5s ease, background 0.3s ease;
		width: 0%;
	}

	.yweb-signal-bar.excellent {
		background: linear-gradient(90deg, #22c55e, #16a34a);
	}

	.yweb-signal-bar.good {
		background: linear-gradient(90deg, #84cc16, #22c55e);
	}

	.yweb-signal-bar.moderate {
		background: linear-gradient(90deg, #eab308, #84cc16);
	}

	.yweb-signal-bar.poor {
		background: linear-gradient(90deg, #f97316, #eab308);
	}

	.yweb-signal-bar.bad {
		background: linear-gradient(90deg, #ef4444, #f97316);
	}

	.yweb-signal-value {
		width: 40px;
		text-align: right;
		font-size: 0.72rem;
		font-weight: 600;
		flex-shrink: 0;
	}

	.yweb-signal-value.excellent { color: #22c55e; }
	.yweb-signal-value.good { color: #84cc16; }
	.yweb-signal-value.moderate { color: #eab308; }
	.yweb-signal-value.poor { color: #f97316; }
	.yweb-signal-value.bad { color: #ef4444; }

	/* BER special styling (lower is better) */
	.yweb-ber-row {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding-top: 0.3rem;
		border-top: 1px solid var(--pico-muted-border-color);
	}

	.yweb-ber-value {
		font-family: var(--pico-font-family-monospace);
		font-size: 0.75rem;
		font-weight: 600;
	}

	.yweb-ber-value.ok { color: #22c55e; }
	.yweb-ber-value.warning { color: #eab308; }
	.yweb-ber-value.error { color: #ef4444; }

	.yweb-tuner-icon {
		display: flex;
		align-items: center;
		gap: 0.3rem;
	}

	.yweb-tuner-icon svg {
		width: 14px;
		height: 14px;
		color: var(--pico-muted-color);
	}

	/* Multi-Tuner List */
	.yweb-tuner-list {
		display: flex;
		flex-direction: column;
		gap: 0.8rem;
	}

	.yweb-tuner-item {
		background: var(--pico-card-sectionning-background-color);
		border-radius: 8px;
		padding: 0.7rem;
		border: 1px solid var(--pico-muted-border-color);
	}

	.yweb-tuner-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 0.5rem;
		gap: 0.5rem;
	}

	.yweb-tuner-name {
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--pico-color);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		flex: 1;
	}

	.yweb-tuner-type {
		font-size: 0.65rem;
		font-weight: 600;
		padding: 0.15rem 0.4rem;
		border-radius: 4px;
		background: var(--pico-primary-background);
		color: var(--pico-primary-inverse);
		flex-shrink: 0;
	}

	.yweb-tuner-state {
		font-size: 0.65rem;
		font-weight: 600;
		padding: 0.15rem 0.4rem;
		border-radius: 4px;
		flex-shrink: 0;
	}

	.yweb-tuner-state.viewing {
		background: #22c55e;
		color: white;
	}

	.yweb-tuner-state.recording {
		background: #ef4444;
		color: white;
		animation: yweb-pulse 1.5s infinite;
	}

	.yweb-tuner-state.busy {
		background: #f97316;
		color: white;
	}

	.yweb-tuner-state.idle {
		background: var(--pico-muted-border-color);
		color: var(--pico-muted-color);
	}

.yweb-tuner-channel {
		font-size: 0.7rem;
		color: var(--pico-muted-color);
		margin-bottom: 0.5rem;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.yweb-tuner-channel:empty {
		display: none;
	}

	.yweb-tuner-signals {
		display: flex;
		gap: 1rem;
	}

	.yweb-tuner-signal {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}

	.yweb-tuner-signal-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.yweb-tuner-signal-label {
		font-size: 0.6rem;
		font-weight: 600;
		color: var(--pico-muted-color);
	}

	.yweb-tuner-signal-value {
		font-size: 0.65rem;
		font-weight: 600;
	}

	.yweb-tuner-signal-bar {
		height: 4px;
		background: var(--pico-muted-border-color);
		border-radius: 2px;
		overflow: hidden;
	}

	.yweb-tuner-signal-fill {
		height: 100%;
		border-radius: 2px;
		transition: width 0.5s ease;
	}

	/* Stream Info Widget */
	.yweb-stream-info {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.5rem;
	}

	.yweb-stream-item {
		display: flex;
		flex-direction: column;
		padding: 0.4rem 0.5rem;
		background: var(--pico-card-sectioning-background-color);
		border-radius: var(--yweb-radius);
	}

	.yweb-stream-label {
		font-size: 0.6rem;
		color: var(--pico-muted-color);
		text-transform: uppercase;
		letter-spacing: 0.03em;
	}

	.yweb-stream-value {
		font-size: 0.78rem;
		font-weight: 600;
		font-family: var(--pico-font-family-monospace);
	}

	.yweb-stream-value.hd {
		color: #22c55e;
	}

	.yweb-stream-value.sd {
		color: #eab308;
	}

	.yweb-pids {
		grid-column: span 2;
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem;
		padding-top: 0.4rem;
		border-top: 1px solid var(--pico-muted-border-color);
	}

	.yweb-pid-tag {
		display: inline-flex;
		align-items: center;
		gap: 0.2rem;
		padding: 0.15rem 0.4rem;
		background: var(--yweb-accent-light);
		border-radius: 3px;
		font-size: 0.6rem;
		font-family: var(--pico-font-family-monospace);
	}

	.yweb-pid-tag .label {
		color: var(--pico-muted-color);
		font-weight: 500;
	}

	.yweb-pid-tag .value {
		color: var(--yweb-accent);
		font-weight: 600;
	}

	/* Mobile Accordion */
	@media (max-width: 768px) {
		.yweb-card-indicator {
			display: flex;
		}

		.yweb-dashboard {
			gap: 0.4rem;
		}

		.yweb-card {
			margin-bottom: 0;
		}

		.yweb-card-header {
			cursor: pointer;
			position: relative;
			padding-right: 2rem;
		}

		.yweb-card .yweb-card-title {
			font-size: 0.9rem;
		}

		/* Show preview only when collapsed on mobile */
		.yweb-card:not(.expanded) .yweb-card-preview {
			display: inline-block;
			margin-right: 0.8rem;
		}

		/* Hide other header elements when collapsed to make room for preview */
		.yweb-card:not(.expanded) .yweb-temp,
		.yweb-card:not(.expanded) #net-hostname,
		.yweb-card:not(.expanded) .yweb-tuner-icon,
		.yweb-card:not(.expanded) .yweb-recording {
			display: none;
		}

		/* Ensure right-side elements don't overlap with chevron */
		.yweb-card-header > *:last-child:not(.yweb-card-title) {
			margin-right: 0.8rem;
			flex-shrink: 0;
		}

		.yweb-card-header::after {
			content: '▼';
			position: absolute;
			right: 0.5rem;
			top: 50%;
			transform: translateY(-50%);
			font-size: 0.55rem;
			color: var(--pico-muted-color);
			transition: transform 0.2s ease;
			pointer-events: none;
		}

		.yweb-card.expanded .yweb-card-header::after {
			transform: translateY(-50%) rotate(180deg);
		}

		.yweb-card-body,
		.yweb-card-footer,
		.yweb-rec-info {
			display: none;
		}

		.yweb-card.expanded .yweb-card-body,
		.yweb-card.expanded .yweb-card-footer,
		.yweb-card.expanded .yweb-rec-info {
			display: block;
		}

		/* Smooth height animation */
		.yweb-card-body {
			overflow: hidden;
		}
	}
	</style>
</head>
<body>
	<!-- Header wird dynamisch von yweb-header.js generiert -->
	<div class="yweb-header-wrapper" data-page="dashboard"></div>
	<div class="yweb-header-spacer"></div>

	<main>
		<div class="yweb-dashboard">
			<!-- Quick Actions -->
			<article class="yweb-card expanded" id="card-actions">
				<header class="yweb-card-header" onclick="toggleCard('card-actions')">
					<h3 class="yweb-card-title">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
						</svg>
						{=L:yw.dash.quick=}
					</h3>
					<span id="actions-preview" class="yweb-card-preview">--</span>
				</header>
				<div class="yweb-card-body">
					<div class="yweb-mode-switch" id="mode-switch">
						<span class="yweb-mode-current" id="mode-current">
							<svg id="mode-current-icon-tv" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
							</svg>
							<svg id="mode-current-icon-radio" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="display:none">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.636 18.364a9 9 0 010-12.728m12.728 0a9 9 0 010 12.728M9 12a3 3 0 106 0 3 3 0 00-6 0z"/>
							</svg>
							<span id="mode-current-text">TV</span>
						</span>
						<button class="yweb-mode-switch-btn" id="mode-switch-btn" onclick="switchMode()">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/>
							</svg>
							<span id="mode-switch-text">{=L:yw.dash.to_radio=}</span>
						</button>
					</div>
					<div class="yweb-actions">
						<a href="/screenshot.yhtm" class="yweb-action-btn">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
							</svg>
							Screenshot
						</a>
<a href="/files.yhtm" class="yweb-action-btn">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
							</svg>
							{=L:yw.tools.files=}
						</a>
						<button class="yweb-action-btn" onclick="ywebShowMessageDialog()">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
							</svg>
							{=L:yw.tools.message=}
						</button>
						<button class="yweb-action-btn" onclick="ywebShowRemote()">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<rect x="7" y="2" width="10" height="20" rx="2"/>
								<circle cx="12" cy="18" r="1"/>
							</svg>
							Remote
						</button>
						<button class="yweb-action-btn" onclick="sendStandby()">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.636 18.364a9 9 0 010-12.728m12.728 0a9 9 0 010 12.728m-9.9-2.829a5 5 0 010-7.07m7.072 0a5 5 0 010 7.07M13 12a1 1 0 11-2 0 1 1 0 012 0z"/>
							</svg>
							Standby
						</button>
					</div>
				</div>
			</article>

			<!-- Current Channel -->
			<article class="yweb-card" id="card-channel">
				<header class="yweb-card-header" onclick="toggleCard('card-channel')">
					<h3 class="yweb-card-title">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
						</svg>
						{=L:yw.dash.current_channel=}
					</h3>
					<span id="channel-preview" class="yweb-card-preview">--</span>
					<span id="rec-indicator" class="yweb-recording yweb-hidden"><svg viewBox="0 0 12 12" fill="currentColor" style="width:0.55rem;height:0.55rem"><circle cx="6" cy="6" r="5"/></svg> REC</span>
				</header>
				<div class="yweb-card-body yweb-status">
					<div class="yweb-status-channel" id="current-channel" onclick="showCurrentEpgInfo()" style="cursor:pointer" title="{=L:yw.dash.epg_info=}">{=L:yw.msg.loading=}</div>
					<div class="yweb-status-epg" id="current-epg">--</div>
					<div class="yweb-status-progress">
						<progress id="epg-progress" value="0" max="100"></progress>
						<div class="yweb-status-time">
							<span id="epg-start">--:--</span>
							<span id="epg-end">--:--</span>
						</div>
					</div>
				</div>
				<div id="rec-info" class="yweb-rec-info yweb-hidden">
					<span class="yweb-rec-icon">●</span>
					<div class="yweb-rec-details">
						<div class="yweb-rec-title" id="rec-title">--</div>
						<div class="yweb-rec-channel" id="rec-channel">--</div>
					</div>
					<div class="yweb-rec-time" id="rec-remaining">--:--</div>
				</div>
				<footer class="yweb-card-footer yweb-channel-footer">
					<div class="yweb-next-epg">Nächste: <span id="next-epg">--</span></div>
					<div class="yweb-channel-actions">
						<button type="button" class="yweb-action-btn" onclick="showCurrentEpgInfo()" title="{=L:yw.dash.epg_info=}">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<circle cx="12" cy="12" r="10"/><path d="M12 16v-4m0-4h.01"/>
							</svg>
							<span>Info</span>
						</button>
						<button type="button" class="yweb-action-btn yweb-rec-btn" id="rec-btn" onclick="toggleRecording()" title="{=L:yw.dash.record=}">
							<svg viewBox="0 0 24 24" fill="currentColor">
								<circle cx="12" cy="12" r="8"/>
							</svg>
							<span>Rec</span>
						</button>
						<a href="/epg.html" class="yweb-action-btn" title="{=L:yw.dash.epg_plus=}">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
							</svg>
							<span>EPGPlus</span>
						</a>
						<a href="bouquets.html" class="yweb-action-btn" title="{=L:yw.dash.to_channels=}">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M4 6h16M4 12h16M4 18h16"/>
							</svg>
							<span>{=L:yw.dash.channels=}</span>
						</a>
					</div>
				</footer>
			</article>

			<!-- System Metrics -->
			<article class="yweb-card" id="card-system">
				<header class="yweb-card-header" onclick="toggleCard('card-system')">
					<h3 class="yweb-card-title">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"/>
						</svg>
						System
					</h3>
					<span id="system-preview" class="yweb-card-preview">--</span>
					<div class="yweb-temp" id="sys-temp">
						<svg class="yweb-temp-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v3m0 0v3m0-3h3m-3 0H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
						</svg>
						<span class="yweb-temp-value" id="temp-value">--</span>
					</div>
				</header>
				<div class="yweb-card-body">
					<div class="yweb-metrics" onclick="location.href='/sysinfo.yhtm'" style="cursor:pointer" title="{=L:yw.dash.sys_details=}">
						<div class="yweb-gauge">
							<div class="yweb-gauge-ring">
								<svg viewBox="0 0 36 36">
									<circle class="bg" cx="18" cy="18" r="16"></circle>
									<circle class="fg" id="gauge-cpu" cx="18" cy="18" r="16" stroke-dasharray="100.5" stroke-dashoffset="100.5"></circle>
								</svg>
								<span class="yweb-gauge-value" id="cpu-percent">--%</span>
							</div>
							<span class="yweb-gauge-label">CPU</span>
							<span class="yweb-gauge-sub" id="cpu-load">--</span>
						</div>
						<div class="yweb-gauge">
							<div class="yweb-gauge-ring">
								<svg viewBox="0 0 36 36">
									<circle class="bg" cx="18" cy="18" r="16"></circle>
									<circle class="fg" id="gauge-ram" cx="18" cy="18" r="16" stroke-dasharray="100.5" stroke-dashoffset="100.5"></circle>
								</svg>
								<span class="yweb-gauge-value" id="ram-percent">--%</span>
							</div>
							<span class="yweb-gauge-label">RAM</span>
							<span class="yweb-gauge-sub" id="ram-info">--</span>
						</div>
						<div class="yweb-gauge">
							<div class="yweb-gauge-ring">
								<svg viewBox="0 0 36 36">
									<circle class="bg" cx="18" cy="18" r="16"></circle>
									<circle class="fg" id="gauge-disk" cx="18" cy="18" r="16" stroke-dasharray="100.5" stroke-dashoffset="100.5"></circle>
								</svg>
								<span class="yweb-gauge-value" id="disk-percent">--%</span>
							</div>
							<span class="yweb-gauge-label">Disk</span>
							<span class="yweb-gauge-sub" id="disk-info">--</span>
						</div>
					</div>
				</div>
				<footer class="yweb-card-footer">
					<div class="yweb-sys-footer">
						<div class="yweb-sys-footer-item">
							<span class="yweb-sys-footer-label">Up:</span>
							<span class="yweb-sys-footer-value" id="sys-uptime">--</span>
						</div>
						<div class="yweb-sys-footer-item">
							<span class="yweb-sys-footer-label">Box:</span>
							<span class="yweb-sys-footer-value" id="sys-box">--</span>
						</div>
						<div class="yweb-sys-footer-item">
							<span class="yweb-sys-footer-label">Kernel:</span>
							<span class="yweb-sys-footer-value" id="sys-kernel">--</span>
						</div>
					</div>
				</footer>
			</article>

			<!-- Network -->
			<article class="yweb-card" id="card-network">
				<header class="yweb-card-header" onclick="toggleCard('card-network')">
					<h3 class="yweb-card-title">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
						</svg>
						{=L:yw.si.network=}
					</h3>
					<span id="network-preview" class="yweb-card-preview">--</span>
					<span class="yweb-hostname" id="net-hostname">--</span>
				</header>
				<div class="yweb-card-body">
					<div class="yweb-net-list" id="net-interfaces">
						<div class="yweb-net-item">
							<span class="yweb-text-muted">{=L:yw.msg.loading=}</span>
						</div>
					</div>
				</div>
			</article>

			<!-- Timer -->
			<article class="yweb-card" id="card-timer">
				<header class="yweb-card-header" onclick="toggleCard('card-timer')">
					<h3 class="yweb-card-title">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
						</svg>
						{=L:yw.dash.next_timers=}
					</h3>
					<span id="timer-preview" class="yweb-card-preview">--</span>
				</header>
				<div class="yweb-card-body">
					<div class="yweb-timer-list" id="timer-list">
						<div class="yweb-timer-empty">{=L:yw.msg.loading=}</div>
