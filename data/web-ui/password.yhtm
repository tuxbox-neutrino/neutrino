<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Neutrino-Web-UI - {=L:yw.pw.title=}</title>
	<link rel="icon" href="/favicon/favicon.ico">
	<script>
		// Apply the stored theme before first paint: webui-header.js runs
		// too late, and some pages never load it at all.
		try { document.documentElement.setAttribute('data-theme', localStorage.getItem('yweb-theme') || 'dark'); } catch (e) {}
	</script>
	<link rel="stylesheet" href="/css/pico.min.css">
	<link rel="stylesheet" href="/css/webui.css?v=89">
	<style>
		/* Compact centered auth card after the portal login pattern.
		   webui.css already makes body a column flexbox with main{flex:1}
		   — undo the stretch and the fixed height so the card sizes to
		   its content; margin:auto centers it and still allows
		   scrolling to the top on tiny viewports. */
		body {
			height: auto;
			min-height: 100vh;
			min-height: 100dvh;
			overflow: auto;
			margin: 0;
			display: flex;
			flex-direction: column;
			padding: 24px;
			background-color: var(--pico-background-color);
			background-image: radial-gradient(circle at 12% -10%, var(--yweb-accent-light), transparent 55%);
		}
		.login-wrap {
			flex: 0 0 auto;
			margin: auto;
			width: 100%;
			max-width: 420px;
			padding: 36px;
		}
		.login-wrap h1 {
			font-size: 1.3rem;
			margin-bottom: 0.4rem;
		}
		.login-wrap p.sub {
			color: var(--pico-muted-color);
			margin-bottom: 20px;
		}
		.login-wrap form {
			display: flex;
			flex-direction: column;
			gap: 12px;
		}
		.login-field {
			display: flex;
			flex-direction: column;
			gap: 4px;
		}
		.login-field label {
			font-size: 0.85em;
			font-weight: 500;
			color: var(--pico-muted-color);
			margin-bottom: 0;
		}
		.login-wrap input[type=text],
		.login-wrap input[type=password] {
			padding: 9px 12px;
			font-size: 1rem;
			height: auto;
			margin-bottom: 0;
		}
		.login-pw-row {
			display: flex;
			gap: 0.4rem;
			align-items: stretch;
		}
		.login-pw-row input {
			flex: 1;
			min-width: 0;
		}
		.login-pw-row .yweb-btn {
			padding: 0 0.7rem;
		}
		.login-flash {
			padding: 12px 16px;
			border-radius: 8px;
			border: 1px solid transparent;
			font-weight: 500;
			font-size: 0.9rem;
			margin: 0;
		}
		/* focused programmatically for the announcement; the tinted
		   banner itself is the visual indicator, it is not interactive */
		.login-flash:focus {
			outline: none;
		}
		.login-flash.err {
			background: rgba(231, 76, 60, 0.12);
			border-color: rgba(231, 76, 60, 0.35);
			color: var(--yweb-danger);
		}
		.login-flash.out {
			background: var(--yweb-bg-elevated);
			border-color: var(--yweb-border-subtle);
			color: var(--pico-color);
		}
		.login-wrap .login-first {
			margin: 14px 0 0;
			font-size: 0.8rem;
		}
		.login-wrap button[type=submit] {
			width: 100%;
			padding: 9px 18px;
			font-size: 0.95rem;
			margin-top: 4px;
		}
	</style>
</head>
<body>
	<main class="login-wrap yweb-card">
		<h1>Neutrino-Web-UI</h1>
		<p class="sub">{=L:yw.pw.intro=}</p>

		<!-- Sets the account's password with PUT /api/v1/account/password, the
		     one route besides login, session and logout a session opened with
		     the password the box shipped with reaches. Loads nothing of the
		     other pages, which would only be refused until this is done. -->
		<form id="pwForm" novalidate>
			<div class="login-flash err" id="pwErr" role="status" tabindex="-1" hidden></div>

			<div class="login-field">
				<label for="pwCurrent">{=L:yw.pw.current=}</label>
				<div class="login-pw-row">
					<input type="password" id="pwCurrent" name="current" autocomplete="current-password" autofocus>
					<button type="button" class="yweb-btn" aria-pressed="false" aria-label="{=L:yw.set.pw_show=}" onclick="loginTogglePw('pwCurrent', this)"></button>
				</div>
			</div>

			<div class="login-field">
				<label for="pwNew">{=L:yw.pw.new=}</label>
				<div class="login-pw-row">
					<input type="password" id="pwNew" name="password" autocomplete="new-password" minlength="8">
					<button type="button" class="yweb-btn" aria-pressed="false" aria-label="{=L:yw.set.pw_show=}" onclick="loginTogglePw('pwNew', this)"></button>
				</div>
			</div>

			<div class="login-field">
				<label for="pwRepeat">{=L:yw.pw.repeat=}</label>
				<div class="login-pw-row">
					<input type="password" id="pwRepeat" name="repeat" autocomplete="new-password" minlength="8">
					<button type="button" class="yweb-btn" aria-pressed="false" aria-label="{=L:yw.set.pw_show=}" onclick="loginTogglePw('pwRepeat', this)"></button>
				</div>
			</div>

			<button type="submit" id="pwSubmit" class="yweb-btn primary">{=L:yw.pw.submit=}</button>
		</form>
		<p class="sub login-first">{=L:yw.pw.apps=}</p>
	</main>

	<script>
		// Local eye icons: this page deliberately does not load webui-header.js
		var LOGIN_EYE = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:1rem;height:1rem;vertical-align:middle" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>';
		var LOGIN_EYEOFF = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:1rem;height:1rem;vertical-align:middle" aria-hidden="true"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/></svg>';
		document.querySelectorAll('.login-pw-row .yweb-btn').forEach(function(b) { b.innerHTML = LOGIN_EYEOFF; });

		function loginTogglePw(id, btn) {
			var el = document.getElementById(id);
			var show = el.type === 'password';
			el.type = show ? 'text' : 'password';
			btn.setAttribute('aria-pressed', show ? 'true' : 'false');
			btn.innerHTML = show ? LOGIN_EYE : LOGIN_EYEOFF;
		}

		// Where to go once the password is set: a path on this box and nothing
		// else, by the rule the login page applies.
		function pwSafeNext(next) {
			if (!next || next.charAt(0) !== '/' || next.charAt(1) === '/' || next.indexOf('\\') >= 0)
				return '/';
			return next;
		}
		var pwNext = pwSafeNext(new URLSearchParams(location.search).get('next'));
		var PW_TEXT = {
			mismatch: '{=L:yw.pw.mismatch=}',
			short: '{=L:yw.pw.short=}',
			wrong: '{=L:yw.pw.wrong=}',
			failed: '{=L:yw.pw.failed=}',
			wait: '{=L:yw.login.wait=}'
		};

		function pwNote(text) {
			var note = document.getElementById('pwErr');
			note.hidden = !text;
			if (!text)
				return;
			note.textContent = text;
			note.focus();
		}

		// The session this page works on, with the second token a change sends
		// back; none means signing in first, and coming back here after.
		async function pwSession() {
			var r = await fetch('/api/v1/session', {credentials: 'same-origin', cache: 'no-store'});
			var s = r.ok ? await r.json() : null;
			if (!s || !s.authenticated) {
				location.replace('/login.yhtm?next=' + encodeURIComponent('/password.yhtm?next=' + pwNext));
				return null;
			}
			return s;
		}

		async function pwSubmit(e) {
			e.preventDefault();
			var btn = document.getElementById('pwSubmit');
			if (btn.disabled)
				return;
			var current = document.getElementById('pwCurrent').value;
			var next = document.getElementById('pwNew').value;
			// characters as a person counts them, as the box counts them
			if (Array.from(next).length < 8)
				return pwNote(PW_TEXT.short);
			if (next !== document.getElementById('pwRepeat').value)
				return pwNote(PW_TEXT.mismatch);
			btn.disabled = true;
			pwNote('');
			try {
				var s = await pwSession();
				if (!s)
					return;
				var headers = {'Content-Type': 'application/json'};
				headers[s.csrf_header] = s.csrf;
				var resp = await fetch('/api/v1/account/password', {
					method: 'PUT', credentials: 'same-origin', cache: 'no-store', headers: headers,
					body: JSON.stringify({current: current, password: next})
				});
				if (resp.status === 204) {
					location.replace(pwNext);
					return;
				}
				var detail = '';
				try { detail = (await resp.json()).detail || ''; } catch (ex) {}
				if (resp.status === 403)
					pwNote(PW_TEXT.wrong);
				else if (resp.status === 429)
					pwNote(PW_TEXT.wait.replace('%s', resp.headers.get('Retry-After') || '60'));
				else
					pwNote(PW_TEXT.failed + (detail ? ': ' + detail : ''));
			} catch (ex) {
				pwNote(PW_TEXT.failed);
			}
			btn.disabled = false;
		}
		document.getElementById('pwForm').addEventListener('submit', pwSubmit);
		// a page that has no session to change a password with sends to the login
		pwSession();
	</script>
</body>
</html>
