<!DOCTYPE html>
<html lang="de" data-theme="dark">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>yWeb - {=L:yw.tools.files=}</title>
	<link rel="icon" href="/favicon/favicon.ico">
	<link rel="stylesheet" href="/css/pico.min.css">
	<link rel="stylesheet" href="/css/yweb.css?v=67">
	<style>
		/* 2-column grid layout */
		main.yweb-files-grid {
			display: grid;
			grid-template-columns: 240px 1fr;
			gap: 0.6rem;
			padding: 0.5rem;
			overflow: hidden;
		}

		@media (max-width: 800px) {
			main.yweb-files-grid {
				grid-template-columns: 1fr;
				grid-template-rows: auto 1fr;
			}
		}

		/* Compact card headers */

		/* Sidebar card */

		/* Disk usage badge */
		.yweb-disk-usage {
			font-size: var(--yweb-font-xs);
			color: var(--pico-muted-color);
			background: var(--pico-card-sectioning-background-color);
			padding: 0.1rem 0.4rem;
			border-radius: 10px;
		}

		/* File list card */

		/* Toolbar (inside card header) */
		.yweb-files-toolbar {
			display: flex;
			align-items: center;
			gap: 0.4rem;
			flex-wrap: wrap;
			padding: 0.4rem 0.6rem;
			border-bottom: 1px solid var(--pico-muted-border-color);
			background: var(--pico-card-sectioning-background-color);
		}

		.yweb-files-toolbar .yweb-btn {
			padding: 0.25rem 0.5rem;
		}

		.yweb-files-toolbar .yweb-btn svg {
			width: 14px;
			height: 14px;
		}

		.yweb-toolbar-spacer {
			flex: 1;
		}

		.yweb-disk-info {
			font-size: var(--yweb-font-xs);
			color: var(--pico-muted-color);
		}

		/* Breadcrumb */
		.yweb-breadcrumb {
			display: flex;
			align-items: center;
			gap: 0.2rem;
			font-size: var(--yweb-font-sm);
			overflow-x: auto;
			white-space: nowrap;
			padding: 0.3rem 0.6rem;
			border-bottom: 1px solid var(--pico-muted-border-color);
		}

		.yweb-breadcrumb a {
			color: var(--yweb-accent);
			text-decoration: none;
			padding: 0.1rem 0.2rem;
			border-radius: var(--yweb-radius);
		}

		.yweb-breadcrumb a:hover {
			background: var(--yweb-accent-light);
		}

		.yweb-breadcrumb-sep {
			color: var(--pico-muted-color);
			font-size: 0.7em;
		}

		.yweb-breadcrumb-current {
			color: var(--pico-color);
			font-weight: 500;
		}

		/* File list */

		.yweb-file-row {
			display: flex;
			align-items: center;
			gap: 0.6rem;
			padding: 0.4rem 0.8rem;
			border-bottom: 1px solid var(--pico-muted-border-color);
			transition: var(--yweb-transition);
			cursor: default;
			font-size: var(--yweb-font-sm);
		}

		.yweb-file-row:last-child {
			border-bottom: none;
		}

		.yweb-file-row:hover {
			background: var(--yweb-accent-light);
		}

		.yweb-file-row.is-dir {
			cursor: pointer;
		}

		/* File icon */
		.yweb-file-icon {
			width: 20px;
			height: 20px;
			flex-shrink: 0;
			color: var(--pico-muted-color);
		}

		.yweb-file-row.is-dir .yweb-file-icon {
			color: var(--yweb-accent);
		}

		/* File info */
		.yweb-file-info {
			flex: 1;
			min-width: 0;
			display: flex;
			align-items: center;
			gap: 0.6rem;
		}

		.yweb-file-name {
			flex: 1;
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
		}

		.yweb-file-name.editing {
			display: flex;
			gap: 0.3rem;
		}

		.yweb-file-name.editing input {
			all: unset;
			box-sizing: border-box;
			flex: 1;
			padding: 0.15rem 0.3rem;
			border: 1px solid var(--yweb-accent);
			border-radius: var(--yweb-radius);
			font-size: inherit;
			font-family: inherit;
			color: inherit;
			background: var(--pico-card-background-color);
		}

		.yweb-file-size {
			width: 70px;
			text-align: right;
			color: var(--pico-muted-color);
			flex-shrink: 0;
			font-size: var(--yweb-font-xs);
		}

		.yweb-file-date {
			width: 120px;
			color: var(--pico-muted-color);
			flex-shrink: 0;
			font-size: var(--yweb-font-xs);
		}

		/* File actions */
		.yweb-file-actions {
			display: flex;
			gap: 0.2rem;
			flex-shrink: 0;
			opacity: 0;
			transition: opacity 0.15s ease;
		}

		.yweb-file-row:hover .yweb-file-actions {
			opacity: 1;
		}

		.yweb-file-actions .yweb-btn {
			padding: 0.2rem 0.3rem;
		}

		.yweb-file-actions .yweb-btn svg {
			width: 13px;
			height: 13px;
		}

		/* Parent dir row */
		.yweb-file-row.parent-dir {
			color: var(--pico-muted-color);
			font-weight: 500;
		}

		.yweb-file-row.parent-dir .yweb-file-icon {
			color: var(--pico-muted-color);
		}

		/* Upload area */
		.yweb-upload-area {
			display: none;
			padding: 0.8rem;
			border-bottom: 1px solid var(--pico-muted-border-color);
			background: var(--pico-card-sectioning-background-color);
		}

		.yweb-upload-area.active {
			display: block;
		}

		.yweb-upload-dropzone {
			border: 2px dashed var(--pico-muted-border-color);
			border-radius: var(--yweb-radius-lg);
			padding: 1.5rem;
			text-align: center;
			color: var(--pico-muted-color);
			transition: var(--yweb-transition);
		}

		.yweb-upload-dropzone.dragover {
			border-color: var(--yweb-accent);
			background: var(--yweb-accent-light);
			color: var(--yweb-accent);
		}

		.yweb-upload-progress {
			margin-top: 0.5rem;
			display: none;
		}

		.yweb-upload-progress.active {
			display: block;
		}

		.yweb-upload-progress progress {
			width: 100%;
			height: 4px;
		}

		/* New folder input in toolbar */
		#newFolderRow {
			display: none;
			padding: 0.4rem 0.6rem;
			border-bottom: 1px solid var(--pico-muted-border-color);
			background: var(--pico-card-sectioning-background-color);
		}

		#newFolderRow.active {
			display: flex;
			align-items: center;
			gap: 0.4rem;
		}

		#newFolderRow input {
			all: unset;
			box-sizing: border-box;
			flex: 1;
			padding: 0.3rem 0.5rem;
			border: 1px solid var(--yweb-accent);
			border-radius: var(--yweb-radius);
			font-size: var(--yweb-font-sm);
			font-family: inherit;
			color: inherit;
			background: var(--pico-card-background-color);
		}

		/* Mobile Accordion */
		@media (max-width: 800px) {
			.yweb-files-grid {
				display: flex;
				flex-direction: column;
				gap: 0.4rem;
				overflow: auto;
			}

			.yweb-card-indicator {
				display: flex;
			}

			.yweb-sidebar-card,
			.yweb-filelist-card {
				flex: none;
				max-height: none;
				min-height: auto;
			}

			.yweb-sidebar-card .yweb-card-header,
			.yweb-filelist-card .yweb-card-header {
				cursor: pointer;
				position: relative;
				padding-right: 2rem;
			}

			.yweb-sidebar-card .yweb-card-title,
			.yweb-filelist-card .yweb-card-title {
				font-size: 0.9rem;
			}

			.yweb-card.collapsed .yweb-card-preview {
				display: inline-block;
			}

			/* Chevron indicator */
			.yweb-sidebar-card .yweb-card-header::after,
			.yweb-filelist-card .yweb-card-header::after {
				content: '\25BC';
				position: absolute;
				right: 0.5rem;
				top: 50%;
				transform: translateY(-50%);
				font-size: 0.55rem;
				color: var(--pico-muted-color);
				transition: transform 0.2s ease;
				pointer-events: none;
			}

			.yweb-card:not(.collapsed) .yweb-card-header::after {
				transform: translateY(-50%) rotate(180deg);
			}

			.yweb-sidebar-card .yweb-card-body,
			.yweb-filelist-card .yweb-card-body {
				display: block;
				max-height: 60dvh;
				overflow-y: auto;
			}

			.yweb-card.collapsed .yweb-card-body,
			.yweb-card.collapsed .yweb-files-toolbar,
			.yweb-card.collapsed .yweb-breadcrumb,
			.yweb-card.collapsed .yweb-upload-area,
			.yweb-card.collapsed #newFolderRow {
				display: none;
			}

			/* File actions always visible on mobile */
			.yweb-file-actions {
				opacity: 1;
			}

			.yweb-file-row {
				padding: 0.5rem 0.6rem;
			}

			/* Hide date on mobile */
			.yweb-file-date {
				display: none;
			}
		}

		[data-theme="light"] .yweb-file-row {
			border-bottom-color: #e5e7eb;
		}

		[data-theme="light"] .yweb-file-row:hover {
			background: #f8f9fa;
		}

	</style>
</head>
<body>
	<div class="yweb-header-wrapper" data-page="tools"></div>
	<div class="yweb-header-spacer"></div>

	<!-- Main Content: 2-Column Grid -->
	<main class="yweb-files-grid">
		<!-- Sidebar Card -->
		<article class="yweb-card yweb-panel-card yweb-card-sm yweb-sidebar-card" id="card-sidebar">
			<header class="yweb-card-header" onclick="toggleCard('card-sidebar')">
				<h3 class="yweb-card-title">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
					</svg>
					{=L:yw.fm.dirs=}
				</h3>
				<span class="yweb-card-preview" id="sidebarPreview">--</span>
			</header>
			<div class="yweb-card-body">
				<ul class="yweb-plain-list yweb-quick-list" id="quickList"></ul>
			</div>
		</article>

		<!-- File List Card -->
		<article class="yweb-card yweb-panel-card yweb-card-sm yweb-filelist-card" id="card-files">
			<header class="yweb-card-header" onclick="toggleCard('card-files')">
				<h3 class="yweb-card-title">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
						<polyline points="14,2 14,8 20,8"/>
					</svg>
					<span id="fileListTitle">{=L:yw.tools.files=}</span>
				</h3>
				<span class="yweb-card-preview" id="filesPreview">--</span>
			</header>

			<!-- Breadcrumb -->
			<nav class="yweb-breadcrumb" id="breadcrumb"></nav>

			<!-- Toolbar -->
			<div class="yweb-files-toolbar">
				<button class="yweb-btn" onclick="showNewFolderInput()" title="{=L:yw.fm.new_folder=}">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z"/>
						<line x1="12" y1="11" x2="12" y2="17"/>
						<line x1="9" y1="14" x2="15" y2="14"/>
					</svg>
					<span class="btn-label">{=L:yw.fm.folder=}</span>
				</button>
				<button class="yweb-btn" onclick="toggleUpload()" title="{=L:yw.fm.upload=}">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
						<polyline points="17,8 12,3 7,8"/>
						<line x1="12" y1="3" x2="12" y2="15"/>
					</svg>
					<span class="btn-label">Upload</span>
				</button>
				<button class="yweb-btn" onclick="refreshDir()" title="{=L:yw.si.refresh=}">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<polyline points="23,4 23,10 17,10"/>
						<path d="M20.49 15a9 9 0 11-2.12-9.36L23 10"/>
					</svg>
				</button>
				<span class="yweb-toolbar-spacer"></span>
				<span class="yweb-disk-info" id="diskInfo"></span>
			</div>

			<!-- New folder input -->
			<div id="newFolderRow">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px;height:16px;color:var(--yweb-accent);flex-shrink:0">
					<path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z"/>
				</svg>
				<input type="text" id="newFolderName" placeholder="{=L:yw.fm.folder_name=}" onkeydown="handleNewFolderKey(event)">
				<button class="yweb-btn primary" onclick="createFolder()" style="padding:0.25rem 0.5rem">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px">
						<polyline points="20,6 9,17 4,12"/>
					</svg>
				</button>
				<button class="yweb-btn" onclick="hideNewFolderInput()" style="padding:0.25rem 0.5rem">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px">
						<line x1="18" y1="6" x2="6" y2="18"/>
						<line x1="6" y1="6" x2="18" y2="18"/>
					</svg>
				</button>
			</div>

			<!-- Upload area -->
			<div class="yweb-upload-area" id="uploadArea">
				<div class="yweb-upload-dropzone" id="dropzone">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:32px;height:32px;margin-bottom:0.5rem">
						<path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
						<polyline points="17,8 12,3 7,8"/>
						<line x1="12" y1="3" x2="12" y2="15"/>
					</svg>
					<div>{=L:yw.fm.drop_here=} <a href="#" onclick="document.getElementById('fileInput').click(); return false;">{=L:yw.fm.choose=}</a></div>
					<input type="file" id="fileInput" style="display:none" onchange="uploadFile(this.files[0])">
				</div>
				<div class="yweb-upload-progress" id="uploadProgress">
					<progress id="uploadBar" value="0" max="100"></progress>
					<div style="font-size:var(--yweb-font-xs);color:var(--pico-muted-color);margin-top:0.3rem" id="uploadStatus"></div>
				</div>
			</div>

			<!-- File list -->
			<div class="yweb-card-body">
				<ul class="yweb-plain-list yweb-file-list" id="fileList">
					<li aria-busy="true" style="padding:1rem;text-align:center">{=L:yw.msg.loading=}</li>
				</ul>
			</div>
		</article>

		<!-- Mobile Card Indicator -->
		<div class="yweb-card-indicator" id="cardIndicator"></div>
	</main>

	<script src="/Y_Baselib.js"></script>
	<script src="/Y_Lang.yjs?v=8"></script>
	<script src="/yweb-header.js?v=40"></script>
	<script>
		// State
		let currentPath = '/';
		let quickDirs = [];

		// SVG icon templates
		const ICONS = {
			folder: '<svg class="yweb-file-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z"/></svg>',
			file: '<svg class="yweb-file-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14,2 14,8 20,8"/></svg>',
			link: '<svg class="yweb-file-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"/></svg>',
			parent: '<svg class="yweb-file-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15,18 9,12 15,6"/></svg>',
			download: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7,10 12,15 17,10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>',
			rename: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3a2.83 2.83 0 114 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>',
			delete: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3,6 5,6 21,6"/><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/></svg>'
		};

		// Format file size
		function formatFileSize(bytes) {
			if (bytes === 0) return '0 B';
			const units = ['B', 'KB', 'MB', 'GB', 'TB'];
			const k = 1024;
			const i = Math.floor(Math.log(bytes) / Math.log(k));
			return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + units[i];
		}

		// Format timestamp to readable date
		function formatFileDate(timestamp) {
			if (!timestamp) return '';
			const d = new Date(timestamp * 1000);
			const pad = n => n < 10 ? '0' + n : n;
			return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes());
		}

		// Normalize path (remove double slashes, trailing slash)
		function normPath(p) {
			p = p.replace(/\/+/g, '/');
			if (p.length > 1 && p.endsWith('/')) p = p.slice(0, -1);
			return p || '/';
		}

		// ===== Quick Access Sidebar =====

		async function loadQuickDirs() {
			quickDirs = [
				{ name: 'Root /', path: '/' },
				{ name: 'Home', path: '/home' },
				{ name: 'Tmp', path: '/tmp' }
			];

			// Load paths from API
			try {
				const paths = await ywebApi('paths');
				if (paths.configdir) quickDirs.push({ name: 'Config', path: paths.configdir });
				if (paths.plugindir) quickDirs.push({ name: 'Plugins', path: paths.plugindir });
			} catch (e) {
				quickDirs.push({ name: 'Config', path: '/var/tuxbox/config' });
			}

			// Load recording dirs
			try {
				const data = await ywebApi('getdir');
				const dirs = data.dirs || data;
				if (Array.isArray(dirs)) {
					dirs.forEach(d => {
						const dir = d.dir || d;
						if (dir && typeof dir === 'string') {
							const name = dir.split('/').filter(Boolean).pop() || dir;
							quickDirs.push({ name: 'Rec: ' + name, path: dir });
						}
					});
				}
			} catch (e) {
				// ignore
			}

			renderQuickDirs();
		}

		function renderQuickDirs() {
			const list = document.getElementById('quickList');
			let html = '';
			quickDirs.forEach(d => {
				const isActive = normPath(d.path) === normPath(currentPath);
				html += '<li class="yweb-nav-item yweb-quick-item' + (isActive ? ' active' : '') + '" onclick="navigateTo(\'' + escapeJs(d.path) + '\')">'
					+ '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z"/></svg>'
					+ '<span class="yweb-nav-name yweb-quick-name">' + escapeHtml(d.name) + '</span>'
					+ '</li>';
			});
			list.innerHTML = html;
		}

		// ===== Breadcrumb =====

		function renderBreadcrumb() {
			const el = document.getElementById('breadcrumb');
			if (currentPath === '/') {
				el.innerHTML = '<span class="yweb-breadcrumb-current">/</span>';
				return;
			}

			const parts = currentPath.split('/').filter(Boolean);
			let html = '<a href="#" onclick="navigateTo(\'/\'); return false;">/</a>';

			let accumulated = '';
			parts.forEach((part, i) => {
				accumulated += '/' + part;
				html += '<span class="yweb-breadcrumb-sep">/</span>';
				if (i === parts.length - 1) {
					html += '<span class="yweb-breadcrumb-current">' + escapeHtml(part) + '</span>';
				} else {
					html += '<a href="#" onclick="navigateTo(\'' + escapeJs(accumulated) + '\'); return false;">' + escapeHtml(part) + '</a>';
				}
			});

			el.innerHTML = html;
		}

		// ===== File Listing =====

		async function loadDir(path) {
			currentPath = normPath(path);
			renderBreadcrumb();
			renderQuickDirs();
			updatePreviews();

			const list = document.getElementById('fileList');
			list.innerHTML = '<li aria-busy="true" style="padding:1rem;text-align:center">{=L:yw.msg.loading=}</li>';

			// Update title
			const title = document.getElementById('fileListTitle');
			const dirName = currentPath === '/' ? '/' : currentPath.split('/').filter(Boolean).pop();
			title.textContent = dirName;

			try {
				const data = await ywebApi('file', {action: 'list', path: currentPath});
				const files = data?.data?.filelist || data?.filelist || [];

				// Sort: directories first, then alphabetical
				files.sort((a, b) => {
					const aDir = a.type_str === 'dir' || a.type === 4;
					const bDir = b.type_str === 'dir' || b.type === 4;
					if (aDir && !bDir) return -1;
					if (!aDir && bDir) return 1;
					return (a.name || '').localeCompare(b.name || '');
				});

				let html = '';

				// Parent directory link
				if (currentPath !== '/') {
					const parentPath = currentPath.substring(0, currentPath.lastIndexOf('/')) || '/';
					html += '<li class="yweb-file-row parent-dir is-dir" onclick="navigateTo(\'' + escapeJs(parentPath) + '\')">'
						+ ICONS.parent
						+ '<div class="yweb-file-info"><span class="yweb-file-name">..</span></div>'
						+ '</li>';
				}

				if (files.length === 0 && currentPath === '/') {
					html += '<li style="padding:1rem;text-align:center;color:var(--pico-muted-color)">{=L:yw.fm.empty=}</li>';
				}

				files.forEach(f => {
					const isDir = f.type_str === 'dir' || f.type === 4;
					const isLink = f.type_str === 'link' || f.type === 10;
					const icon = isDir ? ICONS.folder : (isLink ? ICONS.link : ICONS.file);
					const fullpath = f.fullname || (currentPath + '/' + f.name).replace(/\/+/g, '/');
					const size = isDir ? '' : formatFileSize(parseInt(f.size) || 0);
					const date = formatFileDate(parseInt(f.time_t) || 0);

					html += '<li class="yweb-file-row' + (isDir ? ' is-dir' : '') + '" data-path="' + escapeHtml(fullpath) + '" data-name="' + escapeHtml(f.name) + '" data-isdir="' + isDir + '"'
						+ (isDir ? ' onclick="navigateTo(\'' + escapeJs(fullpath) + '\')"' : '')
						+ '>'
						+ icon
						+ '<div class="yweb-file-info">'
						+ '<span class="yweb-file-name" id="fname-' + escapeHtml(f.name) + '">' + escapeHtml(f.name) + '</span>'
						+ '<span class="yweb-file-size">' + size + '</span>'
						+ '<span class="yweb-file-date">' + date + '</span>'
						+ '</div>'
						+ '<div class="yweb-file-actions" onclick="event.stopPropagation()">';

					// Download (files only)
					if (!isDir) {
						html += '<a class="yweb-btn" href="/api/v4/file?action=download&path=' + encodeURIComponent(fullpath) + '" download title="{=L:yw.fm.download=}">' + ICONS.download + '</a>';
					}

					// Rename
					html += '<button class="yweb-btn" onclick="startRename(\'' + escapeJs(fullpath) + '\', \'' + escapeJs(f.name) + '\')" title="{=L:yw.fm.rename=}">' + ICONS.rename + '</button>';

					// Delete
					html += '<button class="yweb-btn" onclick="deleteItem(\'' + escapeJs(fullpath) + '\', \'' + escapeJs(f.name) + '\', ' + isDir + ')" title="{=L:yw.fm.delete=}" style="color:var(--yweb-danger)">' + ICONS.delete + '</button>';

					html += '</div></li>';
				});

				list.innerHTML = html || '<li style="padding:1rem;text-align:center;color:var(--pico-muted-color)">{=L:yw.fm.empty=}</li>';

				// Load disk info
				loadDiskInfo();
			} catch (e) {
				console.error('Failed to load directory:', e);
				list.innerHTML = '<li style="padding:1rem;text-align:center;color:var(--yweb-danger)">Fehler beim Laden: ' + escapeHtml(e.message) + '</li>';
			}
		}

		function navigateTo(path) {
			loadDir(path);
			// Mobile: switch to file list card
			if (window.innerWidth <= 800) {
				selectCard('card-files');
			}
		}

		function refreshDir() {
			loadDir(currentPath);
		}

		// ===== Disk Info =====

		async function loadDiskInfo() {
			try {
				const data = await ywebApi('statfs', {dir: currentPath});
				// statfs delivers raw f_* fields (the old Total_bytes keys
				// never existed in this payload, the card was silently dead)
				const st = data?.data?.statfs || {};
				const bsize = parseInt(st.f_bsize) || 0;
				const total = (parseInt(st.f_blocks) || 0) * bsize;
				const free = (parseInt(st.f_bavail) || 0) * bsize;
				const used = total - free;
				const pct = total > 0 ? Math.round(used * 100 / total) + '%' : '';

				if (total > 0) {
					document.getElementById('diskInfo').textContent = formatFileSize(free) + ' frei / ' + formatFileSize(total) + ' (' + pct + ')';
				}
			} catch (e) {
				// ignore
			}
		}

		// ===== File Actions =====

		// Delete
		function deleteItem(fullpath, name, isDir) {
			ywebShowConfirm(
				'{=L:yw.fm.delete=}',
				(isDir ? '{=L:yw.fm.folder=}' : '{=L:yw.fm.file=}') + ' "' + name + '" {=L:yw.fm.delete_confirm=}',
				'{=L:yw.fm.delete=}',
				function() {
					doDelete(fullpath, isDir);
				}
			);
		}

		async function doDelete(fullpath, isDir) {
			try {
				const action = isDir ? 'filemgr_rmdir' : 'filemgr_rm';
				await ywebApi('exec', 'Y_NAS&' + action + '&' + encodeURIComponent(fullpath), {raw: true});
				ywebShowToast('{=L:yw.fm.deleted=}');
				refreshDir();
			} catch (e) {
				ywebShowToast('{=L:yw.fm.delete_fail=}: ' + e.message, true);
			}
		}

		// Rename
		function startRename(fullpath, name) {
			// Find the file row
			const row = document.querySelector('.yweb-file-row[data-path="' + CSS.escape(fullpath) + '"]');
			if (!row) return;

			const nameEl = row.querySelector('.yweb-file-name');
			const origName = name;

			nameEl.classList.add('editing');
			nameEl.innerHTML = '<input type="text" value="' + escapeHtml(origName) + '" id="renameInput">'
				+ '<button class="yweb-btn primary" onclick="doRename(\'' + escapeJs(fullpath) + '\', \'' + escapeJs(origName) + '\')" style="padding:0.15rem 0.3rem">'
				+ '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:12px;height:12px"><polyline points="20,6 9,17 4,12"/></svg>'
				+ '</button>'
				+ '<button class="yweb-btn" onclick="refreshDir()" style="padding:0.15rem 0.3rem">'
				+ '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:12px;height:12px"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>'
				+ '</button>';

			const input = document.getElementById('renameInput');
			input.focus();
			// Select filename without extension
			const dotIdx = origName.lastIndexOf('.');
			if (dotIdx > 0) {
				input.setSelectionRange(0, dotIdx);
			} else {
				input.select();
			}
			input.onkeydown = function(e) {
				if (e.key === 'Enter') doRename(fullpath, origName);
				if (e.key === 'Escape') refreshDir();
			};
		}

		async function doRename(fullpath, origName) {
			const input = document.getElementById('renameInput');
			if (!input) return;

			const newName = input.value.trim();
			if (!newName || newName === origName) {
				refreshDir();
				return;
			}

			try {
				const dir = fullpath.substring(0, fullpath.lastIndexOf('/'));
				const oldPath = fullpath;
				const newPath = dir + '/' + newName;
				await ywebApi('exec', 'Y_NAS&filemgr_ren&' + encodeURIComponent(oldPath) + '&' + encodeURIComponent(newPath), {raw: true});
				ywebShowToast('{=L:yw.fm.renamed=}');
				refreshDir();
			} catch (e) {
				ywebShowToast('{=L:yw.fm.rename_fail=}: ' + e.message, true);
			}
		}

		// ===== Create Folder =====

		function showNewFolderInput() {
			const row = document.getElementById('newFolderRow');
			row.classList.add('active');
			const input = document.getElementById('newFolderName');
			input.value = '';
			input.focus();
		}

		function hideNewFolderInput() {
			document.getElementById('newFolderRow').classList.remove('active');
		}

		function handleNewFolderKey(e) {
			if (e.key === 'Enter') createFolder();
			if (e.key === 'Escape') hideNewFolderInput();
		}

		async function createFolder() {
			const input = document.getElementById('newFolderName');
			const name = input.value.trim();
			if (!name) return;

			try {
				const path = normPath(currentPath + '/' + name);
				await ywebApi('exec', 'Y_NAS&filemgr_mkdir&' + encodeURIComponent(path), {raw: true});
				hideNewFolderInput();
				ywebShowToast('{=L:yw.fm.folder_created=}');
				refreshDir();
			} catch (e) {
				ywebShowToast('{=L:yw.msg.error=}: ' + e.message, true);
			}
		}

		// ===== Upload =====

		function toggleUpload() {
			const area = document.getElementById('uploadArea');
			area.classList.toggle('active');
		}

		async function uploadFile(file) {
			if (!file) return;

			const progress = document.getElementById('uploadProgress');
			const bar = document.getElementById('uploadBar');
			const status = document.getElementById('uploadStatus');

			progress.classList.add('active');
			status.textContent = '{=L:yw.fm.uploading=}: ' + file.name;
			bar.value = 0;

			try {
				const formData = new FormData();
				formData.append('file', file);

				const xhr = new XMLHttpRequest();
				xhr.open('POST', '/api/v4/file?action=upload&path=' + encodeURIComponent(currentPath));

				xhr.upload.onprogress = function(e) {
					if (e.lengthComputable) {
						bar.value = Math.round((e.loaded / e.total) * 100);
					}
				};

				await new Promise((resolve, reject) => {
					xhr.onload = function() {
						if (xhr.status >= 200 && xhr.status < 300) resolve();
						else reject(new Error('{=L:yw.inst.upfail=}: ' + xhr.status));
					};
					xhr.onerror = reject;
					xhr.send(formData);
				});

				status.textContent = '{=L:yw.fm.done=}: ' + file.name;
				ywebShowToast('{=L:yw.fm.uploaded=}: ' + file.name);
				setTimeout(() => {
					progress.classList.remove('active');
					document.getElementById('uploadArea').classList.remove('active');
				}, 2000);
				refreshDir();
			} catch (e) {
				status.textContent = '{=L:yw.msg.error=}: ' + e.message;
				ywebShowToast('{=L:yw.fm.upload_fail=}: ' + e.message, true);
			}

			// Reset file input
			document.getElementById('fileInput').value = '';
		}

		// Drag & Drop
		const dropzone = document.getElementById('dropzone');
		dropzone.addEventListener('dragover', function(e) {
			e.preventDefault();
			this.classList.add('dragover');
		});
		dropzone.addEventListener('dragleave', function() {
			this.classList.remove('dragover');
		});
		dropzone.addEventListener('drop', function(e) {
			e.preventDefault();
			this.classList.remove('dragover');
			if (e.dataTransfer.files.length > 0) {
				uploadFile(e.dataTransfer.files[0]);
			}
		});

		// ===== Preview Updates =====

		function updatePreviews() {
			const sidebarPreview = document.getElementById('sidebarPreview');
			const filesPreview = document.getElementById('filesPreview');

			if (sidebarPreview) {
				const active = quickDirs.find(d => normPath(d.path) === normPath(currentPath));
				sidebarPreview.textContent = active ? active.name : currentPath;
			}
			if (filesPreview) {
				filesPreview.textContent = currentPath;
			}
		}

		// ===== Pull-to-Refresh =====

		function isAtScrollTop() {
			const expandedCard = document.querySelector('.yweb-card:not(.collapsed)');
			if (expandedCard) {
				const cardBody = expandedCard.querySelector('.yweb-card-body');
				if (cardBody && cardBody.scrollTop > 5) return false;
			}
			const main = document.querySelector('.yweb-files-grid');
			if (main && main.scrollTop > 5) return false;
			return true;
		}

		// ===== Initialize =====

		loadQuickDirs();
		loadDir('/');

		document.addEventListener('DOMContentLoaded', function() {
			ywebInitMobileAccordion({
				cardOrder: ['card-sidebar', 'card-files'],
				storageKey: 'yweb-files-card',
				defaultCard: 'card-files',
				breakpoint: 800,
				indicatorId: 'cardIndicator',
				containerSelector: '.yweb-files-grid',
				mode: 'collapsed'
			});
		});

		if (typeof ywebSetRefreshCallback === 'function') {
			ywebSetRefreshCallback(function() {
				if (!isAtScrollTop()) return Promise.resolve();
				return loadDir(currentPath);
			});
		}

		if (typeof window.ywebIsAtScrollTop === 'undefined') {
			window.ywebIsAtScrollTop = isAtScrollTop;
		}
	</script>
</body>
</html>
