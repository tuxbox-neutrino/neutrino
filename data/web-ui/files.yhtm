<!DOCTYPE html>
<html lang="de" data-theme="dark">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Neutrino-Web-UI - {=L:yw.tools.files=}</title>
	<link rel="icon" href="/favicon/favicon.ico">
	<script>
		// Apply the stored theme before first paint: yweb-header.js runs
		// too late, and some pages never load it at all.
		try { document.documentElement.setAttribute('data-theme', localStorage.getItem('yweb-theme') || 'dark'); } catch (e) {}
	</script>
	<link rel="stylesheet" href="/css/pico.min.css">
	<link rel="stylesheet" href="/css/yweb.css?v=89">
	<style>
		/* 2-column grid layout */
		main.yweb-files-grid {
			display: grid;
			grid-template-columns: 240px 1fr;
			gap: 0.6rem;
			padding: 0.5rem;
			overflow: hidden;
		}

		@media (max-width: 800px) {
			main.yweb-files-grid {
				grid-template-columns: 1fr;
				grid-template-rows: auto 1fr;
			}
		}

		/* Compact card headers */

		/* Sidebar card */

		/* Disk usage badge */
		.yweb-disk-usage {
			font-size: var(--yweb-font-xs);
			color: var(--pico-muted-color);
			background: var(--pico-card-sectioning-background-color);
			padding: 0.1rem 0.4rem;
			border-radius: 10px;
		}

		/* File list card */

		/* Toolbar (inside card header) */
		.yweb-files-toolbar {
			display: flex;
			align-items: center;
			gap: 0.4rem;
			flex-wrap: wrap;
			padding: 0.4rem 0.6rem;
			border-bottom: 1px solid var(--pico-muted-border-color);
			background: var(--pico-card-sectioning-background-color);
		}

		.yweb-files-toolbar .yweb-btn {
			padding: 0.25rem 0.5rem;
		}

		.yweb-files-toolbar .yweb-btn svg {
			width: 14px;
			height: 14px;
		}

		.yweb-toolbar-spacer {
			flex: 1;
		}

		.yweb-disk-info {
			font-size: var(--yweb-font-xs);
			color: var(--pico-muted-color);
		}

		/* Breadcrumb */
		.yweb-breadcrumb {
			display: flex;
			align-items: center;
			gap: 0.2rem;
			font-size: var(--yweb-font-sm);
			overflow-x: auto;
			white-space: nowrap;
			padding: 0.3rem 0.6rem;
			border-bottom: 1px solid var(--pico-muted-border-color);
		}

		.yweb-breadcrumb a {
			color: var(--yweb-accent);
			text-decoration: none;
			padding: 0.1rem 0.2rem;
			border-radius: var(--yweb-radius);
		}

		.yweb-breadcrumb a:hover {
			background: var(--yweb-accent-light);
		}

		.yweb-breadcrumb-sep {
			color: var(--pico-muted-color);
			font-size: 0.7em;
		}

		.yweb-breadcrumb-current {
			color: var(--pico-color);
			font-weight: 500;
		}

		/* File list */

		.yweb-file-row {
			display: flex;
			align-items: center;
			gap: 0.6rem;
			padding: 0.4rem 0.8rem;
			border-bottom: 1px solid var(--pico-muted-border-color);
			transition: var(--yweb-transition);
			cursor: default;
			font-size: var(--yweb-font-sm);
		}

		.yweb-file-row:last-child {
			border-bottom: none;
		}

		.yweb-file-row:hover {
			background: var(--yweb-accent-light);
		}

		.yweb-file-row.is-dir {
			cursor: pointer;
		}

		/* File icon */
		.yweb-file-icon {
			width: 20px;
			height: 20px;
			flex-shrink: 0;
			color: var(--pico-muted-color);
		}

		.yweb-file-row.is-dir .yweb-file-icon {
			color: var(--yweb-accent);
		}

		/* File info */
		.yweb-file-info {
			flex: 1;
			min-width: 0;
			display: flex;
			align-items: center;
			gap: 0.6rem;
		}

		.yweb-file-name {
			flex: 1;
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
		}

		.yweb-file-name.editing {
			display: flex;
			gap: 0.3rem;
		}

		.yweb-file-name.editing input {
			all: unset;
			box-sizing: border-box;
			flex: 1;
			padding: 0.15rem 0.3rem;
			border: 1px solid var(--yweb-accent);
			border-radius: var(--yweb-radius);
			font-size: inherit;
			font-family: inherit;
			color: inherit;
			background: var(--pico-card-background-color);
		}

		.yweb-file-size {
			width: 70px;
			text-align: right;
			color: var(--pico-muted-color);
			flex-shrink: 0;
			font-size: var(--yweb-font-xs);
		}

		.yweb-file-date {
			width: 120px;
			color: var(--pico-muted-color);
			flex-shrink: 0;
			font-size: var(--yweb-font-xs);
		}

		/* File actions */
		.yweb-file-actions {
			display: flex;
			gap: 0.2rem;
			flex-shrink: 0;
			opacity: 0;
			transition: opacity 0.15s ease;
		}

		.yweb-file-row:hover .yweb-file-actions {
			opacity: 1;
		}

		.yweb-file-actions .yweb-btn {
			padding: 0.2rem 0.3rem;
		}

		.yweb-file-actions .yweb-btn svg {
			width: 13px;
			height: 13px;
		}

		/* Parent dir row */
		.yweb-file-row.parent-dir {
			color: var(--pico-muted-color);
			font-weight: 500;
		}

		.yweb-file-row.parent-dir .yweb-file-icon {
			color: var(--pico-muted-color);
		}

		/* Upload area */
		.yweb-upload-area {
			display: none;
			padding: 0.8rem;
			border-bottom: 1px solid var(--pico-muted-border-color);
			background: var(--pico-card-sectioning-background-color);
		}

		.yweb-upload-area.active {
			display: block;
		}

		.yweb-upload-dropzone {
			border: 2px dashed var(--pico-muted-border-color);
			border-radius: var(--yweb-radius-lg);
			padding: 1.5rem;
			text-align: center;
			color: var(--pico-muted-color);
			transition: var(--yweb-transition);
		}

		.yweb-upload-dropzone.dragover {
			border-color: var(--yweb-accent);
			background: var(--yweb-accent-light);
			color: var(--yweb-accent);
		}

		.yweb-upload-progress {
			margin-top: 0.5rem;
			display: none;
		}

		.yweb-upload-progress.active {
			display: block;
		}

		.yweb-upload-progress progress {
			width: 100%;
			height: 4px;
		}

		/* New folder input in toolbar */
		#newFolderRow {
			display: none;
			padding: 0.4rem 0.6rem;
			border-bottom: 1px solid var(--pico-muted-border-color);
			background: var(--pico-card-sectioning-background-color);
		}

		#newFolderRow.active {
			display: flex;
			align-items: center;
			gap: 0.4rem;
		}

		#newFolderRow input {
			all: unset;
			box-sizing: border-box;
			flex: 1;
			padding: 0.3rem 0.5rem;
			border: 1px solid var(--yweb-accent);
			border-radius: var(--yweb-radius);
			font-size: var(--yweb-font-sm);
			font-family: inherit;
			color: inherit;
			background: var(--pico-card-background-color);
		}

		/* Mobile Accordion */
		@media (max-width: 800px) {
			.yweb-files-grid {
				display: flex;
				flex-direction: column;
				gap: 0.4rem;
				overflow: auto;
			}

			.yweb-card-indicator {
				display: flex;
			}

			.yweb-sidebar-card,
			.yweb-filelist-card {
				flex: none;
				max-height: none;
				min-height: auto;
			}

			.yweb-sidebar-card .yweb-card-header,
			.yweb-filelist-card .yweb-card-header {
				cursor: pointer;
				position: relative;
				padding-right: 2rem;
			}

			.yweb-sidebar-card .yweb-card-title,
			.yweb-filelist-card .yweb-card-title {
				font-size: 0.9rem;
			}

			.yweb-card.collapsed .yweb-card-preview {
				display: inline-block;
			}

			/* Chevron indicator */
			.yweb-sidebar-card .yweb-card-header::after,
			.yweb-filelist-card .yweb-card-header::after {
				content: '\25BC';
				position: absolute;
				right: 0.5rem;
				top: 50%;
				transform: translateY(-50%);
				font-size: 0.55rem;
				color: var(--pico-muted-color);
				transition: transform 0.2s ease;
				pointer-events: none;
			}

			.yweb-card:not(.collapsed) .yweb-card-header::after {
				transform: translateY(-50%) rotate(180deg);
			}

			.yweb-sidebar-card .yweb-card-body,
			.yweb-filelist-card .yweb-card-body {
				display: block;
				max-height: 60dvh;
				overflow-y: auto;
			}

			.yweb-card.collapsed .yweb-card-body,
			.yweb-card.collapsed .yweb-files-toolbar,
			.yweb-card.collapsed .yweb-breadcrumb,
			.yweb-card.collapsed .yweb-upload-area,
			.yweb-card.collapsed #newFolderRow {
				display: none;
			}

			/* File actions always visible on mobile */
			.yweb-file-actions {
				opacity: 1;
			}

			.yweb-file-row {
				padding: 0.5rem 0.6rem;
			}

			/* Hide date on mobile */
			.yweb-file-date {
				display: none;
			}
		}

		[data-theme="light"] .yweb-file-row {
			border-bottom-color: #e5e7eb;
		}

		[data-theme="light"] .yweb-file-row:hover {
			background: #f8f9fa;
		}

	</style>
</head>
<body>
	<div class="yweb-header-wrapper" data-page="tools"></div>
	<div class="yweb-header-spacer"></div>

	<!-- Main Content: 2-Column Grid -->
	<main class="yweb-files-grid">
		<!-- Sidebar Card -->
		<article class="yweb-card yweb-panel-card yweb-card-sm yweb-sidebar-card" id="card-sidebar">
			<header class="yweb-card-header" onclick="toggleCard('card-sidebar')">
				<h3 class="yweb-card-title">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
					</svg>
					{=L:yw.fm.dirs=}
				</h3>
				<span class="yweb-card-preview" id="sidebarPreview">--</span>
			</header>
			<div class="yweb-card-body">
				<ul class="yweb-plain-list yweb-quick-list" id="quickList"></ul>
			</div>
		</article>

		<!-- File List Card -->
		<article class="yweb-card yweb-panel-card yweb-card-sm yweb-filelist-card" id="card-files">
			<header class="yweb-card-header" onclick="toggleCard('card-files')">
				<h3 class="yweb-card-title">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
						<polyline points="14,2 14,8 20,8"/>
					</svg>
					<span id="fileListTitle">{=L:yw.tools.files=}</span>
				</h3>
				<span class="yweb-card-preview" id="filesPreview">--</span>
			</header>

			<!-- Breadcrumb -->
			<nav class="yweb-breadcrumb" id="breadcrumb"></nav>

			<!-- Toolbar -->
			<div class="yweb-files-toolbar">
				<button class="yweb-btn" onclick="showNewFolderInput()" title="{=L:yw.fm.new_folder=}">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z"/>
						<line x1="12" y1="11" x2="12" y2="17"/>
						<line x1="9" y1="14" x2="15" y2="14"/>
					</svg>
					<span class="btn-label">{=L:yw.fm.folder=}</span>
				</button>
				<button class="yweb-btn" onclick="toggleUpload()" title="{=L:yw.fm.upload=}">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
						<polyline points="17,8 12,3 7,8"/>
						<line x1="12" y1="3" x2="12" y2="15"/>
					</svg>
					<span class="btn-label">Upload</span>
				</button>
				<button class="yweb-btn" onclick="refreshDir()" title="{=L:yw.si.refresh=}">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<polyline points="23,4 23,10 17,10"/>
						<path d="M20.49 15a9 9 0 11-2.12-9.36L23 10"/>
					</svg>
				</button>
				<span class="yweb-toolbar-spacer"></span>
				<span class="yweb-disk-info" id="diskInfo"></span>
			</div>

			<!-- New folder input -->
			<div id="newFolderRow">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px;height:16px;color:var(--yweb-accent);flex-shrink:0">
					<path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z"/>
				</svg>
				<input type="text" id="newFolderName" placeholder="{=L:yw.fm.folder_name=}" onkeydown="handleNewFolderKey(event)">
				<button class="yweb-btn primary" onclick="createFolder()" style="padding:0.25rem 0.5rem">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px">
						<polyline points="20,6 9,17 4,12"/>
					</svg>
				</button>
				<button class="yweb-btn" onclick="hideNewFolderInput()" style="padding:0.25rem 0.5rem">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px">
						<line x1="18" y1="6" x2="6" y2="18"/>
						<line x1="6" y1="6" x2="18" y2="18"/>
					</svg>
				</button>
			</div>

			<!-- Upload area -->
			<div class="yweb-upload-area" id="uploadArea">
				<div class="yweb-upload-dropzone" id="dropzone">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:32px;height:32px;margin-bottom:0.5rem">
						<path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
						<polyline points="17,8 12,3 7,8"/>
						<line x1="12" y1="3" x2="12" y2="15"/>
					</svg>
					<div>{=L:yw.fm.drop_here=} <a href="#" onclick="document.getElementById('fileInput').click(); return false;">{=L:yw.fm.choose=}</a></div>
					<input type="file" id="fileInput" style="display:none" onchange="uploadFile(this.files[0])">
				</div>
				<div class="yweb-upload-progress" id="uploadProgress">
					<progress id="uploadBar" value="0" max="100"></progress>
					<div style="font-size:var(--yweb-font-xs);color:var(--pico-muted-color);margin-top:0.3rem" id="uploadStatus"></div>
				</div>
			</div>

			<!-- File list -->
			<div class="yweb-card-body">
				<ul class="yweb-plain-list yweb-file-list" id="fileList">
					<li aria-busy="true" style="padding:1rem;text-align:center">{=L:yw.msg.loading=}</li>
				</ul>
			</div>
		</article>

		<!-- Mobile Card Indicator -->
		<div class="yweb-card-indicator" id="cardIndicator"></div>
	</main>

	<script src="/Y_Lang.yjs?v=27"></script>
	<script src="/yweb-header.js?v=58"></script>
	<script src="/yweb-dom.js?v=1"></script>
	<script src="/yweb-v1.js?v=13"></script>
	<script>
		// The file manager works through /api/v1/storage: it reaches the
		// directories the box names as its roots (where it records, where its
		// movie browser looks, its plugin folders and the usual media and
		// temporary directories) and nothing else on the box. The top level
		// lists those roots. Rows are built with ywebEl, so a file name is
		// always text, whatever characters it carries.

		// State: '' is the top level, the list of roots
		let currentPath = '';
		let roots = [];		// the roots that are there, as GET /storage/roots names them

		// SVG icon templates (page source, not data)
		const ICONS = {
			folder: '<svg class="yweb-file-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z"/></svg>',
			file: '<svg class="yweb-file-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14,2 14,8 20,8"/></svg>',
			link: '<svg class="yweb-file-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"/></svg>',
			parent: '<svg class="yweb-file-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15,18 9,12 15,6"/></svg>',
			download: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7,10 12,15 17,10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>',
			rename: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3a2.83 2.83 0 114 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>',
			delete: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3,6 5,6 21,6"/><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/></svg>',
			ok: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:12px;height:12px"><polyline points="20,6 9,17 4,12"/></svg>',
			cancel: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:12px;height:12px"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>'
		};

		// Format file size
		function formatFileSize(bytes) {
			if (bytes === 0) return '0 B';
			const units = ['B', 'KB', 'MB', 'GB', 'TB'];
			const k = 1024;
			const i = Math.floor(Math.log(bytes) / Math.log(k));
			return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + units[i];
		}

		// Format timestamp to readable date
		function formatFileDate(timestamp) {
			if (!timestamp) return '';
			const d = new Date(timestamp * 1000);
			const pad = n => n < 10 ? '0' + n : n;
			return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes());
		}

		// Normalize path (remove double slashes, trailing slash)
		function normPath(p) {
			p = p.replace(/\/+/g, '/');
			if (p.length > 1 && p.endsWith('/')) p = p.slice(0, -1);
			return p || '/';
		}

		function joinPath(dir, name) {
			return normPath(dir + '/' + name);
		}

		// The root a path lies in: the longest one it is or lies below
		function rootOf(path) {
			let best = '';
			roots.forEach(r => {
				if ((path === r || path.startsWith(r + '/')) && r.length > best.length) best = r;
			});
			return best;
		}

		function storageQuery(path) {
			return '?path=' + encodeURIComponent(path);
		}

		// A yes or no that shows its text as text (file names among it)
		function askFirst(title, text, ok) {
			return new Promise(resolve => {
				ywebSheet({
					title: title,
					body: ywebEl('p', {}, text),
					actions: [
						{label: ywebL('msg.cancel', 'Cancel'), value: false},
						{label: ok, value: true, danger: true}
					],
					onClose: result => resolve(result === true)
				});
			});
		}

		// ===== Quick Access Sidebar: the roots =====

		async function loadQuickDirs() {
			try {
				const r = await ywebV1('GET', '/storage/roots');
				roots = ((r && r.items) || []).filter(x => x.present).map(x => normPath(x.id));
			} catch (e) {
				roots = [];
				ywebShowToast('{=L:yw.msg.load_fail=}: ' + e.message, true);
			}
			renderQuickDirs();
		}

		function renderQuickDirs() {
			const list = document.getElementById('quickList');
			const items = [{name: '{=L:yw.fm.roots=}', path: ''}].concat(roots.map(r => ({name: r, path: r})));
			list.replaceChildren(...items.map(d => ywebEl('li', {
				className: 'yweb-nav-item yweb-quick-item' + (d.path === currentPath ? ' active' : ''),
				on: {click: () => navigateTo(d.path)}
			}, ywebMarkup('<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z"/></svg>'),
				ywebEl('span', {className: 'yweb-nav-name yweb-quick-name'}, d.name))));
		}

		// ===== Breadcrumb: the roots, the root, then what lies below it =====

		function renderBreadcrumb() {
			const el = document.getElementById('breadcrumb');
			const crumbs = [{name: '{=L:yw.fm.roots=}', path: ''}];
			const root = rootOf(currentPath);
			if (root) {
				crumbs.push({name: root, path: root});
				let acc = root;
				currentPath.substring(root.length).split('/').filter(Boolean).forEach(part => {
					acc += '/' + part;
					crumbs.push({name: part, path: acc});
				});
			}
			const parts = [];
			crumbs.forEach((c, i) => {
				if (i > 0) parts.push(ywebEl('span', {className: 'yweb-breadcrumb-sep'}, '/'));
				if (i === crumbs.length - 1)
					parts.push(ywebEl('span', {className: 'yweb-breadcrumb-current'}, c.name));
				else
					parts.push(ywebEl('a', {attrs: {href: '#'}, on: {click: ev => { ev.preventDefault(); navigateTo(c.path); }}}, c.name));
			});
			el.replaceChildren(...parts);
		}

		// ===== File Listing =====

		function fileRow(entry) {
			const isDir = entry.kind === 'dir';
			const isLink = entry.kind === 'link';
			const fullpath = joinPath(currentPath, entry.id);
			const actions = ywebEl('div', {className: 'yweb-file-actions', on: {click: ev => ev.stopPropagation()}});
			if (!isDir)
				actions.appendChild(ywebEl('a', {className: 'yweb-btn', title: '{=L:yw.fm.download=}',
					attrs: {href: '/api/v1/storage/file' + storageQuery(fullpath), download: entry.id}}, ywebMarkup(ICONS.download)));
			actions.appendChild(ywebEl('button', {type: 'button', className: 'yweb-btn', title: '{=L:yw.fm.rename=}',
				on: {click: () => startRename(fullpath, entry.id)}}, ywebMarkup(ICONS.rename)));
			actions.appendChild(ywebEl('button', {type: 'button', className: 'yweb-btn', title: '{=L:yw.fm.delete=}',
				style: {color: 'var(--yweb-danger)'}, on: {click: () => deleteItem(fullpath, entry.id, isDir)}}, ywebMarkup(ICONS.delete)));

			const size = isDir || !entry.attributes_read ? '' : formatFileSize(entry.size || 0);
			const date = entry.attributes_read ? formatFileDate(entry.mtime || 0) : '';
			return ywebEl('li', {className: 'yweb-file-row' + (isDir ? ' is-dir' : ''), data: {path: fullpath, name: entry.id},
				on: isDir ? {click: () => navigateTo(fullpath)} : {}},
				ywebMarkup(isDir ? ICONS.folder : (isLink ? ICONS.link : ICONS.file)),
				ywebEl('div', {className: 'yweb-file-info'},
					ywebEl('span', {className: 'yweb-file-name'}, entry.id),
					ywebEl('span', {className: 'yweb-file-size'}, size),
					ywebEl('span', {className: 'yweb-file-date'}, date)),
				actions);
		}

		function rootRow(root) {
			return ywebEl('li', {className: 'yweb-file-row is-dir', data: {path: root}, on: {click: () => navigateTo(root)}},
				ywebMarkup(ICONS.folder),
				ywebEl('div', {className: 'yweb-file-info'}, ywebEl('span', {className: 'yweb-file-name'}, root)));
		}

		function note(text, color) {
			return ywebEl('li', {style: {padding: '1rem', 'text-align': 'center', color: color || 'var(--pico-muted-color)'}}, text);
		}

		let listToken = 0;	// a slower answer for a directory left already is dropped

		async function loadDir(path) {
			currentPath = path ? normPath(path) : '';
			const mine = ++listToken;
			renderBreadcrumb();
			renderQuickDirs();
			updatePreviews();

			const list = document.getElementById('fileList');
			const title = document.getElementById('fileListTitle');

			// The top level: the roots, and a word on why there is nothing else
			if (!currentPath) {
				title.textContent = '{=L:yw.fm.roots=}';
				document.getElementById('diskInfo').textContent = '';
				list.replaceChildren(...roots.map(rootRow), note('{=L:yw.fm.roots_note=}'));
				return;
			}

			title.textContent = currentPath.split('/').filter(Boolean).pop() || currentPath;
			list.replaceChildren(ywebEl('li', {attrs: {'aria-busy': 'true'}, style: {padding: '1rem', 'text-align': 'center'}}, '{=L:yw.msg.loading=}'));

			try {
				const data = await ywebV1('GET', '/storage/files', {query: {path: currentPath}});
				if (mine !== listToken) return;
				const files = (data && data.items) || [];

				// Sort: directories first, then alphabetical
				files.sort((a, b) => {
					const aDir = a.kind === 'dir';
					const bDir = b.kind === 'dir';
					if (aDir && !bDir) return -1;
					if (!aDir && bDir) return 1;
					return (a.id || '').localeCompare(b.id || '');
				});

				// Up: from a root to the list of roots, else one directory up
				const parentPath = rootOf(currentPath) === currentPath ? '' :
					(currentPath.substring(0, currentPath.lastIndexOf('/')) || '/');
				const rows = [ywebEl('li', {className: 'yweb-file-row parent-dir is-dir', on: {click: () => navigateTo(parentPath)}},
					ywebMarkup(ICONS.parent),
					ywebEl('div', {className: 'yweb-file-info'}, ywebEl('span', {className: 'yweb-file-name'}, '..')))];
				files.forEach(f => rows.push(fileRow(f)));
				if (!files.length) rows.push(note('{=L:yw.fm.empty=}'));
				list.replaceChildren(...rows);

				loadDiskInfo(mine);
			} catch (e) {
				if (mine !== listToken) return;
				list.replaceChildren(note('{=L:yw.msg.load_fail=}: ' + e.message, 'var(--yweb-danger)'));
			}
		}

		function navigateTo(path) {
			loadDir(path);
			// Mobile: switch to file list card
			if (window.innerWidth <= 800) {
				selectCard('card-files');
			}
		}

		function refreshDir() {
			return loadDir(currentPath);
		}

		// ===== Disk Info: the mount the directory lies on =====

		async function loadDiskInfo(mine) {
			const el = document.getElementById('diskInfo');
			try {
				const data = await ywebV1('GET', '/storage/mounts');
				if (mine !== listToken) return;
				let best = null;
				((data && data.items) || []).forEach(m => {
					const at = m.id === '/' ? '' : m.id;
					if ((currentPath === m.id || currentPath.startsWith(at + '/')) && (!best || m.id.length > best.id.length))
						best = m;
				});
				if (best && best.total > 0) {
					const pct = Math.round((best.total - best.free) * 100 / best.total) + '%';
					el.textContent = formatFileSize(best.free) + ' {=L:yw.fm.free=} / ' + formatFileSize(best.total) + ' (' + pct + ')';
				} else {
					el.textContent = '';
				}
			} catch (e) {
				el.textContent = '';
			}
		}

		// ===== File Actions =====

		// Delete: a file, a link or an empty directory; the box keeps a
		// directory that still holds something and says so
		async function deleteItem(fullpath, name, isDir) {
			const ok = await askFirst('{=L:yw.fm.delete=}',
				(isDir ? '{=L:yw.fm.folder=}' : '{=L:yw.fm.file=}') + ' "' + name + '" {=L:yw.fm.delete_confirm=}',
				'{=L:yw.fm.delete=}');
			if (!ok) return;
			try {
				await ywebV1('DELETE', '/storage/path', {query: {path: fullpath}});
				ywebShowToast('{=L:yw.fm.deleted=}');
				refreshDir();
			} catch (e) {
				ywebShowToast((e.code === 'not-empty' ? '{=L:yw.fm.not_empty=}' : '{=L:yw.fm.delete_fail=}') + ': ' + e.message, true);
			}
		}

		// Rename in place: the name field takes the row's name
		function startRename(fullpath, name) {
			const row = Array.prototype.find.call(document.querySelectorAll('.yweb-file-row'), r => r.dataset.path === fullpath);
			if (!row) return;
			const nameEl = row.querySelector('.yweb-file-name');
			const input = ywebEl('input', {type: 'text', value: name});
			const go = () => doRename(fullpath, name, input.value.trim());
			nameEl.classList.add('editing');
			nameEl.replaceChildren(input,
				ywebEl('button', {type: 'button', className: 'yweb-btn primary', style: {padding: '0.15rem 0.3rem'},
					attrs: {'aria-label': '{=L:yw.fm.rename=}'}, on: {click: go}}, ywebMarkup(ICONS.ok)),
				ywebEl('button', {type: 'button', className: 'yweb-btn', style: {padding: '0.15rem 0.3rem'},
					attrs: {'aria-label': ywebL('msg.cancel', 'Cancel')}, on: {click: () => refreshDir()}}, ywebMarkup(ICONS.cancel)));
			input.focus();
			// Select filename without extension
			const dotIdx = name.lastIndexOf('.');
			if (dotIdx > 0) input.setSelectionRange(0, dotIdx);
			else input.select();
			input.addEventListener('keydown', e => {
				if (e.key === 'Enter') go();
				if (e.key === 'Escape') refreshDir();
			});
		}

		async function doRename(fullpath, origName, newName) {
			if (!newName || newName === origName) {
				refreshDir();
				return;
			}
			if (newName.indexOf('/') >= 0) {
				ywebShowToast('{=L:yw.fm.rename_fail=}: {=L:yw.fm.bad_name=}', true);
				return;
			}
			try {
				const dir = fullpath.substring(0, fullpath.lastIndexOf('/')) || '/';
				await ywebV1('POST', '/storage/rename', {body: {from: fullpath, to: joinPath(dir, newName)}});
				ywebShowToast('{=L:yw.fm.renamed=}');
				refreshDir();
			} catch (e) {
				ywebShowToast('{=L:yw.fm.rename_fail=}: ' + e.message, true);
			}
		}

		// ===== Create Folder =====

		function showNewFolderInput() {
			if (!currentPath) return;	// the top level holds the roots only
			const row = document.getElementById('newFolderRow');
			row.classList.add('active');
			const input = document.getElementById('newFolderName');
			input.value = '';
			input.focus();
		}

		function hideNewFolderInput() {
			document.getElementById('newFolderRow').classList.remove('active');
		}

		function handleNewFolderKey(e) {
			if (e.key === 'Enter') createFolder();
			if (e.key === 'Escape') hideNewFolderInput();
		}

		async function createFolder() {
			const input = document.getElementById('newFolderName');
			const name = input.value.trim();
			if (!name || !currentPath) return;
			if (name.indexOf('/') >= 0) {
				ywebShowToast('{=L:yw.msg.error=}: {=L:yw.fm.bad_name=}', true);
				return;
			}
			try {
				await ywebV1('POST', '/storage/directory', {body: {path: joinPath(currentPath, name)}});
				hideNewFolderInput();
				ywebShowToast('{=L:yw.fm.folder_created=}');
				refreshDir();
			} catch (e) {
				ywebShowToast('{=L:yw.msg.error=}: ' + e.message, true);
			}
		}

		// ===== Upload =====

		function toggleUpload() {
			if (!currentPath) return;
			const area = document.getElementById('uploadArea');
			area.classList.toggle('active');
		}

		// The length the piece file has reached, for a piece whose answer was lost
		/* In pieces below the server's body ceiling, to a hidden name of its own
		   beside the target, which takes the real name at the end: what was there
		   under that name stays whole until the last piece is in, and a name in use
		   is only replaced after asking. An upload that fails takes its pieces away
		   again. */
		async function uploadFile(file) {
			if (!file || !currentPath) return;
			const dir = currentPath;
			const target = joinPath(dir, file.name);
			const part = joinPath(dir, '.' + file.name + '.' + Math.random().toString(36).slice(2, 8) + '.upload');

			const progress = document.getElementById('uploadProgress');
			const bar = document.getElementById('uploadBar');
			const status = document.getElementById('uploadStatus');
			progress.classList.add('active');
			status.textContent = '{=L:yw.fm.uploading=}: ' + file.name;
			bar.value = 0;

			// the pieces take themselves away when they fail; after that the
			// piece file is this upload's to take away
			let uploaded = false;
			try {
				await ywebV1UploadPieces(file, part, (sent, total) => {
					bar.value = total ? Math.round(sent * 100 / total) : 100;
				});
				uploaded = true;

				try {
					await ywebV1('POST', '/storage/rename', {body: {from: part, to: target}});
				} catch (e) {
					if (e.code !== 'name-taken') throw e;
					const replace = await askFirst('{=L:yw.fm.upload=}', '"' + file.name + '" {=L:yw.fm.replace_ask=}', '{=L:yw.fm.replace=}');
					if (!replace) throw new Error('{=L:yw.fm.not_replaced=}');
					await ywebV1('POST', '/storage/rename', {body: {from: part, to: target, overwrite: true}});
				}
				uploaded = false;

				status.textContent = '{=L:yw.fm.done=}: ' + file.name;
				ywebShowToast('{=L:yw.fm.uploaded=}: ' + file.name);
				setTimeout(() => {
					progress.classList.remove('active');
					document.getElementById('uploadArea').classList.remove('active');
				}, 2000);
				if (currentPath === dir) refreshDir();
			} catch (e) {
				status.textContent = '{=L:yw.msg.error=}: ' + e.message;
				ywebShowToast('{=L:yw.fm.upload_fail=}: ' + e.message, true);
				if (uploaded)
					ywebV1('DELETE', '/storage/path', {query: {path: part}}).catch(() => {});
			}

			// Reset file input
			document.getElementById('fileInput').value = '';
		}

		// Drag & Drop
		const dropzone = document.getElementById('dropzone');
		dropzone.addEventListener('dragover', function(e) {
			e.preventDefault();
			this.classList.add('dragover');
		});
		dropzone.addEventListener('dragleave', function() {
			this.classList.remove('dragover');
		});
		dropzone.addEventListener('drop', function(e) {
			e.preventDefault();
			this.classList.remove('dragover');
			if (e.dataTransfer.files.length > 0) {
				uploadFile(e.dataTransfer.files[0]);
			}
		});

		// ===== Preview Updates =====

		function updatePreviews() {
			const sidebarPreview = document.getElementById('sidebarPreview');
			const filesPreview = document.getElementById('filesPreview');
			const where = currentPath || '{=L:yw.fm.roots=}';
			if (sidebarPreview) sidebarPreview.textContent = rootOf(currentPath) || where;
			if (filesPreview) filesPreview.textContent = where;
		}

		// ===== Pull-to-Refresh =====

		function isAtScrollTop() {
			const expandedCard = document.querySelector('.yweb-card:not(.collapsed)');
			if (expandedCard) {
				const cardBody = expandedCard.querySelector('.yweb-card-body');
				if (cardBody && cardBody.scrollTop > 5) return false;
			}
			const main = document.querySelector('.yweb-files-grid');
			if (main && main.scrollTop > 5) return false;
			return true;
		}

		// ===== Initialize =====

		// The roots first, so the top level and the breadcrumb know them; an
		// address with #<path> inside them opens there
		(async function() {
			await loadQuickDirs();
			let asked = '';
			try { asked = decodeURIComponent(location.hash.replace(/^#/, '')); } catch (e) { /* not an address */ }
			loadDir(asked && rootOf(normPath(asked)) ? asked : '');
		})();

		document.addEventListener('DOMContentLoaded', function() {
			ywebInitMobileAccordion({
				cardOrder: ['card-sidebar', 'card-files'],
				storageKey: 'yweb-files-card',
				defaultCard: 'card-files',
				breakpoint: 800,
				indicatorId: 'cardIndicator',
				containerSelector: '.yweb-files-grid',
				mode: 'collapsed'
			});
		});

		if (typeof ywebSetRefreshCallback === 'function') {
			ywebSetRefreshCallback(function() {
				if (!isAtScrollTop()) return Promise.resolve();
				return loadDir(currentPath);
			});
		}

		if (typeof window.ywebIsAtScrollTop === 'undefined') {
			window.ywebIsAtScrollTop = isAtScrollTop;
		}
	</script>
</body>
</html>
