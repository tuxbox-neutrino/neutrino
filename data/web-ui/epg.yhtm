<!DOCTYPE html>
<html lang="de" data-theme="dark">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>yWeb - EPG</title>
	<link rel="icon" href="/favicon/favicon.ico">
	<script>
		// Apply the stored theme before first paint: yweb-header.js runs
		// too late, and some pages never load it at all.
		try { document.documentElement.setAttribute('data-theme', localStorage.getItem('yweb-theme') || 'dark'); } catch (e) {}
	</script>
	<link rel="stylesheet" href="/css/pico.min.css">
	<link rel="stylesheet" href="/css/yweb.css?v=89">
	<style>
		/* Program tile colors. These used to be hard-coded dark slate
		   values, which left dark text on a dark tile in the light theme.
		   Both themes now define their own surface, and text on the accent
		   uses the shared --yweb-on-accent token instead of plain white. */
		:root {
			--epg-prog-bg: #2a3a4a;
			--epg-prog-border: #3a4a5a;
			--epg-prog-rest: #3a5a6a;
			--epg-row-hover: rgba(255, 255, 255, 0.02);
		}

		[data-theme="light"] {
			--epg-prog-bg: #e8eef5;
			--epg-prog-border: #c3d0de;
			--epg-prog-rest: #cbd8e6;
			--epg-row-hover: rgba(0, 0, 0, 0.03);
		}

		.yweb-epg-container {
			padding: 0.3rem;
			max-width: 100%;
			overflow-x: auto;
		}

		/* EPG Toolbar - kompakt in einer Zeile */
		.yweb-epg-toolbar {
			margin-bottom: 0.3rem;
			padding: 0.25rem 0.4rem;
			flex-wrap: nowrap;
		}

		/* Pico stretches form controls to full width, which blew both
		   selects up and shoved the buttons against the right edge. Size
		   them by content instead: bouquet names need room, the time is
		   always "HH:MM". Vertical padding matches .yweb-btn so selects
		   and buttons share one control height; buttons themselves keep
		   the shared component size (no local shrinking). */
		.yweb-epg-toolbar .yweb-select {
			padding: 0.3rem 0.5rem;
			width: auto;
			min-width: 0;
		}

		.yweb-epg-toolbar #bouquetSelect {
			flex: 0 1 16rem;
		}

		/* keep room for Pico's dropdown chevron on the narrow select */
		.yweb-epg-toolbar #timeSelect {
			flex: 0 0 auto;
			padding-right: 1.6rem;
		}

		/* EPG Grid */
		.yweb-epg-grid {
			background: var(--pico-card-background-color);
			border-radius: var(--yweb-radius);
			overflow: hidden;
		}

		/* Time header */
		.yweb-epg-time-header {
			display: flex;
			background: var(--pico-card-sectioning-background-color);
			border-bottom: 1px solid var(--pico-muted-border-color);
			position: sticky;
			top: 0;
			z-index: 10;
			position: relative;
		}

		.yweb-epg-channel-header {
			min-width: 100px;
			width: 100px;
			padding: 0.4rem 0.5rem;
			font-weight: 600;
			font-size: 0.7rem;
			/* muted is too faint for 11px labels in the light theme */
			color: var(--yweb-text-secondary);
			border-right: 1px solid var(--pico-muted-border-color);
			flex-shrink: 0;
		}

		.yweb-epg-times {
			display: flex;
			flex: 1;
			overflow: hidden;
		}

		.yweb-epg-time-slot {
			flex: 1;
			padding: 0.4rem 0.25rem;
			text-align: left;
			padding-left: 0.5rem;
			font-size: 0.7rem;
			font-weight: 500;
			border-right: 1px solid var(--pico-muted-border-color);
			color: var(--yweb-text-secondary);
		}

		/* Channel rows */
		.yweb-epg-channels {
			max-height: calc(100vh - 160px);
			overflow-y: auto;
		}

		.yweb-epg-row {
			display: flex;
			border-bottom: 1px solid var(--pico-muted-border-color);
			min-height: 44px;
		}

		.yweb-epg-row:hover {
			background: var(--epg-row-hover);
		}

		.yweb-epg-channel-name {
			min-width: 100px;
			width: 100px;
			padding: 0.25rem 0.4rem;
			display: flex;
			align-items: center;
			font-size: 0.75rem;
			font-weight: 500;
			border-right: 1px solid var(--pico-muted-border-color);
			cursor: pointer;
			flex-shrink: 0;
			line-height: 1.2;
			overflow: hidden;
		}

		.yweb-epg-channel-name:hover {
			color: var(--yweb-accent);
		}

		.yweb-epg-channel-name span {
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}

		.yweb-epg-channel-logo {
			max-width: 92px;
			max-height: 32px;
			object-fit: contain;
		}

		/* Logos sind fuer dunkle OSDs gezeichnet — im Light-Theme eine
		   dunkle Kachel unterlegen (wie .yweb-icon-placeholder) */
		[data-theme="light"] .yweb-epg-channel-logo {
			background: #1e242e;
			border-radius: 4px;
			padding: 2px 4px;
			/* weicher Verlauf statt harter Kachelkante auf hellem Grund */
			box-shadow: 0 2px 10px rgba(30, 36, 46, 0.35);
		}

		/* Desktop: breitere Senderspalte, sonst schrumpfen Banner-Logos
		   (Sky, 8:1) auf Streifenhoehe; Mobile behaelt die 100px, dort
		   zaehlt jede Programmspalten-Breite */
		@media (min-width: 769px) {
			.yweb-epg-channel-header,
			.yweb-epg-channel-name {
				min-width: 150px;
				width: 150px;
			}

			.yweb-epg-channel-logo {
				max-width: 138px;
			}
		}

		.yweb-epg-programs {
			flex: 1;
			position: relative;
			overflow: hidden;
			height: 40px;
			min-width: 0;
		}

		/* Program items */
		.yweb-epg-program {
			position: absolute;
			top: 2px;
			bottom: 2px;
			background: var(--epg-prog-bg);
			border: 1px solid var(--epg-prog-border);
			border-radius: 3px;
			padding: 2px 6px;
			overflow: hidden;
			cursor: pointer;
			transition: var(--yweb-transition);
			font-size: 0.7rem;
			line-height: 1.15;
			display: flex;
			flex-direction: column;
			justify-content: center;
		}

		.yweb-epg-program:hover {
			background: var(--yweb-accent);
			border-color: var(--yweb-accent);
			color: var(--yweb-on-accent);
			z-index: 5;
			box-shadow: 0 2px 8px rgba(0,0,0,0.3);
		}

		/* Current program with progress bar effect */
		.yweb-epg-program.current {
			background: linear-gradient(to right,
				var(--yweb-accent) 0%,
				var(--yweb-accent) var(--progress, 0%),
				var(--epg-prog-rest) var(--progress, 0%),
				var(--epg-prog-rest) 100%);
			border-color: var(--yweb-accent);
			color: var(--yweb-on-accent);
		}

		.yweb-epg-program.timer-rec {
			border-left: 3px solid var(--yweb-danger);
		}

		.yweb-epg-program.timer-zap {
			border-left: 3px solid var(--yweb-success);
		}

		.yweb-epg-program-title {
			font-weight: 600;
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
			color: inherit;
		}

		.yweb-epg-program-time {
			font-size: 0.6rem;
			opacity: 0.7;
		}

		.yweb-epg-program:hover .yweb-epg-program-time,
		.yweb-epg-program.current .yweb-epg-program-time {
			opacity: 0.9;
		}

		/* Detail Modal */
		.yweb-epg-modal {
			display: none;
			position: fixed;
			top: 0;
			left: 0;
			right: 0;
			bottom: 0;
			background: rgba(0,0,0,0.7);
			z-index: 100;
			align-items: center;
			justify-content: center;
			padding: 1rem;
		}

		.yweb-epg-modal.open {
			display: flex;
		}

		.yweb-epg-modal-content {
			background: var(--pico-card-background-color);
			border-radius: var(--yweb-radius-lg);
			box-shadow: var(--yweb-shadow-lg);
			max-width: 500px;
			width: 100%;
			max-height: 80vh;
			overflow-y: auto;
		}

		.yweb-epg-modal-header {
			display: flex;
			justify-content: space-between;
			align-items: flex-start;
			padding: 1rem;
			border-bottom: 1px solid var(--pico-muted-border-color);
		}

		.yweb-epg-modal-title {
			font-size: 1.1rem;
			font-weight: 600;
			margin: 0;
		}

		.yweb-epg-modal-subtitle {
			font-size: 0.85rem;
			color: var(--pico-muted-color);
			margin-top: 0.25rem;
		}

		.yweb-epg-modal-close {
			background: none;
			border: none;
			color: var(--pico-muted-color);
			cursor: pointer;
			padding: 0.25rem;
		}

		.yweb-epg-modal-close:hover {
			color: var(--pico-color);
		}

		.yweb-epg-modal-close svg {
			width: 20px;
			height: 20px;
		}

		.yweb-epg-modal-body {
			padding: 1rem;
		}

		.yweb-epg-modal-info {
			font-size: 0.9rem;
			color: var(--pico-muted-color);
			margin-bottom: 0.5rem;
		}

		.yweb-epg-modal-desc {
			font-size: 0.9rem;
			line-height: 1.5;
		}

		.yweb-epg-modal-footer {
			display: flex;
			gap: 0.5rem;
			padding: 0.75rem 1rem;
			border-top: 1px solid var(--pico-muted-border-color);
			justify-content: center;
			position: sticky;
			bottom: 0;
			background: var(--pico-card-background-color);
		}

		.yweb-epg-modal-footer .yweb-btn {
			padding: 0.4rem 0.75rem;
			font-size: 0.8rem;
		}

		.yweb-epg-modal-footer .yweb-btn svg {
			width: 14px;
			height: 14px;
		}

		/* Now marker - small triangle at top of header */
		.yweb-epg-now-marker {
			position: absolute;
			bottom: 0;
			transform: translateX(-50%);
			width: 0;
			height: 0;
			border-left: 4px solid transparent;
			border-right: 4px solid transparent;
			border-top: 5px solid #ff4444;
			z-index: 15;
		}

		/* Now line spanning through channels area */
		.yweb-epg-now-line {
			position: absolute;
			top: 0;
			bottom: 0;
			width: 1px;
			background: #ff4444;
			opacity: 0.4;
			z-index: 6;
			pointer-events: none;
		}

		/* Responsive */
		@media (max-width: 768px) {
			.yweb-epg-toolbar {
				flex-direction: column;
				align-items: stretch;
			}

			.yweb-epg-select {
				width: 100%;
			}

			.yweb-epg-channel-header,
			.yweb-epg-channel-name {
				min-width: 80px;
				width: 80px;
			}

			.yweb-epg-time-slot {
				flex: 0 0 60px;
			}
		}
	</style>
</head>
<body>
	<!-- Header wird dynamisch von yweb-header.js generiert -->
	<div class="yweb-header-wrapper" data-page="epg"></div>
	<div class="yweb-header-spacer"></div>

	<!-- Main Content -->
	<main class="yweb-epg-container">
		<!-- Toolbar - kompakt in einer Zeile -->
		<div class="yweb-toolbar yweb-epg-toolbar">
			<select class="yweb-select" id="bouquetSelect">
				<option value="">{=L:yw.nav.bouquets=}...</option>
			</select>
			<select class="yweb-select" id="timeSelect"></select>
			<!-- the time nav belongs next to the time it shifts -->
			<div class="yweb-btn-group">
				<button class="yweb-btn" onclick="changeTime(-2)" title="-2 Stunden">&lt; -2h</button>
				<button class="yweb-btn" onclick="changeTime(2)" title="+2 Stunden">+2h &gt;</button>
			</div>
			<button class="yweb-btn primary" onclick="loadEpg()">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<polyline points="23,4 23,10 17,10"/>
					<path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>
				</svg>
				{=L:yw.si.refresh=}
			</button>
		</div>

		<!-- EPG Grid -->
		<div class="yweb-epg-grid" id="epgGrid">
			<p aria-busy="true" style="padding:3rem;text-align:center;color:var(--pico-muted-color)">{=L:yw.epg.loading=}</p>
		</div>
	</main>

	<!-- Detail Modal -->
	<div class="yweb-epg-modal" id="epgModal">
		<div class="yweb-epg-modal-content">
			<div class="yweb-epg-modal-header">
				<div>
					<h3 class="yweb-epg-modal-title" id="modalTitle">-</h3>
					<div class="yweb-epg-modal-subtitle" id="modalSubtitle">-</div>
				</div>
				<button class="yweb-epg-modal-close" onclick="closeModal()">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<line x1="18" y1="6" x2="6" y2="18"/>
						<line x1="6" y1="6" x2="18" y2="18"/>
					</svg>
				</button>
			</div>
			<div class="yweb-epg-modal-body">
				<div class="yweb-epg-modal-info" id="modalInfo">-</div>
				<div class="yweb-epg-modal-desc" id="modalDesc">-</div>
			</div>
			<div class="yweb-epg-modal-footer">
				<button class="yweb-btn" onclick="zapNow()" title="{=L:yw.epg.zap_title=}">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<polygon points="5,3 19,12 5,21"/>
					</svg>
					{=L:yw.epg.zap=}
				</button>
				<button class="yweb-btn" onclick="setTimerZap()" title="{=L:yw.epg.timer_zap_title=}">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<circle cx="12" cy="12" r="10"/>
						<polyline points="12,6 12,12 16,14"/>
					</svg>
					Timer
				</button>
				<button class="yweb-btn primary" onclick="setTimerRec()" title="{=L:yw.epg.timer_rec_title=}">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<circle cx="12" cy="12" r="10"/>
						<circle cx="12" cy="12" r="3" fill="currentColor"/>
					</svg>
					{=L:yw.bc.recording=}
				</button>
			</div>
		</div>
	</div>

	<script src="/Y_Lang.yjs?v=22"></script>
	<script src="/yweb-header.js?v=53"></script>
	<script>
		// Configuration
		const MINUTES_PER_SLOT = 30;
		const DISPLAY_HOURS = 4;
		const TOTAL_MINUTES = DISPLAY_HOURS * 60; // 240 minutes

		// State
		let currentBouquet = '';
		let currentStartTime = null;
		let selectedProgram = null;
		let timers = [];

		// Initialize time selector
		function initTimeSelect() {
			const select = document.getElementById('timeSelect');
			const now = new Date();
			now.setMinutes(0, 0, 0);

			select.innerHTML = '';
			for (let i = 0; i < 24; i++) {
				const time = new Date(now.getTime() + i * 3600000);
				const option = document.createElement('option');
				option.value = Math.floor(time.getTime() / 1000);
				option.textContent = ywebPad2(time.getHours()) + ':00';
				if (i === 0) option.selected = true;
				select.appendChild(option);
			}

			currentStartTime = parseInt(select.value);
		}

		// Load bouquets — uses shared ywebFetchBouquets()
		async function loadBouquets() {
			const select = document.getElementById('bouquetSelect');
			try {
				const bouquets = await ywebFetchBouquets();
				select.innerHTML = '';
				bouquets.forEach((b, i) => {
					const option = document.createElement('option');
					option.value = b.number;
					option.textContent = b.name;
					if (i === 0) {
						option.selected = true;
						currentBouquet = b.number;
					}
					select.appendChild(option);
				});
			} catch (e) {
				select.innerHTML = '<option>{=L:yw.epg.load_fail=}</option>';
				console.error('Failed to load bouquets:', e);
			}
		}

		// Load timers (json list; replaces the legacy format=id line parser)
		async function loadTimers() {
			try {
				const data = await ywebApi('timer');
				timers = ywebParseTimerList(data).map(t => ({
					eventType: parseInt(t.type_number) || 0,
					alarmTime: parseInt(ywebGetTimerAlarm(t).digits) || 0,
					stopTime: ywebGetTimerStopSec(t),
					channelId: t.channel_id
				}));
			} catch (e) {
				console.error('Failed to load timers:', e);
			}
		}

		// Load EPG data
		async function loadEpg() {
			const grid = document.getElementById('epgGrid');
			grid.innerHTML = '<p aria-busy="true" style="padding:3rem;text-align:center;color:var(--pico-muted-color)">{=L:yw.epg.loading=}</p>';

			currentBouquet = document.getElementById('bouquetSelect').value;
			currentStartTime = parseInt(document.getElementById('timeSelect').value);

			await loadTimers();

			try {
				// Get channels for bouquet — uses shared ywebFetchChannels()
				const channels = await ywebFetchChannels(currentBouquet);

				const stopTime = currentStartTime + (DISPLAY_HOURS * 3600);
				const numSlots = (DISPLAY_HOURS * 60) / MINUTES_PER_SLOT;

				// Build time header
				let html = '<div class="yweb-epg-time-header">';
				html += '<div class="yweb-epg-channel-header">{=L:yw.msg.channel=}</div>';
				html += '<div class="yweb-epg-times">';

				for (let i = 0; i < numSlots; i++) {
					const slotTime = new Date((currentStartTime + i * MINUTES_PER_SLOT * 60) * 1000);
					html += `<div class="yweb-epg-time-slot">${ywebFormatTime(slotTime)}</div>`;
				}

				// Now marker and line
				const now = Math.floor(Date.now() / 1000);
				const nowInWindow = now >= currentStartTime && now < stopTime;
				let nowPercent = 0;
				if (nowInWindow) {
					nowPercent = ((now - currentStartTime) / 60) / TOTAL_MINUTES * 100;
					// Small triangle marker in header
					html += `<div class="yweb-epg-now-marker" style="left:calc(100px + ${nowPercent}%)"></div>`;
				}

				html += '</div></div>';

				// Build channel rows container with single now-line
				html += '<div class="yweb-epg-channels" style="position:relative">';

				// Single now line spanning entire channel area (offset by channel name width)
				if (nowInWindow) {
					html += `<div class="yweb-epg-now-line" style="left:calc(100px + ${nowPercent}%)"></div>`;
				}

				for (const channel of channels) {
					html += await buildChannelRow(channel, currentStartTime, stopTime);
				}

				html += '</div>';

				grid.innerHTML = html;

			} catch (e) {
				grid.innerHTML = '<p class="yweb-empty">{=L:yw.epg.load_fail=}</p>';
				console.error('Failed to load EPG:', e);
			}
		}

		// Build channel row
		async function buildChannelRow(channel, startTime, stopTime) {
			let html = '<div class="yweb-epg-row">';
			html += `<div class="yweb-epg-channel-name" onclick="zapTo('${channel.id}')" title="{=L:yw.epg.zap_to=} ${escapeHtml(channel.name)}">`;
			// Show logo if available, otherwise text
			if (channel.logo) {
				html += `<img class="yweb-epg-channel-logo" src="${channel.logo}" alt="${escapeHtml(channel.name)}" onerror="this.outerHTML='<span>${escapeHtml(channel.name)}</span>'">`;
			} else {
				html += `<span>${escapeHtml(channel.name)}</span>`;
			}
			html += '</div>';
			html += '<div class="yweb-epg-programs">';

			try {
				// Note: stoptime parameter doesn't work reliably, so we fetch all and filter client-side
				const epgData = await ywebApi('epg', {channelid: channel.id, details: 'true'});
				const programs = epgData?.data?.epglist?.progData || [];

				if (programs.length === 0) {
					html += '</div></div>';
					return html;
				}

				const now = Math.floor(Date.now() / 1000);


				for (let i = 0; i < programs.length; i++) {
					const prog = programs[i];
					const progStart = parseInt(prog.start_sec) || 0;
					const progStop = parseInt(prog.stop_sec) || 0;
					const desc = prog.description || '';


					// Skip programs that end before our window
					if (progStop <= startTime) {
						continue;
					}
					// Stop if program starts after our window
					if (progStart >= stopTime) {
						break;
					}


					const info1 = prog.info1 || '';
					const info2 = prog.info2 || '';
					const startT = prog.start_t || '';

					// Calculate position in percent
					const displayStart = Math.max(progStart, startTime);
					const displayStop = Math.min(progStop, stopTime);
					const leftPercent = ((displayStart - startTime) / 60) / TOTAL_MINUTES * 100;
					const widthPercent = ((displayStop - displayStart) / 60) / TOTAL_MINUTES * 100;

					// Check for timer
					let timerClass = '';
					const timer = timers.find(t => t.channelId === channel.id &&
						t.alarmTime <= progStart && t.stopTime >= progStop);
					if (timer) {
						timerClass = timer.eventType === 5 ? ' timer-rec' : ' timer-zap';
					}

					// Check if current and calculate progress
					const isCurrent = (now >= progStart && now < progStop);
					const currentClass = isCurrent ? ' current' : '';
					let progressStyle = '';
					if (isCurrent) {
						const elapsed = now - progStart;
						const total = progStop - progStart;
						const progress = Math.round((elapsed / total) * 100);
						progressStyle = `--progress:${progress}%;`;
					}

					const progData = JSON.stringify({
						channelId: channel.id,
						channelName: channel.name,
						start: progStart,
						stop: progStop,
						startT: startT,
						desc: desc,
						info1: info1,
						info2: info2
					}).replace(/'/g, '&#39;');

					html += `<div class="yweb-epg-program${timerClass}${currentClass}" style="left:${leftPercent}%;width:calc(${widthPercent}% - 2px);${progressStyle}" onclick='showProgramDetail(${progData})'>`;
					html += `<div class="yweb-epg-program-title">${escapeHtml(desc)}</div>`;
					html += `<div class="yweb-epg-program-time">${startT}</div>`;
					html += '</div>';
				}

			} catch (e) {
				console.error(`Failed to load EPG for ${channel.name}:`, e);
			}

			html += '</div></div>';
			return html;
		}

		// Show program detail
		function showProgramDetail(prog) {
			selectedProgram = prog;

			document.getElementById('modalTitle').textContent = prog.desc || '-';
			document.getElementById('modalSubtitle').textContent = prog.channelName || '-';

			const startDate = new Date(prog.start * 1000);
			const stopDate = new Date(prog.stop * 1000);
			const duration = Math.round((prog.stop - prog.start) / 60);
			const timeStr = `${formatTime(startDate)} - ${formatTime(stopDate)} (${duration} Min.)`;
			document.getElementById('modalInfo').textContent = timeStr;

			let desc = prog.info1 || '';
			if (prog.info2) {
				desc += (desc ? '\n\n' : '') + prog.info2;
			}
			document.getElementById('modalDesc').textContent = desc || '{=L:yw.epg.no_desc=}';

			document.getElementById('epgModal').classList.add('open');
		}

		// Close modal
		function closeModal() {
			document.getElementById('epgModal').classList.remove('open');
			selectedProgram = null;
		}

		// Set timer (record)
		async function setTimerRec() {
			if (!selectedProgram) return;

			try {
				await ywebApi('timer', {action: 'new', alarm: selectedProgram.start, stop: selectedProgram.stop, channel_id: selectedProgram.channelId, type: 5});
				ywebShowToast('{=L:yw.epg.timer_rec_set=}');
				closeModal();
				loadEpg();
			} catch (e) {
				ywebShowToast('{=L:yw.epg.timer_fail=}', true);
				console.error('Timer error:', e);
			}
		}

		// Set timer (zap)
		async function setTimerZap() {
			if (!selectedProgram) return;

			try {
				await ywebApi('timer', {action: 'new', alarm: selectedProgram.start, channel_id: selectedProgram.channelId, type: 3});
				ywebShowToast('{=L:yw.epg.timer_zap_set=}');
				closeModal();
				loadEpg();
			} catch (e) {
				ywebShowToast('{=L:yw.epg.timer_fail=}', true);
				console.error('Timer error:', e);
			}
		}

		// Zap now
		async function zapNow() {
			if (!selectedProgram) return;

			try {
				await ywebApi('zapto', String(selectedProgram.channelId));
				closeModal();
			} catch (e) {
				console.error('Zap error:', e);
			}
		}

		// Zap to channel
		async function zapTo(channelId) {
			try {
				await ywebApi('zapto', String(channelId));
			} catch (e) {
				console.error('Zap error:', e);
			}
		}

		// Change time
		function changeTime(hours) {
			const select = document.getElementById('timeSelect');
			const currentIndex = select.selectedIndex;
			const newIndex = Math.max(0, Math.min(select.options.length - 1, currentIndex + hours));
			select.selectedIndex = newIndex;
			loadEpg();
		}


		// Use shared ywebFormatTime() from yweb-header.js
		const formatTime = ywebFormatTime;

		// Event listeners
		document.getElementById('bouquetSelect').addEventListener('change', loadEpg);
		document.getElementById('timeSelect').addEventListener('change', loadEpg);

		// Close modal on background click
		document.getElementById('epgModal').addEventListener('click', function(e) {
			if (e.target === this) closeModal();
		});

		// Initialize
		initTimeSelect();
		loadBouquets().then(loadEpg);

		// Register pull-to-refresh callback
		if (typeof ywebSetRefreshCallback === 'function') {
			ywebSetRefreshCallback(function() {
				return loadEpg();
			});
		}
	</script>
</body>
</html>
