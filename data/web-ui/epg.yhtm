<!DOCTYPE html>
<html lang="de" data-theme="dark">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Neutrino-Web-UI - EPG</title>
	<link rel="icon" href="/favicon/favicon.ico">
	<script>
		// Apply the stored theme before first paint: webui-header.js runs
		// too late, and some pages never load it at all.
		try { document.documentElement.setAttribute('data-theme', localStorage.getItem('webui-theme') || localStorage.getItem('yweb-theme') || 'dark'); } catch (e) {}
	</script>
	<link rel="stylesheet" href="/css/pico.min.css">
	<link rel="stylesheet" href="/css/webui.css?v=89">
	<style>
		/* Program tile colors. These used to be hard-coded dark slate
		   values, which left dark text on a dark tile in the light theme.
		   Both themes now define their own surface, and text on the accent
		   uses the shared --webui-on-accent token instead of plain white. */
		:root {
			--epg-prog-bg: #2a3a4a;
			--epg-prog-border: #3a4a5a;
			--epg-prog-rest: #3a5a6a;
			--epg-row-hover: rgba(255, 255, 255, 0.02);
		}

		[data-theme="light"] {
			--epg-prog-bg: #e8eef5;
			--epg-prog-border: #c3d0de;
			--epg-prog-rest: #cbd8e6;
			--epg-row-hover: rgba(0, 0, 0, 0.03);
		}

		.webui-epg-container {
			padding: 0.3rem;
			max-width: 100%;
			overflow-x: auto;
		}

		/* EPG Toolbar - kompakt in einer Zeile */
		.webui-epg-toolbar {
			margin-bottom: 0.3rem;
			padding: 0.25rem 0.4rem;
			flex-wrap: nowrap;
		}

		/* Pico stretches form controls to full width, which blew both
		   selects up and shoved the buttons against the right edge. Size
		   them by content instead: bouquet names need room, the time is
		   always "HH:MM". Vertical padding matches .webui-btn so selects
		   and buttons share one control height; buttons themselves keep
		   the shared component size (no local shrinking). */
		.webui-epg-toolbar .webui-select {
			padding: 0.3rem 0.5rem;
			width: auto;
			min-width: 0;
		}

		.webui-epg-toolbar #bouquetSelect {
			flex: 0 1 16rem;
		}

		/* keep room for Pico's dropdown chevron on the narrow select */
		.webui-epg-toolbar #timeSelect {
			flex: 0 0 auto;
			padding-right: 1.6rem;
		}

		/* EPG Grid */
		.webui-epg-grid {
			background: var(--pico-card-background-color);
			border-radius: var(--webui-radius);
			overflow: hidden;
		}

		/* Time header */
		.webui-epg-time-header {
			display: flex;
			background: var(--pico-card-sectioning-background-color);
			border-bottom: 1px solid var(--pico-muted-border-color);
			position: sticky;
			top: 0;
			z-index: 10;
			position: relative;
		}

		.webui-epg-channel-header {
			min-width: 100px;
			width: 100px;
			padding: 0.4rem 0.5rem;
			font-weight: 600;
			font-size: 0.7rem;
			/* muted is too faint for 11px labels in the light theme */
			color: var(--webui-text-secondary);
			border-right: 1px solid var(--pico-muted-border-color);
			flex-shrink: 0;
		}

		.webui-epg-times {
			display: flex;
			flex: 1;
			overflow: hidden;
		}

		.webui-epg-time-slot {
			flex: 1;
			padding: 0.4rem 0.25rem;
			text-align: left;
			padding-left: 0.5rem;
			font-size: 0.7rem;
			font-weight: 500;
			border-right: 1px solid var(--pico-muted-border-color);
			color: var(--webui-text-secondary);
		}

		/* Channel rows */
		.webui-epg-channels {
			max-height: calc(100vh - 160px);
			overflow-y: auto;
		}

		.webui-epg-row {
			display: flex;
			border-bottom: 1px solid var(--pico-muted-border-color);
			min-height: 44px;
		}

		.webui-epg-row:hover {
			background: var(--epg-row-hover);
		}

		.webui-epg-channel-name {
			min-width: 100px;
			width: 100px;
			padding: 0.25rem 0.4rem;
			display: flex;
			align-items: center;
			font-size: 0.75rem;
			font-weight: 500;
			border-right: 1px solid var(--pico-muted-border-color);
			cursor: pointer;
			flex-shrink: 0;
			line-height: 1.2;
			overflow: hidden;
		}

		.webui-epg-channel-name:hover {
			color: var(--webui-accent);
		}

		.webui-epg-channel-name span {
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}

		.webui-epg-channel-logo {
			max-width: 92px;
			max-height: 32px;
			object-fit: contain;
		}

		/* Logos sind fuer dunkle OSDs gezeichnet — im Light-Theme eine
		   dunkle Kachel unterlegen (wie .webui-icon-placeholder) */
		[data-theme="light"] .webui-epg-channel-logo {
			background: #1e242e;
			border-radius: 4px;
			padding: 2px 4px;
			/* weicher Verlauf statt harter Kachelkante auf hellem Grund */
			box-shadow: 0 2px 10px rgba(30, 36, 46, 0.35);
		}

		/* Desktop: breitere Senderspalte, sonst schrumpfen Banner-Logos
		   (Sky, 8:1) auf Streifenhoehe; Mobile behaelt die 100px, dort
		   zaehlt jede Programmspalten-Breite */
		@media (min-width: 769px) {
			.webui-epg-channel-header,
			.webui-epg-channel-name {
				min-width: 150px;
				width: 150px;
			}

			.webui-epg-channel-logo {
				max-width: 138px;
			}
		}

		.webui-epg-programs {
			flex: 1;
			position: relative;
			overflow: hidden;
			height: 40px;
			min-width: 0;
		}

		/* Program items */
		.webui-epg-program {
			position: absolute;
			top: 2px;
			bottom: 2px;
			background: var(--epg-prog-bg);
			border: 1px solid var(--epg-prog-border);
			border-radius: 3px;
			padding: 2px 6px;
			overflow: hidden;
			cursor: pointer;
			transition: var(--webui-transition);
			font-size: 0.7rem;
			line-height: 1.15;
			display: flex;
			flex-direction: column;
			justify-content: center;
		}

		.webui-epg-program:hover {
			background: var(--webui-accent);
			border-color: var(--webui-accent);
			color: var(--webui-on-accent);
			z-index: 5;
			box-shadow: 0 2px 8px rgba(0,0,0,0.3);
		}

		/* Current program with progress bar effect */
		.webui-epg-program.current {
			background: linear-gradient(to right,
				var(--webui-accent) 0%,
				var(--webui-accent) var(--progress, 0%),
				var(--epg-prog-rest) var(--progress, 0%),
				var(--epg-prog-rest) 100%);
			border-color: var(--webui-accent);
			color: var(--webui-on-accent);
		}

		.webui-epg-program.timer-rec {
			border-left: 3px solid var(--webui-danger);
		}

		.webui-epg-program.timer-zap {
			border-left: 3px solid var(--webui-success);
		}

		.webui-epg-program-title {
			font-weight: 600;
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
			color: inherit;
		}

		.webui-epg-program-time {
			font-size: 0.6rem;
			opacity: 0.7;
		}

		.webui-epg-program:hover .webui-epg-program-time,
		.webui-epg-program.current .webui-epg-program-time {
			opacity: 0.9;
		}

		/* Detail Modal */
		.webui-epg-modal {
			display: none;
			position: fixed;
			top: 0;
			left: 0;
			right: 0;
			bottom: 0;
			background: rgba(0,0,0,0.7);
			z-index: 100;
			align-items: center;
			justify-content: center;
			padding: 1rem;
		}

		.webui-epg-modal.open {
			display: flex;
		}

		.webui-epg-modal-content {
			background: var(--pico-card-background-color);
			border-radius: var(--webui-radius-lg);
			box-shadow: var(--webui-shadow-lg);
			max-width: 500px;
			width: 100%;
			max-height: 80vh;
			overflow-y: auto;
		}

		.webui-epg-modal-header {
			display: flex;
			justify-content: space-between;
			align-items: flex-start;
			padding: 1rem;
			border-bottom: 1px solid var(--pico-muted-border-color);
		}

		.webui-epg-modal-title {
			font-size: 1.1rem;
			font-weight: 600;
			margin: 0;
		}

		.webui-epg-modal-subtitle {
			font-size: 0.85rem;
			color: var(--pico-muted-color);
			margin-top: 0.25rem;
		}

		.webui-epg-modal-close {
			background: none;
			border: none;
			color: var(--pico-muted-color);
			cursor: pointer;
			padding: 0.25rem;
		}

		.webui-epg-modal-close:hover {
			color: var(--pico-color);
		}

		.webui-epg-modal-close svg {
			width: 20px;
			height: 20px;
		}

		.webui-epg-modal-body {
			padding: 1rem;
		}

		.webui-epg-modal-info {
			font-size: 0.9rem;
			color: var(--pico-muted-color);
			margin-bottom: 0.5rem;
		}

		.webui-epg-modal-desc {
			font-size: 0.9rem;
			line-height: 1.5;
		}

		.webui-epg-modal-footer {
			display: flex;
			gap: 0.5rem;
			padding: 0.75rem 1rem;
			border-top: 1px solid var(--pico-muted-border-color);
			justify-content: center;
			position: sticky;
			bottom: 0;
			background: var(--pico-card-background-color);
		}

		.webui-epg-modal-footer .webui-btn {
			padding: 0.4rem 0.75rem;
			font-size: 0.8rem;
		}

		.webui-epg-modal-footer .webui-btn svg {
			width: 14px;
			height: 14px;
		}

		/* Now marker - small triangle at top of header */
		.webui-epg-now-marker {
			position: absolute;
			bottom: 0;
			transform: translateX(-50%);
			width: 0;
			height: 0;
			border-left: 4px solid transparent;
			border-right: 4px solid transparent;
			border-top: 5px solid #ff4444;
			z-index: 15;
		}

		/* Now line spanning through channels area */
		.webui-epg-now-line {
			position: absolute;
			top: 0;
			bottom: 0;
			width: 1px;
			background: #ff4444;
			opacity: 0.4;
			z-index: 6;
			pointer-events: none;
		}

		/* Responsive */
		@media (max-width: 768px) {
			.webui-epg-toolbar {
				flex-direction: column;
				align-items: stretch;
			}

			.webui-epg-select {
				width: 100%;
			}

			.webui-epg-channel-header,
			.webui-epg-channel-name {
				min-width: 80px;
				width: 80px;
			}

			.webui-epg-time-slot {
				flex: 0 0 60px;
			}
		}
	</style>
</head>
<body>
	<!-- Header wird dynamisch von webui-header.js generiert -->
	<div class="webui-header-wrapper" data-page="epg"></div>
	<div class="webui-header-spacer"></div>

	<!-- Main Content -->
	<main class="webui-epg-container">
		<!-- Toolbar - kompakt in einer Zeile -->
		<div class="webui-toolbar webui-epg-toolbar">
			<select class="webui-select" id="bouquetSelect">
				<option value="">{=L:yw.nav.bouquets=}...</option>
			</select>
			<select class="webui-select" id="timeSelect"></select>
			<!-- the time nav belongs next to the time it shifts -->
			<div class="webui-btn-group">
				<button class="webui-btn" onclick="changeTime(-2)" title="-2 Stunden">&lt; -2h</button>
				<button class="webui-btn" onclick="changeTime(2)" title="+2 Stunden">+2h &gt;</button>
			</div>
			<button class="webui-btn primary" onclick="loadEpg()">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<polyline points="23,4 23,10 17,10"/>
					<path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>
				</svg>
				{=L:yw.si.refresh=}
			</button>
		</div>

		<!-- EPG Grid -->
		<div class="webui-epg-grid" id="epgGrid">
			<p aria-busy="true" style="padding:3rem;text-align:center;color:var(--pico-muted-color)">{=L:yw.epg.loading=}</p>
		</div>
	</main>

	<!-- Detail Modal -->
	<div class="webui-epg-modal" id="epgModal">
		<div class="webui-epg-modal-content">
			<div class="webui-epg-modal-header">
				<div>
					<h3 class="webui-epg-modal-title" id="modalTitle">-</h3>
					<div class="webui-epg-modal-subtitle" id="modalSubtitle">-</div>
				</div>
				<button class="webui-epg-modal-close" onclick="closeModal()">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<line x1="18" y1="6" x2="6" y2="18"/>
						<line x1="6" y1="6" x2="18" y2="18"/>
					</svg>
				</button>
			</div>
			<div class="webui-epg-modal-body">
				<div class="webui-epg-modal-info" id="modalInfo">-</div>
				<div class="webui-epg-modal-desc" id="modalDesc">-</div>
			</div>
			<div class="webui-epg-modal-footer">
				<button class="webui-btn" onclick="zapNow()" title="{=L:yw.epg.zap_title=}">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<polygon points="5,3 19,12 5,21"/>
					</svg>
					{=L:yw.epg.zap=}
				</button>
				<button class="webui-btn" onclick="setTimerZap()" title="{=L:yw.epg.timer_zap_title=}">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<circle cx="12" cy="12" r="10"/>
						<polyline points="12,6 12,12 16,14"/>
					</svg>
					Timer
				</button>
				<button class="webui-btn primary" onclick="setTimerRec()" title="{=L:yw.epg.timer_rec_title=}">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<circle cx="12" cy="12" r="10"/>
						<circle cx="12" cy="12" r="3" fill="currentColor"/>
					</svg>
					{=L:yw.bc.recording=}
				</button>
			</div>
		</div>
	</div>

	<script src="/Y_Lang.yjs?v=27"></script>
	<script src="/js/webui-header.js?v=61"></script>
	<script src="/js/webui-dom.js?v=1"></script>
	<script src="/js/webui-v1.js?v=14"></script>
	<script>
		// The programme grid over /api/v1: the bouquet's channels, then the
		// guide window for 20 of them per request (GET /api/v1/epg/grid),
		// filled in as the pages arrive. Titles and texts come from the
		// broadcast and go in as text.
		const MINUTES_PER_SLOT = 30;
		const DISPLAY_HOURS = 4;
		const TOTAL_MINUTES = DISPLAY_HOURS * 60;

		let currentBouquet = '';
		let currentMode = 'tv';
		let currentStartTime = null;
		let selectedProgram = null;	// {channelId, channelName, ev}
		let timers = [];
		let gridToken = 0;

		const formatTime = webuiFormatTime;
		function clock(sec) { return formatTime(new Date(sec * 1000)); }

		function initTimeSelect() {
			const select = document.getElementById('timeSelect');
			const now = new Date();
			now.setMinutes(0, 0, 0);
			const options = [];
			for (let i = 0; i < 24; i++) {
				const time = new Date(now.getTime() + i * 3600000);
				options.push(webuiEl('option', {value: String(Math.floor(time.getTime() / 1000))},
					webuiPad2(time.getHours()) + ':00'));
			}
			select.replaceChildren.apply(select, options);
			select.selectedIndex = 0;
			currentStartTime = parseInt(select.value);
		}

		// The bouquets of the list the box plays from, hidden and empty ones left out
		async function loadBouquets() {
			const select = document.getElementById('bouquetSelect');
			try {
				const ch = await webuiV1('GET', '/channels/current').catch(() => null);
				currentMode = ch && (ch.kind === 'radio' || ch.kind === 'webradio') ? 'radio' : 'tv';
				const r = await webuiV1('GET', '/bouquets');
				const bouquets = ((r && r.items) || []).filter(b =>
					!b.hidden && (currentMode === 'radio' ? b.radio_count : b.tv_count) > 0);
				select.replaceChildren.apply(select, bouquets.map(b => webuiEl('option', {value: String(b.id)}, b.name)));
				currentBouquet = bouquets.length ? String(bouquets[0].id) : '';
			} catch (e) {
				select.replaceChildren(webuiEl('option', {}, '{=L:yw.epg.load_fail=}'));
				console.error('Failed to load bouquets:', e);
			}
		}

		async function loadTimers() {
			try {
				const r = await webuiV1('GET', '/timers');
				timers = (r && r.items) || [];
			} catch (e) {
				timers = [];
			}
		}

		// The timer that covers an event: a recording from before its start to
		// after its end, or a zap timer while it runs (one set on a running
		// event starts at the minute it was set)
		function timerFor(channelId, ev) {
			return timers.find(t => t.channel_id === channelId &&
				((t.kind === 'record' && t.start <= ev.start && t.stop >= ev.start + ev.duration) ||
				 (t.kind === 'zapto' && t.start >= ev.start && t.start < ev.start + ev.duration)));
		}

		async function loadEpg() {
			const token = ++gridToken;
			const grid = document.getElementById('epgGrid');
			grid.replaceChildren(webuiEl('p', {attrs: {'aria-busy': 'true'},
				style: {padding: '3rem', 'text-align': 'center', color: 'var(--pico-muted-color)'}}, '{=L:yw.epg.loading=}'));

			currentBouquet = document.getElementById('bouquetSelect').value;
			currentStartTime = parseInt(document.getElementById('timeSelect').value);
			const startTime = currentStartTime;
			const stopTime = startTime + DISPLAY_HOURS * 3600;
			if (!currentBouquet) {
				grid.replaceChildren(webuiEl('p', {className: 'webui-empty'}, '{=L:yw.bq.no_channels=}'));
				return;
			}

			try {
				await loadTimers();
				const channels = await webuiV1All('/channels', {mode: currentMode, bouquet: currentBouquet});
				if (token !== gridToken) return;

				const now = Math.floor(Date.now() / 1000);
				const nowInWindow = now >= startTime && now < stopTime;
				const nowPercent = ((now - startTime) / 60) / TOTAL_MINUTES * 100;

				const slots = [];
				for (let i = 0; i < TOTAL_MINUTES / MINUTES_PER_SLOT; i++)
					slots.push(webuiEl('div', {className: 'webui-epg-time-slot'}, clock(startTime + i * MINUTES_PER_SLOT * 60)));
				if (nowInWindow)
					slots.push(webuiEl('div', {className: 'webui-epg-now-marker', style: {left: 'calc(100px + ' + nowPercent + '%)'}}));
				const header = webuiEl('div', {className: 'webui-epg-time-header'},
					webuiEl('div', {className: 'webui-epg-channel-header'}, '{=L:yw.msg.channel=}'),
					webuiEl('div', {className: 'webui-epg-times'}, slots));

				const rows = webuiEl('div', {className: 'webui-epg-channels', style: {position: 'relative'}},
					nowInWindow ? webuiEl('div', {className: 'webui-epg-now-line', style: {left: 'calc(100px + ' + nowPercent + '%)'}}) : null);
				const programsOf = Object.create(null);
				channels.forEach(channel => {
					const programs = webuiEl('div', {className: 'webui-epg-programs'});
					programsOf[channel.id] = {channel: channel, el: programs};
					rows.appendChild(webuiEl('div', {className: 'webui-epg-row'},
						webuiEl('div', {className: 'webui-epg-channel-name', title: '{=L:yw.epg.zap_to=} ' + channel.name,
							on: {click: () => zapTo(channel.id)}},
							webuiEl('span', {}, channel.name)),
						programs));
				});
				grid.replaceChildren(header, rows);

				// the guide, a page of channels at a time
				let cursor = null;
				do {
					const query = {bouquet: currentBouquet, from: startTime, to: stopTime, limit: 20};
					if (cursor) query.cursor = cursor;
					const page = await webuiV1('GET', '/epg/grid', {query: query});
					if (token !== gridToken) return;
					((page && page.items) || []).forEach(row => {
						const target = programsOf[row.channel_id];
						if (target) fillRow(target.channel, target.el, row.events || [], startTime, stopTime, now);
					});
					cursor = page && page.next_cursor;
				} while (cursor);
			} catch (e) {
				if (token !== gridToken) return;
				grid.replaceChildren(webuiEl('p', {className: 'webui-empty'}, '{=L:yw.epg.load_fail=}'));
				console.error('Failed to load EPG:', e);
			}
		}

		function fillRow(channel, el, events, startTime, stopTime, now) {
			const boxes = [];
			events.forEach(ev => {
				const evStop = ev.start + ev.duration;
				if (evStop <= startTime || ev.start >= stopTime) return;
				const displayStart = Math.max(ev.start, startTime);
				const displayStop = Math.min(evStop, stopTime);
				const leftPercent = ((displayStart - startTime) / 60) / TOTAL_MINUTES * 100;
				const widthPercent = ((displayStop - displayStart) / 60) / TOTAL_MINUTES * 100;
				const timer = timerFor(channel.id, ev);
				const isCurrent = now >= ev.start && now < evStop;
				const style = {left: leftPercent + '%', width: 'calc(' + widthPercent + '% - 2px)'};
				if (isCurrent) style['--progress'] = Math.round((now - ev.start) / ev.duration * 100) + '%';
				boxes.push(webuiEl('div', {className: 'webui-epg-program' +
					(timer ? (timer.kind === 'record' ? ' timer-rec' : ' timer-zap') : '') + (isCurrent ? ' current' : ''),
					style: style, on: {click: () => showProgramDetail(channel, ev)}},
					webuiEl('div', {className: 'webui-epg-program-title'}, ev.title || ''),
					webuiEl('div', {className: 'webui-epg-program-time'}, clock(ev.start))));
			});
			el.replaceChildren.apply(el, boxes);
		}

		// The detail dialog; the long text is asked for when it opens
		async function showProgramDetail(channel, ev) {
			selectedProgram = {channelId: channel.id, channelName: channel.name, ev: ev};
			document.getElementById('modalTitle').textContent = ev.title || '-';
			document.getElementById('modalSubtitle').textContent = channel.name || '-';
			const minutes = Math.round(ev.duration / 60);
			document.getElementById('modalInfo').textContent =
				clock(ev.start) + ' - ' + clock(ev.start + ev.duration) + ' (' + minutes + ' Min.)';
			const descEl = document.getElementById('modalDesc');
			descEl.textContent = ev.description || '';
			document.getElementById('epgModal').classList.add('open');
			const shown = selectedProgram;
			const full = await webuiV1('GET', '/epg/event', {query: {id: ev.id, start: ev.start}}).catch(() => null);
			if (selectedProgram !== shown) return;
			const desc = full ? [full.description, full.long_description].filter(Boolean).join('\n\n') : (ev.description || '');
			descEl.textContent = desc || '{=L:yw.epg.no_desc=}';
		}

		function closeModal() {
			document.getElementById('epgModal').classList.remove('open');
			selectedProgram = null;
		}

		// A recording of the event, through the helper the other pages share
		async function setTimerRec() {
			if (!selectedProgram) return;
			if (await webuiRecordEvent(selectedProgram.channelId, selectedProgram.channelName, selectedProgram.ev)) {
				closeModal();
				loadEpg();
			}
		}

		// A zap timer at the event's start, or this minute for one running
		async function setTimerZap() {
			if (!selectedProgram) return;
			const ev = selectedProgram.ev;
			try {
				await webuiV1('POST', '/timers', {body: {kind: 'zapto', channel_id: selectedProgram.channelId,
					start: Math.max(ev.start, Math.floor(Date.now() / 60000) * 60), epg_id: ev.id, epg_start: ev.start}});
				webuiShowToast('{=L:yw.epg.timer_zap_set=}');
				closeModal();
				loadEpg();
			} catch (e) {
				webuiShowToast('{=L:yw.epg.timer_fail=}: ' + e.message, true);
			}
		}

		async function zapNow() {
			if (!selectedProgram) return;
			if (await zapTo(selectedProgram.channelId)) closeModal();
		}

		// Zap: a file the player plays, or a box in standby, is asked about first
		async function zapTo(channelId) {
			try {
				return await webuiV1Zap(channelId);
			} catch (e) {
				webuiShowToast(e.message, true);
				return false;
			}
		}

		function changeTime(hours) {
			const select = document.getElementById('timeSelect');
			select.selectedIndex = Math.max(0, Math.min(select.options.length - 1, select.selectedIndex + hours));
			loadEpg();
		}

		document.getElementById('bouquetSelect').addEventListener('change', loadEpg);
		document.getElementById('timeSelect').addEventListener('change', loadEpg);
		document.getElementById('epgModal').addEventListener('click', function(e) {
			if (e.target === this) closeModal();
		});

		initTimeSelect();
		loadBouquets().then(loadEpg);

		if (typeof webuiSetRefreshCallback === 'function') {
			webuiSetRefreshCallback(function() {
				return loadEpg();
			});
		}
	</script>
</body>
</html>
