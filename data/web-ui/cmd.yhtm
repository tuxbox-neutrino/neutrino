<!DOCTYPE html>
<html lang="de" data-theme="dark">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>yWeb - Shell</title>
	<link rel="icon" href="/favicon/favicon.ico">
	<link rel="stylesheet" href="/css/pico.min.css">
	<link rel="stylesheet" href="/css/yweb.css?v=65">
	<style>
		.cmd-content {
			padding: 0.5rem 1rem;
			display: flex;
			flex-direction: column;
			height: calc(100vh - 4rem);
			min-height: 0;
		}

		.cmd-output {
			flex: 1;
			min-height: 0;
			background: var(--pico-card-sectioning-background-color);
			border: 1px solid var(--pico-muted-border-color);
			border-radius: var(--yweb-radius-lg);
			padding: 0.75rem;
			font-family: 'Courier New', monospace;
			font-size: 0.78rem;
			line-height: 1.5;
			overflow: auto;
			white-space: pre-wrap;
			word-break: break-all;
			color: var(--pico-color);
		}

		.cmd-output .cmd-prompt {
			color: var(--yweb-accent);
			font-weight: 600;
		}

		.cmd-output .cmd-error {
			color: var(--yweb-danger, #ef4444);
		}

		.cmd-input-row {
			display: flex;
			gap: 0.5rem;
			align-items: center;
			margin-top: 0.5rem;
			flex-shrink: 0;
		}

		.cmd-prompt-label {
			font-family: 'Courier New', monospace;
			font-size: 0.85rem;
			font-weight: 600;
			color: var(--yweb-accent);
			white-space: nowrap;
			flex-shrink: 0;
		}

		.cmd-input-row input[type="text"] {
			flex: 1;
			margin: 0;
			padding: 0.5rem 0.75rem;
			font-family: 'Courier New', monospace;
			font-size: 0.85rem;
			border-radius: var(--yweb-radius);
			border: 1px solid var(--pico-muted-border-color);
			background: var(--pico-card-background-color);
			color: var(--pico-color);
		}

		.cmd-input-row input[type="text"]:focus {
			border-color: var(--yweb-accent);
			outline: none;
		}

		.cmd-toolbar {
			display: flex;
			align-items: center;
			gap: 0.5rem;
			margin-bottom: 0.5rem;
			flex-shrink: 0;
		}

		.cmd-toolbar .cmd-title {
			font-weight: 600;
			font-size: 0.9rem;
			display: flex;
			align-items: center;
			gap: 0.4rem;
		}

		.cmd-toolbar .cmd-title svg {
			width: 1.1rem;
			height: 1.1rem;
			color: var(--yweb-accent);
		}

		.cmd-toolbar .spacer {
			flex: 1;
		}
	</style>
</head>
<body>
	<div class="yweb-header-wrapper" data-page="tools"></div>
	<div class="yweb-header-spacer"></div>

	<main class="cmd-content">
		<div class="cmd-toolbar">
			<span class="cmd-title">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
				Shell
			</span>
			<span class="spacer"></span>
			<button class="yweb-btn" onclick="cmdClear()" title="{=L:yw.cmd.clear_title=}">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:0.9rem;height:0.9rem"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/></svg>
				{=L:yw.cmd.clear=}
			</button>
		</div>

		<div class="cmd-output" id="cmd-output"></div>

		<div class="cmd-input-row">
			<span class="cmd-prompt-label" id="cmd-prompt-label">$</span>
			<input type="text" id="cmd-input" placeholder="{=L:yw.cmd.placeholder=}" autofocus>
			<button class="yweb-btn primary" onclick="cmdExec()" title="{=L:yw.cmd.run=}">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:1rem;height:1rem"><polygon points="5 3 19 12 5 21 5 3"/></svg>
			</button>
		</div>
	</main>

	<script src="/Y_Baselib.js"></script>
	<script src="/Y_Lang.yjs?v=6"></script>
	<script src="/yweb-header.js?v=37"></script>
	<script>
	var cmdHistory = [];
	var cmdHistoryPos = -1;
	var cmdOutput = document.getElementById('cmd-output');
	var cmdPrompt = '$';

	// Fetch hostname for realistic prompt
	ywebApi('sysinfo').then(function(sys) {
		if (sys.hostname) {
			cmdPrompt = sys.hostname + ':~$';
			document.getElementById('cmd-prompt-label').textContent = cmdPrompt;
		}
	}).catch(function() {});

	function cmdClear() {
		cmdOutput.innerHTML = '';
	}

	function cmdAppend(html) {
		cmdOutput.innerHTML += html;
		cmdOutput.scrollTop = cmdOutput.scrollHeight;
	}

	async function cmdExec() {
		var input = document.getElementById('cmd-input');
		var cmd = input.value.trim();
		if (!cmd) return;

		// History
		if (cmdHistory[cmdHistory.length - 1] !== cmd)
			cmdHistory.push(cmd);
		cmdHistoryPos = -1;
		input.value = '';

		// Show prompt + command
		cmdAppend('<span class="cmd-prompt">' + escapeHtml(cmdPrompt) + ' </span>' + escapeHtml(cmd) + '\n');

		try {
			var text = await ywebApi('cmd', encodeURIComponent(cmd), {raw: true});
			text = text.replace(/^[\s\r\n]+|[\s\r\n]+$/g, '');
			if (text) {
				cmdAppend(escapeHtml(text) + '\n');
			}
		} catch (e) {
			cmdAppend('<span class="cmd-error">{=L:yw.msg.error=}: ' + escapeHtml(e.message) + '</span>\n');
		}
	}

	function escapeHtml(s) {
		var d = document.createElement('div');
		d.textContent = s;
		return d.innerHTML;
	}

	// Keyboard handling
	document.getElementById('cmd-input').addEventListener('keydown', function(e) {
		if (e.key === 'Enter') {
			e.preventDefault();
			cmdExec();
		} else if (e.key === 'ArrowUp') {
			e.preventDefault();
			if (cmdHistory.length === 0) return;
			if (cmdHistoryPos === -1) cmdHistoryPos = cmdHistory.length;
			if (cmdHistoryPos > 0) {
				cmdHistoryPos--;
				this.value = cmdHistory[cmdHistoryPos];
			}
		} else if (e.key === 'ArrowDown') {
			e.preventDefault();
			if (cmdHistoryPos === -1) return;
			cmdHistoryPos++;
			if (cmdHistoryPos >= cmdHistory.length) {
				cmdHistoryPos = -1;
				this.value = '';
			} else {
				this.value = cmdHistory[cmdHistoryPos];
			}
		}
	});
	</script>
</body>
</html>
