<!DOCTYPE html>
<html lang="de" data-theme="dark">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Neutrino-Web-UI - Bouquets</title>
	<link rel="icon" href="/favicon/favicon.ico">
	<script>
		// Apply the stored theme before first paint: webui-header.js runs
		// too late, and some pages never load it at all.
		try { document.documentElement.setAttribute('data-theme', localStorage.getItem('yweb-theme') || 'dark'); } catch (e) {}
	</script>
	<link rel="stylesheet" href="/css/pico.min.css">
	<link rel="stylesheet" href="/css/webui.css?v=89">
	<style>
		/* 2-column grid layout for bouquets. Bouquetspalte bemisst
		   sich am laengsten Namen (wie Timer-Filter), Deckel 22rem —
		   extrem lange Bouquetnamen ellipsen weiterhin; Mobile-Branch
		   unten bleibt einspaltig wie gehabt */
		main.yweb-bouquets-grid {
			display: grid;
			grid-template-columns: fit-content(22rem) 1fr;
			gap: 0.6rem;
			padding: 0.5rem;
			/* Override global main scroll - cards scroll internally */
			overflow: hidden;
		}

		@media (max-width: 800px) {
			main.yweb-bouquets-grid {
				grid-template-columns: 1fr;
				grid-template-rows: auto 1fr; /* Bouquets fixed, channels flex */
			}
		}

		/* Compact card headers for both cards */

		/* Bouquet List Card */



		.yweb-channel-row {
			display: flex;
			flex-direction: column;
			padding: 0.5rem 0.8rem;
			border-bottom: 1px solid var(--pico-muted-border-color);
			border-left: 3px solid transparent;
			transition: var(--yweb-transition);
			cursor: pointer;
		}

		.yweb-channel-main {
			display: flex;
			align-items: center;
			gap: 0.6rem;
			width: 100%;
		}

		.yweb-channel-row:hover {
			background: var(--yweb-accent-light);
		}

		.yweb-channel-row.current {
			background: var(--yweb-accent-light);
			border-left-color: var(--yweb-accent);
		}

		/* Die Logo-Packs bestehen fast nur aus Breitbannern (ZDF 2.8:1
		   bis Sky 8.4:1) — in der kompakten 72px-Kachel skaliert contain
		   ueber die Breite und laesst 8:1-Banner auf ~9px Resthoehe
		   schrumpfen. Mit Logo bekommt die Kachel deshalb Bannerbreite;
		   ohne Logo bleibt der schmale TV-Fallback. */
		.yweb-channel-row.has-logo .yweb-icon-placeholder {
			width: 160px;
		}

		.yweb-channel-info {
			flex: 1;
			min-width: 0;
		}

		.yweb-channel-name {
			font-weight: 500;
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
			font-size: var(--yweb-font-sm);
		}

		.yweb-channel-epg {
			font-size: var(--yweb-font-xs);
			color: var(--pico-muted-color);
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}

		.yweb-channel-progress {
			width: 100%;
			height: 3px;
			margin-top: 4px;
			background: var(--pico-muted-border-color);
			border-radius: 2px;
			overflow: hidden;
			opacity: 0;
			transition: opacity 0.3s ease;
		}

		.yweb-channel-progress.active {
			opacity: 1;
		}

		.yweb-channel-progress-bar {
			height: 100%;
			background: linear-gradient(90deg, var(--yweb-accent), var(--yweb-accent-hover));
			border-radius: 2px;
			transition: width 0.5s ease;
		}

		.yweb-channel-actions {
			display: flex;
			gap: 0.3rem;
			flex-shrink: 0;
		}

		/* Channel count in header */
		.yweb-channel-count {
			font-size: var(--yweb-font-xs);
			color: var(--pico-muted-color);
			font-weight: normal;
		}

		/* Mobile Accordion */
		@media (max-width: 800px) {
			.yweb-bouquets-grid {
				display: flex;
				flex-direction: column;
				gap: 0.4rem;
				overflow: auto;
			}

			.yweb-card-indicator {
				display: flex;
			}

			.yweb-bouquet-card,
			.yweb-channel-card {
				flex: none;
				max-height: none;
				min-height: auto;
			}

			.yweb-bouquet-card .yweb-card-header,
			.yweb-channel-card .yweb-card-header {
				cursor: pointer;
				position: relative;
				padding-right: 2rem;
			}

			.yweb-bouquet-card .yweb-card-title,
			.yweb-channel-card .yweb-card-title {
				font-size: 0.9rem;
			}

			/* Show preview only when collapsed */
			.yweb-card.collapsed .yweb-card-preview {
				display: inline-block;
			}

			/* Hide channel count when collapsed */
			.yweb-card.collapsed .yweb-channel-count {
				display: none;
			}

			/* Chevron indicator */
			.yweb-bouquet-card .yweb-card-header::after,
			.yweb-channel-card .yweb-card-header::after {
				content: '▼';
				position: absolute;
				right: 0.5rem;
				top: 50%;
				transform: translateY(-50%);
				font-size: 0.55rem;
				color: var(--pico-muted-color);
				transition: transform 0.2s ease;
				pointer-events: none;
			}

			/* Chevron rotated when not collapsed (= expanded) */
			.yweb-card:not(.collapsed) .yweb-card-header::after {
				transform: translateY(-50%) rotate(180deg);
			}

			/* Mobile: show card body by default (graceful fallback without JS) */
			.yweb-bouquet-card .yweb-card-body,
			.yweb-channel-card .yweb-card-body {
				display: block;
				max-height: 60dvh;
				overflow-y: auto;
			}

			/* Hide body when JS has initialized and card is collapsed */
			.yweb-card.collapsed .yweb-card-body {
				display: none;
			}

			.yweb-channel-row {
				padding: 0.4rem 0.6rem;
			}

			.yweb-channel-main {
				gap: 0.4rem;
			}

			.yweb-icon-placeholder {
				width: 44px;
				height: 30px;
			}

			/* Mobile: wenn ein Logo geladen ist, traegt es die Zeile allein —
			   der Textname faellt weg (das Logo hat den Namen als alt), das
			   Logo bekommt den freigewordenen Platz. Faellt das Logo aus
			   (onerror entfernt .has-logo), erscheint der Name wieder. */
			.yweb-channel-row.has-logo .yweb-icon-placeholder {
				width: 140px;
				height: 40px;
			}

			.yweb-channel-row.has-logo .yweb-channel-name {
				display: none;
			}

			.yweb-channel-actions {
				gap: 0.2rem;
				flex-wrap: wrap;
				justify-content: flex-end;
			}

			.yweb-channel-actions .yweb-btn {
				padding: 0.25rem 0.35rem;
			}

			.yweb-channel-actions .yweb-btn svg {
				width: 13px;
				height: 13px;
			}
		}

		[data-theme="light"] .yweb-channel-row {
			border-bottom-color: #e5e7eb;
		}

		[data-theme="light"] .yweb-channel-row:hover {
			background: #f8f9fa;
		}


		/* Expandable Channel Row Detail */
		.yweb-channel-detail {
			width: 100%;
			max-height: 0;
			overflow: hidden;
			transition: max-height 0.3s ease, padding 0.3s ease;
			padding: 0;
			margin-top: 0.5rem;
			background: var(--pico-card-sectioning-background-color);
			border-radius: var(--yweb-radius);
		}

		.yweb-channel-row.row-expanded .yweb-channel-detail {
			max-height: 500px;
			padding: 0.8rem 1rem;
			overflow-y: auto;
		}

		.yweb-channel-detail-loading {
			font-size: 0.85rem;
			color: var(--pico-muted-color);
			font-style: italic;
		}

		.yweb-channel-detail-content {
			font-size: 0.9rem;
			line-height: 1.6;
			color: var(--pico-color);
		}

		.yweb-channel-detail-time {
			font-size: 0.8rem;
			color: var(--pico-muted-color);
			margin-bottom: 0.5rem;
		}

		.yweb-channel-detail-title {
			font-weight: 600;
			font-size: 1rem;
			color: var(--yweb-accent);
			margin-bottom: 0.5rem;
		}

		.yweb-channel-detail-desc {
			font-size: 0.9rem;
			line-height: 1.6;
			white-space: pre-wrap;
			word-wrap: break-word;
		}

		/* Expand indicator on row */
		.yweb-channel-row .yweb-expand-icon {
			width: 14px;
			height: 14px;
			color: var(--pico-muted-color);
			flex-shrink: 0;
			transition: transform 0.2s ease;
		}

		.yweb-channel-row.row-expanded .yweb-expand-icon {
			transform: rotate(180deg);
		}

		@media (max-width: 800px) {
			.yweb-channel-detail {
				margin-top: 0.4rem;
			}

			.yweb-channel-row.row-expanded .yweb-channel-detail {
				max-height: 60vh;
				padding: 0.7rem 0.8rem;
			}

			.yweb-channel-detail-content {
				font-size: 0.95rem;
			}

			.yweb-channel-detail-desc {
				font-size: 0.95rem;
				line-height: 1.7;
			}
		}
	</style>
</head>
<body>
	<!-- Header wird dynamisch von webui-header.js generiert -->
	<div class="yweb-header-wrapper" data-page="bouquets"></div>
	<div class="yweb-header-spacer"></div>

	<!-- Main Content: 2-Column Grid -->
	<main class="yweb-bouquets-grid">
		<!-- Bouquet List Card -->
		<article class="yweb-card yweb-panel-card yweb-card-sm yweb-bouquet-card" id="card-bouquets">
			<header class="yweb-card-header" onclick="toggleCard('card-bouquets')">
				<h3 class="yweb-card-title">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M3 6h18M3 12h18M3 18h18"/>
					</svg>
					Bouquets
				</h3>
				<span class="yweb-card-preview" id="bouquetPreview">--</span>
			</header>
			<div class="yweb-card-body">
				<ul class="yweb-plain-list yweb-bouquet-list" id="bouquetList">
					<li aria-busy="true">{=L:yw.bq.loading_bouquets=}</li>
				</ul>
			</div>
		</article>

		<!-- Channel List Card -->
		<article class="yweb-card yweb-panel-card yweb-card-sm yweb-channel-card" id="card-channels">
			<header class="yweb-card-header" onclick="toggleCard('card-channels')">
				<h3 class="yweb-card-title">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<rect x="2" y="7" width="20" height="15" rx="2" ry="2"/>
						<polyline points="17,2 12,7 7,2"/>
					</svg>
					<span id="currentBouquetName">{=L:yw.dash.channels=}</span>
				</h3>
				<span class="yweb-card-preview" id="channelPreview">--</span>
				<span class="yweb-channel-count" id="channelCount"></span>
			</header>
			<div class="yweb-card-body">
				<ul class="yweb-plain-list yweb-channel-grid" id="channelList">
					<li aria-busy="true">{=L:yw.bq.loading_channels=}</li>
				</ul>
			</div>
		</article>

		<!-- Mobile Card Indicator -->
		<div class="yweb-card-indicator" id="cardIndicator"></div>
	</main>

	<script src="/Y_Lang.yjs?v=27"></script>
	<script src="/js/webui-header.js?v=61"></script>
	<script src="/js/webui-dom.js?v=1"></script>
	<script src="/js/webui-v1.js?v=14"></script>
	<script>
		// The channel list over /api/v1: bouquets, their channels and what each
		// is showing now. Names, titles and texts come from the broadcast and go
		// in as text (webui-dom.js); nothing here is built as markup.
		let currentChannelId = null;	// the v1 id of the channel the box plays
		let currentMode = 'tv';		// the list shown: the one the box plays from
		let currentBouquetNumber = '';	// the v1 bouquet id, '' for all channels
		let bouquetsData = [];		// the bouquets of that list, hidden ones left out
		let logosOffered = true;	// false once the box says it hands no logos out

		const SVG_PLAY = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5,3 19,12 5,21"/></svg>';
		const SVG_GLOBE = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>';
		const SVG_EXPAND = '<svg class="yweb-expand-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6,9 12,15 18,9"/></svg>';
		const SVG_INFO = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>';
		const SVG_REC = '<svg viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="8"/></svg>';
		const SVG_STREAM = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 17H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-1"/><polygon points="12,15 17,21 7,21"/></svg>';

		function clock(sec) {
			return ywebFormatTime(new Date(sec * 1000));
		}

		function rowOf(channelId) {
			return document.querySelector('.yweb-channel-row[data-id="' + CSS.escape(String(channelId)) + '"]');
		}

		// The channel the box plays, and with it which list to show
		async function loadCurrentChannel() {
			const ch = await ywebV1('GET', '/channels/current').catch(() => null);
			currentChannelId = ch ? ch.id : null;
			currentMode = ch && (ch.kind === 'radio' || ch.kind === 'webradio') ? 'radio' : 'tv';
		}

		// The bouquets of that list, and the one holding the current channel
		async function loadBouquets() {
			const list = document.getElementById('bouquetList');
			try {
				const r = await ywebV1('GET', '/bouquets');
				bouquetsData = ((r && r.items) || []).filter(b =>
					!b.hidden && (currentMode === 'radio' ? b.radio_count : b.tv_count) > 0);

				let active = '';
				if (currentChannelId) {
					const holding = await ywebV1('GET', '/bouquets', {query: {holds: currentChannelId}}).catch(() => null);
					const found = holding && (holding.items || []).find(x => bouquetsData.some(b => b.id === x.id));
					if (found) active = String(found.id);
				}
				renderBouquetList(active || (bouquetsData[0] ? String(bouquetsData[0].id) : ''));
			} catch (e) {
				console.error('Failed to load bouquets:', e);
				list.replaceChildren(ywebEl('li', {className: 'yweb-empty'}, '{=L:yw.msg.load_fail=}'));
			}
		}

		function renderBouquetList(activeBouquet) {
			const list = document.getElementById('bouquetList');
			const items = [ywebEl('li', {className: 'yweb-nav-item yweb-bouquet-item' + (activeBouquet === '' ? ' active' : ''),
				on: {click: () => selectBouquet('')}},
				ywebMarkup(SVG_GLOBE),
				ywebEl('span', {className: 'yweb-nav-name yweb-bouquet-name'}, '{=L:yw.bq.all_channels=}'))];
			bouquetsData.forEach(b => {
				items.push(ywebEl('li', {className: 'yweb-nav-item yweb-bouquet-item' + (String(activeBouquet) === String(b.id) ? ' active' : ''),
					data: {bouquet: String(b.id)}, on: {click: () => selectBouquet(String(b.id))}},
					ywebMarkup(SVG_PLAY),
					ywebEl('span', {className: 'yweb-nav-name yweb-bouquet-name'}, b.name)));
			});
			list.replaceChildren.apply(list, items);
			currentBouquetNumber = activeBouquet;

			setTimeout(() => {
				const activeItem = list.querySelector('.yweb-bouquet-item.active');
				if (activeItem) scrollToElementInContainer(activeItem, list);
			}, 200);

			updateBouquetPreview();
			loadChannels(activeBouquet);
		}

		function selectBouquet(bouquet) {
			document.querySelectorAll('.yweb-bouquet-item').forEach(item => {
				const itemBouquet = item.dataset.bouquet || '';
				item.classList.toggle('active', itemBouquet === bouquet);
			});
			currentBouquetNumber = bouquet;
			updateBouquetPreview();
			loadChannels(bouquet);
			// Mobile: auto-switch to channel card for better UX
			if (window.innerWidth <= 800) selectCard('card-channels');
		}

		function channelRow(ch) {
			const isCurrent = ch.id === currentChannelId;
			const placeholder = ywebEl('div', {className: 'yweb-icon-placeholder'}, currentMode === 'radio' ? 'Radio' : 'TV');
			const row = ywebEl('li', {className: 'yweb-channel-row' + (isCurrent ? ' current' : ''),
				data: {id: ch.id}, on: {click: event => toggleChannelDetail(event, ch.id)}},
				ywebEl('div', {className: 'yweb-channel-main'},
					placeholder,
					ywebMarkup(SVG_EXPAND),
					ywebEl('div', {className: 'yweb-channel-info'},
						ywebEl('div', {className: 'yweb-channel-name'}, ch.name),
						ywebEl('div', {className: 'yweb-channel-epg'}),
						ywebEl('div', {className: 'yweb-channel-progress'}, ywebEl('div', {className: 'yweb-channel-progress-bar'}))),
					ywebEl('div', {className: 'yweb-channel-actions', on: {click: event => event.stopPropagation()}},
						actionButton(SVG_PLAY, '{=L:yw.epg.zap=}', '{=L:yw.bq.zap_title=}', () => zapTo(ch.id)),
						actionButton(SVG_INFO, 'Info', '{=L:yw.dash.epg_info=}', () => showEpg(ch.id, ch.name)),
						actionButton(SVG_REC, 'Rec', '{=L:yw.bq.rec_title=}', () => ywebRecordEvent(ch.id, ch.name, epgNow[ch.id]), true),
						actionButton(SVG_STREAM, 'Stream', '{=L:yw.bq.stream_title=}', () => ywebStreamChannel(ch.id, ch.name)))),
				ywebEl('div', {className: 'yweb-channel-detail', id: 'detail-' + ch.id},
					ywebEl('div', {className: 'yweb-channel-detail-loading'}, '{=L:yw.bq.tap_info=}')));
			// a logo only while the box hands them out; one that fails leaves the placeholder text
			if (logosOffered) {
				const img = ywebEl('img', {attrs: {src: '/api/v1/channels/' + encodeURIComponent(ch.id) + '/logo', alt: '', loading: 'lazy'},
					on: {error: function() {
						row.classList.remove('has-logo');
						placeholder.textContent = currentMode === 'radio' ? 'Radio' : 'TV';
					}}});
				placeholder.replaceChildren(img);
				row.classList.add('has-logo');
			}
			return row;
		}

		function actionButton(svg, label, title, onClick, danger) {
			return ywebEl('button', {className: 'yweb-btn', title: title, style: danger ? {color: 'var(--yweb-danger)'} : undefined,
				on: {click: onClick}},
				ywebMarkup(svg),
				ywebEl('span', {className: 'btn-label'}, label));
		}

		// Whether the box hands logos out at all, asked once with the first
		// channel: a list of hundreds would otherwise ask for each in vain.
		async function checkLogos(channelId) {
			try {
				const r = await fetch('/api/v1/channels/' + encodeURIComponent(channelId) + '/logo', {credentials: 'same-origin'});
				if (r.status === 404) {
					const p = await r.json().catch(() => null);
					if (p && p.type === '/errors/logos-not-offered') logosOffered = false;
				}
			} catch (e) { /* asked again on the next list */ }
		}

		let channelsToken = 0;
		async function loadChannels(bouquet) {
			const token = ++channelsToken;
			const list = document.getElementById('channelList');
			const countEl = document.getElementById('channelCount');
			const titleEl = document.getElementById('currentBouquetName');
			list.replaceChildren(ywebEl('li', {attrs: {'aria-busy': 'true'}}, '{=L:yw.bq.loading_channels=}'));

			if (bouquet === '') {
				titleEl.textContent = '{=L:yw.bq.all_channels=}';
			} else {
				const bq = bouquetsData.find(b => String(b.id) === String(bouquet));
				titleEl.textContent = bq ? bq.name : '{=L:yw.dash.channels=}';
			}

			try {
				const query = {mode: currentMode};
				if (bouquet) query.bouquet = bouquet;
				const channels = await ywebV1All('/channels', query);
				if (token !== channelsToken) return;	// another bouquet was chosen meanwhile

				countEl.textContent = channels.length + ' {=L:yw.bq.channels_unit=}';
				if (channels.length === 0) {
					list.replaceChildren(ywebEl('li', {className: 'yweb-empty'}, '{=L:yw.bq.no_channels=}'));
					return;
				}
				if (logosOffered) await checkLogos(channels[0].id);
				if (token !== channelsToken) return;

				list.replaceChildren.apply(list, channels.map(channelRow));

				// Scroll to current channel in container (after layout is complete)
				setTimeout(() => {
					const currentRow = list.querySelector('.current');
					const cardBody = list.parentElement;
					if (currentRow && cardBody) {
						const scrollTo = currentRow.offsetTop - (cardBody.clientHeight / 2) + (currentRow.offsetHeight / 2);
						cardBody.scrollTop = Math.max(0, scrollTo);
					}
				}, 300);

				updateChannelPreview();
				loadEpgInfo(channels, bouquet, token);
			} catch (e) {
				if (token !== channelsToken) return;
				list.replaceChildren(ywebEl('li', {className: 'yweb-empty'}, '{=L:yw.msg.load_fail=}'));
				console.error('Failed to load channels:', e);
			}
		}

		// What each channel shows now, from the guide grid: a page of 20 channels
		// per request, for the bouquet or for the named channels of the whole list.
		const epgNow = {};	// channel id -> the event running now
		let progressUpdateInterval = null;

		async function loadEpgInfo(channels, bouquet, token) {
			const now = Math.floor(Date.now() / 1000);
			const pages = [];
			if (bouquet) {
				pages.push({bouquet: bouquet});
			} else {
				for (let i = 0; i < channels.length; i += 20)
					pages.push({channels: channels.slice(i, i + 20).map(ch => ch.id).join(',')});
			}
			for (const base of pages) {
				let cursor = null;
				do {
					if (token !== channelsToken) return;
					const query = Object.assign({from: now, to: now + 60, limit: 20}, base);
					if (cursor) query.cursor = cursor;
					let page;
					try {
						page = await ywebV1('GET', '/epg/grid', {query: query});
					} catch (e) {
						break;	// no guide for this page; the rows stay without one
					}
					if (token !== channelsToken) return;
					((page && page.items) || []).forEach(row => showNow(row.channel_id, row.events || [], now));
					cursor = page && page.next_cursor;
				} while (cursor);
			}
			startProgressUpdateTimer();
		}

		function showNow(channelId, events, now) {
			const ev = events.find(e => e.start <= now && now < e.start + e.duration);
			const row = rowOf(channelId);
			if (!ev || !row) return;
			epgNow[channelId] = ev;
			row.querySelector('.yweb-channel-epg').textContent =
				clock(ev.start) + '-' + clock(ev.start + ev.duration) + ' ' + (ev.title || '');
			updateChannelProgress(channelId);
		}

		function updateChannelProgress(channelId) {
			const ev = epgNow[channelId];
			const row = rowOf(channelId);
			if (!ev || !row) return;
			const container = row.querySelector('.yweb-channel-progress');
			const bar = row.querySelector('.yweb-channel-progress-bar');
			const now = Date.now() / 1000;
			const percent = Math.min(100, Math.max(0, (now - ev.start) / ev.duration * 100));
			bar.style.width = percent + '%';
			container.classList.add('active');
		}

		function updateAllProgress() {
			const now = Date.now() / 1000;
			for (const id of Object.keys(epgNow)) {
				if (now >= epgNow[id].start + epgNow[id].duration) {
					delete epgNow[id];
					continue;
				}
				updateChannelProgress(id);
			}
		}

		function startProgressUpdateTimer() {
			if (!progressUpdateInterval)
				progressUpdateInterval = setInterval(updateAllProgress, 30000);
		}

		function markCurrent() {
			document.querySelectorAll('.yweb-channel-row').forEach(row => {
				row.classList.toggle('current', row.dataset.id === currentChannelId);
			});
			updateChannelPreview();
		}

		// Zap: a file the player plays, or a box in standby, is asked about first
		async function zapTo(channelId) {
			try {
				if (await ywebV1Zap(channelId)) {
					currentChannelId = channelId;
					markCurrent();
				}
			} catch (e) {
				ywebShowToast(e.message, true);
			}
		}

		function showEpg(channelId, channelName) {
			ywebShowEpgModal(channelId, channelName);
		}

		async function toggleChannelDetail(event, channelId) {
			if (event.target.closest('.yweb-channel-actions')) return;
			const row = rowOf(channelId);
			if (!row) return;
			const detailEl = document.getElementById('detail-' + channelId);
			if (row.classList.contains('row-expanded')) {
				row.classList.remove('row-expanded');
				return;
			}
			document.querySelectorAll('.yweb-channel-row.row-expanded').forEach(r => r.classList.remove('row-expanded'));
			row.classList.add('row-expanded');
			if (detailEl && detailEl.querySelector('.yweb-channel-detail-loading'))
				await loadChannelDetail(channelId, detailEl);
		}

		// The long text of what runs now
		async function loadChannelDetail(channelId, detailEl) {
			function content(text, muted) {
				detailEl.replaceChildren(ywebEl('div', {className: 'yweb-channel-detail-content'},
					ywebEl('div', {className: 'yweb-channel-detail-desc',
						style: muted ? {'font-style': 'italic', color: 'var(--pico-muted-color)'} : undefined}, text)));
			}
			try {
				let ev = epgNow[channelId];
				if (!ev) ev = await ywebV1('GET', '/epg/current', {query: {channel: channelId}}).catch(() => null);
				if (!ev) {
					content('{=L:yw.bq.no_epg=}');
					return;
				}
				const full = await ywebV1('GET', '/epg/event', {query: {id: ev.id, start: ev.start}}).catch(() => ev);
				const desc = [full.description, full.long_description].filter(Boolean).join('\n\n');
				if (desc) content(desc);
				else content('{=L:yw.epg.no_desc=}', true);
			} catch (e) {
				console.error('Failed to load channel detail:', e);
				content('{=L:yw.msg.load_fail=}');
			}
		}

		function scrollToElementInContainer(element, listElement) {
			if (!element) return;
			const scrollParent = listElement ? listElement.parentElement : null;
			if (scrollParent && scrollParent.scrollHeight > scrollParent.clientHeight) {
				const containerTop = scrollParent.getBoundingClientRect().top;
				const elementTop = element.getBoundingClientRect().top;
				const relativeTop = elementTop - containerTop + scrollParent.scrollTop;
				scrollParent.scrollTop = Math.max(0, relativeTop - (scrollParent.clientHeight / 2) + (element.offsetHeight / 2));
			} else {
				element.scrollIntoView({ block: 'center', behavior: 'instant' });
			}
		}

		// ===== Mobile Accordion =====

		function updateBouquetPreview() {
			const preview = document.getElementById('bouquetPreview');
			if (preview && bouquetsData.length > 0) {
				const active = bouquetsData.find(b => String(b.id) === String(currentBouquetNumber));
				preview.textContent = active ? active.name : bouquetsData.length + ' Bouquets';
			}
		}

		function updateChannelPreview() {
			const preview = document.getElementById('channelPreview');
			const count = document.getElementById('channelCount');
			if (preview) {
				const currentRow = document.querySelector('.yweb-channel-row.current .yweb-channel-name');
				if (currentRow) preview.textContent = currentRow.textContent;
				else if (count) preview.textContent = count.textContent;
			}
		}

		// Initialize; a zap from anywhere else (remote control, timer) moves the mark
		loadCurrentChannel().then(() => loadBouquets());
		let zapRead = 0;	// an older answer arriving after a newer one is dropped
		ywebV1Events({
			zap: async function() {
				const read = ++zapRead;
				const mode = currentMode;
				const ch = await ywebV1('GET', '/channels/current').catch(() => null);
				if (read !== zapRead) return;
				currentChannelId = ch ? ch.id : null;
				currentMode = ch && (ch.kind === 'radio' || ch.kind === 'webradio') ? 'radio' : 'tv';
				if (currentMode !== mode) loadBouquets();	// the box switched lists
				else markCurrent();
			}
		});

		document.addEventListener('DOMContentLoaded', function() {
			ywebInitMobileAccordion({
				cardOrder: ['card-bouquets', 'card-channels'],
				storageKey: 'yweb-bouquets-card',
				defaultCard: 'card-channels',
				breakpoint: 800,
				indicatorId: 'cardIndicator',
				containerSelector: '.yweb-bouquets-grid',
				mode: 'collapsed'
			});
		});

		// Custom pull-to-refresh for bouquets page
		// Check if expanded card's body is at top before allowing refresh
		function isAtScrollTop() {
			const expandedCard = document.querySelector('.yweb-card:not(.collapsed)');
			if (expandedCard) {
				const cardBody = expandedCard.querySelector('.yweb-card-body');
				if (cardBody && cardBody.scrollTop > 5) return false;
			}
			const main = document.querySelector('.yweb-bouquets-grid');
			if (main && main.scrollTop > 5) return false;
			return true;
		}

		if (typeof ywebSetRefreshCallback === 'function') {
			ywebSetRefreshCallback(function() {
				if (!isAtScrollTop()) return Promise.resolve();
				return loadCurrentChannel().then(() => loadBouquets());
			});
		}

		if (typeof window.ywebIsAtScrollTop === 'undefined') {
			window.ywebIsAtScrollTop = isAtScrollTop;
		}
	</script>
</body>
</html>
