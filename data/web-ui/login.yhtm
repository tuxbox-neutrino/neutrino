<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Neutrino-Web-UI - {=L:yw.login.title=}</title>
	<link rel="icon" href="/favicon/favicon.ico">
	<script>
		// Apply the stored theme before first paint: yweb-header.js runs
		// too late, and some pages never load it at all.
		try { document.documentElement.setAttribute('data-theme', localStorage.getItem('yweb-theme') || 'dark'); } catch (e) {}
	</script>
	<link rel="stylesheet" href="/css/pico.min.css">
	<link rel="stylesheet" href="/css/yweb.css?v=89">
	<style>
		/* Compact centered auth card after the portal login pattern.
		   yweb.css already makes body a column flexbox with main{flex:1}
		   — undo the stretch and the fixed height so the card sizes to
		   its content; margin:auto centers it and still allows
		   scrolling to the top on tiny viewports. */
		body {
			height: auto;
			min-height: 100vh;
			min-height: 100dvh;
			overflow: auto;
			margin: 0;
			display: flex;
			flex-direction: column;
			padding: 24px;
			background-color: var(--pico-background-color);
			background-image: radial-gradient(circle at 12% -10%, var(--yweb-accent-light), transparent 55%);
		}
		.login-wrap {
			flex: 0 0 auto;
			margin: auto;
			width: 100%;
			max-width: 420px;
			padding: 36px;
		}
		.login-wrap h1 {
			font-size: 1.3rem;
			margin-bottom: 0.4rem;
		}
		.login-wrap p.sub {
			color: var(--pico-muted-color);
			margin-bottom: 20px;
		}
		.login-wrap form {
			display: flex;
			flex-direction: column;
			gap: 12px;
		}
		.login-field {
			display: flex;
			flex-direction: column;
			gap: 4px;
		}
		.login-field label {
			font-size: 0.85em;
			font-weight: 500;
			color: var(--pico-muted-color);
			margin-bottom: 0;
		}
		.login-wrap input[type=text],
		.login-wrap input[type=password] {
			padding: 9px 12px;
			font-size: 1rem;
			height: auto;
			margin-bottom: 0;
		}
		.login-pw-row {
			display: flex;
			gap: 0.4rem;
			align-items: stretch;
		}
		.login-pw-row input {
			flex: 1;
			min-width: 0;
		}
		.login-pw-row .yweb-btn {
			padding: 0 0.7rem;
		}
		.login-flash {
			padding: 12px 16px;
			border-radius: 8px;
			border: 1px solid transparent;
			font-weight: 500;
			font-size: 0.9rem;
			margin: 0;
		}
		/* focused programmatically for the announcement; the tinted
		   banner itself is the visual indicator, it is not interactive */
		.login-flash:focus {
			outline: none;
		}
		.login-flash.err {
			background: rgba(231, 76, 60, 0.12);
			border-color: rgba(231, 76, 60, 0.35);
			color: var(--yweb-danger);
		}
		.login-flash.out {
			background: var(--yweb-bg-elevated);
			border-color: var(--yweb-border-subtle);
			color: var(--pico-color);
		}
		.login-wrap button[type=submit] {
			width: 100%;
			padding: 9px 18px;
			font-size: 0.95rem;
			margin-top: 4px;
		}
	</style>
</head>
<body>
	<main class="login-wrap yweb-card">
		<h1>Neutrino-Web-UI</h1>
		<p class="sub">{=L:yw.login.intro=}</p>

		<!-- Signs in through the REST login (POST /api/v1/login), whose
		     session cookie the old pages and /control accept as well. -->
		<form id="loginForm" novalidate>
			<!-- The notes exist in the DOM up front, so role=status is
			     announced when they are unhidden. -->
			<div class="login-flash err" id="loginErr" role="status" tabindex="-1" hidden>{=L:yw.login.failed=}</div>
			<div class="login-flash err" id="loginWait" role="status" tabindex="-1" data-template="{=L:yw.login.wait=}" hidden></div>
			<div class="login-flash out" id="loginOut" role="status" hidden>{=L:yw.login.out=}</div>

			<div class="login-field">
				<label for="loginUser">{=L:yw.login.user=}</label>
				<input type="text" id="loginUser" name="username" autocomplete="username" autofocus>
			</div>

			<div class="login-field">
				<label for="loginPass">{=L:yw.login.pass=}</label>
				<div class="login-pw-row">
					<input type="password" id="loginPass" name="password" autocomplete="current-password">
					<button type="button" class="yweb-btn" aria-pressed="false" aria-label="{=L:yw.set.pw_show=}" onclick="loginTogglePw('loginPass', this)"></button>
				</div>
			</div>

			<button type="submit" id="loginSubmit" class="yweb-btn primary">{=L:yw.login.submit=}</button>
		</form>
	</main>

	<script>
		// Local eye icons: this page deliberately does not load yweb-header.js
		var LOGIN_EYE = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:1rem;height:1rem;vertical-align:middle" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>';
		var LOGIN_EYEOFF = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:1rem;height:1rem;vertical-align:middle" aria-hidden="true"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/></svg>';
		// The icon mirrors the state: crossed-out eye while masked
		document.querySelectorAll('.login-pw-row .yweb-btn').forEach(function(b) { b.innerHTML = LOGIN_EYEOFF; });

		function loginTogglePw(id, btn) {
			var el = document.getElementById(id);
			var show = el.type === 'password';
			el.type = show ? 'text' : 'password';
			btn.setAttribute('aria-pressed', show ? 'true' : 'false');
			btn.innerHTML = show ? LOGIN_EYE : LOGIN_EYEOFF;
		}

		// Where to go once signed in: a path on this box and nothing else -
		// one leading slash, no second one, no backslash anywhere, which is
		// the rule the server applied while it handled this form itself.
		function loginSafeNext(next) {
			if (!next || next.charAt(0) !== '/' || next.charAt(1) === '/' || next.indexOf('\\') >= 0)
				return '/';
			return next;
		}

		var loginParams = new URLSearchParams(location.search);
		var loginNext = loginSafeNext(loginParams.get('next'));
		var LOGIN_WAIT = document.getElementById('loginWait').getAttribute('data-template');

		function loginNote(id, text) {
			['loginErr', 'loginWait', 'loginOut'].forEach(function(n) {
				document.getElementById(n).hidden = (n !== id);
			});
			if (!id)
				return;
			var note = document.getElementById(id);
			if (text)
				note.textContent = text;
			if (note.hasAttribute('tabindex'))
				note.focus();
		}

		async function loginSubmit(e) {
			e.preventDefault();
			var btn = document.getElementById('loginSubmit');
			var pass = document.getElementById('loginPass');
			if (btn.disabled)
				return;
			btn.disabled = true;
			loginNote(null);
			try {
				var resp = await fetch('/api/v1/login', {
					method: 'POST', credentials: 'same-origin', cache: 'no-store',
					headers: {'Content-Type': 'application/json'},
					body: JSON.stringify({user: document.getElementById('loginUser').value, password: pass.value})
				});
				if (resp.ok) {
					location.replace(loginNext);
					return;
				}
				// A session is open already: the login route then asks for its
				// second token, and there is nothing left to sign in to.
				if (resp.status === 403) {
					var s = await fetch('/api/v1/session', {credentials: 'same-origin', cache: 'no-store'});
					var state = s.ok ? await s.json() : null;
					if (state && state.authenticated) {
						location.replace(loginNext);
						return;
					}
				}
				if (resp.status === 429)
					loginNote('loginWait', LOGIN_WAIT.replace('%s', resp.headers.get('Retry-After') || '60'));
				else
					loginNote('loginErr');
			} catch (ex) {
				loginNote('loginErr');
			}
			btn.disabled = false;
			pass.select();
		}
		document.getElementById('loginForm').addEventListener('submit', loginSubmit);

		if (loginParams.get('out') === '1')
			loginNote('loginOut');
	</script>
</body>
</html>
