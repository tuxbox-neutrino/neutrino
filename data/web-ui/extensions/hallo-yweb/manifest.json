{
	"name": "Hello yWeb",
	"version": "1.0.0",
	"slot": "tools",
	"entry": "hallo.html",
	"description": "Reference extension (copy-paste template)",
	"settings": {
		"label": "L:settings.label",
		"config": "yweb",
		"sections": [
			{
				"title": "L:settings.section_demo",
				"fields": [
					{ "key": "hallo_yweb_text", "label": "L:settings.greeting", "type": "text" },
					{ "key": "hallo_yweb_flag", "label": "L:settings.flag", "type": "bool01" }
				]
			},
			{
				"title": "L:settings.section_action",
				"fields": [
					{
						"type": "action",
						"id": "hallo-yweb-hostname",
						"label": "L:settings.hostname",
						"button": "L:settings.hostname_btn",
						"api": { "endpoint": "exec", "params": "Y_Tools&get_hostname", "raw": true },
						"success": "L:settings.hostname_ok"
					}
				]
			}
		]
	}
}
