<!DOCTYPE html>
<html lang="de" data-theme="dark">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Neutrino-Web-UI - {=L:yw.nav.recordings=}</title>
	<link rel="icon" href="/favicon/favicon.ico">
	<script>
		// Apply the stored theme before first paint: yweb-header.js runs
		// too late, and some pages never load it at all.
		try { document.documentElement.setAttribute('data-theme', localStorage.getItem('yweb-theme') || 'dark'); } catch (e) {}
	</script>
	<link rel="stylesheet" href="/css/pico.min.css">
	<link rel="stylesheet" href="/css/yweb.css?v=89">
	<style>
		/* Two columns like the timer list: sources and sorting, then the list */
		main.yweb-media-grid {
			display: grid;
			grid-template-columns: fit-content(18rem) 1fr;
			gap: 0.6rem;
			padding: 0.5rem;
			overflow: hidden;
		}

		@media (max-width: 800px) {
			main.yweb-media-grid {
				grid-template-columns: 1fr;
				grid-template-rows: auto 1fr;
			}
		}

		.yweb-media-controls {
			display: grid;
			gap: 0.4rem;
			padding: 0.5rem 0.8rem;
		}

		.yweb-media-controls input,
		.yweb-media-controls select {
			margin: 0;
			font-size: var(--yweb-font-sm, 0.8rem);
			padding: 0.3rem 0.5rem;
			height: auto;
		}

		.yweb-media-sort {
			display: flex;
			gap: 0.3rem;
		}

		.yweb-media-row {
			display: flex;
			align-items: center;
			gap: 0.6rem;
			padding: 0.45rem 0.6rem;
			border-bottom: 1px solid var(--pico-muted-border-color);
			cursor: pointer;
		}

		.yweb-media-row:hover {
			background: var(--pico-secondary-background, rgba(127, 127, 127, 0.08));
		}

		.yweb-media-cover {
			flex: 0 0 4.2rem;
			height: 2.4rem;
			border-radius: 4px;
			overflow: hidden;
			display: flex;
			align-items: center;
			justify-content: center;
			background: var(--pico-muted-border-color);
			color: var(--pico-muted-color);
		}

		.yweb-media-cover img {
			width: 100%;
			height: 100%;
			object-fit: cover;
		}

		.yweb-media-cover svg {
			width: 1.2rem;
			height: 1.2rem;
		}

		.yweb-media-info {
			flex: 1;
			min-width: 0;
			line-height: 1.3;
		}

		.yweb-media-title {
			font-weight: 600;
			font-size: 0.85rem;
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}

		.yweb-media-meta {
			font-size: 0.7rem;
			color: var(--pico-muted-color);
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}

		.yweb-media-badge {
			font-size: 0.62rem;
			font-weight: 600;
			padding: 0.05rem 0.4rem;
			border-radius: 999px;
			background: rgba(59, 130, 246, 0.15);
			color: var(--pico-primary);
			margin-left: 0.4rem;
		}

		.yweb-media-actions {
			display: flex;
			gap: 0.25rem;
		}

		.yweb-media-actions .yweb-btn svg {
			width: 0.9rem;
			height: 0.9rem;
		}

		.yweb-media-note {
			padding: 0.4rem 0.8rem;
			font-size: 0.72rem;
			color: var(--pico-muted-color);
		}

		.yweb-media-more {
			display: block;
			margin: 0.6rem auto;
		}

		.yweb-media-detail-cover {
			max-width: 100%;
			max-height: 12rem;
			border-radius: 6px;
			display: block;
			margin-bottom: 0.6rem;
		}

		.yweb-media-detail-facts {
			display: grid;
			grid-template-columns: auto 1fr;
			gap: 0.15rem 0.8rem;
			font-size: 0.78rem;
			margin-bottom: 0.6rem;
		}

		.yweb-media-detail-facts dt {
			color: var(--pico-muted-color);
		}

		.yweb-media-detail-facts dd {
			margin: 0;
		}

		.yweb-media-detail-text {
			white-space: pre-wrap;
			font-size: 0.8rem;
		}

		.yweb-media-detail-links {
			display: flex;
			flex-wrap: wrap;
			gap: 0.8rem;
			margin-top: 0.6rem;
			font-size: 0.8rem;
		}
	</style>
</head>
<body>
	<!-- Header generated by yweb-header.js -->
	<div class="yweb-header-wrapper" data-page="recordings"></div>
	<div class="yweb-header-spacer"></div>

	<main class="yweb-media-grid">
		<!-- Sources, search and sorting -->
		<article class="yweb-card yweb-panel-card yweb-card-sm" id="card-sources">
			<header class="yweb-card-header" onclick="toggleCard('card-sources')">
				<h3 class="yweb-card-title">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z"/>
					</svg>
					{=L:yw.media.sources=}
				</h3>
				<span class="yweb-card-preview" id="sourcePreview">{=L:yw.media.all=}</span>
			</header>
			<div class="yweb-card-body">
				<div class="yweb-media-controls">
					<input type="search" id="mediaSearch" placeholder="{=L:yw.media.search=}" aria-label="{=L:yw.media.search=}">
					<div class="yweb-media-sort">
						<select id="mediaSort" aria-label="{=L:yw.media.sort=}">
							<option value="start">{=L:yw.media.sort_start=}</option>
							<option value="title">{=L:yw.media.sort_title=}</option>
							<option value="channel">{=L:yw.media.sort_channel=}</option>
							<option value="duration">{=L:yw.media.sort_duration=}</option>
							<option value="size">{=L:yw.media.sort_size=}</option>
						</select>
						<select id="mediaOrder" aria-label="{=L:yw.media.order=}">
							<option value="">↕</option>
							<option value="asc">↑</option>
							<option value="desc">↓</option>
						</select>
					</div>
				</div>
				<ul class="yweb-plain-list yweb-filter-list" id="sourceList">
					<li aria-busy="true">{=L:yw.msg.loading=}</li>
				</ul>
			</div>
		</article>

		<!-- The recordings -->
		<article class="yweb-card yweb-panel-card yweb-card-sm" id="card-recordings">
			<header class="yweb-card-header" onclick="toggleCard('card-recordings')">
				<h3 class="yweb-card-title">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<rect x="2" y="4" width="20" height="16" rx="2"/>
						<path d="M7 4v16M17 4v16M2 9h5M2 15h5M17 9h5M17 15h5"/>
					</svg>
					{=L:yw.nav.recordings=}
				</h3>
				<span class="yweb-card-preview" id="mediaPreview">--</span>
				<span class="yweb-timer-count" id="mediaCount"></span>
			</header>
			<div class="yweb-card-body">
				<div class="yweb-media-note" id="mediaPartial" hidden>{=L:yw.media.partial=}</div>
				<ul class="yweb-plain-list" id="mediaList">
					<li aria-busy="true">{=L:yw.media.loading=}</li>
				</ul>
				<button type="button" class="yweb-btn yweb-media-more" id="mediaMore" hidden>{=L:yw.media.more=}</button>
			</div>
		</article>

		<!-- Mobile Card Indicator -->
		<div class="yweb-card-indicator" id="cardIndicator"></div>
	</main>

	<script src="/Y_Lang.yjs?v=27"></script>
	<script src="/yweb-header.js?v=58"></script>
	<script src="/yweb-dom.js?v=1"></script>
	<script src="/yweb-v1.js?v=12"></script>
	<script>
		// The finished recordings over /api/v1/recordings/archive: a page at a
		// time, by source, title words and order; details, play on the TV,
		// playlist and file, and delete. Titles and texts come from the
		// recording's metadata and go in as text.
		const PAGE = 30;
		const SVG_FILM = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M7 4v16M17 4v16M2 9h5M2 15h5M17 9h5M17 15h5"/></svg>';
		const SVG_PLAY = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5,3 19,12 5,21"/></svg>';
		const SVG_INFO = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>';
		const SVG_DELETE = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3,6 5,6 21,6"/><path d="M19,6v14a2,2 0 0,1-2,2H7a2,2 0 0,1-2-2V6m3,0V4a2,2 0 0,1,2-2h4a2,2 0 0,1,2,2v2"/></svg>';

		let source = '';		// the library directory shown, '' for all
		let nextOffset = 0;		// where the next page begins, null after the last
		let listToken = 0;		// a newer read makes an older answer stale
		let partialRetry = null;
		let partialTries = 0;		// a directory still read the first time is asked about a few times, not for ever
		let pagesShown = 0;		// pages on screen, so a reread does not throw away what "more" loaded
		let sourcesShown = '';

		function archive(id) {
			return '/recordings/archive/' + encodeURIComponent(id);
		}

		function when(sec) {
			const d = new Date(sec * 1000);
			return ywebPad2(d.getDate()) + '.' + ywebPad2(d.getMonth() + 1) + '.' + d.getFullYear() + ' ' + ywebFormatTime(d);
		}

		function length(sec) {
			if (!sec) return '';
			const h = Math.floor(sec / 3600), m = Math.floor(sec / 60) % 60;
			return h > 0 ? h + ':' + ywebPad2(m) + ' h' : m + ' min';
		}

		function bytes(n) {
			return n ? ywebFormatKB(Math.round(n / 1024)) : '';
		}

		// One page of the list; more=true appends the next page
		async function loadList(more) {
			const token = ++listToken;
			const list = document.getElementById('mediaList');
			const moreBtn = document.getElementById('mediaMore');
			if (!more) {
				nextOffset = 0;
				list.replaceChildren(ywebEl('li', {attrs: {'aria-busy': 'true'}}, '{=L:yw.media.loading=}'));
			}
			if (nextOffset === null) return;

			const query = {offset: nextOffset, limit: PAGE, sort: document.getElementById('mediaSort').value};
			const order = document.getElementById('mediaOrder').value;
			if (order) query.order = order;
			const words = document.getElementById('mediaSearch').value.trim();
			if (words) query.title = words;
			if (source) query.source = source;

			let page;
			try {
				page = await ywebV1('GET', '/recordings/archive', {query: query});
			} catch (e) {
				if (token !== listToken) return;
				list.replaceChildren(ywebEl('li', {className: 'yweb-empty'}, '{=L:yw.msg.load_fail=}: ' + e.message));
				moreBtn.hidden = true;
				return;
			}
			if (token !== listToken) return;

			const items = (page && page.items) || [];
			pagesShown = more ? pagesShown + 1 : 1;
			if (!more) list.replaceChildren();
			items.forEach(rec => list.appendChild(recordingRow(rec)));
			if (!more && items.length === 0)
				list.appendChild(ywebEl('li', {className: 'yweb-empty'}, '{=L:yw.media.none=}'));

			nextOffset = (page && typeof page.next_offset === 'number') ? page.next_offset : null;
			moreBtn.hidden = nextOffset === null;
			const total = (page && page.total) || 0;
			document.getElementById('mediaCount').textContent = String(total);
			document.getElementById('mediaPreview').textContent = total + ' {=L:yw.nav.recordings=}';
			showSources((page && page.sources) || []);

			// a directory still being read the first time: asked again a few
			// times, further apart each time, while only the first page is shown
			document.getElementById('mediaPartial').hidden = !(page && page.partial);
			if (!(page && page.partial)) partialTries = 0;
			else if (!partialRetry && partialTries < 5 && pagesShown === 1) {
				partialRetry = setTimeout(() => {
					partialRetry = null;
					if (pagesShown === 1) loadList(false);	// "more" was pressed meanwhile: keep its pages
				}, 3000 * ++partialTries);
			}
		}

		// The player moved: only the first page is read again, and not while
		// somebody has paged further down
		let playbackSoon = null;
		function playbackChanged() {
			if (pagesShown > 1 || playbackSoon) return;
			playbackSoon = setTimeout(() => { playbackSoon = null; loadList(false); }, 1000);
		}

		function recordingRow(rec) {
			const cover = ywebEl('div', {className: 'yweb-media-cover'},
				ywebEl('img', {attrs: {src: '/api/v1' + archive(rec.id) + '/cover', alt: '', loading: 'lazy'},
					on: {error: function() { cover.replaceChildren(ywebMarkup(SVG_FILM)); }}}));
			const meta = [rec.channel, when(rec.start), length(rec.duration), bytes(rec.size)].filter(Boolean).join(' · ');
			return ywebEl('li', {className: 'yweb-media-row', data: {id: rec.id}, on: {click: () => showDetail(rec.id)}},
				cover,
				ywebEl('div', {className: 'yweb-media-info'},
					ywebEl('div', {className: 'yweb-media-title'}, rec.title || rec.channel || rec.id,
						rec.playing ? ywebEl('span', {className: 'yweb-media-badge'}, '{=L:yw.media.playing=}') : null),
					ywebEl('div', {className: 'yweb-media-meta'}, meta)),
				ywebEl('div', {className: 'yweb-media-actions', on: {click: e => e.stopPropagation()}},
					button(SVG_PLAY, '{=L:yw.media.play=}', () => play(rec.id)),
					button(SVG_INFO, 'Info', () => showDetail(rec.id)),
					button(SVG_DELETE, '{=L:yw.media.delete=}', () => remove(rec), true)));
		}

		function button(svg, title, onClick, danger) {
			return ywebEl('button', {type: 'button', className: 'yweb-btn', title: title,
				attrs: {'aria-label': title}, style: danger ? {color: 'var(--yweb-danger)'} : undefined,
				on: {click: onClick}}, ywebMarkup(svg));
		}

		// The library's directories, as the answer names them
		function showSources(sources) {
			const key = sources.join('\n');
			if (key === sourcesShown) return;
			sourcesShown = key;
			const list = document.getElementById('sourceList');
			const item = (value, label) => ywebEl('li', {className: 'yweb-nav-item yweb-filter-item' + (value === source ? ' active' : ''),
				data: {source: value}, on: {click: () => chooseSource(value, label)}},
				ywebEl('span', {className: 'yweb-nav-name yweb-filter-name'}, label));
			list.replaceChildren.apply(list, [item('', '{=L:yw.media.all=}')].concat(sources.map(s => item(s, s))));
		}

		function chooseSource(value, label) {
			source = value;
			document.querySelectorAll('#sourceList .yweb-filter-item').forEach(li => {
				li.classList.toggle('active', (li.dataset.source || '') === value);
			});
			document.getElementById('sourcePreview').textContent = label;
			loadList(false);
			if (window.innerWidth <= 800) selectCard('card-recordings');
		}

		// The details of one recording in a sheet
		async function showDetail(id) {
			let rec;
			try {
				rec = await ywebV1('GET', archive(id));
			} catch (e) {
				ywebShowToast(e.message, true);
				return;
			}
			const facts = [];
			function fact(label, value) {
				if (value === undefined || value === null || value === '') return;
				facts.push(ywebEl('dt', {}, label), ywebEl('dd', {}, String(value)));
			}
			fact('{=L:yw.dash.channels=}', rec.channel);
			fact('Start', when(rec.start));
			fact('{=L:yw.media.sort_duration=}', length(rec.duration));
			fact('{=L:yw.media.sort_size=}', bytes(rec.size));
			fact('{=L:yw.media.year=}', rec.year);
			fact('{=L:yw.media.country=}', rec.country);
			if (rec.rating) fact('{=L:yw.media.rating=}', (rec.rating / 10).toFixed(1));
			if (rec.age && rec.age !== 99) fact('{=L:yw.media.age=}', rec.age);
			if (rec.audio && rec.audio.length) fact('{=L:yw.media.audio=}', rec.audio.join(', '));
			const text = [rec.description, rec.long_description].filter(Boolean).join('\n\n');
			const base = '/api/v1' + archive(id);
			ywebSheet({
				title: rec.title || rec.channel || rec.id,
				body: [
					rec.cover ? ywebEl('img', {className: 'yweb-media-detail-cover', attrs: {src: base + '/cover', alt: ''}}) : null,
					ywebEl('dl', {className: 'yweb-media-detail-facts'}, facts),
					text ? ywebEl('div', {className: 'yweb-media-detail-text'}, text) : null,
					ywebEl('div', {className: 'yweb-media-detail-links'},
						ywebEl('a', {attrs: {href: base + '/playlist.m3u', download: ''}}, '{=L:yw.media.playlist=}'),
						ywebEl('a', {attrs: {href: base + '/file', download: ''}}, '{=L:yw.media.download=}'))
				],
				actions: [
					{label: '{=L:yw.media.delete=}', value: 'delete', danger: true},
					{label: '{=L:yw.msg.close=}', value: 'close'},
					{label: '{=L:yw.media.play=}', value: 'play', primary: true}
				],
				onClose: result => {
					if (result === 'play') play(id);
					else if (result === 'delete') remove(rec);
				}
			});
		}

		// On the TV: a file the player plays, or a box in standby, is asked about first
		async function play(id) {
			try {
				const ok = await ywebV1Lifting(archive(id) + '/play', {}, {
					title: '{=L:yw.media.ask_title=}',
					ok: '{=L:yw.media.play=}',
					stop: '{=L:yw.media.ask_stop=}',
					wake: '{=L:yw.media.ask_wake=}'
				});
				if (ok) ywebShowToast('{=L:yw.media.played=}');
			} catch (e) {
				ywebShowToast(e.message, true);
			}
		}

		// Delete with a question; the box says why it cannot (recording,
		// playing, a share it may not write)
		function remove(rec) {
			ywebSheet({
				title: rec.title || rec.channel || rec.id,
				body: ywebEl('p', {}, '{=L:yw.media.delete_confirm=}'),
				actions: [
					{label: '{=L:yw.tm.cancel=}', value: false},
					{label: '{=L:yw.media.delete=}', value: true, primary: true, danger: true}
				],
				onClose: async result => {
					if (result !== true) return;
					try {
						await ywebV1('DELETE', archive(rec.id));
						ywebShowToast('{=L:yw.media.deleted=}');
						loadList(false);
					} catch (e) {
						ywebShowToast(e.message, true);
					}
				}
			});
		}

		// Controls: a search waits for the typing to pause
		let searchTimer = null;
		document.getElementById('mediaSearch').addEventListener('input', () => {
			clearTimeout(searchTimer);
			searchTimer = setTimeout(() => loadList(false), 400);
		});
		document.getElementById('mediaSort').addEventListener('change', () => loadList(false));
		document.getElementById('mediaOrder').addEventListener('change', () => loadList(false));
		document.getElementById('mediaMore').addEventListener('click', () => loadList(true));

		loadList(false);
		// a finished recording joins the library; a playback moves the "playing" mark
		ywebV1Events({
			'record-stop': () => loadList(false),
			playback: playbackChanged
		});

		document.addEventListener('DOMContentLoaded', function() {
			ywebInitMobileAccordion({
				cardOrder: ['card-sources', 'card-recordings'],
				storageKey: 'yweb-media-card',
				defaultCard: 'card-recordings',
				breakpoint: 800,
				indicatorId: 'cardIndicator',
				containerSelector: '.yweb-media-grid',
				mode: 'collapsed'
			});
		});

		if (typeof ywebSetRefreshCallback === 'function') {
			ywebSetRefreshCallback(function() {
				return loadList(false);
			});
		}
	</script>
</body>
</html>
