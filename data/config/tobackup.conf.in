# enter stuff you want to backup here.
# one file or directory per line
# prefix entries with "-" to exclude them from broader directory backups
# wildcard entries are allowed for file patterns
#
# @CONFIGDIR@/tuxtxt/			# an example for a complete directory
# /var/etc/rcS.local			# an example for a single file

